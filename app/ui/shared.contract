use Face from "../face.contract"

// Shared screen rhythm. Colours are generated from design/tokens.json.
style Screen
  background-color="surface.canvas"
  color="-exact-label"

style PageTitle
  font="-exact-headline"
  font-weight=600
  letter-spacing="-0.2px"

style HeroTitle
  font="-exact-large-title"
  font-weight=700
  letter-spacing="-0.8px"

style PageHeader
  display="flex"
  align-items="center"
  gap="space.sm"
  padding="space.md space.xl"
  min-height=72
  box-sizing="border-box"
  background-color="surface.canvas"
  border-bottom="1px solid surface.line"

// The sidebar's top bar: search and New Bot as two quiet circles.

// A file on a message: a type tile, its name and size, and a download glyph.
style FileCard
  display="flex"
  min-width=240
  padding="space.sm space.md"
  border-radius="radius.lg"
  background-color="surface.card"
  border="1px solid surface.line"
  color="-exact-label"
  text-decoration="none"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// An answer button on a request card.
style ChoiceButton
  min-height=32
  padding="2px space.md"
  border="1px solid surface.line"
  border-radius="radius.full"
  font="-exact-subheadline"
  font-weight=500
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style QuietButton
  min-width=44
  min-height=44

style TextControl
  box-sizing="border-box"
  min-height=44
  padding="space.sm space.md"
  border="none"
  border-radius="radius.sm"
  color="ink.muted"
  background-color="transparent"
  font="-exact-subheadline"
  font-weight=500
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style IconControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=44
  height=44
  padding=0
  border="none"
  border-radius="radius.md"
  color="ink.muted"
  background-color="transparent"
  :disabled
    opacity=0.4
    color="ink.muted"
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// The composer's send: a Tide circle with Night ink, the brand's filled look.
// The chat header's Bot name: one button that toggles the right panel.

style ToggleControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=44
  height=32
  padding=0
  border="none"
  border-radius="radius.sm"
  background-color="transparent"
  :checked
    background-color="transparent"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"
  :disabled
    opacity=0.4

style SwatchControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=44
  height=44
  box-sizing="border-box"
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="transparent"
  :checked
    background-color="transparent"
  :hover
    background-color="surface.soft"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style ConversationLink
  display="flex"
  align-items="center"
  width="100%"
  box-sizing="border-box"
  color="-exact-label"
  text-decoration="none"
  padding="space.md"
  border-radius="radius.md"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A search field: a pill with a magnifier beside it.

// A section label above a grouped card, like the panel labels in Threebot.
style SectionLabel
  font="-exact-footnote"
  font-weight=600
  color="ink.muted"
  padding="space.md space.md space.xs"

// A small status chip: a dot and a word.
style Chip
  display="flex"
  align-items="center"
  gap="space.xs"
  padding="4px space.sm"
  border-radius="radius.full"
  background-color="surface.soft"
  font="-exact-footnote"
  font-weight=500

// A rounded tile behind a row's glyph.
style IconTile
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  border-radius="radius.sm"
  background-color="surface.soft"

// Segmented choices (the theme picker): one pill, filled when chosen. The
// chosen fill is a node attribute, so the class keeps only literal states.
style Segment
  border="none"
  min-height=30
  padding="2px space.md"
  font="-exact-footnote"
  border-radius="radius.full"
  background-color="transparent"
  color="-exact-label"
  font-weight=500
  :hover
    background-color="surface.soft"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// Chat bubbles. Mine is the brand fill (Tide with Night ink, 8.2:1); the
// Bot's is a card. Fill, ink and the tail corner are node attributes.
style Bubble
  padding="space.sm space.lg"
  line-height=1.55
  white-space="pre-wrap"
  overflow-wrap="break-word"

// An applied reaction, overlapping the bubble's bottom corner.
style ReactionChip
  background-color="surface.raised"
  border="1px solid surface.line"
  border-radius="radius.full"
  font="-exact-footnote"
  padding="1px space.xs"
  min-height=22
  line-height=1.2

style Field
  box-sizing="border-box"
  min-height=44
  border="none"
  background-color="transparent"
  padding="space.xs 0"
  color="-exact-label"

style FormList
  background-color="surface.canvas"
  width="100%"
  max-width="44rem"
  align-self="center"
  box-sizing="border-box"

style PrimaryButton
  min-height=44

shape Bot
  slug: string
  name: string
  label: string
  line: string
  time: string
  initials: string
  color: string
  shape: string
  main: bool
  pinned: bool
  hidden: bool
  ready: bool
  working: bool
  unread: bool
  parentSlug: string
  hideFromSidebar: bool
  subagent: bool
  prompt: string
  inheritParentPrompt: bool
  notifications: bool

// A file on a message: an image shows in place, audio plays, any other file is a card.
shape FileRef
  id: string
  name: string
  kind: string
  size: string
  url: string

// One answer a request offers. `key` is the question it answers; `warn` is a caution to show.
shape Choice
  label: string
  value: string
  key: string
  warn: string

// One row of the transcript: a day mark, a message, a line between messages, a request the
// Bot is waiting on, or the working line. `head` and `tail` mark a run of one sender's messages
// for the bubble corners. `variant` is the kind of an event or a request.
// One slice of a Bot message. `text` is markdown. A `table` has header cells, body
// rows, and one alignment per header cell (`left`, `center`, or `right`).
shape Part
  kind: string
  text: string
  head: string[]
  rows: string[][]
  align: string[]

shape Row
  id: string
  kind: string
  mine: bool
  text: string
  title: string
  time: string
  head: bool
  tail: bool
  variant: string
  files: FileRef[]
  botSlug: string
  botName: string
  botColor: string
  botShape: string
  choices: Choice[]
  placeholder: string
  key: string
  react: string
  quote: string
  tokens: string
  resetAt: string
  parts: Part[]

shape Pin
  id: string
  text: string
  missing: bool

shape Chat
  slug: string
  rows: Row[]
  working: bool
  partial: bool
  readOnly: bool
  pins: Pin[]
  threadId: string

shape RoomMember
  slug: string
  name: string
  line: string
  state: string
  ready: bool
  working: bool

shape RoomMessage
  id: string
  name: string
  text: string
  from: string
  parts: Part[]

shape Room
  id: string
  title: string
  description: string
  color: string
  shape: string
  members: RoomMember[]
  messages: RoomMessage[]
  notifications: bool
  answerPolicy: string

// One @ completion row above the composer.
shape MentionHit
  slug: string
  name: string
  color: string
  shape: string

// One face in a group's stack. Colour stays a brand token; the view maps it.
shape FaceBit
  shape: string
  color: string
  state: string

// One row of the sidebar list: a Bot or a group, newest conversation first.
shape Convo
  kind: string
  key: string
  id: string
  name: string
  color: string
  shape: string
  faces: FaceBit[]
  line: string
  time: string
  at: string
  unread: bool
  working: bool
  ready: bool
  notifications: bool

// A Vault login, as the list may see it: the password is never in this shape.
shape Login
  id: string
  title: string
  website: string
  username: string
  hasPassword: bool
  hints: string
  icon: string

// The one password the person asked to see, for the login it names.

// One effort level a model offers, and one model a provider lists.
shape Effort
  id: string
  label: string

shape ModelOption
  slug: string
  name: string
  recommended: bool
  effort: string
  efforts: Effort[]

shape Provider
  instanceId: string
  name: string
  account: string
  models: ModelOption[]

// A Bot's model choice, and every provider T3 Code has ready. `efforts` are the current model's levels.
// `runtimeMode` is approval-required, auto, or full-access.
shape ModelList
  ok: bool
  error: string
  current: string
  instanceId: string
  effort: string
  runtimeMode: string
  currentName: string
  providerName: string
  effortLabel: string
  efforts: Effort[]
  providers: Provider[]

// A routine, to read: the panel does not edit them.
shape Routine
  id: string
  title: string
  paused: bool
  schedule: string
  next: string
  failed: bool

shape RoutineList
  ok: bool
  tasks: Routine[]
  error: string

shape LineRow
  id: string
  title: string
  status: string
  remote: bool
  threadId: string

shape Lineage
  ok: bool
  rows: LineRow[]
  error: string

// One day of a usage report: the chart bar (`px`), the sparkline bar (`spx`), and the figures as words.
shape DayRow
  day: string
  label: string
  short: string
  tokens: string
  input: string
  output: string
  cached: string
  cacheWrite: string
  turns: string
  messages: string
  px: number
  spx: number

shape ModelRow
  name: string
  tokens: string
  turns: string
  share: number

shape BotShare
  slug: string
  name: string
  color: string
  shape: string
  tokens: string
  turns: string
  messages: string
  share: number

shape UsageReport
  ok: bool
  error: string
  period: string
  periodLabel: string
  messages: string
  attachments: string
  turns: string
  tokens: string
  input: string
  output: string
  cached: string
  cacheWrite: string
  hit: string
  sentence: string
  days: DayRow[]
  rows: DayRow[]
  models: ModelRow[]
  bots: BotShare[]
  empty: bool
  first: string
  last: string

// What a Bot has kept: pictures, files and links, to look at.
shape ShelfItem
  id: string
  title: string
  detail: string
  url: string

shape Shelf
  ok: bool
  total: number
  pictures: ShelfItem[]
  files: ShelfItem[]
  links: ShelfItem[]

shape PageTab
  id: string
  title: string
  url: string

shape Computer
  ok: bool
  tabs: PageTab[]
  image: string
  error: string
  selected: string

// The tab on screen: the one the person picked, else the server's choice, else the first.
fn tabId(tabs: PageTab[], picked: string, selected: string): string = match first(tabs.filter(t => t.id == (picked != "" ? picked : selected))) { case some(t) => t.id, case none => match first(tabs) { case some(t) => t.id, case none => "" } }
fn tabTitle(tabs: PageTab[], id: string): string = match first(tabs.filter(t => t.id == id)) { case some(t) => t.title, case none => "" }
// Navigation and editing keys go as keys, including with Shift, Alt or Ctrl. One character goes as text. Escape and Meta do not.
// Colours come from design/tokens.json: change them there.
// design:begin colours
fn pickerColours(): string[] = ["brand.brown", "brand.red", "brand.orange", "brand.amber", "brand.green", "brand.default", "brand.blue", "brand.violet", "brand.pink", "brand.gray"]
fn avatarInk(c: string): string = c == "brand.black" || c == "brand.brown" || c == "brand.gray" ? "ink.light" : "ink.dark"
// design:end colours
fn shapeOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.shape, case none => "ball" }
fn colorOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.color, case none => "brand.default" }
// Keep the level only when the model being chosen lists it. Otherwise the gateway uses that model's default.
fn keptEffort(levels: Effort[], current: string): string = levels.filter(e => e.id == current).length > 0 ? current : ""
fn modelEfforts(providers: Provider[], instanceId: string, model: string): Effort[] = match first(providers.filter(p => p.instanceId == instanceId)) { case some(p) => match first(p.models.filter(m => m.slug == model)) { case some(m) => m.efforts, case none => [] }, case none => [] }
// Face colours are plain names; Bot colours are brand.* tokens from the design package.
fn faceColor(c: string): string = c == "brand.default" ? "teal" : c == "brand.blue" ? "blue" : c == "brand.violet" ? "violet" : c == "brand.pink" ? "pink" : c == "brand.orange" ? "orange" : c == "brand.green" ? "green" : c == "brand.black" ? "black" : c == "brand.white" ? "white" : c == "brand.brown" ? "brown" : c == "brand.red" ? "red" : c == "brand.amber" ? "amber" : c == "brand.yellow" ? "yellow" : c == "brand.cyan" ? "cyan" : c == "brand.purple" ? "purple" : c == "brand.magenta" ? "magenta" : c == "brand.gray" ? "gray" : "teal"
// Hover chrome ids. A prefix keeps a new menu row from falling out of the focus check.
fn chromeTarget(id: string): bool = id.startsWith("reply-") or id.startsWith("menu-") or id.startsWith("pick-")
fn knownReact(current: string): bool = current == "👍" or current == "❤️" or current == "😂" or current == "😮" or current == "🎉" or current == "🙏"
// The six menu emoji. A saved reaction outside that set stays on the strip so it can show the ring.
fn reactStrip(current: string): string[] = current == "" or knownReact(current) ? ["👍", "❤️", "😂", "😮", "🎉", "🙏"] : ["👍", "❤️", "😂", "😮", "🎉", "🙏"].concat([current])
// A tool line's verb. Known ids come from the string table (passed in: a top-level `fn` cannot call `t`). Anything else keeps the stored sentence.
fn eventVerb(id: string, stored: string, sent: string, routineCreated: string, routineUpdated: string, routineDeleted: string, from: string, ran: string, started: string, providerLimit: string, providerError: string): string = id == "sent" ? sent : id == "routine-created" ? routineCreated : id == "routine-updated" ? routineUpdated : id == "routine-deleted" ? routineDeleted : id == "from" ? from : id == "ran" ? ran : id == "started" ? started : id == "provider-limit" ? providerLimit : id == "provider-error" ? providerError : stored
// The open chat is clear. A hidden Bot keeps the mark until that chat is the open one.
fn showUnread(unread: bool, open: bool, hidden: bool): bool = unread and not open and (hidden or not hidden)
fn bitShape(faces: FaceBit[], n: number): string = match faces.at(n) { case some(f) => f.shape, case none => "ball" }
fn bitColor(faces: FaceBit[], n: number): string = match faces.at(n) { case some(f) => f.color, case none => "brand.default" }
fn bitState(faces: FaceBit[], n: number): string = match faces.at(n) { case some(f) => f.state, case none => "idle" }
fn memberFaces(bots: Bot[], members: RoomMember[]): FaceBit[] = members.slice(0, 3).map(m => FaceBit(shape=shapeOf(bots, m.slug), color=colorOf(bots, m.slug), state=m.state))
fn alignAt(align: string[], i: number): string = match align.at(i) { case some(a) => a == "center" or a == "right" ? a : "left", case none => "left" }
// The transcript id for a command id. A row already in that form is kept.

// The three working marks. Each one lags the last. Reduced motion is the host's job.
// Declared after Bots: the first component is the root, and it owns `routes nav`.

style PanelRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  padding="space.md"
  border="1px solid surface.line"
  border-radius="radius.md"
  background-color="surface.card"
  color="-exact-label"
  text-align="left"
  :hover
    background-color="surface.raised"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A choice in a list: a model, a shape.
style ChoiceRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  min-height=40
  padding="space.xs space.md"
  border="none"
  border-radius="radius.md"
  color="-exact-label"
  font="-exact-subheadline"
  text-align="left"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// The Bot's right panel: its Face and name, then three tabs, and pages for its model, its usage and editing it.
// The details beside a group, as a Bot has: who is in it, and its name, look and members.

keyframes dot
  from opacity=0.3 translate="0 0"
  40% opacity=1 translate="0 -3px"
  to opacity=0.3 translate="0 0"

// The message tray scales in, then rests. trayFade is the same entrance with no scale.
keyframes trayIn
  from opacity=0 scale=0.96
  to opacity=1 scale=1

keyframes trayFade
  from opacity=0
  to opacity=1

keyframes emojiIn
  from opacity=0 scale=0.96
  to opacity=1 scale=1
