
style PanelRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  padding="space.md"
  border="1px solid surface.line"
  border-radius="radius.md"
  background-color="surface.card"
  color="-exact-label"
  text-align="left"
  :hover
    background-color="surface.raised"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A choice in a list: a model, a shape.
style ChoiceRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  min-height=40
  padding="space.xs space.md"
  border="none"
  border-radius="radius.md"
  color="-exact-label"
  font="-exact-subheadline"
  text-align="left"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// The Bot's right panel: its Face and name, then three tabs, and pages for its model, its usage and editing it.
// The details beside a group, as a Bot has: who is in it, and its name, look and members.

keyframes dot
  from opacity=0.3 translate="0 0"
  40% opacity=1 translate="0 -3px"
  to opacity=0.3 translate="0 0"

// The message tray scales in, then rests. trayFade is the same entrance with no scale.
keyframes trayIn
  from opacity=0 scale=0.96
  to opacity=1 scale=1

keyframes trayFade
  from opacity=0
  to opacity=1

keyframes emojiIn
  from opacity=0 scale=0.96
  to opacity=1 scale=1
