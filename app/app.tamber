// Generated by `cargo run -p hbots-design -- sync` from design/tokens.json. Do not edit.
// The guidelines are in design/docs/.
tamber hbots

theme
  // The tint: Tide, darkened on light and lightened on dark so it reads as text.
  AccentColor = light-dark(#0a7a6e, #16a090)
  // The avatar colours. Each keeps its value in both schemes.
  brand.black = #000000  scheme=fixed
  brand.white = #f2f2f0  scheme=fixed
  brand.brown = #936439  scheme=fixed
  brand.red = #ff263c  scheme=fixed
  brand.orange = #ff6700  scheme=fixed
  brand.amber = #ffaf38  scheme=fixed
  brand.yellow = #ff9800  scheme=fixed
  brand.green = #00c972  scheme=fixed
  brand.default = #1cc3b0  scheme=fixed
  brand.cyan = #00bca6  scheme=fixed
  brand.blue = #1084fe  scheme=fixed
  brand.purple = #a97efe  scheme=fixed
  brand.violet = #9159fe  scheme=fixed
  brand.pink = #ff5eb1  scheme=fixed
  brand.magenta = #ff309b  scheme=fixed
  brand.gray = #777777  scheme=fixed
  // The ink on an avatar colour: white or Night, by its contrast.
  ink.light = #ffffff  scheme=fixed
  ink.dark = #16141f  scheme=fixed
  // Spacing and corners.
  space.xs = 4px
  space.sm = 8px
  space.md = 12px
  space.lg = 16px
  space.xl = 24px
  radius.sm = 8px
  radius.md = 14px
  radius.lg = 20px
  radius.full = 999px
