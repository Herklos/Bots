// hbots: the messaging app, written once in Contract. The Rust gateway
// (`hbots`, in ../gateway) keeps the Bots, the Vault and the Projects board and talks to a
// harness. T3 Code is the harness wired today; other backends may be added.
// This app is the same screen on the web, macOS, iOS and Linux.
use EmptyState from "exact:content"
use Face from "./face.contract"
use Glyph from "./glyph.contract"

// Shared screen rhythm. Colours are generated from design/tokens.json.
style Screen
  background-color="surface.canvas"
  color="-exact-label"

style PageTitle
  font="-exact-headline"
  font-weight=600
  letter-spacing="-0.2px"

style HeroTitle
  font="-exact-large-title"
  font-weight=700
  letter-spacing="-0.8px"

style PageHeader
  display="flex"
  align-items="center"
  gap="space.sm"
  padding="space.md space.xl"
  min-height=72
  box-sizing="border-box"
  background-color="surface.canvas"
  border-bottom="1px solid surface.line"

style QuietButton
  min-width=44
  min-height=44

style TextControl
  box-sizing="border-box"
  min-height=44
  padding="space.sm space.md"
  border="none"
  border-radius="radius.sm"
  color="ink.muted"
  background-color="transparent"
  font="-exact-subheadline"
  font-weight=500
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style IconControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=44
  height=44
  padding=0
  border="none"
  border-radius="radius.md"
  color="ink.muted"
  background-color="transparent"
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style SendControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=40
  height=40
  padding=0
  border="none"
  border-radius="radius.md"
  background-color="AccentColor"
  color="AccentColorText"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"
  :disabled
    background-color="surface.line"
    color="ink.muted"

style SwatchControl
  width=44
  height=44
  box-sizing="border-box"
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="transparent"
  :checked
    background-color="transparent"
  :hover
    background-color="surface.soft"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style ConversationLink
  color="-exact-label"
  text-decoration="none"
  padding="space.md"
  border-radius="radius.md"
  :hover
    background-color="surface.card"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style BotRow
  padding="space.md space.xs"
  gap="space.md"
  align-items="center"
  min-height=52

style Field
  box-sizing="border-box"
  min-height=44
  border="none"
  background-color="transparent"
  padding="space.xs 0"
  color="-exact-label"

style FormList
  background-color="surface.canvas"
  width="100%"
  max-width="44rem"
  align-self="center"
  box-sizing="border-box"

style PrimaryButton
  min-height=44

routes nav
  inbox "/"
    chat "/bot/:slug"
      details "/bot/:slug/details"
    create "/new"
    settings "/settings"
      vault "/vault"
        vaultAdd "/vault/new"
        vaultEdit "/vault/:id"

shape Reply
  ok: bool
  error: string

shape Session
  authenticated: bool
  passwordRequired: bool

shape Bot
  slug: string
  name: string
  label: string
  initials: string
  color: string
  main: bool
  hidden: bool
  ready: bool

// One row of the transcript: a message, a card the Bot is waiting on, or the working line.
shape Row
  id: string
  kind: string
  mine: bool
  text: string
  files: string

shape Chat
  slug: string
  rows: Row[]
  working: bool

shape Prefs
  userName: string
  theme: string
  projects: bool

// A connected app the gateway stores; the executor protocol is not spoken here.
shape App
  id: string
  name: string
  url: string

shape Config
  executorUrl: string

// Result of uploading one chat attachment to the gateway.
shape Attached
  ok: bool
  id: string
  name: string
  error: string

// A Vault login, as the list may see it: the password is never in this shape.
shape Login
  id: string
  title: string
  website: string
  username: string
  hasPassword: bool
  hints: string

// The one password the person asked to see, for the login it names.
shape Revealed
  ok: bool
  id: string
  password: string
  error: string

shape Project
  id: string
  kind: string
  title: string
  status: string
  area: string
  body: string

fn nameOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.name, case none => "" }
// Colours come from design/tokens.json: change them there.
// design:begin colours
fn pickerColours(): string[] = ["brand.default", "brand.blue", "brand.violet", "brand.pink", "brand.orange", "brand.green"]
fn avatarInk(c: string): string = c == "brand.black" || c == "brand.brown" || c == "brand.gray" ? "ink.light" : "ink.dark"
// design:end colours
fn colorOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.color, case none => "brand.default" }
fn kindTitle(k: string): string = k == "project" ? "Projects" : k == "task" ? "Tasks" : k == "machine" ? "Machines" : k == "service" ? "Services" : k == "repo" ? "Repos" : k == "note" ? "Notes" : "Links"
fn themeLabel(t: string): string = t == "system" ? "System" : t == "dark" ? "Dark" : "Light"
// Face colours are plain names; Bot colours are brand.* tokens from the design package.
fn faceColor(c: string): string = c == "brand.default" ? "teal" : c == "brand.blue" ? "blue" : c == "brand.violet" ? "violet" : c == "brand.pink" ? "pink" : c == "brand.orange" ? "orange" : c == "brand.green" ? "green" : c == "brand.black" ? "black" : c == "brand.white" ? "white" : c == "brand.brown" ? "brown" : c == "brand.red" ? "red" : c == "brand.amber" ? "amber" : c == "brand.yellow" ? "yellow" : c == "brand.cyan" ? "cyan" : c == "brand.purple" ? "purple" : c == "brand.magenta" ? "magenta" : c == "brand.gray" ? "gray" : "teal"

component Bots
  state password = ""
  state draft = ""
  state newName = ""
  state newColor = "brand.default"
  state nameDraft = ""
  state nameEditing = false
  state newPassword = ""
  // Each entry is `id\\tname` for a file waiting to go out with the next send.
  state pendingAttaches: string[] = []
  state appId = ""
  state appName = ""
  state appUrl = ""
  resource session = loadSession() as shape Session else empty()
  resource bots = loadBots() as shape Bot[] else empty()
  resource chat = loadChat(slug) as shape Chat else empty()
  resource prefs = loadPrefs() as shape Prefs else empty()
  resource vault = loadVault() as shape Login[] else empty()
  resource board = loadProjects() as shape Project[] else empty()
  resource apps = loadApps() as shape App[] else empty()
  resource config = loadConfig() as shape Config else empty()
  mutation signedIn as shape Reply refreshes session, bots
  mutation signedOut as shape Reply refreshes session, bots
  mutation created as shape Reply refreshes bots then afterCreate
  mutation sent as shape Reply refreshes chat then afterSend
  mutation stopped as shape Reply refreshes chat
  mutation renamed as shape Reply refreshes bots
  mutation recoloured as shape Reply refreshes bots
  mutation hidSaved as shape Reply refreshes bots
  mutation mainSaved as shape Reply refreshes bots
  mutation botRemoved as shape Reply refreshes bots then afterBotRemove
  mutation prefsSaved as shape Reply refreshes prefs
  mutation passwordSet as shape Reply refreshes session then afterPassword
  mutation loginSaved as shape Reply refreshes vault then afterLoginSave
  mutation loginRemoved as shape Reply refreshes vault then afterLoginRemove
  mutation revealed as shape Revealed
  mutation projectSaved as shape Reply refreshes board then afterProjectSave
  mutation projectRemoved as shape Reply refreshes board then afterProjectRemove
  mutation attached as shape Attached then afterAttach
  mutation appsSaved as shape Reply refreshes apps then afterAppsSave
  derive slug = match stack(nav).filter(e => e.name == "chat").at(-1) { case some(e) => e.params.slug, case none => "" }
  derive signInError = match signedIn { case some(r) => r.error, case none => "" }
  derive createError = match created { case some(r) => r.error, case none => "" }
  derive sendError = match sent { case some(r) => r.error, case none => "" }
  derive lastId = match chat.rows.at(-1) { case some(m) => m.id, case none => "" }
  derive locked = session.passwordRequired and not session.authenticated
  derive visibleBots = bots.filter(b => not b.hidden)
  derive hiddenBots = bots.filter(b => b.hidden)
  derive renameError = match renamed { case some(r) => r.error, case none => "" }
  derive colourError = match recoloured { case some(r) => r.error, case none => "" }
  derive hideError = match hidSaved { case some(r) => r.error, case none => "" }
  derive mainError = match mainSaved { case some(r) => r.error, case none => "" }
  derive botError = renameError != "" ? renameError : colourError != "" ? colourError : hideError != "" ? hideError : mainError
  derive botRemoveError = match botRemoved { case some(r) => r.error, case none => "" }
  derive prefsError = match prefsSaved { case some(r) => r.error, case none => "" }
  derive passwordError = match passwordSet { case some(r) => r.error, case none => "" }
  derive loginError = match loginSaved { case some(r) => r.error, case none => "" }
  derive loginRemoveError = match loginRemoved { case some(r) => r.error, case none => "" }
  derive revealedFor = match revealed { case some(r) => r.id, case none => "" }
  derive revealedText = match revealed { case some(r) => (r.ok ? r.password : ""), case none => "" }
  derive projectError = match projectSaved { case some(r) => r.error, case none => "" }
  derive projectRemoveError = match projectRemoved { case some(r) => r.error, case none => "" }
  derive attachError = match attached { case some(r) => r.error, case none => "" }
  derive appsError = match appsSaved { case some(r) => r.error, case none => "" }
  derive canSend = draft.trim() != "" or pendingAttaches.length > 0

  // Chats are read while they are open; the inbox while it is.
  task poll mount
    every(1500, pull)

  action pull
    refresh bots
    refresh chat
    if top(nav).name == "projects"
      refresh board
    if top(nav).name == "settings"
      refresh apps
      refresh config
  action editPassword(v: string)
    password = v
  action login
    if password != "" and not pending(signedIn)
      send signedIn = signIn(password)
      password = ""
  action logout
    send signedOut = signOut()
  // A wide window shows the list beside the open chat. Opening another Bot
  // replaces that chat, so the conversation swaps instead of stacking.
  action open(url: string)
    nav = top(nav).name == "chat" and url.startsWith("/bot/") and not url.includes("/details") ? replace(nav, url) : go(nav, url)
  action back
    nav = back(nav)
  action openNew
    newName = ""
    newColor = "brand.default"
    nav = push(nav, "/new")
  action editName(v: string)
    newName = v
  action pick(c: string)
    newColor = c
  action create
    if newName.trim() != "" and not pending(created)
      send created = createBot(newName.trim(), newColor)
  action afterCreate
    if createError == "" and top(nav).name == "create"
      nav = back(nav)
  action edit(v: string)
    draft = v
  action pickFiles
    showPicker("chat-attach")
  action filesPicked(files: Picked[])
    if slug != "" and not pending(attached) and files.length > 0
      match files.at(0)
        case some(f)
          send attached = uploadAttachment(slug, f.path, f.name, f.type)
        case none
  action afterAttach
    match attached
      case some(r)
        if r.ok and r.id != ""
          pendingAttaches = pendingAttaches.concat([`${r.id}\t${r.name}`])
      case none
  action dropPending(entry: string)
    pendingAttaches = pendingAttaches.filter(e => e != entry)
  action post
    if canSend and not pending(sent)
      // pendingAttaches entries are `id\\tname`; the data module keeps the ids.
      send sent = sendMessage(slug, draft.trim(), pendingAttaches.join("\n"))
      draft = ""
    focus("composer")
  action afterSend
    if sendError == ""
      pendingAttaches = []
    toEnd()
  action stop
    send stopped = stopRun(slug)
  action toEnd
    scrollIntoView("transcript", lastId, block="end")
  action editAppId(v: string)
    appId = v
  action editAppName(v: string)
    appName = v
  action editAppUrl(v: string)
    appUrl = v
  action addApp
    if appId.trim() != "" and appName.trim() != "" and appUrl.trim() != "" and not pending(appsSaved)
      send appsSaved = addConnectedApp(appId.trim(), appName.trim(), appUrl.trim())
  action removeApp(id: string)
    if not pending(appsSaved)
      send appsSaved = removeConnectedApp(id)
  action afterAppsSave
    if appsError == ""
      appId = ""
      appName = ""
      appUrl = ""

  // Bot details: a Bot's name, colour, visibility and main status, and its deletion.
  action doRename(bslug: string, name: string)
    if name.trim() != ""
      send renamed = renameBot(bslug, name.trim())
  action doRecolour(bslug: string, color: string)
    send recoloured = recolourBot(bslug, color)
  action doHide(bslug: string, on: bool)
    send hidSaved = hideBot(bslug, on)
  action doMain(bslug: string)
    send mainSaved = makeMainBot(bslug)
  action doDropBot(bslug: string)
    send botRemoved = deleteBot(bslug)
  action afterBotRemove
    if botRemoveError == ""
      nav = go(nav, "/")

  // Settings: name, theme, the Projects beta and the remote-access password.
  action doEditName(v: string)
    nameDraft = v
    nameEditing = true
  action doSaveName(v: string)
    nameEditing = false
    if v.trim() != "" and v.trim() != prefs.userName
      send prefsSaved = setUserName(v.trim())
  action doPickTheme(t: string)
    send prefsSaved = setTheme(t)
  action doSetBeta(on: bool)
    send prefsSaved = setProjects(on)
  action editNewPassword(v: string)
    newPassword = v
  action doSavePassword
    if newPassword != "" and not pending(passwordSet)
      send passwordSet = setPassword(newPassword)
  action afterPassword
    if passwordError == ""
      newPassword = ""

  // Vault: a login is edited in a sheet. The password is kept unless a new one is typed.
  action doCommitLogin(id: string, title: string, website: string, username: string, password: string, hints: string)
    if (title.trim() != "" or website.trim() != "") and not pending(loginSaved)
      send loginSaved = saveLogin(id, title.trim(), website.trim(), username.trim(), password, hints.trim())
  action afterLoginSave
    if loginError == ""
      nav = back(nav)
  action doDropLogin(id: string)
    send loginRemoved = deleteLogin(id)
  action afterLoginRemove
    if loginRemoveError == ""
      nav = back(nav)
  action doReveal(id: string)
    if not pending(revealed)
      send revealed = revealPassword(id)
  action doHideReveal
    revealed = none
  action doCloseLogin
    revealed = none
    nav = back(nav)

  // Projects: a board of items by kind, edited in a sheet.
  action doCommitProject(id: string, kind: string, title: string, status: string, area: string, body: string)
    if title.trim() != "" and not pending(projectSaved)
      send projectSaved = saveProject(id, kind, title.trim(), status.trim(), area.trim(), body)
  action afterProjectSave
    if projectError == ""
      nav = back(nav)
  action doDropProject(id: string)
    send projectRemoved = deleteProject(id)
  action afterProjectRemove
    if projectRemoveError == ""
      nav = back(nav)

  view
    main class=Screen navigationKey=`${top(nav).id}` navigationBack="back" navigate=open interactive-widget="resizes-content" width="100%" height="100%" testId="app"
      if locked
        column flex=1 justify-content="center" align-items="center" padding="space.xl" testId="sign-in"
          column width="100%" max-width="22rem" gap="space.lg"
            column align-items="center" gap="space.sm"
              Face(shape="ball", color="teal", state="idle", size=72, still=false)
              text "hbots" role="heading" aria-level=1 class=HeroTitle
              text "Your Bots, at home." color="-exact-secondary-label"
            text "Enter the password you set in Settings → Remote access." color="-exact-secondary-label"
            input appearance="none" class=Field type="password" value=password input=editPassword submit=login placeholder="Password" aria-label="Password" testId="password" width="100%"
            if signInError != "" and not pending(signedIn)
              text signInError color="-exact-system-red" testId="sign-in-error"
            button press=login disabled=(password == "" or pending(signedIn)) buttonStyle="filled" testId="sign-in-button"
              text (pending(signedIn) ? "Signing in…" : "Sign In")
      else
        for e in stack(nav) key=e.id
          if e.name == "inbox"
            column class=Screen background-color="surface.sidebar" navigationSplit="288" navigationKey=`${e.id}` navigationScroll="bots-list" position="absolute" inset=0
              header class=PageHeader background-color="surface.sidebar"
                text "hbots" role="heading" aria-level=1 font-size=22 font-weight=700 letter-spacing="-0.6px" flex=1
                button class=TextControl appearance="none" press=openNew aria-label="New Bot" testId="new-bot" color="AccentColor"
                  text "New Bot"
              column navigationSplit="placeholder" flex=1 align-items="center" justify-content="center" gap="space.lg" padding="space.xl"
                Face(shape="ball", color="teal", state="idle", size=72, still=false)
                text "Your Bots, at home." class=HeroTitle text-align="center"
                text "Choose a Bot to pick up where you left off, or create someone new." color="ink.muted" text-align="center" max-width="24rem"
                button class=PrimaryButton press=openNew buttonStyle="filled"
                  text "New Bot"
              if failed(bots) and bots.length == 0
                EmptyState(symbol="symbol:alert", title="Can’t Reach the Gateway", message="Start the `hbots` gateway on this machine or on your server, then try again.")
                  button press=pull testId="retry"
                    text "Try Again"
              else if bots.length == 0 and not pending(bots)
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="empty-bots"
                  Face(shape="ball", color="teal", state="idle", size=72, still=false)
                  text "Meet your first Bot" role="heading" aria-level=2 class=PageTitle
                  text "Give your Bot a name, then make it your own. Your conversations stay together, right here." color="-exact-secondary-label" text-align="center" max-width="22rem"
                  button press=openNew buttonStyle="filled" testId="empty-new"
                    text "Create Your First Bot"
              else
                list id="bots-list" appearance="none" flex=1 min-height=0 padding="space.sm" gap="space.xs"
                  for b in visibleBots key=b.slug
                    link class=ConversationLink href=path("chat", b.slug) testId=`bot-${b.slug}`
                      row gap="space.md" align-items="center"
                        Face(shape="ball", color=faceColor(b.color), state=(b.ready ? "idle" : "asleep"), size=40, still=true)
                        column gap="space.xs" flex=1 min-width=0
                          text b.name font-weight=600
                          text (b.ready ? (b.label != "" ? b.label : "Ready to chat") : "Getting set up…") color="ink.muted" font="-exact-footnote" overflow-wrap="break-word"
                  if hiddenBots.length > 0
                    text "Hidden Bots" padding="space.lg space.md space.xs" font="-exact-footnote" color="ink.muted"
                    for b in hiddenBots key=b.slug
                      link class=ConversationLink href=path("details", b.slug) testId=`hidden-${b.slug}`
                        row gap="space.md" align-items="center"
                          Face(shape="ball", color=faceColor(b.color), state="asleep", size=32, still=true)
                          text b.name flex=1 color="ink.muted"
              row padding="space.sm space.md" border-top="1px solid surface.line"
                button class=TextControl appearance="none" press=open("/settings") testId="open-settings" flex=1 text-align="start"
                  text "Settings"
          else if e.name == "chat"
            column class=Screen navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0
              header class=PageHeader
                button press=open(path("details", e.params.slug)) appearance="none" aria-label="Bot details" testId="bot-details" width=44 height=44
                  Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state=(chat.working ? "working" : "idle"), size=36, still=(chat.rows.length == 0 and not chat.working))
                column flex=1 gap="space.xs"
                  text nameOf(bots, e.params.slug) role="heading" aria-level=1 class=PageTitle
                  if chat.working
                    text "Working…" color="ink.muted" font="-exact-footnote"
                button class=TextControl appearance="none" press=open(path("details", e.params.slug)) aria-label="Conversation details"
                  text "Bot details"
              if failed(chat)
                EmptyState(symbol="symbol:alert", title="Can’t Load This Conversation", message="Your messages haven’t loaded. Check the gateway, then try again.")
                  button press=pull testId="retry-chat"
                    text "Try Again"
              else if pending(chat) and chat.rows.length == 0
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" aria-busy=true
                  Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state="working", size=44, still=false)
                  text "Loading your conversation…" color="ink.muted"
              else if chat.rows.length == 0 and not chat.working
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="empty-chat"
                  Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state="idle", size=72, still=false)
                  text nameOf(bots, e.params.slug) class=HeroTitle
                  text "A little help, a new idea, or just a hello." color="ink.muted" text-align="center"
                  column gap="space.sm" width="100%" max-width="24rem" margin-top="space.lg"
                    button press=edit("Help me make a plan for today.") class=TextControl appearance="none" background-color="surface.card" testId="starter-plan"
                      text "Make a plan for today"
                    button press=edit("I have an idea I’d like to think through.") class=TextControl appearance="none" background-color="surface.card" testId="starter-idea"
                      text "Think through an idea"
                    button press=edit("What can we work on together?") class=TextControl appearance="none" background-color="surface.card" testId="starter-help"
                      text "See what we can do together"
              else
                column flex=1 min-height=0 justify-content="flex-end"
                  list id="transcript" testId="transcript" width="100%" max-width="46rem" align-self="center" box-sizing="border-box" padding="space.xl 0" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true max-height="100%" min-height=0 flex-shrink=1
                    for m in chat.rows key=m.id
                      column
                        if m.kind == "message"
                          row justify-content=(m.mine ? "flex-end" : "flex-start") padding="space.sm space.lg"
                            column gap="space.xs" max-width="82%"
                              if m.text != ""
                                text m.text padding="space.md space.lg" line-height=1.55 white-space="pre-wrap" border-radius="radius.md" overflow-wrap="break-word"
                                  background-color=(m.mine ? "surface.soft" : "surface.card") color="-exact-label"
                                  testId=`message-${m.id}`
                              if m.files != ""
                                text m.files padding="space.xs space.md" border-radius="radius.md" background-color="-exact-secondary-background" color="-exact-secondary-label" font="-exact-footnote" testId=`files-${m.id}`
                        else if m.kind == "request"
                          row padding="6px space.md"
                            column gap="space.xs" padding="space.md" border-radius="radius.md" background-color="-exact-secondary-background" flex=1 testId=`request-${m.id}`
                              text m.text font-weight=600
                              text "Answer this in T3 Code for now. It will show up here once the Bot can take your answer." color="-exact-secondary-label" font="-exact-footnote"
                        else
                          row padding="6px space.lg" gap="space.sm" align-items="center" testId="working"
                            Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state="working", size=24, still=false)
                            text "Working…" color="-exact-secondary-label"
              if sendError != "" and not pending(sent)
                text sendError color="-exact-system-red" padding="0 space.lg" testId="send-error"
              if attachError != "" and not pending(attached)
                text attachError color="-exact-system-red" padding="0 space.lg" testId="attach-error"
              if pendingAttaches.length > 0
                row gap="space.sm" flex-wrap="wrap" padding="0 space.md" testId="pending-files"
                  for entry in pendingAttaches key=entry
                    button press=dropPending(entry) buttonStyle="bordered" testId="pending-file"
                      text "Remove attachment"
              row align-items="flex-end" width="calc(100% - 32px)" max-width="44rem" align-self="center" box-sizing="border-box" margin="space.md space.lg space.xl" padding="space.xs space.sm" gap="space.xs" border-radius="radius.lg" border="1px solid surface.line"
                button class=IconControl press=pickFiles disabled=(slug == "" or pending(attached) or pendingAttaches.length >= 8) appearance="none" aria-label="Attach a file" testId="attach"
                  Glyph(name="attach", size=20)
                input type="file" id="chat-attach" display="none" change=filesPicked testId="chat-attach"
                textarea id="composer" value=draft input=edit rows=1 field-sizing="content" max-height=140 placeholder="Write a message…" aria-label="Message" testId="composer" flex=1 min-width=0 padding="space.md 0" border="none" background-color="transparent"
                if chat.working and not canSend
                  button class=SendControl appearance="none" press=stop margin="2px 0" aria-label="Stop" testId="stop"
                    Glyph(name="stop", size=18)
                else
                  button class=SendControl appearance="none" press=post disabled=(not canSend or pending(sent)) margin="2px 0" retainFocus=true aria-label="Send" testId="send"
                    Glyph(name="send", size=20)
          else if e.name == "details"
            for b in bots.filter(x => x.slug == e.params.slug) key=b.slug
              BotDetails(route=e.id, bot=b, error=botError, rename=doRename, recolour=doRecolour, hide=doHide, makeMain=doMain, drop=doDropBot)
          else if e.name == "settings"
            column class=Screen navigationKey=`${e.id}` navigationScroll="settings-form" position="absolute" inset=0
              header class=PageHeader
                text "Settings" role="heading" aria-level=1 class=PageTitle flex=1
              list id="settings-form" class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  row
                    text "Name"
                    input appearance="none" class=Field value=(nameEditing ? nameDraft : prefs.userName) input=doEditName change=doSaveName placeholder="Your name" aria-label="Your name" text-align="end" flex=1 min-width=0 testId="user-name"
                section
                  header
                    text "Appearance"
                  row gap=8 role="radiogroup" aria-label="Theme"
                    for t in ["system", "light", "dark"] key=t
                      button press=doPickTheme(t) role="radio" aria-checked=(prefs.theme == t) buttonStyle=(prefs.theme == t ? "filled" : "bordered") min-height=44 flex=1 testId=`theme-${t}`
                        text themeLabel(t)
                section
                  header
                    text "Private data"
                  button press=open("/vault") testId="open-vault"
                    row gap="space.md" align-items="center"
                      column flex=1 gap="space.xs"
                        text "Vault" font-weight=600
                        text "Manage saved logins" color="ink.muted" font="-exact-footnote"
                      Glyph(name="chevron", size=18)
                section
                  header
                    text "Remote access"
                  row
                    input appearance="none" class=Field type="password" value=newPassword input=editNewPassword submit=doSavePassword placeholder=(session.passwordRequired ? "New password" : "Set a password") aria-label="Password" autocomplete="new-password" flex=1 min-width=0 testId="new-password"
                  if passwordError != "" and not pending(passwordSet)
                    text passwordError color="-exact-system-red" testId="password-error"
                  button press=doSavePassword disabled=(newPassword == "" or pending(passwordSet)) testId="save-password"
                    text (session.passwordRequired ? "Change Password" : "Set Password")
                  footer
                    text "Anyone who opens hbots from another device signs in with this password."
                section
                  header
                    text "Connected apps"
                  if failed(apps)
                    text "Can’t load connected apps. Check that `hbots` is running." color="-exact-system-red"
                  else if apps.length == 0 and not pending(apps)
                    text "No connected apps yet. Add an https app the Bots can use." color="-exact-secondary-label" font="-exact-footnote"
                  for a in apps key=a.id
                    row gap="space.md" align-items="center" testId=`app-${a.id}`
                      column flex=1 min-width=0
                        text a.name font-weight=600
                        text a.url color="-exact-secondary-label" font="-exact-footnote"
                      button press=removeApp(a.id) disabled=pending(appsSaved) aria-label=`Remove ${a.name}` testId=`remove-app-${a.id}`
                        Glyph(name="trash", size=20)
                  row
                    text "Id"
                    input appearance="none" class=Field value=appId input=editAppId placeholder="short-name" aria-label="App id" text-align="end" flex=1 min-width=0 testId="app-id"
                  row
                    text "Name"
                    input appearance="none" class=Field value=appName input=editAppName placeholder="What you call it" aria-label="App name" text-align="end" flex=1 min-width=0 testId="app-name"
                  row
                    text "URL"
                    input appearance="none" class=Field value=appUrl input=editAppUrl placeholder="https://…" aria-label="App URL" text-align="end" flex=1 min-width=0 testId="app-url"
                  if appsError != "" and not pending(appsSaved)
                    text appsError color="-exact-system-red" testId="apps-error"
                  button press=addApp disabled=(appId.trim() == "" or appName.trim() == "" or appUrl.trim() == "" or pending(appsSaved)) testId="add-app"
                    text "Add App"
                  footer
                    text (config.executorUrl != "" ? `Executor: ${config.executorUrl}. The list is stored on this machine.` : "The list is stored on this machine. The gateway does not speak the executor protocol yet.")
                if session.passwordRequired
                  section
                    button press=logout testId="sign-out"
                      text "Sign Out"
          else if e.name == "vault"
            column class=Screen navigationKey=`${e.id}` navigationScroll="vault-list" position="absolute" inset=0
              header class=PageHeader
                text "Vault" role="heading" aria-level=1 class=PageTitle flex=1
                button press=open("/vault/new") aria-label="New Login" testId="new-login"
                  Glyph(name="add", size=20)
              if failed(vault)
                EmptyState(symbol="symbol:alert", title="Can’t Open the Vault", message="Check that `hbots` is running, then try again.")
              else if vault.length == 0 and not pending(vault)
                EmptyState(symbol="symbol:lock", title="No Logins Yet", message="Save a login here. Its password stays in the Vault and shows only when you press Reveal.")
                  button press=open("/vault/new") testId="empty-login"
                    text "Add a Login"
              else
                list id="vault-list" class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                  section
                    for v in vault key=v.id
                      link href=path("vaultEdit", v.id) testId=`login-${v.id}`
                        row class=BotRow
                          Glyph(name="lock", size=20)
                          column flex=1 min-width=0 gap="space.xs"
                            text v.title font-weight=600
                            text (v.username != "" ? v.username : v.website) color="ink.muted" font="-exact-footnote"
                          Glyph(name="chevron", size=20)
          else if e.name == "vaultAdd"
            LoginSheet(route=e.id, item=Login(id="", title="", website="", username="", hasPassword=false, hints=""), revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "vaultEdit"
            for l in vault.filter(x => x.id == e.params.id) key=l.id
              LoginSheet(route=e.id, item=l, revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="new-form" position="absolute" inset=0
              header class=PageHeader
                button class=TextControl appearance="none" press=back testId="new-cancel"
                  text "Cancel"
                text "New Bot" role="heading" aria-level=1 class=PageTitle flex=1
              scroll id="new-form" flex=1 min-height=0
                column width="100%" max-width="25rem" box-sizing="border-box" margin="0 auto" padding="space.xl" gap="space.xl"
                  column align-items="center" gap="space.md" padding="space.xl 0"
                    Face(shape="ball", color=faceColor(newColor), state="idle", size=96, still=false)
                    text "Pick a name and a colour." color="ink.muted" font="-exact-subheadline" text-align="center"
                  column gap="space.sm"
                    text "Name" font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=newName input=editName submit=create placeholder="What should we call your Bot?" aria-label="Name" padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-name"
                  column gap="space.md"
                    text "Colour" font="-exact-subheadline" font-weight=600
                    row gap="space.xs" flex-wrap="wrap"
                      for c in pickerColours() key=c
                        button class=SwatchControl press=pick(c) appearance="none" aria-label=`Colour ${faceColor(c)}` aria-pressed=(newColor == c) testId=`colour-${c}` width=44 height=44 padding=0
                          column width=36 height=36 box-sizing="border-box" margin="space.xs" border-radius="radius.full" background-color=c border=(newColor == c ? "3px solid -exact-label" : "3px solid transparent")
                  if createError != "" and not pending(created)
                    text createError color="-exact-system-red" testId="create-error"
              row padding="space.lg space.xl space.xl" width="100%" max-width="25rem" box-sizing="border-box" align-self="center"
                button class=PrimaryButton buttonStyle="filled" press=create disabled=(newName.trim() == "" or pending(created)) flex=1 testId="create"
                  text (pending(created) ? "Creating…" : "Create Bot")

// A Bot's own page, pushed from its chat or the inbox's Hidden section.
component BotDetails
  props
    route: number
    bot: Bot
    error: string
    rename: action
    recolour: action
    hide: action
    makeMain: action
    drop: action
  state name = bot.name
  action edit(v: string)
    name = v
  view
    column class=Screen navigationKey=`${route}` navigationScroll="details" position="absolute" inset=0
      header class=PageHeader
        text "Bot Details" role="heading" aria-level=1 class=PageTitle flex=1
      list id="details" class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          column align-items="center" gap="space.sm" padding="space.lg"
            Face(shape="ball", color=faceColor(bot.color), state=(bot.hidden ? "asleep" : "idle"), size=72, still=false)
            text bot.name class=PageTitle testId="details-name"
            text (bot.main ? "Your main Bot" : "Make this Bot your own") color="ink.muted" font="-exact-footnote"
        section
          row
            text "Name"
            input appearance="none" class=Field value=name input=edit change=rename(bot.slug) aria-label="Name" text-align="end" flex=1 min-width=0 testId="bot-name"
        section
          header
            text "Colour"
          row gap="space.sm" flex-wrap="wrap"
            for c in pickerColours() key=c
              button press=recolour(bot.slug, c) appearance="none" aria-label=`Colour ${c}` aria-pressed=(bot.color == c) testId=`colour-${c}`
                column width=44 height=44 border-radius=22 background-color=c border=(bot.color == c ? "3px solid -exact-label" : "3px solid transparent")
        section
          row
            text "Main Bot"
            if bot.main
              text "Yes" color="-exact-secondary-label" testId="is-main"
            else
              button press=makeMain(bot.slug) buttonStyle="bordered" testId="make-main"
                text "Make Main"
          row
            text "Hidden from the list"
            input type="checkbox" switch checked=bot.hidden disabled=bot.main change=hide(bot.slug) aria-label="Hidden from the list" testId="hide-bot"
          footer
            text (bot.main ? "The main Bot can’t be hidden or deleted. Make another Bot main first." : "A hidden Bot moves to the Hidden section of the list.")
        if error != ""
          section
            text error color="-exact-system-red" testId="bot-error"
        section
          button commandfor="drop-bot" command="show-modal" disabled=bot.main testId="delete-bot"
            text "Delete Bot"
      dialog id="drop-bot" role="alertdialog" aria-label=`Delete ${bot.name}?`
        text "Its folder moves to the trash. This can’t be undone from here."
        button press=drop(bot.slug) destructive=true commandfor="drop-bot" command="close" testId="drop-bot-ok"
          text "Delete"
        button commandfor="drop-bot" command="close" testId="drop-bot-cancel"
          text "Cancel"

// A Vault login's sheet. The password field starts empty: a saved password is shown only after Reveal.
component LoginSheet
  props
    route: number
    item: Login
    revealedFor: string
    revealedText: string
    error: string
    save: action
    reveal: action
    hide: action
    drop: action
    cancel: action
  state ttl = item.title
  state site = item.website
  state user = item.username
  state pass = ""
  state note = item.hints
  action editTitle(v: string)
    ttl = v
  action editWebsite(v: string)
    site = v
  action editUsername(v: string)
    user = v
  action editPassword(v: string)
    pass = v
  action editHints(v: string)
    note = v
  view
    column class=Screen navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
      header class=PageHeader justify-content="space-between"
        button press=cancel aria-label="Cancel" testId="login-cancel"
          Glyph(name="close", size=20)
        text (item.id == "" ? "New Login" : item.title) role="heading" aria-level=1
        button press=save(item.id, ttl, site, user, pass, note) disabled=(ttl.trim() == "" and site.trim() == "") buttonStyle="filled" aria-label="Save" testId="login-save"
          text "Save"
      list class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            text "Title"
            input appearance="none" class=Field value=ttl input=editTitle placeholder="Title" aria-label="Title" text-align="end" flex=1 min-width=0 testId="login-title"
          row
            text "Website"
            input appearance="none" class=Field type="url" value=site input=editWebsite placeholder="Website" aria-label="Website" autocapitalize="none" text-align="end" flex=1 min-width=0 testId="login-website"
          footer
            text "A login needs a website or a title."
        section
          row
            text "Username"
            input appearance="none" class=Field value=user input=editUsername placeholder="Username" aria-label="Username" autocapitalize="none" autocomplete="username" text-align="end" flex=1 min-width=0 testId="login-username"
          row
            text "Password"
            input appearance="none" class=Field type="password" value=pass input=editPassword placeholder=(item.hasPassword ? "New password (blank keeps it)" : "Password") aria-label="Password" autocomplete="new-password" text-align="end" flex=1 min-width=0 testId="login-password"
        section
          if item.hasPassword
            row
              text "Saved password"
              if revealedFor == item.id and revealedText != ""
                text revealedText user-select="text" testId="revealed-password"
              else
                text "••••••••" color="-exact-secondary-label" testId="hidden-password"
            row
              if revealedFor == item.id and revealedText != ""
                button press=hide buttonStyle="bordered" testId="hide-password"
                  text "Hide"
              else
                button press=reveal(item.id) buttonStyle="bordered" testId="reveal-password"
                  text "Reveal"
        section
          row
            text "Notes"
            input appearance="none" class=Field value=note input=editHints placeholder="Notes" aria-label="Notes" text-align="end" flex=1 min-width=0 testId="login-notes"
        if error != ""
          section
            text error color="-exact-system-red" testId="login-error"
        if item.id != ""
          section
            button commandfor="drop-login" command="show-modal" testId="login-delete"
              text "Delete Login"
      dialog id="drop-login" role="alertdialog" aria-label="Delete this login?"
        text "It is removed from the Vault. This can’t be undone."
        button press=drop(item.id) destructive=true commandfor="drop-login" command="close" testId="drop-login-ok"
          text "Delete"
        button commandfor="drop-login" command="close" testId="drop-login-cancel"
          text "Cancel"

// A project's sheet. Its kind is chosen when it is made and fixed after.
component ProjectSheet
  props
    route: number
    item: Project
    error: string
    save: action
    drop: action
    cancel: action
  state kind = item.kind
  state ttl = item.title
  state status = item.status
  state area = item.area
  state body = item.body
  action pickKind(v: string)
    kind = v
  action editTitle(v: string)
    ttl = v
  action editStatus(v: string)
    status = v
  action editArea(v: string)
    area = v
  action editBody(v: string)
    body = v
  view
    column class=Screen navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
      header class=PageHeader justify-content="space-between"
        button press=cancel aria-label="Cancel" testId="project-cancel"
          Glyph(name="close", size=20)
        text (item.id == "" ? "New Project" : item.title) role="heading" aria-level=1
        button press=save(item.id, kind, ttl, status, area, body) disabled=(ttl.trim() == "") buttonStyle="filled" aria-label="Save" testId="project-save"
          text "Save"
      list class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            text "Title"
            input appearance="none" class=Field value=ttl input=editTitle placeholder="Title" aria-label="Title" text-align="end" flex=1 min-width=0 testId="project-title"
          row
            text "Kind"
            if item.id == ""
              select value=kind change=pickKind aria-label="Kind" testId="project-kind"
                option "Project" value="project"
                option "Task" value="task"
                option "Machine" value="machine"
                option "Service" value="service"
                option "Repo" value="repo"
                option "Note" value="note"
                option "Link" value="link"
            else
              text kind color="-exact-secondary-label"
        section
          row
            text "Status"
            input appearance="none" class=Field value=status input=editStatus placeholder="Status" aria-label="Status" text-align="end" flex=1 min-width=0 testId="project-status"
          row
            text "Area"
            input appearance="none" class=Field value=area input=editArea placeholder="Area" aria-label="Area" text-align="end" flex=1 min-width=0 testId="project-area"
        section
          row
            textarea value=body input=editBody rows=6 placeholder="Notes" aria-label="Notes" flex=1 min-width=0 testId="project-body"
        if error != ""
          section
            text error color="-exact-system-red" testId="project-error"
        if item.id != ""
          section
            button commandfor="drop-project" command="show-modal" testId="project-delete"
              text "Delete"
      dialog id="drop-project" role="alertdialog" aria-label="Delete this item?"
        text "It is removed from the board. This can’t be undone."
        button press=drop(item.id) destructive=true commandfor="drop-project" command="close" testId="drop-project-ok"
          text "Delete"
        button commandfor="drop-project" command="close" testId="drop-project-cancel"
          text "Cancel"
