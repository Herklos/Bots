// hbots: the messaging app, written once in Contract. The Rust gateway
// (`hbots`, in ../gateway) keeps the Bots, the Vault and the Projects board and talks to a
// harness. T3 Code is the harness wired today; other backends may be added.
// This app is the same screen on the web, macOS, iOS and Linux.
use EmptyState from "exact:content"
use Face from "./face.contract"
use Avatar from "./face.contract"
use shapeNames from "./face.contract"
use Glyph from "./glyph.contract"
use getUserMedia, stopTrack, MediaStream, MediaStreamTrack from "@exact/media-capture"
use startMediaRecorder, stopMediaRecorder, isTypeSupported, MediaRecorderInfo, RecordedMedia, TypeSupport from "@exact/recording"

// Shared screen rhythm. Colours are generated from design/tokens.json.
style Screen
  background-color="surface.canvas"
  color="-exact-label"

style PageTitle
  font="-exact-headline"
  font-weight=600
  letter-spacing="-0.2px"

style HeroTitle
  font="-exact-large-title"
  font-weight=700
  letter-spacing="-0.8px"

style PageHeader
  display="flex"
  align-items="center"
  gap="space.sm"
  padding="space.md space.xl"
  min-height=72
  box-sizing="border-box"
  background-color="surface.canvas"
  border-bottom="1px solid surface.line"

// The sidebar's top bar: search and New Bot as two quiet circles.
style SidebarBar
  display="flex"
  align-items="center"
  gap="space.xs"
  padding="space.sm space.md space.xs space.lg"
  min-height=56
  box-sizing="border-box"
  background-color="surface.sidebar"

// A 36 point disc inside a 44 point control, like the circles in the sidebar bar.
style Disc
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  box-sizing="border-box"
  border-radius="radius.full"
  border="1px solid surface.line"
  background-color="surface.card"

// A pinned Bot: its Face over its name, on a raised tile when it is open.
style TileLink
  display="flex"
  justify-content="center"
  box-sizing="border-box"
  padding="space.sm space.xs"
  border-radius="radius.lg"
  color="-exact-label"
  text-decoration="none"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A file on a message: a type tile, its name and size, and a download glyph.
style FileCard
  display="flex"
  min-width=240
  padding="space.sm space.md"
  border-radius="radius.lg"
  background-color="surface.card"
  border="1px solid surface.line"
  color="-exact-label"
  text-decoration="none"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// An answer button on a request card.
style ChoiceButton
  min-height=32
  padding="2px space.md"
  border="1px solid surface.line"
  border-radius="radius.full"
  font="-exact-subheadline"
  font-weight=500
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style QuietButton
  min-width=44
  min-height=44

style TextControl
  box-sizing="border-box"
  min-height=44
  padding="space.sm space.md"
  border="none"
  border-radius="radius.sm"
  color="ink.muted"
  background-color="transparent"
  font="-exact-subheadline"
  font-weight=500
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style IconControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=44
  height=44
  padding=0
  border="none"
  border-radius="radius.md"
  color="ink.muted"
  background-color="transparent"
  :disabled
    opacity=0.4
    color="ink.muted"
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// The composer's send: a Tide circle with Night ink, the brand's filled look.
// The chat header's Bot name: one button that toggles the right panel.
style HeaderToggle
  display="flex"
  align-items="center"
  min-height=44
  padding="0 space.xs"
  border="none"
  border-radius="radius.md"
  background-color="transparent"
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style SendControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="brand.default"
  color="ink.dark"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"
  :disabled
    background-color="surface.line"
    color="ink.muted"

style StopControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="surface.raised"
  color="-exact-label"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style ToggleControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=44
  height=32
  padding=0
  border="none"
  border-radius="radius.sm"
  background-color="transparent"
  :checked
    background-color="transparent"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"
  :disabled
    opacity=0.4

style SwatchControl
  width=44
  height=44
  box-sizing="border-box"
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="transparent"
  :checked
    background-color="transparent"
  :hover
    background-color="surface.soft"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style ConversationLink
  color="-exact-label"
  text-decoration="none"
  padding="space.md"
  border-radius="radius.md"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A search field: a pill with a magnifier beside it.
style SearchField
  box-sizing="border-box"
  min-height=36
  padding="space.xs space.md"
  border="1px solid surface.line"
  border-radius="radius.full"
  background-color="surface.card"
  color="-exact-label"

// A section label above a grouped card, like the panel labels in Threebot.
style SectionLabel
  font="-exact-footnote"
  font-weight=600
  color="ink.muted"
  padding="space.md space.md space.xs"

style GroupCard
  background-color="surface.card"
  border="1px solid surface.line"
  border-radius="radius.md"
  padding="space.xs space.md"
  box-sizing="border-box"

// A small status chip: a dot and a word.
style Chip
  display="flex"
  align-items="center"
  gap="space.xs"
  padding="4px space.sm"
  border-radius="radius.full"
  background-color="surface.soft"
  font="-exact-footnote"
  font-weight=500

// A rounded tile behind a row's glyph.
style IconTile
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  border-radius="radius.sm"
  background-color="surface.soft"

// Segmented choices (the theme picker): one pill, filled when chosen. The
// chosen fill is a node attribute, so the class keeps only literal states.
style Segment
  border="none"
  min-height=30
  padding="2px space.md"
  font="-exact-footnote"
  border-radius="radius.full"
  background-color="transparent"
  color="-exact-label"
  font-weight=500
  :hover
    background-color="surface.soft"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// Chat bubbles. Mine is the brand fill (Tide with Night ink, 8.2:1); the
// Bot's is a card. Fill, ink and the tail corner are node attributes.
style Bubble
  padding="space.sm space.lg"
  line-height=1.55
  white-space="pre-wrap"
  overflow-wrap="break-word"

style FileChip
  padding="space.xs space.sm"
  border-radius="radius.full"
  font="-exact-footnote"
  overflow-wrap="anywhere"

style BotRow
  padding="space.md space.xs"
  gap="space.md"
  align-items="center"
  min-height=52

style Field
  box-sizing="border-box"
  min-height=44
  border="none"
  background-color="transparent"
  padding="space.xs 0"
  color="-exact-label"

style FormList
  background-color="surface.canvas"
  width="100%"
  max-width="44rem"
  align-self="center"
  box-sizing="border-box"

style PrimaryButton
  min-height=44

routes nav
  inbox "/"
    chat "/bot/:slug"
    group "/group/:id"
    create "/new"
    newGroup "/new-group"
    settings "/settings"
      vault "/vault"
        vaultAdd "/vault/new"
        vaultEdit "/vault/:id"

shape Reply
  ok: bool
  error: string

shape Session
  authenticated: bool
  passwordRequired: bool

shape Bot
  slug: string
  name: string
  label: string
  line: string
  time: string
  initials: string
  color: string
  shape: string
  main: bool
  pinned: bool
  hidden: bool
  ready: bool
  working: bool
  unread: bool

// A file on a message: an image shows in place, audio plays, any other file is a card.
shape FileRef
  id: string
  name: string
  kind: string
  size: string
  url: string

// One answer a request offers. `key` is the question it answers; `warn` is a caution to show.
shape Choice
  label: string
  value: string
  key: string
  warn: string

// One row of the transcript: a day mark, a message, a line between messages, a request the
// Bot is waiting on, or the working line. `head` and `tail` mark a run of one sender's messages
// for the bubble corners. `variant` is the kind of an event or a request.
shape Row
  id: string
  kind: string
  mine: bool
  text: string
  title: string
  time: string
  head: bool
  tail: bool
  variant: string
  files: FileRef[]
  botSlug: string
  botName: string
  botColor: string
  botShape: string
  choices: Choice[]
  placeholder: string
  key: string
  react: string
  quote: string
  tokens: string

shape Suggestion
  name: string
  about: string
  color: string
  shape: string
  first: string

shape About
  ok: bool
  version: string
  harness: string
  connected: bool

shape Pin
  id: string
  text: string
  missing: bool

shape Chat
  slug: string
  rows: Row[]
  working: bool
  partial: bool
  readOnly: bool
  pins: Pin[]
  threadId: string

shape RoomMember
  slug: string
  name: string
  line: string
  state: string
  ready: bool
  working: bool

shape RoomMessage
  id: string
  name: string
  text: string
  from: string

shape Room
  id: string
  title: string
  description: string
  color: string
  shape: string
  members: RoomMember[]
  messages: RoomMessage[]

// One row of the sidebar list: a Bot or a group, newest conversation first.
shape Convo
  kind: string
  key: string
  id: string
  name: string
  color: string
  shape: string
  line: string
  time: string
  at: string
  unread: bool
  working: bool
  ready: bool

shape Made
  ok: bool
  id: string
  error: string

shape Prefs
  userName: string
  theme: string
  defaultInstance: string
  defaultModel: string

// Result of uploading one chat attachment to the gateway.
shape Attached
  ok: bool
  id: string
  name: string
  error: string

// A clip stored once, ready to hear and then send on the voice route.
shape VoiceHeld
  ok: bool
  id: string
  name: string
  url: string
  seconds: number
  error: string

// A Vault login, as the list may see it: the password is never in this shape.
shape Login
  id: string
  title: string
  website: string
  username: string
  hasPassword: bool
  hints: string
  icon: string

// The one password the person asked to see, for the login it names.
shape Revealed
  ok: bool
  id: string
  password: string
  error: string

// Counts on this machine. `ok` is false until a read succeeds, so an empty
// fallback is not "nothing counted yet".
shape Usage
  ok: bool
  error: string
  messages: number
  attachments: number
  vaultWrites: number
  iconFetches: number

// One effort level a model offers, and one model a provider lists.
shape Effort
  id: string
  label: string

shape ModelOption
  slug: string
  name: string
  recommended: bool
  effort: string
  efforts: Effort[]

shape Provider
  instanceId: string
  name: string
  account: string
  models: ModelOption[]

// A Bot's model choice, and every provider T3 Code has ready. `efforts` are the current model's levels.
shape ModelList
  ok: bool
  error: string
  current: string
  instanceId: string
  effort: string
  currentName: string
  providerName: string
  effortLabel: string
  efforts: Effort[]
  providers: Provider[]

// A routine, to read: the panel does not edit them.
shape Routine
  id: string
  title: string
  paused: bool
  schedule: string
  next: string
  failed: bool

shape RoutineList
  ok: bool
  tasks: Routine[]
  error: string

shape LineRow
  id: string
  title: string
  status: string
  remote: bool
  threadId: string

shape Lineage
  ok: bool
  rows: LineRow[]
  error: string

// One day of a usage report: the chart bar (`px`), the sparkline bar (`spx`), and the figures as words.
shape DayRow
  day: string
  label: string
  short: string
  tokens: string
  input: string
  output: string
  cached: string
  cacheWrite: string
  turns: string
  messages: string
  px: number
  spx: number

shape ModelRow
  name: string
  tokens: string
  turns: string
  share: number

shape BotShare
  slug: string
  name: string
  color: string
  shape: string
  tokens: string
  turns: string
  messages: string
  share: number

shape UsageReport
  ok: bool
  error: string
  period: string
  periodLabel: string
  messages: string
  attachments: string
  turns: string
  tokens: string
  input: string
  output: string
  cached: string
  cacheWrite: string
  hit: string
  sentence: string
  days: DayRow[]
  rows: DayRow[]
  models: ModelRow[]
  bots: BotShare[]
  empty: bool
  first: string
  last: string

// What a Bot has kept: pictures, files and links, to look at.
shape ShelfItem
  id: string
  title: string
  detail: string
  url: string

shape Shelf
  ok: bool
  total: number
  pictures: ShelfItem[]
  files: ShelfItem[]
  links: ShelfItem[]

shape PageTab
  id: string
  title: string
  url: string

shape Computer
  ok: bool
  tabs: PageTab[]
  image: string
  error: string

fn nameOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.name, case none => "" }
fn labelOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.ready ? (b.label != "" ? b.label : "Ready to chat") : "Getting set up…", case none => "" }
fn initialsOf(name: string): string = name.trim().split(" ").filter(w => w != "").slice(0, 2).map(w => w.slice(0, 1).toUpperCase()).join("")
fn botCountLabel(n: number): string = n == 1 ? "1 Bot" : `${n} Bots`
// Colours come from design/tokens.json: change them there.
// design:begin colours
fn pickerColours(): string[] = ["brand.brown", "brand.red", "brand.orange", "brand.amber", "brand.green", "brand.default", "brand.blue", "brand.violet", "brand.pink", "brand.gray"]
fn avatarInk(c: string): string = c == "brand.black" || c == "brand.brown" || c == "brand.gray" ? "ink.light" : "ink.dark"
// design:end colours
fn shapeOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.shape, case none => "ball" }
fn colorOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.color, case none => "brand.default" }
fn nText(n: number, one: string, many: string): string = n == 1 ? `1 ${one}` : `${n} ${many}`
fn usageLine(m: number, a: number, v: number, i: number): string = `${nText(m, "message", "messages")}, ${nText(a, "attachment", "attachments")}, ${nText(v, "vault write", "vault writes")}, and ${nText(i, "icon fetch", "icon fetches")} on this machine.`
fn attachmentName(entry: string): string = match entry.split("\\t").at(-1) { case some(name) => name, case none => "Attachment" }
fn themeLabel(t: string): string = t == "system" ? "System" : t == "dark" ? "Dark" : "Light"
// Face colours are plain names; Bot colours are brand.* tokens from the design package.
fn faceColor(c: string): string = c == "brand.default" ? "teal" : c == "brand.blue" ? "blue" : c == "brand.violet" ? "violet" : c == "brand.pink" ? "pink" : c == "brand.orange" ? "orange" : c == "brand.green" ? "green" : c == "brand.black" ? "black" : c == "brand.white" ? "white" : c == "brand.brown" ? "brown" : c == "brand.red" ? "red" : c == "brand.amber" ? "amber" : c == "brand.yellow" ? "yellow" : c == "brand.cyan" ? "cyan" : c == "brand.purple" ? "purple" : c == "brand.magenta" ? "magenta" : c == "brand.gray" ? "gray" : "teal"
// The open chat is clear. A hidden Bot keeps the mark until that chat is the open one.
fn showUnread(unread: bool, open: bool, hidden: bool): bool = unread and not open and (hidden or not hidden)

component Bots
  state password = ""
  state drafts: string[] = []
  state lastText = ""
  state failedText = ""
  state answerText = ""
  state newName = ""
  state newColor = "brand.default"
  state newShape = "ball"
  state newFirst = ""
  state groupName = ""
  state groupAbout = ""
  state groupColor = "brand.default"
  state groupShape = "ball"
  state groupMembers: string[] = []
  state roomText = ""
  state plusOpen = false
  state groupPanel = false
  state groupPage = "root"
  state nameDraft = ""
  state nameEditing = false
  state newPassword = ""
  state botQuery = ""
  state searching = false
  state away = false
  state chatSearching = false
  state hiddenOpen = false
  state vaultQuery = ""
  state messageQuery = ""
  state marksOn = true
  state voiceHold = ""
  state voiceRecorder = ""
  state voiceTrack = ""
  state voiceId = ""
  state voicePreview = ""
  state voiceSeconds = 0
  state voiceError = ""
  state reactFor = ""
  state childThread = ""
  // Wide windows show the Bot's panel beside the chat, like Threebot's desktop.
  state wide = false
  // The right panel (the Bot's settings) opens and closes from the chat header's
  // Bot name. It opens by default when the window turns wide.
  state panelOpen = false
  state panelTab = "details"
  state panelPage = "root"
  state usagePeriod = "7d"
  state usageView = "summary"
  state toast = ""
  // Each entry is `id\\tname` for a file waiting to go out with the next send.
  state pendingAttaches: string[] = []
  // The page the person is driving. Cleared after Release, including when they leave.
  state wantHold = false
  state heldTab = ""
  resource session = loadSession() as shape Session else empty()
  resource bots = loadBots(slug) as shape Bot[] else empty()
  resource convos = loadConvos(botQuery.trim().toLowerCase(), slug, roomId) as shape Convo[] else empty()
  resource chat = loadChat(slug, childThread) as shape Chat else empty()
  resource room = loadRoom(roomId) as shape Room else empty()
  resource suggestions = loadSuggestions() as shape Suggestion[] else empty()
  resource providers = loadProviders() as shape Provider[] else empty()
  resource about = loadAbout() as shape About else empty()
  resource prefs = loadPrefs() as shape Prefs else empty()
  resource vault = loadVault() as shape Login[] else empty()
  resource usage = loadUsage(usageGate) as shape Usage else empty()
  resource report = loadUsageReport(slug, usagePeriod, reportGate) as shape UsageReport else empty()
  resource models = loadModels(slug, detailGate) as shape ModelList else empty()
  resource routines = loadRoutines(slug, detailGate) as shape RoutineList else empty()
  resource lineage = loadLineage(slug, detailGate) as shape Lineage else empty()
  resource shelf = loadShelf(slug, libraryGate) as shape Shelf else empty()
  resource computer = loadComputer(slug, computerGate) as shape Computer else empty()
  resource clipType = isTypeSupported(type="audio/mp4") as shape TypeSupport else empty()
  mutation signedIn as shape Reply refreshes session, bots
  mutation signedOut as shape Reply refreshes session, bots
  mutation created as shape Reply refreshes bots then afterCreate
  mutation groupMade as shape Made refreshes convos then afterGroupMade
  mutation roomSent as shape Reply refreshes room, convos
  mutation groupGone as shape Reply refreshes convos
  mutation groupSaved as shape Reply refreshes room, convos
  mutation seen as shape Reply refreshes bots
  mutation reacted as shape Reply refreshes chat
  mutation sent as shape Reply refreshes chat then afterSend
  mutation answered as shape Reply refreshes chat then afterAnswer
  mutation stopped as shape Reply refreshes chat
  mutation renamed as shape Reply refreshes bots
  mutation recoloured as shape Reply refreshes bots
  mutation reshaped as shape Reply refreshes bots
  mutation pinned as shape Reply refreshes bots
  mutation hidSaved as shape Reply refreshes bots
  mutation mainSaved as shape Reply refreshes bots
  mutation botRemoved as shape Reply refreshes bots then afterBotRemove
  mutation prefsSaved as shape Reply refreshes prefs
  mutation passwordSet as shape Reply refreshes session then afterPassword
  mutation loginSaved as shape Reply refreshes vault then afterLoginSave
  mutation loginRemoved as shape Reply refreshes vault then afterLoginRemove
  mutation revealed as shape Revealed
  mutation attached as shape Attached then afterAttach
  mutation micOpened as shape MediaStream then armMic
  mutation recStarted as shape MediaRecorderInfo then recBegun
  mutation clipSaved as shape RecordedMedia then stageClip
  mutation trackEnded as shape MediaStreamTrack
  mutation voiced as shape VoiceHeld then showClip
  mutation voiceSent as shape Reply refreshes chat then afterVoice
  mutation voiceDropped as shape Reply
  mutation modelSaved as shape Reply refreshes models then afterModel
  mutation defaultSaved as shape Reply refreshes prefs, models
  mutation controlled as shape Reply refreshes computer then afterControl
  derive slug = match stack(nav).filter(e => e.name == "chat").at(-1) { case some(e) => e.params.slug, case none => "" }
  derive signInError = match signedIn { case some(r) => r.error, case none => "" }
  derive createError = match created { case some(r) => r.error, case none => "" }
  derive sendError = match sent { case some(r) => r.error, case none => "" }
  derive lastId = match chat.rows.at(-1) { case some(m) => m.id, case none => "" }
  derive locked = session.passwordRequired and not session.authenticated
  derive query = botQuery.trim().toLowerCase()
  derive groupSaveError = match groupSaved { case some(r) => r.error, case none => "" }
  derive groupError = match groupMade { case some(r) => r.error, case none => "" }
  derive canMakeGroup = groupName.trim() != "" and groupMembers.length >= 2 and not pending(groupMade)
  derive roomError = match roomSent { case some(r) => r.error, case none => "" }
  derive roomId = match stack(nav).filter(e => e.name == "group").at(-1) { case some(e) => e.params.id, case none => "" }
  derive qtext = messageQuery.trim().toLowerCase()
  derive shownRows = chat.rows.filter(m => m.kind != "message" or qtext == "" or m.text.toLowerCase().includes(qtext))
  derive searchNote = qtext != "" and chat.partial ? "Search covers the loaded conversation." : ""
  derive visibleBots = bots.filter(b => not b.hidden and (query == "" or b.name.toLowerCase().includes(query) or b.label.toLowerCase().includes(query)))
  derive tiles = visibleBots.filter(b => query == "" and (b.main or b.pinned))
  derive openUnread = bots.filter(b => b.slug == slug and b.unread).length > 0
  derive hiddenBots = bots.filter(b => b.hidden and (query == "" or b.name.toLowerCase().includes(query) or b.label.toLowerCase().includes(query)))
  derive vquery = vaultQuery.trim().toLowerCase()
  derive shownVault = vault.filter(v => vquery == "" or v.title.toLowerCase().includes(vquery) or v.username.toLowerCase().includes(vquery) or v.website.toLowerCase().includes(vquery))
  derive renameError = match renamed { case some(r) => r.error, case none => "" }
  derive colourError = match recoloured { case some(r) => r.error, case none => "" }
  derive hideError = match hidSaved { case some(r) => r.error, case none => "" }
  derive mainError = match mainSaved { case some(r) => r.error, case none => "" }
  derive reshapeError = match reshaped { case some(r) => r.error, case none => "" }
  derive pinError = match pinned { case some(r) => r.error, case none => "" }
  derive botError = renameError != "" ? renameError : colourError != "" ? colourError : reshapeError != "" ? reshapeError : pinError != "" ? pinError : hideError != "" ? hideError : mainError
  derive botRemoveError = match botRemoved { case some(r) => r.error, case none => "" }
  derive prefsError = match prefsSaved { case some(r) => r.error, case none => "" }
  derive passwordError = match passwordSet { case some(r) => r.error, case none => "" }
  derive loginError = match loginSaved { case some(r) => r.error, case none => "" }
  derive loginRemoveError = match loginRemoved { case some(r) => r.error, case none => "" }
  derive revealedFor = match revealed { case some(r) => r.id, case none => "" }
  derive revealedText = match revealed { case some(r) => (r.ok ? r.password : ""), case none => "" }
  derive attachError = match attached { case some(r) => r.error, case none => "" }
  derive draft = match first(drafts.filter(d => d.startsWith(`${slug}\t`))) { case some(d) => d.slice(slug.length + 1), case none => "" }
  derive answerError = match answered { case some(r) => r.error, case none => "" }
  derive canSend = draft.trim() != "" or pendingAttaches.length > 0
  derive onBot = top(nav).name == "chat"
  derive onLibrary = top(nav).name == "chat" and panelOpen and panelTab == "library"
  derive onComputer = top(nav).name == "chat" and panelOpen and panelTab == "computer"
  derive detailGate = (onBot and slug != "") ? "1" : "0"
  derive reportGate = ((onBot and slug != "") or top(nav).name == "settings") ? "1" : "0"
  derive pickedModel = providers.filter(p => p.instanceId == prefs.defaultInstance).length > 0
  derive libraryGate = (onLibrary and slug != "") ? "1" : "0"
  derive computerGate = (onComputer and slug != "") ? "1" : "0"
  derive usageGate = top(nav).name == "settings" ? "1" : "0"
  derive modelError = match modelSaved { case some(r) => r.error, case none => "" }
  derive controlError = match controlled { case some(r) => r.error, case none => "" }
  derive holding = wantHold and controlError == "" and not pending(controlled)

  // Chats are read while they are open; the inbox while it is.
  task poll mount
    every(1500, pull)

  task fadeToast when toast != ""
    after(3000, clearToast)

  task fit mount
    every(200, fitView)

  // The saved theme is applied once it has loaded; picking one applies it at once.
  task scheme when prefs.theme != ""
    after(1, applyScheme)

  task letGo when holding and not onComputer
    after(1, releaseHeld)

  // A take stops itself at two minutes. Stopping earlier cancels this wait.
  task capClip when voiceRecorder != ""
    after(120000, holdVoice)

  action fitView
    let box = frame("app-shell")
    // A missing measurement is not a resize. Keep the last stable layout.
    if not box.unavailable and box.width > 0
      let w = box.width >= 1200
      if w != wide
        wide = w
        panelOpen = w
  action togglePanel
    let next = not panelOpen
    panelOpen = next
    if next and panelTab == "details"
      refresh models
      refresh routines
      refresh lineage
      refresh report
  action retryDetails
    refresh models
    refresh routines
    refresh lineage
    refresh report
  action retryUsage
    refresh usage
  action pickPanelTab(tab: string)
    panelTab = tab
  action openPage(page: string)
    panelPage = page
  action pickPeriod(p: string)
    usagePeriod = p
  action pickView(v: string)
    usageView = v
  action clearToast
    toast = ""
  action openHidden(bslug: string)
    panelTab = "details"
    panelPage = "root"
    panelOpen = true
    nav = go(nav, path("chat", bslug))

  action pull
    refresh bots
    refresh convos
    refresh chat
    if top(nav).name == "chat" and openUnread and not pending(seen)
      send seen = markSeen(slug)
    if top(nav).name == "group"
      refresh room
    if top(nav).name == "settings"
      refresh usage
      refresh report
    if onLibrary
      refresh shelf
    if onComputer
      refresh computer
    if onBot and panelOpen and panelTab == "details"
      refresh models
      refresh routines
      refresh lineage
      refresh report
  action editPassword(v: string)
    password = v
  action login
    if password != "" and not pending(signedIn)
      send signedIn = signIn(password)
      password = ""
  action logout
    send signedOut = signOut()
  // A wide window shows the list beside the open chat. Opening another Bot
  // replaces that chat, so the conversation swaps instead of stacking.
  action open(url: string)
    childThread = ""
    panelPage = "root"
    nav = top(nav).name == "chat" and url.startsWith("/bot/") ? replace(nav, url) : go(nav, url)
  action back
    childThread = ""
    nav = back(nav)
  action editChatQuery(v: string)
    messageQuery = v
  action toggleShownMark
    let next = not marksOn
    marksOn = next
  action toggleChatSearch
    let next = not chatSearching
    chatSearching = next
    messageQuery = ""
    if next
      focus("chat-search")
  // The contract runner has no microphone: the fixture hold is the file name, at once.
  // Anywhere else, the first press records and the next press stops.
  action holdVoice
    voiceError = ""
    if slug == "fixture" or slug == ""
      voiceHold = "voice.m4a"
    else if voiceRecorder != ""
      send clipSaved = stopMediaRecorder(recorder=voiceRecorder)
    else if not pending(micOpened)
      send micOpened = getUserMedia(audio=true)
  action armMic
    match micOpened
      case some(s)
        let stream = s.id
        let track = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
        voiceTrack = track
        let path = clipType.supported ? "app:/tmp/voice.m4a" : "app:/tmp/voice.webm"
        let mime = clipType.supported ? "audio/mp4" : "audio/webm"
        send recStarted = startMediaRecorder(stream=stream, mimeType=mime, path=path)
      case none
        voiceError = "The microphone is off."
  action recBegun
    match recStarted
      case some(r)
        voiceRecorder = r.id
        voiceHold = "Recording"
      case none
        voiceRecorder = ""
        voiceError = "The microphone is off."
  action stageClip
    match clipSaved
      case some(media)
        let track = voiceTrack
        let secs = media.duration / 1000
        voiceRecorder = ""
        voiceTrack = ""
        voiceSeconds = secs
        if track != ""
          send trackEnded = stopTrack(track=track)
        if media.size > 8388608
          voiceHold = ""
          voiceError = "That clip is too long."
        else if secs <= 0 or media.size == 0
          voiceHold = ""
          voiceError = "That clip is empty."
        else
          send voiced = stageVoice(slug, media.path, media.mimeType, secs)
      case none
        voiceRecorder = ""
        voiceError = "That clip could not be read."
  action showClip
    match voiced
      case some(r)
        if r.ok and r.id != ""
          voiceHold = r.name
          voiceId = r.id
          voicePreview = r.url
          voiceSeconds = r.seconds
          voiceError = ""
        else
          voiceHold = ""
          voiceId = ""
          voicePreview = ""
          voiceError = r.error != "" ? r.error : "That clip could not be read."
      case none
  action sendHeldVoice
    if voiceId != "" and not pending(voiceSent)
      send voiceSent = sendVoice(slug, voiceSeconds, voiceId, childThread)
  action afterVoice
    match voiceSent
      case some(r)
        if r.ok
          voiceHold = ""
          voiceId = ""
          voicePreview = ""
          voiceSeconds = 0
          voiceError = ""
        else
          voiceError = r.error
      case none
  action discardVoice
    if voiceId != ""
      let id = voiceId
      voiceHold = ""
      voiceId = ""
      voicePreview = ""
      voiceSeconds = 0
      voiceError = ""
      send voiceDropped = dropVoice(slug, id)
  action openChild(threadId: string)
    childThread = threadId
  action openNew
    plusOpen = false
    newName = ""
    newColor = "brand.default"
    newShape = "ball"
    newFirst = ""
    nav = push(nav, "/new")
  action editBotQuery(v: string)
    botQuery = v
  action openSearch
    searching = true
    focus("bot-search")
  action closeSearch
    searching = false
    botQuery = ""
  action toggleHidden
    hiddenOpen = not hiddenOpen
  action editVaultQuery(v: string)
    vaultQuery = v
  action editName(v: string)
    newName = v
  action pick(c: string)
    newColor = c
  action pickShape(s: string)
    newShape = s
  action useStart(name: string, color: string, shape: string, first: string)
    newName = name
    newColor = color
    newShape = shape
    newFirst = first
  action create
    if newName.trim() != "" and not pending(created)
      send created = createBot(newName.trim(), newColor, newShape, newFirst)
  action afterCreate
    if createError == "" and top(nav).name == "create"
      nav = back(nav)
  action openNewGroup
    plusOpen = false
    groupName = ""
    groupAbout = ""
    groupColor = "brand.default"
    groupShape = "ball"
    groupMembers = []
    nav = push(nav, "/new-group")
  action editGroupName(v: string)
    groupName = v
  action editGroupAbout(v: string)
    groupAbout = v
  action pickGroupColour(c: string)
    groupColor = c
  action pickGroupShape(s: string)
    groupShape = s
  action toggleGroupMember(m: string)
    groupMembers = groupMembers.includes(m) ? groupMembers.filter(x => x != m) : groupMembers.concat([m])
  action makeGroup
    if canMakeGroup
      send groupMade = createGroup(groupName.trim(), groupAbout.trim(), groupColor, groupShape, groupMembers.join("\n"))
  action afterGroupMade
    match groupMade
      case some(r)
        if r.ok and r.id != "" and top(nav).name == "newGroup"
          nav = push(back(nav), path("group", r.id))
      case none
  action togglePlus
    plusOpen = not plusOpen
  action toggleGroupPanel
    groupPanel = not groupPanel
    groupPage = "root"
  action openGroupEdit
    groupPage = "edit"
  action groupBack
    groupPage = "root"
  action patchGroup(field: string, value: string)
    if roomId != ""
      send groupSaved = updateGroup(roomId, field, value)
  action toggleGroupMemberOf(m: string)
    let current = room.members.map(x => x.slug)
    let next = current.includes(m) ? current.filter(x => x != m) : current.concat([m])
    send groupSaved = updateGroup(roomId, "members", next.join("\n"))
  action dropGroup
    if roomId != ""
      send groupGone = deleteGroup(roomId)
      groupPanel = false
      groupPage = "root"
      nav = back(nav)
  action editRoomText(v: string)
    roomText = v
  action mention(m: string)
    roomText = `${roomText}${(roomText == "" or roomText.endsWith(" ")) ? "" : " "}@${m} `
    focus("room-composer")
  action postRoom
    if roomText.trim() != "" and not pending(roomSent) and roomId != ""
      send roomSent = sendRoom(roomId, roomText.trim())
      roomText = ""
    focus("room-composer")
  action roomKey(k: string, event: KeyboardEvent)
    if k == "Enter" and not event.shiftKey and not event.isComposing
      preventDefault()
      if not event.repeat
        postRoom()
  action edit(v: string)
    drafts = drafts.filter(d => not d.startsWith(`${slug}\t`)).concat([`${slug}\t${v}`])
  action pickFiles
    showPicker("chat-attach")
  action filesPicked(files: Picked[])
    if slug != "" and not pending(attached) and files.length > 0
      match files.at(0)
        case some(f)
          send attached = uploadAttachment(slug, f.path, f.name, f.type)
        case none
  action afterAttach
    match attached
      case some(r)
        if r.ok and r.id != ""
          pendingAttaches = pendingAttaches.concat([`${r.id}\\t${r.name}`])
      case none
  action dropPending(entry: string)
    pendingAttaches = pendingAttaches.filter(e => e != entry)
  action post
    if canSend and not pending(sent)
      // pendingAttaches entries are `id\\tname`; the data module keeps the ids.
      lastText = draft.trim()
      failedText = ""
      send sent = sendMessage(slug, draft.trim(), pendingAttaches.join("\n"), childThread)
      edit("")
    focus("composer")
  action composerKey(k: string, event: KeyboardEvent)
    if k == "Enter" and not event.shiftKey and not event.isComposing
      preventDefault()
      if not event.repeat
        post()
  action afterSend
    if sendError == ""
      pendingAttaches = []
      lastText = ""
    else
      failedText = lastText
    toEnd()
  action retry
    if failedText != "" and not pending(sent)
      let again = failedText
      lastText = again
      failedText = ""
      send sent = sendMessage(slug, again, "", childThread)
  action doReact(item: string, emoji: string)
    reactFor = ""
    send reacted = reactTo(slug, item, emoji)
  action openReact(item: string)
    reactFor = (reactFor == item ? "" : item)
  action filesDropped(e: DragEvent)
    if slug != "" and not pending(attached) and e.files.length > 0
      match e.files.at(0)
        case some(f)
          send attached = uploadAttachment(slug, f, "", "")
        case none
  action editAnswer(v: string)
    answerText = v
  action answer(rid: string, kind: string, key: string, value: string)
    if not pending(answered)
      send answered = respondRequest(slug, rid, kind, key, value, childThread)
  action afterAnswer
    answerText = ""
  action stop
    send stopped = stopRun(slug, childThread)
  action toEnd
    away = false
    scrollIntoView("transcript", lastId, block="end")
  action moved(x: number, y: number, e: ScrollEvent)
    away = e.scrollHeight - e.scrollTop - e.clientHeight > 80
  action pasted(e: ClipboardEvent)
    if slug != "" and not pending(attached) and pendingAttaches.length < 8 and e.files.length > 0
      preventDefault()
      match e.files.at(0)
        case some(f)
          send attached = uploadAttachment(slug, f, "", "")
        case none
  // Bot details: a Bot's name, colour, visibility and main status, and its deletion.
  action doRename(bslug: string, name: string)
    if name.trim() != ""
      send renamed = renameBot(bslug, name.trim())
  action doRecolour(bslug: string, color: string)
    send recoloured = recolourBot(bslug, color)
  action doHide(bslug: string, on: bool)
    send hidSaved = hideBot(bslug, on)
  action doMain(bslug: string)
    send mainSaved = makeMainBot(bslug)
  action doDropBot(bslug: string)
    send botRemoved = deleteBot(bslug)
  action afterBotRemove
    if botRemoveError == ""
      nav = go(nav, "/")

  // Settings: name, theme, the Projects beta and the remote-access password.
  action doEditName(v: string)
    nameDraft = v
    nameEditing = true
  action doSaveName(v: string)
    nameEditing = false
    if v.trim() != "" and v.trim() != prefs.userName
      send prefsSaved = setUserName(v.trim())
  action applyScheme
    setScheme(prefs.theme)
  action doPickTheme(t: string)
    setScheme(t)
    send prefsSaved = setTheme(t)
  action editNewPassword(v: string)
    newPassword = v
  action doSavePassword
    if newPassword != "" and not pending(passwordSet)
      send passwordSet = setPassword(newPassword)
  action afterPassword
    if passwordError == ""
      newPassword = ""

  // Vault: a login is edited in a sheet. The password is kept unless a new one is typed.
  action doCommitLogin(id: string, title: string, website: string, username: string, password: string, hints: string)
    if (title.trim() != "" or website.trim() != "") and not pending(loginSaved)
      send loginSaved = saveLogin(id, title.trim(), website.trim(), username.trim(), password, hints.trim())
  action afterLoginSave
    if loginError == ""
      nav = back(nav)
  action doDropLogin(id: string)
    send loginRemoved = deleteLogin(id)
  action afterLoginRemove
    if loginRemoveError == ""
      nav = back(nav)
  action doReveal(id: string)
    if not pending(revealed)
      send revealed = revealPassword(id)
  action doHideReveal
    revealed = none
  action doCloseLogin
    revealed = none
    nav = back(nav)

  // Projects: a board of items by kind, edited in a sheet.
  action doPickModel(bslug: string, instanceId: string, model: string, effort: string)
    if not pending(modelSaved)
      send modelSaved = setModel(bslug, instanceId, model, effort)
  action afterModel
    if modelError == ""
      toast = "Saved. It applies to the next message."
  action doMakeDefault(instanceId: string, model: string, effort: string)
    if not pending(defaultSaved)
      send defaultSaved = setDefaultModel(instanceId, model, effort)
  action doReshape(bslug: string, shape: string)
    send reshaped = reshapeBot(bslug, shape)
  action doPin(bslug: string, on: bool)
    send pinned = pinBot(bslug, on)
  action doTake(tab: string)
    wantHold = true
    heldTab = tab
    send controlled = computerControl(slug, tab, "take")
  action doRelease
    wantHold = false
    if heldTab != ""
      send controlled = computerControl(slug, heldTab, "release")
  action releaseHeld
    wantHold = false
    if heldTab != ""
      send controlled = computerControl(slug, heldTab, "release")
  action afterControl
    if not wantHold
      heldTab = ""

  view
    main id="app-shell" class=Screen navigationKey=`${top(nav).id}` navigationBack="back" navigate=open interactive-widget="resizes-content" width="100%" height="100%" testId="app"
      if locked
        column flex=1 justify-content="center" align-items="center" padding="space.xl" testId="sign-in"
          column width="100%" max-width="22rem" gap="space.lg" box-sizing="border-box" padding="space.xl" border="1px solid surface.line" border-radius="radius.lg" background-color="surface.card"
            column align-items="center" gap="space.sm"
              Face(shape="ball", color="teal", state=(pending(signedIn) ? "working" : "idle"), size=96, still=false)
              text "hbots" role="heading" aria-level=1 class=HeroTitle
              text t("inbox.tagline") color="-exact-secondary-label"
            text "Enter the password you set in Settings → Remote access." color="-exact-secondary-label"
            input appearance="none" class=Field type="password" value=password input=editPassword submit=login placeholder="Password" aria-label="Password" testId="password" width="100%"
            if signInError != "" and not pending(signedIn)
              text signInError color="-exact-system-red" testId="sign-in-error"
            button press=login disabled=(password == "" or pending(signedIn)) buttonStyle="filled" testId="sign-in-button"
              text (pending(signedIn) ? t("auth.signingIn") : t("auth.signIn"))
      else
        for e in stack(nav) key=e.id
          if e.name == "inbox"
            column class=Screen background-color="surface.sidebar" navigationSplit="288" navigationKey=`${e.id}` navigationScroll="bots-list" position="absolute" inset=0
              header class=SidebarBar
                if searching
                  input type="search" class=SearchField value=botQuery input=editBotQuery placeholder="Search Bots" aria-label="Search Bots" testId="bot-search" flex=1 min-width=0
                  button class=TextControl appearance="none" press=closeSearch testId="search-cancel"
                    text t("common.cancel")
                else
                  column flex=1
                  button class=IconControl appearance="none" press=openSearch aria-label="Search Bots" title="Search Bots" testId="search-open"
                    column class=Disc
                      Glyph(name="search", size=18)
                  button class=IconControl appearance="none" press=togglePlus aria-label="New Bot or group" title="New Bot or group" aria-expanded=plusOpen testId="new-bot"
                    column class=Disc
                      Glyph(name="add", size=18)
              if plusOpen
                button appearance="none" press=togglePlus aria-label="Close menu" position="absolute" inset=0 z-index=9 background-color="transparent" border="none" testId="new-menu-backdrop"
                column position="absolute" top=52 right=8 z-index=10 width=208 box-sizing="border-box" padding="space.xs" gap="2px" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-menu"
                  button class=ConversationLink appearance="none" press=openNew testId="new-bot-option" padding="space.sm space.md"
                    row gap="space.md" align-items="center"
                      Face(shape="ball", color="teal", state="idle", size=28, still=true)
                      text "New Bot" font-weight=500
                  button class=ConversationLink appearance="none" press=openNewGroup disabled=(bots.length < 2) testId="new-group-option" padding="space.sm space.md"
                    row gap="space.md" align-items="center"
                      Face(shape="hex", color="blue", state="idle", size=28, still=true)
                      column gap="2px"
                        text "New group" font-weight=500
                        if bots.length < 2
                          text "Needs two Bots" font="-exact-footnote" color="ink.faint"
              column navigationSplit="placeholder" flex=1 align-items="center" justify-content="center" gap="space.lg" padding="space.xl"
                Face(shape="ball", color="teal", state="idle", size=72, still=false)
                text t("inbox.tagline") class=HeroTitle text-align="center"
                text "Choose a Bot to pick up where you left off, or create someone new." color="ink.muted" text-align="center" max-width="24rem"
                button class=PrimaryButton press=openNew buttonStyle="filled"
                  text "New Bot"
              if failed(bots) and bots.length == 0
                EmptyState(symbol="symbol:alert", title="Can’t Reach the Gateway", message="Start the `hbots` gateway on this machine or on your server, then try again.")
                  button press=pull testId="retry"
                    text "Try again"
              else if bots.length == 0 and not pending(bots)
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="empty-bots"
                  Face(shape="ball", color="teal", state="idle", size=72, still=false)
                  text "Meet your first Bot" role="heading" aria-level=2 class=PageTitle
                  text "Give your Bot a name, then make it your own. Your conversations stay together, right here." color="-exact-secondary-label" text-align="center" max-width="22rem"
                  button press=openNew buttonStyle="filled" testId="empty-new"
                    text "Create your first Bot"
              else if query != "" and visibleBots.length == 0 and hiddenBots.length == 0
                column flex=1 min-height=0 align-items="center" justify-content="center" padding="space.xl" testId="no-bot-match"
                  EmptyState(symbol="symbol:search", title=`No Bots match “${botQuery.trim()}”`, message="Check the spelling, or clear the search to see every Bot.")
              else
                if tiles.length > 0
                  row gap="space.xs" padding="0 space.sm space.sm" testId="bot-tiles"
                    for b in tiles key=b.slug
                      link class=TileLink href=path("chat", b.slug) testId=`bot-${b.slug}` aria-label=b.name width=84 flex-shrink=0 background-color=(slug == b.slug ? "surface.raised" : "transparent")
                        column align-items="center" gap="space.xs" width="100%" min-width=0 max-width="100%"
                          Avatar(shape=b.shape, color=faceColor(b.color), state=(b.ready ? (b.working ? "working" : "idle") : "asleep"), size=64, still=(not b.working), presence=(b.unread ? "unread" : b.working ? "online" : ""))
                          text b.name font="-exact-footnote" font-weight=600 max-width="100%" overflow="hidden" text-overflow="ellipsis" white-space="nowrap" text-align="center"
                list id="bots-list" appearance="none" flex=1 min-height=0 padding="0 space.sm" gap="2px"
                  for c in convos key=c.key
                    link class=ConversationLink href=(c.kind == "group" ? path("group", c.id) : path("chat", c.id)) testId=(c.kind == "group" ? `group-${c.id}` : `bot-${c.id}`) background-color=((c.kind == "group" ? roomId == c.id : slug == c.id) ? "surface.raised" : "transparent")
                      row gap="space.md" align-items="center"
                        Avatar(shape=c.shape, color=faceColor(c.color), state=(c.ready ? (c.working ? "working" : "idle") : "asleep"), size=44, still=(not c.working), presence=(c.working ? "online" : ""))
                        column gap="2px" flex=1 min-width=0
                          row gap="space.sm" align-items="baseline"
                            text c.name font-weight=(c.unread ? 700 : 600) flex=1 min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=(c.kind == "group" ? `group-title-${c.id}` : `bot-title-${c.id}`)
                            text c.time font="-exact-footnote" color="ink.faint"
                          row gap="space.sm" align-items="center"
                            text c.line color=(c.unread ? "-exact-label" : "ink.muted") font="-exact-footnote" flex=1 min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                            if showUnread(c.unread, slug == c.id, false)
                              column width=8 height=8 flex-shrink=0 border-radius="radius.full" background-color="AccentColor" aria-label="Unread" testId=`unread-${c.id}`
                  if hiddenBots.length > 0
                    button class=ConversationLink appearance="none" press=toggleHidden aria-expanded=hiddenOpen testId="hidden-toggle"
                      row gap="space.sm" align-items="center"
                        text `Hidden ${hiddenBots.length}` font="-exact-footnote" color="ink.muted" flex=1
                        column color="ink.muted" rotate=(hiddenOpen ? "90deg" : "0deg")
                          Glyph(name="chevron", size=14)
                    if hiddenOpen
                      for b in hiddenBots key=b.slug
                        button class=ConversationLink appearance="none" press=openHidden(b.slug) testId=`hidden-${b.slug}`
                          row gap="space.md" align-items="center"
                            Avatar(shape=b.shape, color=faceColor(b.color), state="asleep", size=32, still=true, presence="")
                            text b.name flex=1 color="ink.muted"
                            if showUnread(b.unread, slug == b.slug, b.hidden)
                              column width=8 height=8 flex-shrink=0 border-radius="radius.full" background-color="AccentColor" aria-label="Unread" testId=`unread-${b.slug}`
              column padding="space.xs space.sm" border-top="1px solid surface.line" gap="2px"
                link class=ConversationLink href="/vault" aria-label=t("vault.title") testId="sidebar-vault" padding="space.xs space.md"
                  row align-items="center" gap="space.md"
                    column color="ink.muted" width=32 align-items="center"
                      Glyph(name="lock", size=18)
                    text t("vault.title") font-weight=500
                link class=ConversationLink href="/settings" aria-label=t("settings.title") title=t("settings.title") testId="open-settings" padding="space.sm space.md"
                  row align-items="center" gap="space.md"
                    column width=32 height=32 border-radius="radius.full" background-color="surface.raised" align-items="center" justify-content="center"
                      if initialsOf(prefs.userName) != ""
                        text initialsOf(prefs.userName) font="-exact-footnote" font-weight=600
                      else
                        Glyph(name="person", size=16)
                    column flex=1 min-width=0 gap="2px"
                      text (prefs.userName != "" ? prefs.userName : "You") font-weight=500 overflow-wrap="break-word" testId="you-name"
                      text botCountLabel(bots.length) color="ink.muted" font="-exact-footnote"
          else if e.name == "chat"
            column class=Screen navigationKey=`${e.id}` navigationScroll="transcript" drop=filesDropped position="absolute" inset=0 padding-right=((wide and panelOpen) ? "20rem" : "0px")
              header appearance="none" class=PageHeader position="relative" testId="chat-header"
                button id="back" class=IconControl appearance="none" press=back aria-label="Back" title="Back" display=(wide ? "none" : "flex")
                  column rotate="180deg"
                    Glyph(name="chevron", size=20)
                button class=HeaderToggle appearance="none" press=togglePanel aria-label=(panelOpen ? "Hide Bot details" : "Show Bot details") aria-expanded=panelOpen aria-controls="bot-panel" title="Bot settings" testId="panel-toggle" position="absolute" left="50%" translate="-50% 0" gap="space.sm" padding="0 space.md" max-width="75%"
                  if nameOf(bots, e.params.slug) != ""
                    column testId="chat-avatar"
                      Face(shape=shapeOf(bots, e.params.slug), color=faceColor(colorOf(bots, e.params.slug)), state=(chat.working ? "working" : "idle"), size=28, still=true)
                  text nameOf(bots, e.params.slug) role="heading" aria-level=1 class=PageTitle overflow-wrap="anywhere" testId="chat-title" min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                column flex=1
                button class=IconControl appearance="none" press=toggleChatSearch aria-label="Search this conversation" title="Search this conversation" testId="chat-search-open" width=36 height=36
                  Glyph(name=(chatSearching ? "close" : "search"), size=18)
              if failed(chat)
                EmptyState(symbol="symbol:alert", title="Can’t load this conversation", message="Your messages haven’t loaded. Check the gateway, then try again.")
                  button press=pull testId="retry-chat"
                    text "Try again"
              else if pending(chat) and chat.rows.length == 0
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" aria-busy=true
                  Face(shape=shapeOf(bots, e.params.slug), color=faceColor(colorOf(bots, e.params.slug)), state="working", size=44, still=false)
                  text "Loading your conversation…" color="ink.muted"
              else if chat.rows.length == 0 and not chat.working
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="empty-chat"
                  Face(shape=shapeOf(bots, e.params.slug), color=faceColor(colorOf(bots, e.params.slug)), state="idle", size=72, still=false)
                  text nameOf(bots, e.params.slug) class=HeroTitle
                  text "A little help, a new idea, or just a hello." color="ink.muted" text-align="center"
                  column gap="space.sm" width="100%" max-width="24rem" margin-top="space.lg"
                    button press=edit("Help me make a plan for today.") class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-plan"
                      text "Make a plan for today"
                    button press=edit("I have an idea I’d like to think through.") class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-idea"
                      text "Think through an idea"
                    button press=edit("What can we work on together?") class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-help"
                      text "See what we can do together"
              else
                column flex=1 min-height=0 justify-content="flex-end" position="relative"
                  if chatSearching
                    input type="search" class=SearchField value=messageQuery input=editChatQuery placeholder="Search this conversation" aria-label="Search this conversation" testId="chat-search" width="calc(100% - 32px)" max-width="44rem" align-self="center" box-sizing="border-box" margin="0 space.lg space.xs"
                  if chatSearching and searchNote != ""
                    text searchNote color="ink.muted" font="-exact-footnote" testId="search-note" width="100%" max-width="46rem" align-self="center" box-sizing="border-box" padding="0 space.lg"
                  if away
                    button class=IconControl appearance="none" press=toEnd aria-label="Jump to the latest message" title="Jump to the latest" testId="to-end" position="absolute" left="50%" translate="-50% 0" bottom=8 z-index=1 width=32 height=32 border-radius="radius.full" background-color="surface.raised" border="1px solid surface.line"
                      Glyph(name="arrow-down", size=16)
                  for p in chat.pins key=p.id
                    text p.text color="ink.muted" font="-exact-footnote" testId=`pin-${p.id}` width="100%" max-width="46rem" align-self="center" box-sizing="border-box" padding="0 space.lg"
                  list id="transcript" testId=(childThread != "" ? "child-transcript" : "transcript") width="100%" box-sizing="border-box" padding="space.lg max(0px, calc((100% - 46rem) / 2))" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true scroll=moved max-height="100%" min-height=0 flex-shrink=1
                    for m in shownRows key=m.id
                      column
                        if m.kind == "day"
                          text m.text text-align="center" font="-exact-footnote" color="ink.faint" padding="space.lg space.lg space.xs" testId=`day-${m.id}`
                        else if m.kind == "event"
                          row justify-content="center" align-items="center" gap="space.xs" flex-wrap="wrap" padding="space.sm space.lg" testId=`event-${m.id}`
                            text m.text font="-exact-footnote" color="ink.faint"
                            if m.botName != ""
                              row gap="space.xs" align-items="center" padding="2px space.sm 2px 2px" border-radius="radius.full" background-color="surface.bubble"
                                Avatar(shape=m.botShape, color=faceColor(m.botColor), state="idle", size=18, still=true, presence="")
                                text m.botName font="-exact-footnote" color="-exact-label"
                            if m.title != ""
                              row gap="space.xs" align-items="center" padding="2px space.sm" border-radius="radius.full" background-color="surface.bubble"
                                column color="ink.muted"
                                  Glyph(name=(m.variant == "routine" ? "clock" : "check"), size=14)
                                text m.title font="-exact-footnote" color="-exact-label"
                        else if m.kind == "message"
                          row justify-content=(m.mine ? "flex-end" : "flex-start") padding=(m.head ? "space.sm space.lg 2px" : "2px space.lg")
                            column gap="2px" max-width="82%" align-items=(m.mine ? "flex-end" : "flex-start")
                              if m.quote != ""
                                text m.quote color="ink.muted" font="-exact-footnote" testId=`quote-${m.id}`
                              if m.text != "" and m.mine
                                text m.text class=Bubble testId=`message-${m.id}`
                                  background-color="brand.default"
                                  color="ink.dark"
                                  border-top-left-radius="radius.lg"
                                  border-top-right-radius="radius.lg"
                                  border-bottom-left-radius="radius.lg"
                                  border-bottom-right-radius=(m.tail ? "radius.sm" : "radius.lg")
                              else if m.text != ""
                                text m.text markup="markdown" class=Bubble white-space="normal" testId=`message-${m.id}`
                                  background-color="surface.bubble"
                                  color="-exact-label"
                                  border-top-left-radius="radius.lg"
                                  border-top-right-radius="radius.lg"
                                  border-bottom-left-radius=(m.tail ? "radius.sm" : "radius.lg")
                                  border-bottom-right-radius="radius.lg"
                              for f in m.files key=f.id
                                if f.kind == "image"
                                  link href=f.url target="_blank" aria-label=`Open ${f.name}` testId=`image-${f.id}`
                                    image f.url aria-label=f.name max-width="20rem" width="100%" border-radius="radius.lg"
                                else if f.kind == "audio" and f.url != ""
                                  audio f.url controls=true testId=`audio-${f.id}`
                                else
                                  link class=FileCard href=f.url target="_blank" aria-label=`Download ${f.name}` testId=`file-${f.id}`
                                    row gap="space.md" align-items="center"
                                      column class=IconTile color="AccentColor"
                                        Glyph(name="file", size=18)
                                      column gap="2px" flex=1 min-width=0
                                        text f.name font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                                        text f.size font="-exact-footnote" color="ink.muted"
                                      column color="ink.muted"
                                        Glyph(name="download", size=18)
                              if m.tokens != ""
                                text m.tokens color="ink.muted" font="-exact-footnote" testId=`tokens-${m.id}`
                              if m.tail and m.time != ""
                                row gap="space.xs" align-items="center" padding="0 space.xs"
                                  text m.time font="-exact-footnote" color="ink.faint"
                                  if m.react != ""
                                    button class=TextControl appearance="none" press=doReact(m.id, m.react) aria-label="Remove reaction" min-height=24 padding="0 space.xs" testId=`react-${m.id}`
                                      text m.react font="-exact-footnote"
                                  else if not m.mine
                                    button class=TextControl appearance="none" press=openReact(m.id) aria-label="React" title="React" min-height=24 padding="0 space.xs" testId=`add-react-${m.id}`
                                      Glyph(name="smile", size=14)
                                if reactFor == m.id
                                  row gap="2px" padding="space.xs" border-radius="radius.full" background-color="surface.raised" border="1px solid surface.line" box-shadow="0 4px 16px rgba(0,0,0,0.25)" testId="react-picker"
                                    for em in ["👍", "❤️", "😂", "😮", "🎉", "🙏"] key=em
                                      button class=TextControl appearance="none" press=doReact(m.id, em) aria-label=`React ${em}` width=36 height=36 min-height=36 padding=0 border-radius="radius.full" font="-exact-title3" testId=`pick-${em}`
                                        text em
                        else if m.kind == "request"
                          row padding="space.sm space.lg"
                            column gap="space.sm" padding="space.md space.lg" border-radius="radius.lg" background-color="surface.bubble" flex=1 max-width="32rem" testId=`request-${m.id}`
                              row gap="space.sm" align-items="center"
                                Avatar(shape=shapeOf(bots, e.params.slug), color=faceColor(colorOf(bots, e.params.slug)), state="idle", size=24, still=true, presence="")
                                text m.text font-weight=600 flex=1 min-width=0
                              if m.title != ""
                                text m.title color="ink.muted" font="-exact-footnote"
                              if m.variant == "approval_request"
                                row gap="space.sm" flex-wrap="wrap"
                                  for c in m.choices key=c.value
                                    button class=ChoiceButton appearance="none" press=answer(m.id, m.variant, c.key, c.value) testId=`answer-${c.value}`
                                      background-color=(c.value == "accept" ? "brand.default" : "surface.card")
                                      color=(c.value == "accept" ? "ink.dark" : "-exact-label")
                                      text c.label
                              else if m.variant == "user_input_request"
                                column gap="space.sm"
                                  for c in m.choices key=c.value
                                    button class=ChoiceButton appearance="none" press=answer(m.id, m.variant, c.key, c.value) background-color="surface.card" testId=`answer-${c.value}`
                                      text c.label
                                  if m.placeholder != ""
                                    row gap="space.sm" align-items="center"
                                      input appearance="none" class=Field value=answerText input=editAnswer placeholder=m.placeholder aria-label="Your answer" flex=1 min-width=0 padding="0 space.md" border="1px solid surface.line" border-radius="radius.full" background-color="surface.card" testId="answer-text"
                                      button class=ChoiceButton appearance="none" press=answer(m.id, m.variant, m.key, answerText) disabled=(answerText.trim() == "") background-color="brand.default" color="ink.dark" testId="answer-send"
                                        text "Send"
                              else
                                row gap="space.sm" align-items="center"
                                  input appearance="none" class=Field type="password" value=answerText input=editAnswer placeholder=(m.placeholder != "" ? m.placeholder : "Secret") aria-label="Secret" flex=1 min-width=0 padding="0 space.md" border="1px solid surface.line" border-radius="radius.full" background-color="surface.card" testId="secret-text"
                                  button class=ChoiceButton appearance="none" press=answer(m.id, m.variant, "", answerText) disabled=(answerText == "") background-color="brand.default" color="ink.dark" testId="secret-save"
                                    text "Save"
                                  button class=ChoiceButton appearance="none" press=answer(m.id, m.variant, "", "") background-color="surface.card" testId="secret-decline"
                                    text "Decline"
                              if answerError != "" and not pending(answered)
                                text answerError color="-exact-system-red" font="-exact-footnote" testId="answer-error"
                        else
                          row padding="space.sm space.lg" gap="space.sm" align-items="center" testId="working"
                            Face(shape=shapeOf(bots, e.params.slug), color=faceColor(colorOf(bots, e.params.slug)), state="working", size=24, still=false)
                            row gap="6px" align-items="center" padding="space.md space.lg" background-color="surface.bubble" border-top-left-radius="radius.lg" border-top-right-radius="radius.lg" border-bottom-left-radius="radius.sm" border-bottom-right-radius="radius.lg" aria-label="Working"
                              for n in [0, 1, 2] key=n
                                column width=7 height=7 border-radius="radius.full" background-color="ink.muted" opacity=0.6
                  if pending(sent) and lastText != ""
                    row justify-content="flex-end" padding="2px space.lg" testId="sending"
                      text lastText class=Bubble opacity=0.6 background-color="brand.default" color="ink.dark" border-radius="radius.lg" border-bottom-right-radius="radius.sm" max-width="82%"
                  if failedText != "" and not pending(sent)
                    row justify-content="flex-end" padding="2px space.lg" testId="not-sent"
                      column align-items="flex-end" gap="space.xs" max-width="82%"
                        text failedText class=Bubble background-color="brand.default" color="ink.dark" border-radius="radius.lg" border-bottom-right-radius="radius.sm" opacity=0.7
                        row gap="space.sm" align-items="center"
                          text "Not sent" font="-exact-footnote" color="-exact-system-red"
                          button class=TextControl appearance="none" press=retry testId="retry-send"
                            text "Retry"
              if attachError != "" and not pending(attached)
                text attachError color="-exact-system-red" padding="0 space.lg" testId="attach-error"
              if pendingAttaches.length > 0
                row gap="space.sm" flex-wrap="wrap" padding="0 space.lg space.xs" align-self="center" width="100%" max-width="44rem" box-sizing="border-box" testId="pending-files"
                  for entry in pendingAttaches key=entry
                    row gap="space.xs" align-items="center" padding="4px 6px 4px space.sm" border="1px solid surface.line" border-radius="radius.full" background-color="surface.card" max-width="100%" box-sizing="border-box"
                      column color="ink.muted"
                        Glyph(name="attach", size=14)
                      text attachmentName(entry) font="-exact-footnote" color="-exact-label" overflow-wrap="anywhere" flex=1 min-width=0
                      button class=IconControl appearance="none" press=dropPending(entry) aria-label=`Remove ${attachmentName(entry)}` title="Remove attachment" testId="pending-file" width=28 height=28
                        Glyph(name="close", size=14)
              if chat.readOnly
                text "This thread is read only." color="ink.muted" padding="space.md space.lg space.xl" testId="child-readonly"
              else
                column width="calc(100% - 32px)" max-width="44rem" align-self="center" box-sizing="border-box" margin="space.sm space.lg space.xl" gap="space.xs"
                  if voicePreview != ""
                    audio voicePreview controls=true testId="voice-preview"
                  if voiceError != ""
                    text voiceError color="-exact-system-red" font="-exact-footnote" testId="voice-error"
                  row align-items="flex-end" width="100%" box-sizing="border-box" padding="space.xs" gap="space.xs" border-radius="radius.lg" border="1px solid surface.line" background-color="surface.card"
                    button class=IconControl press=pickFiles disabled=(slug == "" or pending(attached) or pendingAttaches.length >= 8) appearance="none" aria-label="Attach a file" title="Attach a file" testId="attach" width=36 height=36 border-radius="radius.full" background-color="surface.raised"
                      Glyph(name="add", size=18)
                    if voiceHold != ""
                      text voiceHold font="-exact-footnote" color="ink.muted" testId="voice-hold"
                    if voiceId != ""
                      button class=IconControl appearance="none" press=discardVoice aria-label="Discard clip" title="Discard clip" testId="voice-discard" width=36 height=36
                        Glyph(name="close", size=16)
                    input type="file" id="chat-attach" display="none" change=filesPicked testId="chat-attach"
                    textarea id="composer" value=draft input=edit key=composerKey paste=pasted outline="none" border-radius="radius.md" rows=1 field-sizing="content" max-height=140 placeholder=(nameOf(bots, e.params.slug) != "" ? `Message ${nameOf(bots, e.params.slug)}` : "Write a message…") aria-label="Message" testId="composer" flex=1 min-width=0 padding="space.sm space.xs" border="none" background-color="transparent" color="-exact-label"
                    if voiceRecorder != ""
                      button class=SendControl appearance="none" press=holdVoice margin="2px 0" aria-label="Stop recording" title="Stop recording" testId="voice-record" background-color="-exact-system-red" color="ink.dark"
                        Glyph(name="stop", size=16)
                    else if voiceId != ""
                      button class=SendControl appearance="none" press=sendHeldVoice disabled=pending(voiceSent) margin="2px 0" aria-label="Send voice clip" title="Send voice clip" testId="voice-send"
                        Glyph(name="send", size=18)
                    else if chat.working and not canSend
                      button class=StopControl appearance="none" press=stop margin="2px 0" aria-label="Stop" testId="stop"
                        Glyph(name="stop", size=16)
                    else if not canSend
                      button class=SendControl appearance="none" press=holdVoice margin="2px 0" aria-label="Record a voice clip" title="Record a voice clip" testId="voice-record" background-color="-exact-label" color="surface.canvas"
                        Glyph(name="mic", size=18)
                    else
                      button class=SendControl appearance="none" press=post disabled=(not canSend or pending(sent)) margin="2px 0" retainFocus=true aria-label="Send" testId="send"
                        Glyph(name="send", size=18)
              for b in bots.filter(x => x.slug == e.params.slug) key=b.slug
                BotPanel(working=chat.working, shown=panelOpen, tab=panelTab, page=panelPage, pickTab=pickPanelTab, openPage=openPage, closePanel=togglePanel, openChild=openChild, wide=wide, bot=b, error=botError, rename=doRename, recolour=doRecolour, reshape=doReshape, pin=doPin, hide=doHide, makeMain=doMain, drop=doDropBot, models=models, modelsDown=failed(models), pickModel=doPickModel, makeDefault=doMakeDefault, isDefault=(prefs.defaultInstance == models.instanceId and prefs.defaultModel == models.current), modelError=modelError, routines=routines, routinesDown=failed(routines), lineage=lineage, lineageDown=failed(lineage), report=report, reportDown=failed(report), period=usagePeriod, usageView=usageView, pickPeriod=pickPeriod, pickView=pickView, retryDetails=retryDetails, shelf=shelf, shelfDown=failed(shelf), computer=computer, computerDown=failed(computer), heldTab=heldTab, controlError=controlError, take=doTake, release=doRelease)
          else if e.name == "group"
            column class=Screen navigationKey=`${e.id}` navigationScroll="room-log" position="absolute" inset=0 padding-right=((wide and groupPanel) ? "20rem" : "0px")
              header appearance="none" class=PageHeader position="relative" testId="room-header"
                button id="back" class=IconControl appearance="none" press=back aria-label="Back" title="Back" display=(wide ? "none" : "flex")
                  column rotate="180deg"
                    Glyph(name="chevron", size=20)
                button class=HeaderToggle appearance="none" press=toggleGroupPanel aria-label=(groupPanel ? "Hide group details" : "Show group details") aria-expanded=groupPanel aria-controls="group-panel" title="Group details" testId="group-toggle" position="absolute" left="50%" translate="-50% 0" gap="space.sm" padding="0 space.md" max-width="75%"
                  if room.title != ""
                    Face(shape=room.shape, color=faceColor(room.color), state="idle", size=28, still=true)
                  text (room.title != "" ? room.title : "Group") role="heading" aria-level=1 class=PageTitle overflow="hidden" text-overflow="ellipsis" white-space="nowrap" min-width=0 testId="room-title"
                column flex=1
              if failed(room)
                EmptyState(symbol="symbol:alert", title="Can’t load this group", message="Check that hbots is running, then try again.")
                  button press=pull testId="room-retry"
                    text "Try again"
              else
                row gap="space.sm" padding="space.sm space.lg" overflow-x="auto" flex-shrink=0 testId="room-members"
                  for m in room.members key=m.slug
                    row gap="space.sm" align-items="center" padding="4px space.md 4px 4px" border="1px solid surface.line" border-radius="radius.full" background-color="surface.card" flex-shrink=0
                      Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state=m.state, size=28, still=(m.state != "working"), presence="")
                      column
                        text m.name font="-exact-footnote" font-weight=600 testId=`member-${m.slug}-name`
                        text m.line color="ink.muted" font="-exact-caption2" testId=`member-${m.slug}-state`
                if room.messages.length == 0
                  column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="room-empty"
                    Face(shape=room.shape, color=faceColor(room.color), state="idle", size=72, still=false)
                    text "Start the conversation" class=HeroTitle text-align="center"
                    text "Everyone hears a plain message. Write @name to wake just one Bot." color="ink.muted" text-align="center" max-width="24rem"
                else
                  list id="room-log" appearance="none" width="100%" max-width="46rem" align-self="center" box-sizing="border-box" flex=1 min-height=0 padding="space.sm space.lg" virtualized=true scroll-start="end" scrollFollowEnd=true testId="room-log"
                    for msg in room.messages key=msg.id
                      row justify-content=(msg.from == "user" ? "flex-end" : "flex-start") gap="space.sm" align-items="flex-end" padding="2px 0" testId=`room-msg-${msg.id}`
                        if msg.from != "user"
                          Face(shape=shapeOf(bots, msg.from), color=faceColor(colorOf(bots, msg.from)), state="idle", size=28, still=true)
                        column gap="2px" max-width="82%" align-items=(msg.from == "user" ? "flex-end" : "flex-start")
                          if msg.from != "user"
                            text msg.name font="-exact-footnote" font-weight=600 color="ink.muted" testId=`room-from-${msg.id}`
                          if msg.from == "user"
                            text msg.text class=Bubble testId=`room-text-${msg.id}`
                              background-color="brand.default"
                              color="ink.dark"
                              border-radius="radius.lg"
                              border-bottom-right-radius="radius.sm"
                          else
                            text msg.text markup="markdown" class=Bubble white-space="normal" testId=`room-text-${msg.id}`
                              background-color="surface.bubble"
                              color="-exact-label"
                              border-radius="radius.lg"
                              border-bottom-left-radius="radius.sm"
                column width="calc(100% - 32px)" max-width="44rem" align-self="center" box-sizing="border-box" margin="space.sm space.lg space.xl" gap="space.sm" flex-shrink=0
                  if roomError != "" and not pending(roomSent)
                    text roomError color="-exact-system-red" font="-exact-footnote" testId="room-send-error"
                  row gap="space.xs" flex-wrap="wrap" testId="mention-chips"
                    for m in room.members key=m.slug
                      button appearance="none" press=mention(m.slug) aria-label=`Mention ${m.name}` title=`Mention ${m.name}` testId=`mention-${m.slug}` min-height=32 padding="0 space.md 0 4px" border-radius="radius.full" border="1px solid surface.line" background-color=(roomText.includes(`@${m.slug}`) ? "surface.soft" : "surface.card") color="-exact-label"
                        row gap="space.xs" align-items="center"
                          Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state="idle", size=22, still=true, presence="")
                          text `@${m.slug}` font="-exact-footnote" font-weight=500
                  row align-items="flex-end" padding="space.xs" gap="space.xs" border-radius="radius.lg" border="1px solid surface.line" background-color="surface.card"
                    textarea id="room-composer" value=roomText input=editRoomText key=roomKey outline="none" border-radius="radius.md" rows=1 field-sizing="content" max-height=140 placeholder=(room.title != "" ? `Message ${room.title}` : "Write a message…") aria-label="Message the group" testId="room-composer" flex=1 min-width=0 padding="space.sm space.sm" border="none" background-color="transparent" color="-exact-label"
                    button class=SendControl appearance="none" press=postRoom disabled=(roomText.trim() == "" or pending(roomSent)) margin="2px 0" retainFocus=true aria-label="Send" testId="room-send"
                      Glyph(name="send", size=18)
                  text (roomText.includes("@") ? "Only the Bots you mention are woken." : "No @mention: the Bot that spoke last answers, or everyone at first.") color="ink.muted" font="-exact-footnote" testId="room-hint"
              GroupPanel(shown=groupPanel, wide=wide, page=groupPage, room=room, bots=bots, closePanel=toggleGroupPanel, openEdit=openGroupEdit, goRoot=groupBack, patch=patchGroup, toggleMember=toggleGroupMemberOf, drop=dropGroup, error=groupSaveError)
          else if e.name == "settings"
            column class=Screen navigationKey=`${e.id}` navigationScroll="settings-form" position="absolute" inset=0
              header class=PageHeader
                text t("settings.title") role="heading" aria-level=1 class=PageTitle flex=1
              scroll id="settings-form" flex=1 min-height=0
                column width="100%" max-width="40rem" align-self="center" box-sizing="border-box" margin="0 auto" padding="space.lg space.lg space.xl" gap="space.xl"
                  row class=GroupCard gap="space.lg" align-items="center" padding="space.lg"
                    column width=56 height=56 border-radius="radius.full" background-color="surface.raised" align-items="center" justify-content="center"
                      if initialsOf(prefs.userName) != ""
                        text initialsOf(prefs.userName) font="-exact-title3" font-weight=600
                      else
                        Glyph(name="person", size=24)
                    column flex=1 gap="2px" min-width=0
                      input appearance="none" class=Field value=(nameEditing ? nameDraft : prefs.userName) input=doEditName change=doSaveName placeholder="Your name" aria-label="Your name" font="-exact-headline" testId="user-name"
                      text botCountLabel(bots.length) color="ink.muted" font="-exact-footnote"
                  column gap="space.sm"
                    text "Appearance" class=SectionLabel
                    row gap="space.sm" role="radiogroup" aria-label="Theme"
                      for t in ["system", "light", "dark"] key=t
                        button press=doPickTheme(t) role="radio" aria-checked=(prefs.theme == t) appearance="none" flex=1 padding="space.sm" border-radius="radius.md" testId=`theme-${t}` border=(prefs.theme == t ? "2px solid AccentColor" : "2px solid transparent") background-color="surface.card"
                          column gap="space.xs" align-items="center"
                            row width="100%" height=44 border-radius="radius.sm" overflow="hidden" border="1px solid surface.line"
                              column flex=1 background-color=(t == "dark" ? "#17171b" : "#fcfcfd")
                              column flex=1 background-color=(t == "light" ? "#fcfcfd" : t == "dark" ? "#17171b" : "#17171b")
                            text themeLabel(t) font="-exact-footnote" font-weight=500
                  column gap="space.sm"
                    text "New Bots start with" class=SectionLabel
                    column class=GroupCard padding="space.sm"
                      if providers.length == 0
                        text "No provider is ready in T3 Code yet." color="ink.muted" font="-exact-subheadline" padding="space.sm"
                      else
                        ModelPicker(providers=providers, instanceId=prefs.defaultInstance, model=prefs.defaultModel, effort="", efforts=[], prefix="default", pick=doMakeDefault)
                  column gap="space.sm"
                    text "Usage" class=SectionLabel
                    column class=GroupCard padding="0"
                      UsageView(report=report, down=failed(report), period=usagePeriod, view=usageView, pickPeriod=pickPeriod, pickView=pickView, showBots=true)
                    text "Counted on this machine. Nothing is sent anywhere." color="ink.muted" font="-exact-footnote" padding="0 space.md"
                  column gap="space.sm"
                    text "Private data" class=SectionLabel
                    button class=PanelRow appearance="none" press=open("/vault") testId="open-vault"
                      column class=IconTile color="AccentColor"
                        Glyph(name="lock", size=18)
                      column flex=1 gap="2px" min-width=0
                        text t("vault.title") font-weight=600
                        text "Manage saved logins" color="ink.muted" font="-exact-footnote"
                      column color="ink.muted"
                        Glyph(name="chevron", size=18)
                  column gap="space.sm"
                    text "Remote access" class=SectionLabel
                    column class=GroupCard gap="space.md" padding="space.md"
                      text (session.passwordRequired ? "A password protects hbots when you open it from another device." : "No password is set. Anyone who can reach this machine can open hbots.") color="ink.muted" font="-exact-footnote"
                      row gap="space.sm" align-items="center"
                        input appearance="none" class=Field type="password" value=newPassword input=editNewPassword submit=doSavePassword placeholder=(session.passwordRequired ? "New password" : "Set a password") aria-label="Password" autocomplete="new-password" flex=1 min-width=0 min-height=36 padding="0 space.md" border="1px solid surface.line" border-radius="radius.full" font="-exact-subheadline" testId="new-password"
                        button class=ChoiceButton appearance="none" press=doSavePassword disabled=(newPassword == "" or pending(passwordSet)) background-color=(newPassword == "" ? "surface.raised" : "brand.default") color=(newPassword == "" ? "ink.muted" : "ink.dark") testId="save-password"
                          text (session.passwordRequired ? "Change" : "Set")
                      if passwordError != "" and not pending(passwordSet)
                        text passwordError color="-exact-system-red" font="-exact-footnote" testId="password-error"
                  column gap="space.sm"
                    text "About" class=SectionLabel
                    column class=GroupCard padding="space.xs space.md"
                      row justify-content="space-between" align-items="center" min-height=40 font="-exact-subheadline"
                        text "hbots" color="ink.muted"
                        text (about.ok ? about.version : "Unknown") testId="about-version"
                      row justify-content="space-between" align-items="center" min-height=40 border-top="1px solid surface.line" font="-exact-subheadline"
                        text about.harness color="ink.muted"
                        text (about.connected ? "Connected" : "Not connected") color=(about.connected ? "-exact-label" : "-exact-system-red") testId="about-harness"
                    if session.passwordRequired
                      button class=ChoiceRow appearance="none" press=logout justify-content="center" color="-exact-system-red" testId="sign-out"
                        text "Sign out" font-weight=500
          else if e.name == "vault"
            column class=Screen navigationKey=`${e.id}` navigationScroll="vault-list" position="absolute" inset=0
              header class=PageHeader flex-wrap="wrap"
                text t("vault.title") role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=open("/vault/new") aria-label="New login" title="New login" testId="new-login"
                  Glyph(name="add", size=20)
                input type="search" class=SearchField value=vaultQuery input=editVaultQuery placeholder="Search Vault" aria-label="Search Vault" testId="vault-search" width="100%"
              if failed(vault)
                EmptyState(symbol="symbol:alert", title="Can’t open the Vault", message="Check that `hbots` is running, then try again.")
              else if vault.length == 0 and not pending(vault)
                EmptyState(symbol="symbol:lock", title="No logins yet", message="Save a login here. Its password stays in the Vault and shows only when you press Reveal.")
                  button press=open("/vault/new") testId="empty-login"
                    text "Add a login"
              else if vquery != "" and shownVault.length == 0
                column flex=1 min-height=0 align-items="center" justify-content="center" padding="space.xl" testId="no-vault-match"
                  EmptyState(symbol="symbol:search", title=`No logins match “${vaultQuery.trim()}”`, message="Check the spelling, or clear the search to see every login.")
              else
                list id="vault-list" appearance="none" width="100%" box-sizing="border-box" flex=1 min-height=0 gap="space.sm" padding="space.md max(space.lg, calc((100% - 40rem) / 2))"
                  for v in shownVault key=v.id
                    link href=path("vaultEdit", v.id) testId=`login-${v.id}`
                      row class=BotRow background-color="surface.card" border="1px solid surface.line" border-radius="radius.md" padding="space.md"
                        column class=IconTile color="AccentColor" overflow="hidden"
                          if v.icon != ""
                            image v.icon aria-label="" width=24 height=24 border-radius="radius.sm"
                          else
                            Glyph(name="lock", size=18)
                        column flex=1 min-width=0 gap="space.xs"
                          text v.title font-weight=600
                          text (v.username != "" ? v.username : v.website) color="ink.muted" font="-exact-footnote"
                        Glyph(name="chevron", size=20)
          else if e.name == "vaultAdd"
            LoginSheet(route=e.id, item=Login(id="", title="", website="", username="", hasPassword=false, hints="", icon=""), revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "vaultEdit"
            for l in vault.filter(x => x.id == e.params.id) key=l.id
              LoginSheet(route=e.id, item=l, revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "newGroup"
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="group-form" position="absolute" inset=0
              header class=PageHeader
                button id="back" class=TextControl appearance="none" press=back testId="group-cancel"
                  text t("common.cancel")
                text "New group" role="heading" aria-level=1 class=PageTitle flex=1
                button buttonStyle="filled" press=makeGroup disabled=(not canMakeGroup) testId="group-create"
                  text (pending(groupMade) ? "Creating…" : "Create group")
              scroll id="group-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  column align-items="center" gap="space.md"
                    Avatar(shape=groupShape, color=faceColor(groupColor), state="idle", size=96, still=false, presence="")
                    row gap="space.xs" flex-wrap="wrap" justify-content="center"
                      for c in pickerColours() key=c
                        button class=SwatchControl press=pickGroupColour(c) appearance="none" aria-label=`Colour ${faceColor(c)}` aria-pressed=(groupColor == c) testId=`group-colour-${c}` width=36 height=36 padding=0
                          column width=26 height=26 box-sizing="border-box" margin="space.xs" border-radius="radius.full" background-color=c border=(groupColor == c ? "3px solid AccentColor" : "3px solid transparent")
                    row gap="space.xs" flex-wrap="wrap" justify-content="center"
                      for s in shapeNames() key=s
                        button class=SwatchControl press=pickGroupShape(s) appearance="none" aria-label=`Shape ${s}` aria-pressed=(groupShape == s) testId=`group-shape-${s}` width=44 height=44 padding=0 border-radius="radius.md" background-color=(groupShape == s ? "surface.raised" : "transparent")
                          Avatar(shape=s, color=faceColor(groupColor), state="idle", size=30, still=true, presence="")
                  column gap="space.sm"
                    text "Name" font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=groupName input=editGroupName submit=makeGroup placeholder="What is this group for?" aria-label="Group name" padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-name"
                  column gap="space.sm"
                    text "Description" font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=groupAbout input=editGroupAbout placeholder="Optional. What the group works on." aria-label="Description" padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-about"
                  column gap="space.sm"
                    row align-items="baseline" gap="space.sm"
                      text "Bots" font="-exact-subheadline" font-weight=600 flex=1
                      text (groupMembers.length < 2 ? `Pick at least two (${groupMembers.length} so far)` : `${groupMembers.length} picked`) color="ink.muted" font="-exact-footnote" testId="group-count"
                    column gap="space.xs"
                      for b in bots key=b.slug
                        button appearance="none" press=toggleGroupMember(b.slug) role="checkbox" aria-checked=groupMembers.includes(b.slug) aria-label=b.name testId=`pick-bot-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border=(groupMembers.includes(b.slug) ? "2px solid AccentColor" : "2px solid surface.line") border-radius="radius.md" background-color="surface.card" color="-exact-label"
                          row gap="space.md" align-items="center" width="100%"
                            Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=36, still=true, presence="")
                            text b.name font-weight=500 flex=1 min-width=0 text-align="left"
                            column width=24 height=24 align-items="center" justify-content="center" border-radius="radius.full" background-color=(groupMembers.includes(b.slug) ? "AccentColor" : "transparent") border=(groupMembers.includes(b.slug) ? "none" : "2px solid surface.line") color="ink.dark"
                              if groupMembers.includes(b.slug)
                                Glyph(name="check", size=14)
                  if groupError != "" and not pending(groupMade)
                    text groupError color="-exact-system-red" testId="group-error"
          else
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="new-form" position="absolute" inset=0
              header class=PageHeader
                button id="back" class=TextControl appearance="none" press=back testId="new-cancel"
                  text t("common.cancel")
                text "New Bot" role="heading" aria-level=1 class=PageTitle flex=1
                button buttonStyle="filled" press=create disabled=(newName.trim() == "" or pending(created)) testId="create"
                  text (pending(created) ? "Creating…" : "Get started")
              scroll id="new-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  column align-items="center" gap="space.md"
                    Avatar(shape=newShape, color=faceColor(newColor), state="idle", size=96, still=false, presence="")
                    row gap="space.xs" flex-wrap="wrap" justify-content="center"
                      for c in pickerColours() key=c
                        button class=SwatchControl press=pick(c) appearance="none" aria-label=`Colour ${faceColor(c)}` aria-pressed=(newColor == c) testId=`colour-${c}` width=36 height=36 padding=0
                          column width=26 height=26 box-sizing="border-box" margin="space.xs" border-radius="radius.full" background-color=c border=(newColor == c ? "3px solid AccentColor" : "3px solid transparent")
                    row gap="space.xs" flex-wrap="wrap" justify-content="center"
                      for s in shapeNames() key=s
                        button class=SwatchControl press=pickShape(s) appearance="none" aria-label=`Shape ${s}` aria-pressed=(newShape == s) testId=`shape-${s}` width=44 height=44 padding=0 border-radius="radius.md" background-color=(newShape == s ? "surface.raised" : "transparent")
                          Avatar(shape=s, color=faceColor(newColor), state="idle", size=30, still=true, presence="")
                  column gap="space.sm"
                    text "Name" font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=newName input=editName submit=create placeholder="What should we call your Bot?" aria-label="Name" padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-name"
                  if createError != "" and not pending(created)
                    text createError color="-exact-system-red" testId="create-error"
                  if suggestions.length > 0
                    column gap="space.sm"
                      text "Suggestions" font="-exact-subheadline" font-weight=600 color="ink.muted"
                      column gap="space.sm"
                        for s in suggestions key=s.name
                          button class=PanelRow appearance="none" press=useStart(s.name, s.color, s.shape, s.first) testId=`start-${s.name}`
                            Avatar(shape=s.shape, color=faceColor(s.color), state="idle", size=44, still=true, presence="")
                            column flex=1 gap="2px" min-width=0
                              text s.name font-weight=600
                              text s.about color="ink.muted" font="-exact-footnote"
      if toast != ""
        row position="absolute" bottom=88 left="50%" translate="-50% 0" padding="space.md space.lg" border-radius="radius.full" background-color="-exact-label" color="surface.canvas" max-width="90%" box-sizing="border-box" testId="toast" role="status" aria-live="polite"
          text toast font="-exact-subheadline" font-weight=500

// A Vault login's sheet. The password field starts empty: a saved password is shown only after Reveal.
component LoginSheet
  props
    route: number
    item: Login
    revealedFor: string
    revealedText: string
    error: string
    save: action
    reveal: action
    hide: action
    drop: action
    cancel: action
  state ttl = item.title
  state site = item.website
  state user = item.username
  state pass = ""
  state note = item.hints
  action editTitle(v: string)
    ttl = v
  action editWebsite(v: string)
    site = v
  action editUsername(v: string)
    user = v
  action editPassword(v: string)
    pass = v
  action editHints(v: string)
    note = v
  view
    column class=Screen navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
      header class=PageHeader justify-content="space-between"
        button press=cancel aria-label=t("common.cancel") testId="login-cancel"
          Glyph(name="close", size=20)
        text (item.id == "" ? "New login" : item.title) role="heading" aria-level=1
        button press=save(item.id, ttl, site, user, pass, note) disabled=(ttl.trim() == "" and site.trim() == "") buttonStyle="filled" aria-label="Save" testId="login-save"
          text "Save"
      list class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            text "Title"
            input appearance="none" class=Field value=ttl input=editTitle placeholder="Title" aria-label="Title" text-align="end" flex=1 min-width=0 testId="login-title"
          row
            text "Website"
            input appearance="none" class=Field type="url" value=site input=editWebsite placeholder="Website" aria-label="Website" autocapitalize="none" text-align="end" flex=1 min-width=0 testId="login-website"
          footer
            text "A login needs a website or a title."
        section
          row
            text "Username"
            input appearance="none" class=Field value=user input=editUsername placeholder="Username" aria-label="Username" autocapitalize="none" autocomplete="username" text-align="end" flex=1 min-width=0 testId="login-username"
          row
            text "Password"
            input appearance="none" class=Field type="password" value=pass input=editPassword placeholder=(item.hasPassword ? "New password (blank keeps it)" : "Password") aria-label="Password" autocomplete="new-password" text-align="end" flex=1 min-width=0 testId="login-password"
        section
          if item.hasPassword
            row
              text "Saved password"
              if revealedFor == item.id and revealedText != ""
                text revealedText user-select="text" testId="revealed-password"
              else
                text "••••••••" color="-exact-secondary-label" testId="hidden-password"
            row
              if revealedFor == item.id and revealedText != ""
                button press=hide buttonStyle="bordered" testId="hide-password"
                  text "Hide"
              else
                button press=reveal(item.id) buttonStyle="bordered" testId="reveal-password"
                  text "Reveal"
        section
          row
            text "Notes"
            input appearance="none" class=Field value=note input=editHints placeholder="Notes" aria-label="Notes" text-align="end" flex=1 min-width=0 testId="login-notes"
        if error != ""
          section
            text error color="-exact-system-red" testId="login-error"
        if item.id != ""
          section
            button commandfor="drop-login" command="show-modal" testId="login-delete"
              text "Delete login"
      dialog id="drop-login" role="alertdialog" aria-label="Delete this login?"
        text "It is removed from the Vault. This can’t be undone."
        button press=drop(item.id) destructive=true commandfor="drop-login" command="close" testId="drop-login-ok"
          text "Delete"
        button commandfor="drop-login" command="close" testId="drop-login-cancel"
          text t("common.cancel")

// ---------- the Bot panel ----------

// A row that opens a page: a title line, the value, and a chevron.
style PanelRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  padding="space.md"
  border="1px solid surface.line"
  border-radius="radius.md"
  background-color="surface.card"
  color="-exact-label"
  text-align="left"
  :hover
    background-color="surface.raised"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A choice in a list: a model, a shape.
style ChoiceRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  min-height=40
  padding="space.xs space.md"
  border="none"
  border-radius="radius.md"
  color="-exact-label"
  font="-exact-subheadline"
  text-align="left"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// The Bot's right panel: its Face and name, then three tabs, and pages for its model, its usage and editing it.
// The details beside a group, as a Bot has: who is in it, and its name, look and members.
component GroupPanel
  props
    shown: bool
    wide: bool
    page: string
    room: Room
    bots: Bot[]
    closePanel: action
    openEdit: action
    goRoot: action
    patch: action
    toggleMember: action
    drop: action
    error: string
  state title = room.title
  state about = room.description
  derive picked = room.members.map(m => m.slug)
  action editTitle(v: string)
    title = v
  action editAbout(v: string)
    about = v
  view
    column id="group-panel" display=(shown ? "flex" : "none") position="absolute" top=(wide ? 0 : 72) right=0 bottom=0 width=(wide ? "20rem" : "100%") box-sizing="border-box" background-color="surface.canvas" border-left="1px solid surface.line" testId="group-panel"
      row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
        if page == "edit"
          button class=IconControl appearance="none" press=goRoot aria-label="Back" title="Back" testId="group-panel-back"
            column rotate="180deg"
              Glyph(name="chevron", size=20)
          text "Edit group" role="heading" aria-level=2 class=PageTitle flex=1 testId="group-panel-title"
        else
          column flex=1
          button class=IconControl appearance="none" press=openEdit aria-label="Edit group" title="Edit group" testId="group-edit"
            Glyph(name="settings", size=20)
          button class=IconControl appearance="none" press=closePanel aria-label="Close panel" title="Close panel" testId="group-panel-close"
            Glyph(name="close", size=20)
      if page == "edit"
        scroll flex=1 min-height=0
          column gap="space.lg" padding="space.sm space.lg space.xl" testId="group-edit-page"
            column gap="space.sm"
              text "Name" class=SectionLabel
              input appearance="none" class=Field value=title input=editTitle change=patch("title") aria-label="Group name" padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-edit-name"
            column gap="space.sm"
              text "Description" class=SectionLabel
              input appearance="none" class=Field value=about input=editAbout change=patch("description") placeholder="What the group works on" aria-label="Description" padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-edit-about"
            column gap="space.sm"
              text "Colour" class=SectionLabel
              row gap="space.xs" flex-wrap="wrap"
                for c in pickerColours() key=c
                  button class=SwatchControl press=patch("color", c) appearance="none" aria-label=`Colour ${faceColor(c)}` aria-pressed=(room.color == c) testId=`group-edit-colour-${c}` width=40 height=40 padding=0
                    column width=30 height=30 box-sizing="border-box" border-radius="radius.full" background-color=c border=(room.color == c ? "3px solid AccentColor" : "3px solid transparent")
            column gap="space.sm"
              text "Shape" class=SectionLabel
              row gap="space.xs" flex-wrap="wrap"
                for s in shapeNames() key=s
                  button class=SwatchControl press=patch("shape", s) appearance="none" aria-label=`Shape ${s}` aria-pressed=(room.shape == s) testId=`group-edit-shape-${s}` width=48 height=48 padding=0 border-radius="radius.md" background-color=(room.shape == s ? "surface.raised" : "transparent")
                    Avatar(shape=s, color=faceColor(room.color), state="idle", size=34, still=true, presence="")
            column gap="space.sm"
              text "Bots" class=SectionLabel
              for b in bots key=b.slug
                button appearance="none" press=toggleMember(b.slug) role="checkbox" aria-checked=picked.includes(b.slug) aria-label=b.name testId=`group-edit-member-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border=(picked.includes(b.slug) ? "2px solid AccentColor" : "2px solid surface.line") border-radius="radius.md" background-color="surface.card" color="-exact-label"
                  row gap="space.md" align-items="center" width="100%"
                    Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=32, still=true, presence="")
                    text b.name font-weight=500 flex=1 min-width=0 text-align="left"
                    if picked.includes(b.slug)
                      column color="AccentColor"
                        Glyph(name="check", size=18)
            if error != ""
              text error color="-exact-system-red" testId="group-error-panel"
            row align-items="center" gap="space.md" min-height=56 padding="0 space.md" border-top="1px solid surface.line"
              column class=IconTile color="-exact-system-red"
                Glyph(name="trash", size=18)
              column flex=1 gap="2px"
                text "Delete group" font-weight=600 color="-exact-system-red"
                text "Removes the group. The Bots and their chats stay." color="ink.muted" font="-exact-footnote"
              button class=IconControl appearance="none" commandfor="drop-group" command="show-modal" aria-label="Delete group" title="Delete group" color="-exact-system-red" testId="group-delete"
                Glyph(name="trash", size=20)
            dialog id="drop-group" role="alertdialog" aria-label=`Delete ${room.title}?`
              text "The group and what was said in it are removed. The Bots and their own chats stay."
              button press=drop destructive=true commandfor="drop-group" command="close" testId="group-delete-ok"
                text "Delete"
              button commandfor="drop-group" command="close" testId="group-delete-cancel"
                text t("common.cancel")
      else
        scroll flex=1 min-height=0
          column gap="space.lg" padding="0 space.lg space.xl"
            column align-items="center" gap="space.xs"
              Face(shape=room.shape, color=faceColor(room.color), state=(room.members.filter(m => m.working).length > 0 ? "working" : "idle"), size=72, still=(room.members.filter(m => m.working).length == 0))
              text room.title font="-exact-title3" font-weight=700 letter-spacing="-0.3px" text-align="center" overflow-wrap="anywhere" testId="group-details-name"
              text (room.description != "" ? room.description : "No description yet") color="ink.muted" font="-exact-footnote" text-align="center" testId="group-details-about"
            column gap="2px"
              text `Bots, ${room.members.length}` class=SectionLabel testId="group-members-label"
              for m in room.members key=m.slug
                link class=ConversationLink href=path("chat", m.slug) testId=`group-member-${m.slug}` padding="space.sm space.md"
                  row gap="space.md" align-items="center"
                    Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state=m.state, size=40, still=(m.state != "working"), presence="")
                    column gap="2px" flex=1 min-width=0
                      text m.name font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                      text m.line color="ink.muted" font="-exact-footnote"
            text "Write @name to wake one Bot. A message with no @name goes to whoever spoke last." color="ink.muted" font="-exact-footnote" padding="0 space.md" testId="group-details-hint"

component BotPanel
  props
    working: bool
    shown: bool
    tab: string
    page: string
    pickTab: action
    openPage: action
    closePanel: action
    openChild: action
    wide: bool
    bot: Bot
    error: string
    rename: action
    recolour: action
    reshape: action
    pin: action
    hide: action
    makeMain: action
    drop: action
    models: ModelList
    modelsDown: bool
    pickModel: action
    makeDefault: action
    isDefault: bool
    modelError: string
    routines: RoutineList
    routinesDown: bool
    lineage: Lineage
    lineageDown: bool
    report: UsageReport
    reportDown: bool
    period: string
    usageView: string
    pickPeriod: action
    pickView: action
    retryDetails: action
    shelf: Shelf
    shelfDown: bool
    computer: Computer
    computerDown: bool
    heldTab: string
    controlError: string
    take: action
    release: action
  action tabKey(k: string, event: KeyboardEvent)
    if not event.isComposing and (k == "ArrowRight" or k == "ArrowLeft" or k == "Home" or k == "End")
      preventDefault()
      let next = k == "Home" ? "details" : k == "End" ? "computer" : k == "ArrowRight" ? (tab == "details" ? "library" : tab == "library" ? "computer" : "details") : (tab == "details" ? "computer" : tab == "computer" ? "library" : "details")
      pickTab(next)
      focus(`panel-tab-${next}`)
  action goRoot
    openPage("root")
  action goModel
    openPage("model")
  action goUsage
    openPage("usage")
  action goEdit
    openPage("edit")
  view
    column id="bot-panel" display=(shown ? "flex" : "none") position="absolute" top=(wide ? 0 : 72) right=0 bottom=0 width=(wide ? "20rem" : "100%") box-sizing="border-box" background-color="surface.canvas" border-left="1px solid surface.line" testId="bot-panel"
      row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
        if page != "root"
          button class=IconControl appearance="none" press=goRoot aria-label="Back" title="Back" testId="panel-back"
            column rotate="180deg"
              Glyph(name="chevron", size=20)
          text (page == "model" ? "Model" : page == "usage" ? "Usage" : "Edit Bot") role="heading" aria-level=2 class=PageTitle flex=1 testId="panel-page-title"
        else
          column flex=1
          button class=IconControl appearance="none" press=goEdit aria-label="Edit Bot" title="Edit Bot" testId="panel-edit"
            Glyph(name="settings", size=20)
          button class=IconControl appearance="none" press=closePanel aria-label="Close panel" title="Close panel" testId="panel-close"
            Glyph(name="close", size=20)
      if page == "model"
        scroll flex=1 min-height=0
          ModelPage(models=models, down=modelsDown, bot=bot, pick=pickModel, makeDefault=makeDefault, isDefault=isDefault, error=modelError)
      else if page == "usage"
        scroll flex=1 min-height=0
          UsageView(report=report, down=reportDown, period=period, view=usageView, pickPeriod=pickPeriod, pickView=pickView, showBots=false)
      else if page == "edit"
        scroll flex=1 min-height=0
          EditBotPage(bot=bot, error=error, rename=rename, recolour=recolour, reshape=reshape, pin=pin, hide=hide, makeMain=makeMain, drop=drop)
      else
        column align-items="center" gap="space.xs" padding="0 space.lg space.md"
          Avatar(shape=bot.shape, color=faceColor(bot.color), state=(bot.hidden ? "asleep" : working ? "working" : "idle"), size=72, still=(not working), presence="")
          text bot.name font="-exact-title3" font-weight=700 letter-spacing="-0.3px" testId="details-name" text-align="center" overflow-wrap="anywhere"
          text (bot.hidden ? "Hidden from your inbox" : working ? "Working" : bot.ready ? "Ready" : "Getting set up…") color="ink.muted" font="-exact-footnote" testId="details-status"
        row role="tablist" appearance="none" background-color="surface.canvas" aria-label="Bot sidebar" justify-content="center" padding="space.xs space.md space.md" gap="space.xs"
          for t in ["details", "library", "computer"] key=t
            button id=`panel-tab-${t}` key=tabKey tabindex=(tab == t ? 0 : -1) class=Segment appearance="none" role="tab" aria-selected=(tab == t) aria-controls=`bot-tab-${t}` press=pickTab(t) min-height=36 padding="space.xs space.md" testId=`panel-tab-${t}` background-color=(tab == t ? "surface.raised" : "transparent") color=(tab == t ? "-exact-label" : "ink.muted")
              text (t == "details" ? "Details" : t == "library" ? "Library" : "Computer") font="-exact-subheadline"
        column id="bot-tab-details" role="tabpanel" aria-label="Details" display=(tab == "details" ? "flex" : "none") flex=1 min-height=0
          scroll id=`panel-${bot.slug}` flex=1 min-height=0
            column width="100%" box-sizing="border-box" padding="0 space.lg space.xl" gap="space.sm"
              if modelsDown
                text "Can’t load the model. Check that hbots is running, then try again." color="-exact-system-red" testId="model-error"
              else
                button class=PanelRow appearance="none" press=goModel testId="model-row" aria-label=`Model: ${models.currentName}`
                  column class=IconTile color="AccentColor"
                    text (models.providerName != "" ? models.providerName.slice(0, 1) : "?") font-weight=700
                  column flex=1 gap="2px" min-width=0
                    text (models.currentName != "" ? models.currentName : "Choosing a model…") font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="model-name"
                    text (models.effortLabel != "" ? `${models.providerName}, ${models.effortLabel}` : models.providerName) color="ink.muted" font="-exact-footnote"
                  column color="ink.muted"
                    Glyph(name="chevron", size=18)
              button class=PanelRow appearance="none" press=goUsage testId="usage-card" aria-label="Usage"
                column flex=1 gap="space.xs" min-width=0
                  row gap="space.sm" align-items="baseline"
                    text `Usage, ${report.periodLabel != "" ? report.periodLabel : "7 days"}` color="ink.muted" font="-exact-footnote" flex=1
                  if reportDown
                    text "Can’t load usage." color="-exact-system-red" font="-exact-footnote"
                  else
                    text `${report.tokens} tokens` font="-exact-headline" font-weight=600 testId="usage-tokens"
                    row gap="3px" align-items="flex-end" height=30
                      for d in report.days key=d.day
                        column flex=1 height=d.spx border-radius="2px" background-color="brand.default"
                column color="ink.muted"
                  Glyph(name="chevron", size=18)
              text "Routines" class=SectionLabel
              if routinesDown
                text "Can’t load routines. Check that hbots is running, then try again." color="-exact-system-red" padding="0 space.md" testId="routine-error"
              else if routines.tasks.length == 0
                text `Ask ${bot.name} in chat to set one up, like “every weekday at 8”.` color="ink.muted" font="-exact-footnote" padding="0 space.md" testId="routine-empty"
              else
                column gap="2px"
                  for r in routines.tasks key=r.id
                    row gap="space.md" align-items="center" padding="space.sm space.md" testId=`routine-${r.id}`
                      column color=(r.paused ? "ink.faint" : "AccentColor")
                        Glyph(name=(r.paused ? "pause" : "clock"), size=18)
                      column flex=1 gap="2px" min-width=0
                        text r.title font-weight=500 overflow-wrap="anywhere"
                        text r.schedule color="ink.muted" font="-exact-footnote"
                        if r.next != "" and not r.paused
                          text r.next color="ink.faint" font="-exact-footnote"
                        if r.failed
                          text "Last run failed" color="-exact-system-red" font="-exact-footnote"
                      if r.paused
                        text "Paused" color="ink.faint" font="-exact-footnote"
              if routines.error != "" and routines.tasks.length == 0
                text routines.error color="ink.muted" font="-exact-footnote" padding="0 space.md" testId="routine-setup"
              text "Working on" class=SectionLabel
              if lineageDown
                text "Can’t load what this Bot is doing. Check that hbots is running, then try again." color="-exact-system-red" padding="0 space.md" testId="lineage-error"
              else if lineage.rows.length == 0
                text "No other threads yet." color="ink.muted" font="-exact-footnote" padding="0 space.md" testId="lineage-empty"
              else
                column gap="2px"
                  for line in lineage.rows key=line.id
                    row align-items="center" gap="space.md" padding="space.sm space.md" testId=`line-${line.id}`
                      column color="ink.faint"
                        Glyph(name="chevron", size=14)
                      column flex=1 gap="2px" min-width=0
                        text line.title font-weight=500 overflow-wrap="anywhere"
                        text (line.remote ? "On another machine" : line.threadId != "" ? "On this machine" : "") color="ink.muted" font="-exact-footnote" testId=`where-${line.id}`
                      if not line.remote and line.threadId != ""
                        button class=TextControl appearance="none" press=openChild(line.threadId) min-height=28 padding="0 space.sm" font="-exact-footnote" color="AccentColor" testId=`open-${line.id}`
                          text "Open"
                      row class=Chip
                        text line.status
        column id="bot-tab-library" role="tabpanel" aria-label="Library" display=(tab == "library" ? "flex" : "none") flex=1 min-height=0
          scroll id="panel-library-scroll" flex=1 min-height=0
            BotShelf(shelf=shelf, down=shelfDown, name=bot.name)
        column id="bot-tab-computer" role="tabpanel" aria-label="Computer" display=(tab == "computer" ? "flex" : "none") flex=1 min-height=0
          scroll id="panel-computer-scroll" flex=1 min-height=0
            ScreenCard(name=bot.name, computer=computer, down=computerDown, heldTab=heldTab, controlError=controlError, take=take, release=release)

// Pick the provider, the model and how hard it thinks. Each choice applies to the Bot's next message.
// Provider, model and effort as one picker. The Bot's panel and Settings both use it.
component ModelPicker
  props
    providers: Provider[]
    instanceId: string
    model: string
    effort: string
    efforts: Effort[]
    prefix: string
    pick: action
  state viewing = ""
  action showProvider(id: string)
    viewing = id
  derive shownProvider = viewing != "" ? viewing : instanceId
  view
    column gap="space.md" testId=`${prefix}-picker`
      if providers.length > 1
        row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label="Provider"
          for p in providers key=p.instanceId
            button class=Segment appearance="none" role="radio" aria-checked=(shownProvider == p.instanceId) press=showProvider(p.instanceId) testId=`provider-${p.instanceId}` border="1px solid surface.line" background-color=(shownProvider == p.instanceId ? "surface.raised" : "transparent")
              text p.name
      for p in providers.filter(x => x.instanceId == shownProvider and x.account != "") key=p.instanceId
        text p.account color="ink.muted" font="-exact-footnote" padding="0 space.xs"
      column gap="2px" role="radiogroup" aria-label="Model"
        for p in providers.filter(x => x.instanceId == shownProvider) key=p.instanceId
          for m in p.models key=m.slug
            button class=ChoiceRow appearance="none" role="radio" aria-checked=(instanceId == p.instanceId and model == m.slug) press=pick(p.instanceId, m.slug, "") testId=`${prefix}-${m.slug}` background-color=(instanceId == p.instanceId and model == m.slug ? "surface.raised" : "transparent")
              text m.name font-weight=500 flex=1 min-width=0
              if m.recommended
                text "Recommended" color="ink.faint" font="-exact-footnote"
              if instanceId == p.instanceId and model == m.slug
                column color="AccentColor"
                  Glyph(name="check", size=16)
      if efforts.length > 0
        row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label="Effort"
          for e in efforts key=e.id
            button class=Segment appearance="none" role="radio" aria-checked=(effort == e.id) press=pick(instanceId, model, e.id) testId=`effort-${e.id}` border="1px solid surface.line" background-color=(effort == e.id ? "AccentColor" : "transparent") color=(effort == e.id ? "AccentColorText" : "-exact-label")
              text e.label

component ModelPage
  props
    models: ModelList
    down: bool
    bot: Bot
    pick: action
    makeDefault: action
    isDefault: bool
    error: string
  action choose(i: string, m: string, e: string)
    pick(bot.slug, i, m, e)
  view
    column gap="space.lg" padding="space.sm space.lg space.xl" testId="model-page"
      if down
        text "Can’t load providers. Check that hbots and T3 Code are running, then try again." color="-exact-system-red" testId="provider-error"
      else if models.providers.length == 0
        text "No provider is ready in T3 Code yet. Set one up there, then come back." color="ink.muted" testId="provider-none"
      else
        ModelPicker(providers=models.providers, instanceId=models.instanceId, model=models.current, effort=models.effort, efforts=models.efforts, prefix="model", pick=choose)
        text `Applies to ${bot.name}’s next message.` color="ink.muted" font="-exact-footnote" padding="0 space.xs"
        row align-items="center" gap="space.md" padding="space.xs 0" border-top="1px solid surface.line"
          column flex=1 gap="2px"
            text "Use for new Bots" font-weight=500 font="-exact-subheadline"
            text "New Bots start with this model." color="ink.muted" font="-exact-footnote"
          button class=ToggleControl appearance="none" role="switch" aria-checked=isDefault press=makeDefault(models.instanceId, models.current, models.effort) aria-label="Use for new Bots" testId="default-model"
            row width=36 height=22 border-radius="radius.full" background-color=(isDefault ? "AccentColor" : "surface.line") align-items="center" justify-content=(isDefault ? "flex-end" : "flex-start")
              column width=16 height=16 margin="0 3px" border-radius="radius.full" background-color="ink.light"
        if error != ""
          text error color="-exact-system-red" font="-exact-footnote" testId="model-save-error"

// One report of what a Bot (or every Bot) used: a period, a summary or a detail, always with the figures as a table.
component UsageView
  props
    report: UsageReport
    down: bool
    period: string
    view: string
    pickPeriod: action
    pickView: action
    showBots: bool
  view
    column gap="space.lg" padding="space.sm space.lg space.xl" testId="usage-view"
      row gap="space.xs" role="radiogroup" aria-label="Period"
        for p in ["today", "7d", "30d", "all"] key=p
          button class=Segment appearance="none" role="radio" aria-checked=(period == p) press=pickPeriod(p) testId=`period-${p}` border="1px solid surface.line" min-height=32 flex=1 min-width=0 padding="2px space.xs" font="-exact-footnote" white-space="nowrap" box-sizing="border-box"
            background-color=(period == p ? "surface.raised" : "transparent")
            text (p == "today" ? "Today" : p == "7d" ? "7 days" : p == "30d" ? "30 days" : "All time")
      row gap="space.xs" role="radiogroup" aria-label="View"
        for v in ["summary", "detail"] key=v
          button class=Segment appearance="none" role="radio" aria-checked=(view == v) press=pickView(v) testId=`view-${v}` min-height=28 font="-exact-footnote" padding="2px space.md"
            background-color=(view == v ? "surface.raised" : "transparent")
            color=(view == v ? "-exact-label" : "ink.muted")
            text (v == "summary" ? "Summary" : "Detail")
      if down or not report.ok
        text (report.error != "" ? report.error : "Can’t load usage. Check that hbots is running, then try again.") color="-exact-system-red" testId="usage-error"
      else if report.empty
        text "Nothing counted in this period." color="ink.muted" testId="usage-empty"
      else
        row gap="space.lg"
          column gap="2px" flex=1
            text report.tokens font="-exact-headline" font-weight=700 testId="figure-tokens"
            text "tokens" color="ink.muted" font="-exact-footnote"
          column gap="2px" flex=1
            text report.messages font="-exact-headline" font-weight=700 testId="figure-messages"
            text "messages" color="ink.muted" font="-exact-footnote"
          column gap="2px" flex=1
            text report.turns font="-exact-headline" font-weight=700 testId="figure-turns"
            text "turns" color="ink.muted" font="-exact-footnote"
        column gap="space.xs"
          row gap="4px" align-items="flex-end" width="100%" height=72 role="img" aria-label=`Tokens per day, ${report.first} to ${report.last}`
            for d in report.days key=d.day
              column flex=1 min-width=0 height=d.px border-radius="3px" background-color="brand.default"
          row justify-content="space-between"
            text report.first color="ink.faint" font="-exact-footnote"
            text report.last color="ink.faint" font="-exact-footnote"
        if report.sentence != ""
          text report.sentence color="ink.muted" font="-exact-footnote"
        if view == "detail"
          column gap="space.sm" testId="usage-detail"
            text "By day" class=SectionLabel
            column gap="2px"
              for d in report.rows key=d.day
                row gap="space.md" align-items="center" padding="space.xs space.md"
                  column flex=1 gap="2px" min-width=0
                    text d.label font-weight=500
                    text `${d.input} in, ${d.output} out, ${d.cached} cached` color="ink.muted" font="-exact-footnote"
                  column align-items="flex-end" gap="2px"
                    text d.tokens font-weight=600
                    text `${d.messages} msg` color="ink.faint" font="-exact-footnote"
            text "By model" class=SectionLabel
            column gap="space.sm" padding="0 space.md"
              for m in report.models key=m.name
                column gap="space.xs"
                  row gap="space.md" align-items="baseline"
                    text m.name font-weight=500 flex=1 min-width=0
                    text `${m.tokens}, ${m.turns} turns` color="ink.muted" font="-exact-footnote"
                  row height=6 border-radius="3px" background-color="surface.line"
                    column width=`${m.share}%` height=6 border-radius="3px" background-color="brand.default"
            if showBots
              text "By Bot" class=SectionLabel
              column gap="space.sm" padding="0 space.md"
                for b in report.bots key=b.slug
                  column gap="space.xs"
                    row gap="space.md" align-items="center"
                      Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=22, still=true, presence="")
                      text b.name font-weight=500 flex=1 min-width=0
                      text `${b.tokens}, ${b.messages} msg` color="ink.muted" font="-exact-footnote"
                    row height=6 border-radius="3px" background-color="surface.line"
                      column width=`${b.share}%` height=6 border-radius="3px" background-color="brand.default"
            text "Totals" class=SectionLabel
            column gap="2px" padding="0 space.md"
              row justify-content="space-between"
                text "Input" color="ink.muted"
                text report.input
              row justify-content="space-between"
                text "Output" color="ink.muted"
                text report.output
              row justify-content="space-between"
                text "Read from cache" color="ink.muted"
                text report.cached
              row justify-content="space-between"
                text "Written to cache" color="ink.muted"
                text report.cacheWrite
              row justify-content="space-between"
                text "Attachments" color="ink.muted"
                text report.attachments

// What a Bot has kept, to look at: pictures, files and links. Nothing here can be changed.
component BotShelf
  props
    shelf: Shelf
    down: bool
    name: string
  view
    column gap="space.lg" padding="0 space.lg space.xl" testId="shelf"
      if down or not shelf.ok
        text "Can’t open this library. Check that hbots is running, then try again." color="-exact-system-red" testId="library-error"
      else if shelf.total == 0
        text `Files, pictures and links shared with ${name} show up here.` color="ink.muted" testId="library-status"
      else
        text (shelf.total == 1 ? `1 thing with ${name}.` : `${shelf.total} things with ${name}.`) color="ink.muted" testId="library-count"
        if shelf.pictures.length > 0
          column gap="space.sm"
            text "Pictures" class=SectionLabel
            row gap="space.xs" flex-wrap="wrap"
              for p in shelf.pictures key=p.id
                link href=p.url target="_blank" aria-label=`Open ${p.title}` testId=`picture-${p.id}`
                  image p.url aria-label=p.title width=88 height=88 border-radius="radius.md" object-fit="cover"
        if shelf.files.length > 0
          column gap="space.sm"
            text "Files" class=SectionLabel
            column gap="space.xs"
              for f in shelf.files key=f.id
                link class=FileCard href=f.url target="_blank" aria-label=`Open ${f.title}` testId=`shelf-file-${f.id}` min-width=0
                  row gap="space.md" align-items="center"
                    column class=IconTile color="AccentColor"
                      Glyph(name="file", size=18)
                    column gap="2px" flex=1 min-width=0
                      text f.title font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                      text f.detail color="ink.muted" font="-exact-footnote" overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
        if shelf.links.length > 0
          column gap="space.sm"
            text "Links" class=SectionLabel
            column gap="space.xs"
              for l in shelf.links key=l.id
                link class=FileCard href=l.url target="_blank" aria-label=`Open ${l.title}` testId=`shelf-link-${l.id}` min-width=0
                  row gap="space.md" align-items="center"
                    column class=IconTile color="AccentColor"
                      Glyph(name="globe", size=18)
                    column gap="2px" flex=1 min-width=0
                      text l.title font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                      text l.detail color="ink.muted" font="-exact-footnote" overflow="hidden" text-overflow="ellipsis" white-space="nowrap"

// The page a Bot has open, as a picture. Watching changes nothing; taking control is a second step.
component ScreenCard
  props
    name: string
    computer: Computer
    down: bool
    heldTab: string
    controlError: string
    take: action
    release: action
  view
    column gap="space.md" padding="0 space.lg space.xl" testId="screen"
      if down or not computer.ok
        text "Can’t open this Bot’s browser. Check that hbots is running, then try again." color="-exact-system-red" testId="computer-error"
      else if computer.tabs.length == 0
        column align-items="center" gap="space.sm" padding="space.xl 0"
          column color="ink.faint"
            Glyph(name="monitor", size=32)
          text `${name} has not opened a page.` color="ink.muted" text-align="center" testId="computer-status"
      else
        column border-radius="radius.md" overflow="hidden" border="1px solid surface.line" background-color="surface.card"
          if computer.image != ""
            image `data:image/jpeg;base64,${computer.image}` aria-label=`Page open for ${name}` width="100%" testId="computer-frame"
          else
            column align-items="center" justify-content="center" height=140 color="ink.faint"
              Glyph(name="monitor", size=28)
        for t in computer.tabs.slice(0, 1) key=t.id
          column gap="space.xs" align-items="center"
            text `${name}’s screen` color="ink.muted" testId="computer-status"
            text t.title font-weight=500 text-align="center" overflow-wrap="anywhere"
          if heldTab == t.id
            button class=PrimaryButton buttonStyle="filled" press=release testId="computer-release"
              text "Release"
          else
            button class=PrimaryButton buttonStyle="bordered" press=take(t.id) testId="computer-take"
              text "Take control"
        if heldTab != ""
          text "You have this page. Release it so the Bot can use it again." color="ink.muted" font="-exact-footnote" text-align="center"
        else
          text "Watching changes nothing. Take control to type or click yourself." color="ink.muted" font="-exact-footnote" text-align="center"
        if controlError != ""
          text controlError color="-exact-system-red" testId="computer-error"

// Everything about a Bot that is not what it is doing: its name, colour and shape, and where it sits.
component EditBotPage
  props
    bot: Bot
    error: string
    rename: action
    recolour: action
    reshape: action
    pin: action
    hide: action
    makeMain: action
    drop: action
  state name = bot.name
  action editName(v: string)
    name = v
  view
    column gap="space.lg" padding="space.sm space.lg space.xl" testId="edit-page"
      column gap="space.sm"
        text "Name" class=SectionLabel
        input appearance="none" class=Field value=name input=editName change=rename(bot.slug) aria-label="Name" padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="bot-name"
      column gap="space.sm"
        text "Colour" class=SectionLabel
        row gap="space.xs" flex-wrap="wrap"
          for c in pickerColours() key=c
            button class=SwatchControl press=recolour(bot.slug, c) appearance="none" aria-label=`Colour ${faceColor(c)}` aria-pressed=(bot.color == c) testId=`colour-${c}` width=40 height=40 padding=0
              column width=30 height=30 box-sizing="border-box" border-radius="radius.full" background-color=c border=(bot.color == c ? "3px solid AccentColor" : "3px solid transparent")
      column gap="space.sm"
        text "Shape" class=SectionLabel
        row gap="space.xs" flex-wrap="wrap"
          for s in shapeNames() key=s
            button class=SwatchControl press=reshape(bot.slug, s) appearance="none" aria-label=`Shape ${s}` aria-pressed=(bot.shape == s) testId=`shape-${s}` width=48 height=48 padding=0 border-radius="radius.md" background-color=(bot.shape == s ? "surface.raised" : "transparent")
              Avatar(shape=s, color=faceColor(bot.color), state="idle", size=34, still=true, presence="")
      column gap="2px"
        row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
          column class=IconTile color="AccentColor"
            Glyph(name="pin", size=18)
          column flex=1 gap="2px"
            text "Pin to the top" font-weight=600
            text "Shows as a tile above the list." color="ink.muted" font="-exact-footnote"
          button class=ToggleControl appearance="none" role="switch" aria-checked=bot.pinned disabled=bot.main press=pin(bot.slug, not bot.pinned) aria-label="Pin to the top" testId="pin-bot"
            row width=44 height=26 border-radius="radius.full" background-color=(bot.pinned or bot.main ? "AccentColor" : "surface.line") align-items="center" justify-content=(bot.pinned or bot.main ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
        row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
          column class=IconTile color="AccentColor"
            Glyph(name="star", size=18)
          column flex=1 gap="2px"
            text "Main Bot" font-weight=600
            text (bot.main ? "Your default Bot" : "Make this your default Bot") color="ink.muted" font="-exact-footnote"
          if bot.main
            column color="AccentColor" aria-label="Main Bot" testId="is-main"
              Glyph(name="check", size=20)
          else
            button class=IconControl appearance="none" press=makeMain(bot.slug) aria-label="Make main Bot" title="Make main Bot" testId="make-main"
              Glyph(name="star", size=20)
        row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
          column class=IconTile color="ink.muted"
            Glyph(name="eye-off", size=18)
          column flex=1 gap="2px"
            text "Hide from inbox" font-weight=600
            text "Keep this conversation tucked away." color="ink.muted" font="-exact-footnote"
          button class=ToggleControl appearance="none" role="switch" aria-checked=bot.hidden disabled=bot.main press=hide(bot.slug, not bot.hidden) aria-label="Hidden from the list" testId="hide-bot"
            row width=44 height=26 border-radius="radius.full" background-color=(bot.hidden ? "AccentColor" : "surface.line") align-items="center" justify-content=(bot.hidden ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
      if bot.main
        text "Your main Bot stays in the inbox. Choose another main Bot before hiding or deleting this one." color="ink.muted" font="-exact-footnote" padding="0 space.md"
      if error != ""
        text error color="-exact-system-red" testId="bot-error" padding="0 space.md"
      row align-items="center" gap="space.md" min-height=56 padding="0 space.md" border-top="1px solid surface.line"
        column class=IconTile color="-exact-system-red"
          Glyph(name="trash", size=18)
        column flex=1 gap="2px"
          text "Delete Bot" font-weight=600 color=(bot.main ? "ink.muted" : "-exact-system-red")
          text "Moves its folder to the trash." color="ink.muted" font="-exact-footnote"
        button class=IconControl appearance="none" commandfor=`drop-bot-${bot.slug}` command="show-modal" disabled=bot.main aria-label="Delete Bot" title="Delete Bot" color="-exact-system-red" testId="delete-bot"
          Glyph(name="trash", size=20)
      dialog id=`drop-bot-${bot.slug}` role="alertdialog" aria-label=`Delete ${bot.name}?`
        text "Its folder moves to the trash. This can’t be undone from here."
        button press=drop(bot.slug) destructive=true commandfor=`drop-bot-${bot.slug}` command="close" testId="drop-bot-ok"
          text "Delete"
        button commandfor=`drop-bot-${bot.slug}` command="close" testId="drop-bot-cancel"
          text t("common.cancel")
