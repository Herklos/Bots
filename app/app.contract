  members "./scroll/model.contract"
  members "./inbox/model.contract"
  members "./session/model.contract"
  members "./group/model.contract"
  members "./shell/model.contract"
  members "./usage/model.contract"
  derive vaultFailed = failed(vault)
  derive vaultPending = pending(vault)
  derive botsFailed = failed(bots)
  derive chatFailed = failed(chat)
  derive chatPending = pending(chat)
  derive answeredPending = pending(answered)
  derive attachedPending = pending(attached)
  derive voiceSentPending = pending(voiceSent)
  derive sentPending = pending(sent)
  derive modelsFailed = failed(models)
  derive routinesFailed = failed(routines)
  derive lineageFailed = failed(lineage)
  derive reportFailed = failed(report)
  derive shelfFailed = failed(shelf)
  derive computerFailed = failed(computer)
  derive subCreatedPending = pending(subCreated)
  derive createdPending = pending(created)
  derive subSavedPending = pending(subSaved)
  derive childModelsFailed = failed(childModels)
  derive signedInPending = pending(signedIn)
  derive roomSentPending = pending(roomSent)
  derive roomFailed = failed(room)
  derive groupMadePending = pending(groupMade)
  derive anytypeCheckedPending = pending(anytypeChecked)
  derive anytypePreparedPending = pending(anytypePrepared)
  derive networkRestartedPending = pending(networkRestarted)
  derive networkSetPending = pending(networkSet)
  derive noticeAskedPending = pending(noticeAsked)
  derive pairConfirmedPending = pending(pairConfirmed)
  derive pairStartedPending = pending(pairStarted)
  derive passwordSetPending = pending(passwordSet)
  derive spaceSavedPending = pending(spaceSaved)
  derive storageCopiedPending = pending(storageCopied)
  derive storageRestartedPending = pending(storageRestarted)
  derive storageSavedPending = pending(storageSaved)
  derive storageTestedPending = pending(storageTested)
  derive systemPending = pending(system)
  derive updateStartedPending = pending(updateStarted)
  provide
