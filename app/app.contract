use SettingsScreen from "./settings/screen.contract"
use NewGroupScreen from "./group/new.contract"
use CreateBotScreen from "./bot/create.contract"
use GroupScreen from "./group/screen.contract"
use ToastLine from "./shell/toast.contract"
use ComputerOverlay from "./computer/overlay.contract"
use LockScreen from "./session/lock.contract"
use ChatScreen from "./chat/screen.contract"
use Inbox from "./inbox/screen.contract"
use VaultScreen from "./vault/screen.contract"
use LoginSheet from "./settings/settings.contract"
use Login, Chat from "./ui/shapes.contract"
use SideList from "./ui/root-types.contract"
use Screen from "./ui/controls.contract"

routes nav
  inbox "/"
    chat "/bot/:slug"
    group "/group/:id"
    create "/new"
    newGroup "/new-group"
    settings "/settings"
      vault "/vault"
        vaultAdd "/vault/new"
        vaultEdit "/vault/:id"
component Bots
  members "./shell/held.contract"
  members "./computer/model.contract"
  members "./computer/preview.contract"
  members "./vault/model.contract"
  members "./settings/model.contract"
  members "./settings/mcp-model.contract"
  members "./bot/model.contract"
  members "./bot/memory-model.contract"
  members "./bot/helpers-model.contract"
  members "./mentions/model.contract"
  members "./chat/model.contract"
  members "./chat/side.contract"
  members "./voice/model.contract"
  members "./drafts/model.contract"
  members "./drafts/link.contract"
  members "./scroll/model.contract"
  members "./inbox/model.contract"
  members "./session/model.contract"
  members "./group/model.contract"
  members "./shell/model.contract"
  members "./usage/model.contract"
  members "./shell/flags.contract"
  members "./shell/bag-chat.contract"
  members "./shell/bag-settings.contract"
  members "./shell/bag-rest.contract"
  resource sideChat = loadChat(slug, sideThread, "side") as shape Chat else empty()
  resource sideList = loadSideChats(slug) as shape SideList else empty()
  provide
    copyMcpToken
    hideMcpToken
    toggleMcp
    createMcp
    revokeMcp
    open
    editVaultQuery
    login
    openSettings
    openHidden
    editBotQuery
    openSearch
    closeSearch
    toggleHidden
    openRowMenu
    closeRowMenu
    moveRow
    editBotFromRow
    editGroupFromRow
    retry
    openNewGroup
    doMuteGroup
    created
    createBack
    createNext
    create
    editName
    editFirst
    editNewPrompt
    pickShape
    useStart
    goCreateStep
    openNew
    doHide
    doMute
    doMain
    doPin
    pull
    togglePlus
    doPickModel
    doRefreshLimits
    toEnd
    moved
    editChatQuery
    toggleChatSearch
    edit
    editDraft
    composerCaret
    pickFiles
    filesPicked
    dropPending
    post
    composerKey
    acceptSlash
    cancelSideReply
    closeSide
    discardSideVoice
    dropSidePending
    editSide
    editSideAnswer
    mergeSideChat
    openSideChat
    parentAttachError
    parentRecording
    pickSideFiles
    pinSide
    postSide
    reactSide
    reopenSide
    retrySide
    sendSideVoice
    sidePasted
    sideAnswer
    sideBag
    sideCaret
    sideComposerKey
    sideHoldVoice
    sideOffer
    sideThread
    newestSide
    slashIdx
    slashOpen
    startSideReply
    stopSide
    startReply
    cancelReply
    doPinMessage
    doReact
    openReact
    openMessageMenu
    closeMessageMenu
    noteCopied
    copyPromptLink
    filesDropped
    editAnswer
    answer
    stop
    pasted
    openPage
    pickPeriod
    pickView
    back
    closeChild
    openChild
    mention
    completeMention
    holdVoice
    sendHeldVoice
    discardVoice
    togglePanel
    retryDetails
    pickPanelTab
    beginMemoryEdit
    editMemoryDraft
    cancelMemory
    saveMemory
    reloadMemory
    overwriteMemory
    memoryBag
    helperBag
    editHelpWhen
    editHelpCap
    writeHelpers
    retryHelpers
    pick
    doRename
    doSavePrompt
    doRecolour
    doDropBot
    openNewSub
    editSub
    editSubName
    editSubPrompt
    pickSubColor
    pickSubShape
    toggleSubInherit
    doCreateSub
    doSaveSub
    doDropChild
    doReshape
    doTake
    doRelease
    pickComputerTab
    doDrive
    doOpenBrowser
    doCloseBrowser
    showComputerLarge
    places
    placesFailed
    placeError
    doPickComputer
    editPassword
    largePageKey
    largePoint
    largeWheel
    largePaste
    hideComputerLarge
    addGroupMember
    closeGroupAdd
    dropGroup
    editRoomText
    groupBack
    openGroupAdd
    openGroupEdit
    patchGroup
    postRoom
    removeGroupMember
    roomKey
    toggleGroupPanel
    editGroupAbout
    editGroupName
    goGroupStep
    groupStepBack
    groupStepNext
    makeGroup
    pickGroupPolicy
    toggleGroupMember
    pickGroupChief
    doAllowNotices
    doAnytypeCheck
    doCopyStorage
    doDefaultMode
    doEditFolder
    doEditName
    doEditPairCode
    doEditSpace
    doGroupAnswer
    doMakeDefault
    doPairConfirm
    doPairStart
    doPickBackend
    doPickTheme
    doRestartNetwork
    doRestartStorage
    doSaveName
    doSavePassword
    doSaveSpace
    doSaveStorage
    doSetNetwork
    doStartUpdate
    doTestStorage
    editNewPassword
    logout
    pickSettingsDomain
    saveNoticePart
    saveNotifications
    doPrepareAnytype
    inboxBag
    chatBag
    groupBag
    settingsBag
    vaultBag
    newGroupBag
    createBotBag
    computerBag
    lockBag
    toastBag
  view
    main id="app-shell" class=Screen navigationKey=`${top(nav).id}` navigationBack="back" navigate=open beforeunload=writeDrafts interactive-widget="resizes-content" position="relative" width="100%" height="100%" testId="app"
      if locked
            LockScreen()
      else
        for e in stack(nav) key=e.id
          if e.name == "inbox"
            Inbox(route=e.id)
          else if e.name == "chat"
            ChatScreen(route=e.id, doSwitchLimit=doSwitchLimit)
          else if e.name == "group"
            GroupScreen(route=e.id)
          else if e.name == "settings"
            SettingsScreen(route=e.id)
          else if e.name == "vault"
            VaultScreen(route=e.id)
          else if e.name == "vaultAdd"
            LoginSheet(route=e.id, item=Login(id="", title="", website="", username="", hasPassword=false, hints="", icon=""), revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "vaultEdit"
            for l in vault.filter(x => x.id == e.params.id) key=l.id
              LoginSheet(route=e.id, item=l, revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "newGroup"
            NewGroupScreen(route=e.id)
          else
            CreateBotScreen(route=e.id)
      if computerEnlarged and not locked and onComputer and computer.image != ""
        ComputerOverlay(paneA=previewA, paneB=previewB, showA=previewShowA, paneLoadedA=previewLoadedA, paneLoadedB=previewLoadedB)
      if toast != ""
        ToastLine()
