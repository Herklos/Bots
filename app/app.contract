                      column class=GroupCard padding="0"
                        UsageView(report=report, down=failed(report), period=usagePeriod, view=usageView, pickPeriod=pickPeriod, pickView=pickView, showBots=true)
                      text t("settings.usageNote") class=SettingsFoot
                  else if settingsDomain == "notifications"
                    column
