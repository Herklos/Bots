                          column color="ink.muted"
                            Glyph(name="chevron", size=18)
                    column
                      text t("settings.remote") class=SectionLabel
                      column class=GroupCard padding="0"
                        row class=SettingsRow min-height=44
                          input appearance="none" class=Field type="password" value=newPassword input=editNewPassword submit=doSavePassword placeholder=(session.passwordRequired ? t("settings.newPassword") : t("settings.setPassword")) aria-label=t("common.password") autocomplete="new-password" flex=1 min-width=0 testId="new-password"
                          button appearance="none" press=doSavePassword disabled=(newPassword == "" or pending(passwordSet)) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color=(newPassword == "" ? "ink.muted" : "AccentColor") font="-exact-subheadline" font-weight=500 testId="save-password"
                            text (session.passwordRequired ? t("settings.change") : t("settings.set"))
                      text (session.passwordRequired ? t("settings.passwordOn") : t("settings.passwordOff")) class=SettingsFoot
                      if passwordError != "" and not pending(passwordSet)
                        text passwordError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="password-error"
                    column
                      text t("settings.network") class=SectionLabel
                      column class=GroupCard padding="space.sm"
                        row class=SettingsTrack role="radiogroup" aria-label=t("settings.network")
                          for mode in ["local", "lan", "tailscale"] key=mode
                            button class=SettingsTab appearance="none" role="radio" aria-checked=(network.mode == mode) press=doSetNetwork(mode) disabled=network.locked opacity=(network.locked and network.mode != mode ? 0.4 : 1) testId=`network-${mode}` background-color=(network.mode == mode ? "surface.card" : "transparent") color=(network.mode == mode ? "-exact-label" : "ink.muted")
                              text networkModeLabel(mode, t("settings.networkLocal"), t("settings.networkLan"), t("settings.networkTailscale"))
                      text (network.mode == "lan" ? t("settings.networkLanNote") : network.mode == "tailscale" ? t("settings.networkTailscaleNote") : t("settings.networkLocalNote")) class=SettingsFoot
                      if network.locked
                        text t("settings.networkManaged") class=SettingsFoot testId="network-managed"
                      if network.listening != ""
                        text t("settings.networkListening", address=network.listening) class=SettingsFoot testId="network-listening"
                      if network.urls != ""
                        text network.urls class=SettingsFoot testId="network-urls"
                      if network.http
                        text t("settings.networkHttp") class=SettingsFoot
                      if network.error != ""
                        text network.error color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="network-error"
                      if networkError != "" and not pending(networkSet)
                        text networkError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="network-save-error"
                      if pending(networkRestarted)
                        text t("settings.networkRestarting") class=SettingsFoot
                      else if network.restartRequired
                        row class=SettingsRow padding="space.xs space.md 0" min-height=44
                          text t("settings.networkRestart") color="ink.muted" font="-exact-footnote" flex=1 testId="network-restart-note"
                          if network.canRestart
                            button appearance="none" press=doRestartNetwork min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="network-restart"
                              text t("settings.networkRestartButton")
                      if networkRestartError != "" and not pending(networkRestarted)
                        text networkRestartError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0"
                    column
                      text t("settings.storage") class=SectionLabel
                      column class=GroupCard padding="space.sm" gap="space.sm"
                        text t("settings.storage.where") font="-exact-subheadline"
                        row class=SettingsTrack role="radiogroup" aria-label=t("settings.storage.where")
                          button class=SettingsTab appearance="none" role="radio" aria-checked=(storage.backend != "anytype") press=doSaveStorage disabled=(storage.backendLock != "") testId="storage-filesystem" background-color=(storage.backend != "anytype" ? "surface.card" : "transparent") color=(storage.backend != "anytype" ? "-exact-label" : "ink.muted")
                            text t("settings.storage.filesystem")
                          button class=SettingsTab appearance="none" role="radio" aria-checked=false disabled=true testId="storage-anytype" background-color="transparent" color="ink.muted"
                            text t("settings.storage.anytype")
                        text t("settings.storage.anytypeSoon") class=SettingsFoot testId="storage-anytype-note"
                        if storage.backendLock != ""
                          text t("settings.storage.locked", variable=storage.backendLock) class=SettingsFoot testId="storage-locked-backend"
                      text t("settings.storage.folder") class=SectionLabel
                      column class=GroupCard padding="0"
                        row class=SettingsRow min-height=44
                          input appearance="none" class=Field value=storagePath placeholder=t("settings.storage.defaultFolder") input=doEditFolder aria-label=t("settings.storage.folder") flex=1 min-width=0 disabled=(storage.rootLock != "") testId="storage-folder"
                          button appearance="none" press=doSaveStorage disabled=(storagePath == "" or (storage.rootLock != "" and storage.backendLock != "") or pending(storageSaved)) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="storage-save"
                            text t("settings.storage.save")
                      text t("settings.storage.folderNote") class=SettingsFoot
                      if storage.rootLock != ""
                        text t("settings.storage.locked", variable=storage.rootLock) class=SettingsFoot testId="storage-locked-folder"
                      row class=SettingsRow padding="space.xs space.md 0" min-height=44 gap="space.sm"
                        button appearance="none" press=doTestStorage disabled=(storagePath == "" or pending(storageTested)) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="storage-test"
                          text t("settings.storage.test")
                        button appearance="none" press=doCopyStorage disabled=(storagePath == "" or pending(storageCopied)) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="storage-copy"
                          text t("settings.storage.copy")
                      text t("settings.storage.copyNote") class=SettingsFoot
                      if storageHint == "test" and storageTestError == "" and not pending(storageTested)
                        text t("settings.storage.testOk") class=SettingsFoot testId="storage-test-ok"
                      if storageHint == "copy" and storageCopyError == "" and not pending(storageCopied)
                        text t("settings.storage.copyOk") class=SettingsFoot testId="storage-copy-ok"
                      if storage.error != ""
                        text storage.error color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="storage-error"
                      if storageSaveError != "" and not pending(storageSaved)
                        text storageSaveError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="storage-save-error"
                      if storageTestError != "" and not pending(storageTested)
                        text storageTestError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="storage-test-error"
                      if storageCopyError != "" and not pending(storageCopied)
                        text storageCopyError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="storage-copy-error"
                      if pending(storageRestarted)
                        text t("settings.storage.restarting") class=SettingsFoot
                      else if storage.restartRequired
                        row class=SettingsRow padding="space.xs space.md 0" min-height=44
