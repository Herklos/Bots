  view
    main id="app-shell" class=Screen navigationKey=`${top(nav).id}` navigationBack="back" navigate=open beforeunload=writeDrafts interactive-widget="resizes-content" position="relative" width="100%" height="100%" testId="app"
      if locked
            LockScreen()
      else
        for e in stack(nav) key=e.id
          if e.name == "inbox"
            Inbox(route=e.id)
          else if e.name == "chat"
            ChatScreen(route=e.id)
          else if e.name == "group"
            GroupScreen(route=e.id)
          else if e.name == "settings"
            column class=Screen navigationKey=`${e.id}` navigationScroll="settings-form" position="absolute" inset=0
              header class=PageHeader
                text t("settings.title") role="heading" aria-level=1 class=PageTitle flex=1
              column width="100%" max-width="40rem" align-self="center" box-sizing="border-box" padding="space.md space.lg space.sm"
                row class=SettingsTrack role="tablist" aria-label=t("settings.domains")
                  for d in ["user", "notifications", "models", "access", "updates"] key=d
                    button class=SettingsTab appearance="none" role="tab" aria-selected=(settingsDomain == d) press=pickSettingsDomain(d) testId=`settings-domain-${d}` background-color=(settingsDomain == d ? "surface.card" : "transparent") color=(settingsDomain == d ? "-exact-label" : "ink.muted")
                      text settingsDomainLabel(d, t("settings.domainUser"), t("settings.domainNotifications"), t("settings.domainModels"), t("settings.domainAccess"), t("settings.about"))
              scroll id="settings-form" flex=1 min-height=0
                column width="100%" max-width="40rem" align-self="center" box-sizing="border-box" margin="0 auto" padding="space.lg space.lg space.xl" gap="space.xl"
                  if settingsDomain == "user"
                    column
                      text t("settings.you") class=SectionLabel
                      row class=GroupCard gap="space.lg" align-items="center" padding="space.lg" min-height=44
                        column width=56 height=56 border-radius="radius.full" background-color="surface.raised" align-items="center" justify-content="center"
                          if initialsOf(prefs.userName) != ""
                            text initialsOf(prefs.userName) font="-exact-title3" font-weight=600
                          else
                            Glyph(name="person", size=24)
                        column flex=1 gap="2px" min-width=0
                          input appearance="none" class=Field value=(nameEditing ? nameDraft : prefs.userName) input=doEditName change=doSaveName placeholder=t("settings.yourName") aria-label=t("settings.yourName") font="-exact-headline" testId="user-name"
                          text botCountLabel(bots.length, t("bots.one"), t("bots.many", n=bots.length)) color="ink.muted" font="-exact-footnote"
                    column
                      text t("settings.appearance") class=SectionLabel
                      column class=GroupCard padding="space.md"
                        row gap="space.sm" role="radiogroup" aria-label=t("settings.theme")
                          for t in ["system", "light", "dark"] key=t
                            button press=doPickTheme(t) role="radio" aria-checked=(prefs.theme == t) appearance="none" flex=1 padding="space.sm" border-radius="radius.md" testId=`theme-${t}` border=(prefs.theme == t ? "2px solid AccentColor" : "2px solid transparent") background-color="surface.canvas"
                              column gap="space.xs" align-items="center"
                                row width="100%" height=44 border-radius="radius.sm" overflow="hidden" border="1px solid surface.line"
                                  column flex=1 background-color=(t == "dark" ? "#17171b" : "#fcfcfd")
                                  column flex=1 background-color=(t == "light" ? "#fcfcfd" : t == "dark" ? "#17171b" : "#17171b")
                                text themeLabel(t, t("theme.system"), t("theme.dark"), t("theme.light")) font="-exact-footnote" font-weight=500
                    column
                      text t("panel.usage") class=SectionLabel
                      column class=GroupCard padding="0"
                        UsageView(report=report, down=failed(report), period=usagePeriod, view=usageView, pickPeriod=pickPeriod, pickView=pickView, showBots=true)
                      text t("settings.usageNote") class=SettingsFoot
                  else if settingsDomain == "notifications"
                    column
                      text t("settings.notifications") class=SectionLabel
                      column class=GroupCard padding="0"
                        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box"
                          text noticeStatusLabel(notice.available, notice.state, t("settings.noticeAllowed"), t("settings.noticeDenied"), t("settings.noticeUnavailable"), t("settings.noticeAllow")) flex=1 font="-exact-subheadline" testId="notice-status"
                          if notice.available and notice.state != "granted"
                            button appearance="none" press=doAllowNotices disabled=pending(noticeAsked) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="notice-allow"
                              text t("settings.noticeAllow")
                        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line"
                          text t("settings.noticeNew") flex=1 font="-exact-subheadline"
                          button class=ToggleControl appearance="none" role="switch" aria-checked=noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state) press=saveNotifications(not noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state), prefs.noticeSound, prefs.noticePreview, prefs.noticeWhen) aria-label=t("settings.noticeNew") testId="notice-enabled"
                            row width=44 height=26 border-radius="radius.full" background-color=(noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state) ? "AccentColor" : "surface.line") align-items="center" justify-content=(noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state) ? "flex-end" : "flex-start")
                              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
                        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line"
                          text t("settings.noticeSound") flex=1 font="-exact-subheadline"
                          button class=ToggleControl appearance="none" role="switch" aria-checked=prefs.noticeSound press=saveNoticePart(not prefs.noticeSound, prefs.noticePreview, prefs.noticeWhen) aria-label=t("settings.noticeSound") testId="notice-sound"
                            row width=44 height=26 border-radius="radius.full" background-color=(prefs.noticeSound ? "AccentColor" : "surface.line") align-items="center" justify-content=(prefs.noticeSound ? "flex-end" : "flex-start")
                              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
                        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line"
                          text t("settings.noticePreview") flex=1 font="-exact-subheadline"
                          button class=ToggleControl appearance="none" role="switch" aria-checked=(prefs.noticePreview == "full") press=saveNoticePart(prefs.noticeSound, prefs.noticePreview == "full" ? "hidden" : "full", prefs.noticeWhen) aria-label=t("settings.noticePreview") testId="notice-preview"
                            row width=44 height=26 border-radius="radius.full" background-color=(prefs.noticePreview == "full" ? "AccentColor" : "surface.line") align-items="center" justify-content=(prefs.noticePreview == "full" ? "flex-end" : "flex-start")
                              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
                      text t("settings.notificationsNote") class=SettingsFoot
                    column
                      text t("settings.noticeAlso") class=SectionLabel
                      column class=GroupCard padding="space.sm"
                        row class=SettingsTrack role="radiogroup" aria-label=t("settings.noticeAlso")
                          button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.noticeWhen == "any") press=saveNoticePart(prefs.noticeSound, prefs.noticePreview, "any") testId="notice-when-any" background-color=(prefs.noticeWhen == "any" ? "surface.card" : "transparent") color=(prefs.noticeWhen == "any" ? "-exact-label" : "ink.muted")
                            text t("settings.noticeWhen")
                          button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.noticeWhen == "background") press=saveNoticePart(prefs.noticeSound, prefs.noticePreview, "background") testId="notice-when-background" background-color=(prefs.noticeWhen == "background" ? "surface.card" : "transparent") color=(prefs.noticeWhen == "background" ? "-exact-label" : "ink.muted")
                            text t("settings.noticeAway")
                    column
                      text t("settings.muted") class=SectionLabel
                      column class=GroupCard padding="0"
                        for b in mutedBots(bots) key=b.slug
                          row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top=(b.slug == firstMutedBot(bots) ? "none" : "1px solid surface.line")
                            text b.name flex=1 font="-exact-subheadline"
                            button appearance="none" press=doMute(b.slug, true) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId=`unmute-bot-${b.slug}`
                              text t("settings.unmute")
                        for c in mutedGroups(convos) key=c.key
                          row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top=(firstMutedBot(bots) != "" or c.id != firstMutedGroup(convos) ? "1px solid surface.line" : "none")
                            text c.name flex=1 font="-exact-subheadline"
                            button appearance="none" press=doMuteGroup(c.id, true) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId=`unmute-group-${c.id}`
                              text t("settings.unmute")
                  else if settingsDomain == "models"
                    column
                      text t("settings.defaultModel") class=SectionLabel
                      column class=GroupCard padding="space.sm"
                        if providers.length == 0
                          text t("settings.noProvider") color="ink.muted" font="-exact-subheadline" padding="space.sm" min-height=44
                        else
                          ModelPicker(providers=providers, instanceId=prefs.defaultInstance, model=prefs.defaultModel, effort=prefs.defaultEffort, prefix="default", pick=doMakeDefault)
                    column
                      text t("settings.defaultAccess") class=SectionLabel
                      column class=GroupCard padding="space.sm"
                        row class=SettingsTrack role="radiogroup" aria-label=t("settings.defaultAccess")
                          for mode in ["approval-required", "auto", "full-access"] key=mode
                            button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.defaultRuntimeMode == mode) press=doDefaultMode(mode) testId=`default-access-${mode}` background-color=(prefs.defaultRuntimeMode == mode ? "surface.card" : "transparent") color=(prefs.defaultRuntimeMode == mode ? "-exact-label" : "ink.muted")
                              text (mode == "approval-required" ? t("model.ask") : mode == "auto" ? t("model.auto") : t("model.fullAccess"))
                      text t("settings.defaultAccessNote") class=SettingsFoot
                    column
                      text t("settings.groupAnswer") class=SectionLabel
                      column class=GroupCard padding="space.sm"
                        row class=SettingsTrack role="radiogroup" aria-label=t("settings.groupAnswer")
                          for policy in ["last", "everyone", "chief"] key=policy
                            button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.groupAnswerPolicy == policy) press=doGroupAnswer(policy) testId=`group-answer-${policy}` background-color=(prefs.groupAnswerPolicy == policy ? "surface.card" : "transparent") color=(prefs.groupAnswerPolicy == policy ? "-exact-label" : "ink.muted")
                              text (policy == "last" ? t("group.policyLast") : policy == "everyone" ? t("group.policyEveryone") : t("group.policyChief"))
                      text t("settings.groupAnswerNote") class=SettingsFoot
                      if prefsError != ""
                        text prefsError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0"
                  else if settingsDomain == "access"
                    column
                      text t("settings.private") class=SectionLabel
                      column class=GroupCard padding="0"
                        button class=SettingsRow appearance="none" press=open("/vault") testId="open-vault"
                          column class=IconTile color="AccentColor"
                            Glyph(name="lock", size=18)
                          column flex=1 gap="2px" min-width=0
                            text t("vault.title") font-weight=600
                            text t("settings.vaultNote") color="ink.muted" font="-exact-footnote"
                          column color="ink.muted"
                            Glyph(name="chevron", size=18)
                    column
                      text t("settings.remote") class=SectionLabel
                      column class=GroupCard padding="0"
                        row class=SettingsRow min-height=44
                          input appearance="none" class=Field type="password" value=newPassword input=editNewPassword submit=doSavePassword placeholder=(session.passwordRequired ? t("settings.newPassword") : t("settings.setPassword")) aria-label=t("common.password") autocomplete="new-password" flex=1 min-width=0 testId="new-password"
                          button appearance="none" press=doSavePassword disabled=(newPassword == "" or pending(passwordSet)) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color=(newPassword == "" ? "ink.muted" : "AccentColor") font="-exact-subheadline" font-weight=500 testId="save-password"
                            text (session.passwordRequired ? t("settings.change") : t("settings.set"))
                      text (session.passwordRequired ? t("settings.passwordOn") : t("settings.passwordOff")) class=SettingsFoot
                      if passwordError != "" and not pending(passwordSet)
                        text passwordError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="password-error"
                    column
                      text t("settings.network") class=SectionLabel
                      column class=GroupCard padding="space.sm"
                        row class=SettingsTrack role="radiogroup" aria-label=t("settings.network")
                          for mode in ["local", "lan", "tailscale"] key=mode
                            button class=SettingsTab appearance="none" role="radio" aria-checked=(network.mode == mode) press=doSetNetwork(mode) disabled=network.locked opacity=(network.locked and network.mode != mode ? 0.4 : 1) testId=`network-${mode}` background-color=(network.mode == mode ? "surface.card" : "transparent") color=(network.mode == mode ? "-exact-label" : "ink.muted")
                              text networkModeLabel(mode, t("settings.networkLocal"), t("settings.networkLan"), t("settings.networkTailscale"))
                      text (network.mode == "lan" ? t("settings.networkLanNote") : network.mode == "tailscale" ? t("settings.networkTailscaleNote") : t("settings.networkLocalNote")) class=SettingsFoot
                      if network.locked
                        text t("settings.networkManaged") class=SettingsFoot testId="network-managed"
                      if network.listening != ""
                        text t("settings.networkListening", address=network.listening) class=SettingsFoot testId="network-listening"
                      if network.urls != ""
                        text network.urls class=SettingsFoot testId="network-urls"
                      if network.http
                        text t("settings.networkHttp") class=SettingsFoot
                      if network.error != ""
                        text network.error color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="network-error"
                      if networkError != "" and not pending(networkSet)
                        text networkError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="network-save-error"
                      if pending(networkRestarted)
                        text t("settings.networkRestarting") class=SettingsFoot
                      else if network.restartRequired
                        row class=SettingsRow padding="space.xs space.md 0" min-height=44
                          text t("settings.networkRestart") color="ink.muted" font="-exact-footnote" flex=1 testId="network-restart-note"
                          if network.canRestart
                            button appearance="none" press=doRestartNetwork min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="network-restart"
                              text t("settings.networkRestartButton")
                      if networkRestartError != "" and not pending(networkRestarted)
                        text networkRestartError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0"
                    column
                      text t("settings.storage") class=SectionLabel
                      column class=GroupCard padding="space.md" gap="space.sm"
                        text t("settings.storage.where") font="-exact-subheadline" font-weight=600
                        row class=SettingsTrack role="radiogroup" aria-label=t("settings.storage.where")
                          button class=SettingsTab appearance="none" role="radio" aria-checked=(shownBackend != "anytype") press=doPickBackend("filesystem") disabled=(storage.backendLock != "") testId="storage-filesystem" background-color=(shownBackend != "anytype" ? "surface.card" : "transparent") color=(shownBackend != "anytype" ? "-exact-label" : "ink.muted")
                            text t("settings.storage.filesystem")
                          button class=SettingsTab appearance="none" role="radio" aria-checked=(shownBackend == "anytype") press=doPickBackend("anytype") disabled=(storage.backendLock != "" or not anytypeOn) testId="storage-anytype" background-color=(shownBackend == "anytype" ? "surface.card" : "transparent") color=(shownBackend == "anytype" ? "-exact-label" : "ink.muted")
                            text t("settings.storage.anytype")
                        text (shownBackend == "anytype" ? t("settings.storage.activeAnytype") : t("settings.storage.activeFile")) color="-exact-label" font="-exact-footnote" testId="storage-active"
                        if not anytypeOn
                          text t("settings.storage.anytypeConnect") color="ink.muted" font="-exact-footnote" testId="storage-anytype-note"
                        if storage.backendLock != ""
                          text t("settings.storage.locked", variable=storage.backendLock) color="ink.muted" font="-exact-footnote" testId="storage-locked-backend"
                      if shownBackend == "anytype" or not anytypeOn
                        text t("settings.anytype.title") class=SectionLabel
                        column class=GroupCard padding="space.md" gap="space.md" testId="anytype-connect"
                          text t("settings.anytype.intro") color="ink.muted" font="-exact-footnote"
                          row gap="space.sm" align-items="center"
                            button appearance="none" class=ActionMain press=doPairStart disabled=pending(pairStarted) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-connect-start"
                              text (pairStep == "" ? t("settings.anytype.connect") : t("settings.anytype.again"))
                            button appearance="none" class=ActionQuiet press=doAnytypeCheck disabled=pending(anytypeChecked) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-check"
                              text t("settings.anytype.check")
                          if pairStep == "code"
                            column gap="space.xs"
                              text t("settings.anytype.approve") color="ink.muted" font="-exact-footnote" testId="anytype-approve"
                              row gap="space.sm" align-items="center"
                                input appearance="none" class=FieldBox value=pairCode input=doEditPairCode maxlength=4 inputmode="numeric" placeholder="0000" aria-label=t("settings.anytype.code") flex=1 min-width=0 testId="anytype-code"
                                button appearance="none" class=ActionMain press=doPairConfirm disabled=(pairCode.length != 4 or pending(pairConfirmed)) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-confirm"
                                  text t("settings.anytype.confirm")
                          if pairError != "" and not pending(pairStarted)
                            text pairError color="-exact-system-red" font="-exact-footnote" testId="anytype-pair-error"
                          if pairConfirmError != "" and not pending(pairConfirmed)
                            text pairConfirmError color="-exact-system-red" font="-exact-footnote" testId="anytype-confirm-error"
                          if anytypeError != "" and not pending(anytypeChecked)
                            text anytypeError color="-exact-system-red" font="-exact-footnote" testId="anytype-check-error"
                          if pairStep == "checked" and anytypeError == "" and not pending(anytypeChecked) and pairConfirmError == ""
                            text t("settings.anytype.reachable") color="-exact-label" font="-exact-footnote" font-weight=600 testId="anytype-reachable"
                          column gap="space.xs"
                            text t("settings.anytype.spaceLabel") class=FieldLabel
                            row gap="space.sm" align-items="center"
                              input appearance="none" class=FieldBox value=spaceName placeholder=t("settings.anytype.spaceDefault") input=doEditSpace aria-label=t("settings.anytype.spaceName") flex=1 min-width=0 disabled=(storage.spaceLock != "") testId="anytype-space-name"
                              button appearance="none" class=ActionMain press=doSaveSpace disabled=(storage.spaceLock != "" or not spaceEditing or pending(spaceSaved)) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-space-save"
                                text t("settings.storage.save")
                            text t("settings.anytype.spaceHelp") color="ink.muted" font="-exact-footnote"
                            if storage.spaceLock != ""
                              text t("settings.storage.locked", variable=storage.spaceLock) color="ink.muted" font="-exact-footnote" testId="anytype-space-locked"
                            if spaceSaveError != "" and not pending(spaceSaved)
                              text spaceSaveError color="-exact-system-red" font="-exact-footnote" testId="anytype-space-error"
                            if pairStep == "checked" and anytypeError == "" and not pending(anytypeChecked) and pairConfirmError == ""
                              if anytypeFound
                                text t("settings.anytype.space", name=anytypeSpace) color="-exact-label" font="-exact-footnote" testId="anytype-space"
                                text (anytypeShared ? t("settings.anytype.shared") : t("settings.anytype.private")) color="ink.muted" font="-exact-footnote" testId="anytype-shared"
                              else
                                text t("settings.anytype.missing", name=anytypeSpace) color="-exact-system-red" font="-exact-footnote" testId="anytype-missing"
                      text t("settings.storage.folder") class=SectionLabel
                      column class=GroupCard padding="space.md" gap="space.sm"
                        text t("settings.storage.folderLabel") class=FieldLabel
                        row gap="space.sm" align-items="center"
                          input appearance="none" class=FieldBox value=storagePath placeholder=t("settings.storage.defaultFolder") input=doEditFolder aria-label=t("settings.storage.folder") flex=1 min-width=0 disabled=(storage.rootLock != "") testId="storage-folder"
                          button appearance="none" class=ActionMain press=doSaveStorage disabled=(storagePath == "" or (storage.rootLock != "" and storage.backendLock != "") or pending(storageSaved)) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="storage-save"
                            text t("settings.storage.save")
                        text t("settings.storage.folderNote") color="ink.muted" font="-exact-footnote"
                        if storage.rootLock != ""
                          text t("settings.storage.locked", variable=storage.rootLock) color="ink.muted" font="-exact-footnote" testId="storage-locked-folder"
                        row gap="space.sm" align-items="center"
                          button appearance="none" class=ActionQuiet press=doTestStorage disabled=(storagePath == "" or pending(storageTested)) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="storage-test"
                            text t("settings.storage.test")
                          button appearance="none" class=ActionQuiet press=doCopyStorage disabled=(storagePath == "" or pending(storageCopied)) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="storage-copy"
                            text t("settings.storage.copy")
                        text t("settings.storage.copyNote") color="ink.muted" font="-exact-footnote"
                        if storageHint == "test" and storageTestError == "" and not pending(storageTested)
                          text t("settings.storage.testOk") color="-exact-label" font="-exact-footnote" font-weight=600 testId="storage-test-ok"
                        if storageHint == "copy" and storageCopyError == "" and not pending(storageCopied)
                          text t("settings.storage.copyOk") color="-exact-label" font="-exact-footnote" font-weight=600 testId="storage-copy-ok"
                        if storage.error != ""
                          text storage.error color="-exact-system-red" font="-exact-footnote" testId="storage-error"
                        if storageSaveError != "" and not pending(storageSaved)
                          text storageSaveError color="-exact-system-red" font="-exact-footnote" testId="storage-save-error"
                        if storageTestError != "" and not pending(storageTested)
                          text storageTestError color="-exact-system-red" font="-exact-footnote" testId="storage-test-error"
                        if storageCopyError != "" and not pending(storageCopied)
                          text storageCopyError color="-exact-system-red" font="-exact-footnote" testId="storage-copy-error"
                      if pending(storageRestarted)
                        text t("settings.storage.restarting") class=SettingsFoot
                      else if storage.restartRequired
                        row class=SettingsRow padding="space.xs space.md 0" min-height=44
                          text t("settings.storage.restart") color="ink.muted" font="-exact-footnote" flex=1 testId="storage-restart-note"
                          if storage.canRestart
                            button appearance="none" press=doRestartStorage min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="storage-restart"
                              text t("settings.storage.restartNow")
                      if storageRestartError != "" and not pending(storageRestarted)
                        text storageRestartError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="storage-restart-error"
                  else if settingsDomain == "updates"
                    column gap="space.xl"
                      column
                        text t("settings.domainUpdates") class=SectionLabel
                        column class=GroupCard padding="0"
                          row align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box"
                            if updateTo != "" and not updateStuck
                              text t("settings.updating", version=updateTo) font="-exact-subheadline" testId="update-status"
                            else if updateStuck
                              text t("settings.updateStuck", version=(updateFrom != "" ? updateFrom : system.version)) font="-exact-subheadline" color="-exact-system-red" testId="update-status"
                            else if pending(system) and not system.ok
                              text t("settings.updateChecking") font="-exact-subheadline" color="ink.muted" testId="update-status"
                            else if system.error != ""
                              text system.error font="-exact-subheadline" color="ink.muted" testId="update-status"
                            else if not system.ok
                              text t("settings.updateFailed") font="-exact-subheadline" color="ink.muted" testId="update-status"
                            else if not system.installed
                              text t("settings.updateSource") font="-exact-subheadline" testId="update-status"
                            else if system.updateAvailable
                              text t("settings.updateAvailable", version=system.latest) font="-exact-subheadline" testId="update-status"
                            else
                              text t("settings.updateCurrent", version=system.version) font="-exact-subheadline" testId="update-status"
                          if canUpdate
                            row align-items="center" min-height=44 padding="space.sm space.md" box-sizing="border-box" border-top="1px solid surface.line"
                              button appearance="none" press=doStartUpdate disabled=pending(updateStarted) testId="start-update" min-height=36 padding="0 space.lg" border="none" border-radius="radius.full" background-color="brand.default" color="ink.dark" font="-exact-subheadline" font-weight=600
                                text t("settings.updateRestart")
                        if updateNeedsService
                          text t("settings.updateNotService") class=SettingsFoot
                        if updateError != "" and updateTo == ""
                          text updateError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="update-error"
                      column
                        text t("settings.about") class=SectionLabel
                        column class=GroupCard padding="0"
                          row justify-content="space-between" align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box" font="-exact-subheadline"
                            text "hbots" color="ink.muted"
                            text (about.ok ? about.version : t("settings.unknown")) testId="about-version"
                          row justify-content="space-between" align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line" font="-exact-subheadline"
                            text about.harness color="ink.muted"
                            text (about.connected ? t("settings.connected") : t("settings.disconnected")) color=(about.connected ? "-exact-label" : "-exact-system-red") testId="about-harness"
                          link class=SettingsRow href="https://github.com/Herklos/HBots/blob/main/CHANGELOG.md" target="_blank" border-top="1px solid surface.line" testId="about-changelog"
                            text t("settings.changelog") font-weight=500 flex=1
                            column color="ink.muted"
                              Glyph(name="chevron", size=18)
                      if session.passwordRequired
                        column class=GroupCard padding="0"
                          button class=SettingsRow appearance="none" press=logout justify-content="flex-start" color="-exact-system-red" testId="sign-out"
                            text t("settings.signOut") font-weight=500
          else if e.name == "vault"
            VaultScreen(route=e.id)
          else if e.name == "vaultAdd"
            LoginSheet(route=e.id, item=Login(id="", title="", website="", username="", hasPassword=false, hints="", icon=""), revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "vaultEdit"
            for l in vault.filter(x => x.id == e.params.id) key=l.id
              LoginSheet(route=e.id, item=l, revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "newGroup"
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="group-form" position="absolute" inset=0
              header class=PageHeader
                if groupStep != "name"
                  button id="back" class=TextControl appearance="none" press=groupStepBack testId="group-back"
                    text t("common.back")
                text t("group.new") role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=back aria-label=t("common.close") title=t("common.close") testId="group-close"
                  Glyph(name="close", size=20)
              scroll id="group-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  if groupStep == "face" or groupStep == "review"
                    column align-items="center" gap="space.md" testId="group-face-preview"
                      Faces(faces=pickedFaces(bots, groupMembers), size=72, tuck=-28)
                      text (groupMembers.length == 0 ? t("group.pickFaces") : t("group.face")) color="ink.muted" font="-exact-footnote" text-align="center"
                  if groupStep == "name"
                    column gap="space.sm"
                      text t("group.askName") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-name"
                      input appearance="none" class=Field value=groupName input=editGroupName submit=groupStepNext placeholder=t("group.namePlaceholder") aria-label=t("group.name") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-name"
                  else if groupStep == "face"
                    column gap="space.sm"
                      text t("group.askFace") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-face"
                      row align-items="baseline" gap="space.sm"
                        text t("common.bots") font="-exact-subheadline" font-weight=600 flex=1
                        text (groupMembers.length < 2 ? t("group.pickMore", n=groupMembers.length) : t("group.picked", n=groupMembers.length)) color="ink.muted" font="-exact-footnote" testId="group-count"
                      column gap="space.xs"
                        for b in pickableBots key=b.slug
                          button appearance="none" press=toggleGroupMember(b.slug) role="checkbox" aria-checked=groupMembers.includes(b.slug) aria-label=b.name testId=`pick-bot-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border=(groupMembers.includes(b.slug) ? "2px solid AccentColor" : "2px solid surface.line") border-radius="radius.md" background-color="surface.card" color="-exact-label"
                            row gap="space.md" align-items="center" width="100%"
                              Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=36, still=true, presence="")
                              text b.name font-weight=500 flex=1 min-width=0 text-align="left"
                              column width=24 height=24 align-items="center" justify-content="center" border-radius="radius.full" background-color=(groupMembers.includes(b.slug) ? "AccentColor" : "transparent") border=(groupMembers.includes(b.slug) ? "none" : "2px solid surface.line") color="ink.dark"
                                if groupMembers.includes(b.slug)
                                  Glyph(name="check", size=14)
                  else if groupStep == "policy"
                    column gap="space.sm" width="100%"
                      text t("group.askPolicy") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-policy"
                      button class=ChoiceRow appearance="none" press=pickGroupPolicy("last") role="radio" aria-checked=(groupPolicy == "last") testId="policy-last"
                        column flex=1 gap="2px" min-width=0 align-items="flex-start"
                          text t("group.policyLast") font-weight=600
                          text t("group.policyLastAbout") color="ink.muted" font="-exact-footnote"
                      button class=ChoiceRow appearance="none" press=pickGroupPolicy("everyone") role="radio" aria-checked=(groupPolicy == "everyone") testId="policy-everyone"
                        column flex=1 gap="2px" min-width=0 align-items="flex-start"
                          text t("group.policyEveryone") font-weight=600
                          text t("group.policyEveryoneAbout") color="ink.muted" font="-exact-footnote"
                      button class=ChoiceRow appearance="none" press=pickGroupPolicy("chief") role="radio" aria-checked=(groupPolicy == "chief") testId="policy-chief"
                        column flex=1 gap="2px" min-width=0 align-items="flex-start"
                          text t("group.policyChief") font-weight=600
                          text t("group.policyChiefAbout") color="ink.muted" font="-exact-footnote"
                      if groupPolicy == "chief"
                        ChiefList(bots=pickableBots, slugs=groupMembers, selected=groupChief, pick=pickGroupChief)
                  else if groupStep == "kickoff"
                    column gap="space.sm"
                      text t("group.askKickoff") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-kickoff"
                      textarea appearance="none" class=Field value=groupAbout input=editGroupAbout placeholder=t("group.kickoffPlaceholder") aria-label=t("group.stepKickoff") rows=4 maxlength=2000 padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-about"
                  else
                    column gap="space.sm" testId="step-group-review"
                      text t("create.review") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2
                      column class=GroupCard padding="0"
                        button class=SettingsRow appearance="none" press=goGroupStep("name") min-height=56 padding="space.sm space.md" testId="review-edit-name"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("common.name") color="ink.muted" font="-exact-footnote"
                            text groupName font-weight=600 testId="review-group-name"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goGroupStep("policy") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-policy"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("group.stepPolicy") color="ink.muted" font="-exact-footnote"
                            row gap="space.sm" align-items="baseline" flex-wrap="wrap" min-width=0
                              text (groupPolicy == "everyone" ? t("group.policyEveryone") : groupPolicy == "chief" ? t("group.policyChief") : t("group.policyLast")) font-weight=600 testId="review-policy" overflow-wrap="anywhere"
                              if groupPolicy == "chief"
                                text nameOf(bots, groupChief) testId="review-chief" overflow-wrap="anywhere"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goGroupStep("kickoff") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-kickoff"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("group.stepKickoff") color="ink.muted" font="-exact-footnote"
                            text (groupAbout.trim() == "" ? t("group.noKickoff") : groupAbout) font-weight=600 testId="review-kickoff"
                          Glyph(name="chevron", size=18)
                  if groupError != "" and not pending(groupMade)
                    text groupError color="-exact-system-red" testId="group-error"
              row justify-content="center" padding="space.md space.lg" border-top="1px solid surface.line" box-sizing="border-box"
                column width="100%" max-width="34rem"
                  if groupStep == "review"
                    button class=PrimaryButton buttonStyle="filled" press=makeGroup disabled=(not canMakeGroup) width="100%" testId="group-create"
                      text (pending(groupMade) ? t("common.creating") : t("group.create"))
                  else
                    button class=PrimaryButton buttonStyle="filled" press=groupStepNext disabled=((groupStep == "name" and groupName.trim() == "") or (groupStep == "face" and groupMembers.length < 2)) width="100%" testId="group-next"
                      text t("create.next")
          else
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="new-form" position="absolute" inset=0
              header class=PageHeader
                if createStep != "name"
                  button id="back" class=TextControl appearance="none" press=createBack testId="create-back"
                    text t("common.back")
                text t("inbox.newBot") role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=back aria-label=t("common.close") title=t("common.close") testId="new-close"
                  Glyph(name="close", size=20)
              scroll id="new-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  column align-items="center" gap="space.md" testId="create-face"
                    Avatar(shape=newShape, color=faceColor(newColor), state="idle", size=96, still=false, presence="")
                  if createStep == "name"
                    column gap="space.sm"
                      text t("create.askName") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-name"
                      input appearance="none" class=Field value=newName input=editName submit=createNext placeholder=t("create.namePlaceholder") aria-label=t("common.name") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-name"
                  else if createStep == "colour"
                    column gap="space.sm"
                      text t("create.askColour") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-colour"
                      row gap="space.xs" flex-wrap="wrap" justify-content="center"
                        for c in pickerColours() key=c
                          button class=SwatchControl press=pick(c) appearance="none" aria-label=t("edit.colourNamed", name=faceColor(c)) aria-pressed=(newColor == c) testId=`colour-${c}` width=44 height=44 padding=0
                            column width=32 height=32 box-sizing="border-box" border-radius="radius.full" background-color=c border=(newColor == c ? "3px solid AccentColor" : "3px solid transparent")
                  else if createStep == "shape"
                    column gap="space.sm"
                      text t("create.askShape") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-shape"
                      row gap="space.xs" flex-wrap="wrap" justify-content="center"
                        for s in shapeNames() key=s
                          button class=SwatchControl press=pickShape(s) appearance="none" aria-label=t("edit.shapeNamed", name=s) aria-pressed=(newShape == s) testId=`shape-${s}` width=44 height=44 padding=0 border-radius="radius.md" background-color=(newShape == s ? "surface.raised" : "transparent")
                            Avatar(shape=s, color=faceColor(newColor), state="idle", size=30, still=true, presence="")
                  else if createStep == "template"
                    column gap="space.sm" width="100%"
                      text t("create.askTemplate") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-template"
                      text t("create.or") color="ink.muted"
                      if suggestions.length > 0
                        column gap="space.sm"
                          for s in suggestions key=s.name
                            button class=PanelRow appearance="none" press=useStart(s.name, s.color, s.shape, s.first) testId=`start-${s.name}`
                              Avatar(shape=s.shape, color=faceColor(s.color), state="idle", size=44, still=true, presence="")
                              column flex=1 gap="2px" min-width=0
                                text s.name font-weight=600
                                text s.about color="ink.muted" font="-exact-footnote"
                  else if createStep == "message"
                    column gap="space.sm"
                      text t("create.askMessage") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-message"
                      textarea appearance="none" class=Field value=newFirst input=editFirst placeholder=t("create.messagePlaceholder") aria-label=t("create.firstMessage") rows=4 maxlength=2000 padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-first"
                  else
                    column gap="space.sm" testId="step-review"
                      text t("create.review") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2
                      column class=GroupCard padding="0"
                        button class=SettingsRow appearance="none" press=goCreateStep("name") min-height=56 padding="space.sm space.md" testId="review-edit-name"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("common.name") color="ink.muted" font="-exact-footnote"
                            text newName font-weight=600 testId="review-name"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goCreateStep("colour") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-colour"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("edit.colour") color="ink.muted" font="-exact-footnote"
                            text faceColor(newColor) font-weight=600 testId="review-colour"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goCreateStep("shape") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-shape"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("edit.shape") color="ink.muted" font="-exact-footnote"
                            text newShape font-weight=600 testId="review-shape"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goCreateStep("message") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-message"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("create.firstMessage") color="ink.muted" font="-exact-footnote"
                            text (newFirst.trim() == "" ? t("create.noMessage") : newFirst) font-weight=600 testId="review-first"
                          Glyph(name="chevron", size=18)
                  if createError != "" and not pending(created)
                    text createError color="-exact-system-red" testId="create-error"
              row justify-content="center" padding="space.md space.lg" border-top="1px solid surface.line" box-sizing="border-box"
                column width="100%" max-width="34rem"
                  if createStep == "review"
                    button class=PrimaryButton buttonStyle="filled" press=create disabled=(newName.trim() == "" or pending(created)) width="100%" testId="create"
                      text (pending(created) ? t("common.creating") : t("create.start"))
                  else if createStep == "template"
                    button class=PrimaryButton buttonStyle="filled" press=createNext width="100%" testId="create-skip"
                      text t("create.skip")
                  else
                    button class=PrimaryButton buttonStyle="filled" press=createNext disabled=(createStep == "name" and newName.trim() == "") width="100%" testId="create-next"
                      text t("create.next")
      if computerEnlarged and not locked and onComputer and computer.image != ""
        ComputerOverlay()
      if toast != ""
        ToastLine()
