                          text t("settings.updateNotService") class=SettingsFoot
                        if updateError != "" and updateTo == ""
                          text updateError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="update-error"
                      column
                        text t("settings.about") class=SectionLabel
                        column class=GroupCard padding="0"
                          row justify-content="space-between" align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box" font="-exact-subheadline"
                            text "hbots" color="ink.muted"
                            text (about.ok ? about.version : t("settings.unknown")) testId="about-version"
                          row justify-content="space-between" align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line" font="-exact-subheadline"
                            text about.harness color="ink.muted"
                            text (about.connected ? t("settings.connected") : t("settings.disconnected")) color=(about.connected ? "-exact-label" : "-exact-system-red") testId="about-harness"
                          link class=SettingsRow href="https://github.com/Herklos/HBots/blob/main/CHANGELOG.md" target="_blank" border-top="1px solid surface.line" testId="about-changelog"
                            text t("settings.changelog") font-weight=500 flex=1
                            column color="ink.muted"
                              Glyph(name="chevron", size=18)
                      if session.passwordRequired
                        column class=GroupCard padding="0"
                          button class=SettingsRow appearance="none" press=logout justify-content="flex-start" color="-exact-system-red" testId="sign-out"
                            text t("settings.signOut") font-weight=500
          else if e.name == "vault"
            column class=Screen navigationKey=`${e.id}` navigationScroll="vault-list" position="absolute" inset=0
              header class=PageHeader flex-wrap="wrap"
                text t("vault.title") role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=open("/vault/new") aria-label=t("vault.new") title=t("vault.new") testId="new-login"
                  Glyph(name="add", size=20)
                input type="search" class=SearchField value=vaultQuery input=editVaultQuery placeholder=t("vault.search") aria-label=t("vault.search") testId="vault-search" width="100%"
              if failed(vault)
                EmptyState(symbol="symbol:alert", title=t("error.vaultTitle"), message=t("error.hbotsCode"))
              else if vault.length == 0 and not pending(vault)
                EmptyState(symbol="symbol:lock", title=t("vault.emptyTitle"), message=t("vault.emptyBody"))
                  button press=open("/vault/new") testId="empty-login"
                    text t("vault.add")
              else if vquery != "" and shownVault.length == 0
                column flex=1 min-height=0 align-items="center" justify-content="center" padding="space.xl" testId="no-vault-match"
                  EmptyState(symbol="symbol:search", title=t("vault.noMatch", query=vaultQuery.trim()), message=t("vault.searchHint"))
              else
                list id="vault-list" appearance="none" width="100%" box-sizing="border-box" flex=1 min-height=0 gap="space.sm" padding="space.md max(space.lg, calc((100% - 40rem) / 2))"
                  for v in shownVault key=v.id
                    link href=path("vaultEdit", v.id) testId=`login-${v.id}`
                      row class=BotRow background-color="surface.card" border="1px solid surface.line" border-radius="radius.md" padding="space.md"
                        column class=IconTile color="AccentColor" overflow="hidden"
                          if v.icon != ""
                            image v.icon aria-label="" width=24 height=24 border-radius="radius.sm"
                          else
                            Glyph(name="lock", size=18)
                        column flex=1 min-width=0 gap="space.xs"
                          text v.title font-weight=600
                          text (v.username != "" ? v.username : v.website) color="ink.muted" font="-exact-footnote"
                        Glyph(name="chevron", size=20)
          else if e.name == "vaultAdd"
            LoginSheet(route=e.id, item=Login(id="", title="", website="", username="", hasPassword=false, hints="", icon=""), revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "vaultEdit"
            for l in vault.filter(x => x.id == e.params.id) key=l.id
              LoginSheet(route=e.id, item=l, revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "newGroup"
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="group-form" position="absolute" inset=0
              header class=PageHeader
                button id="back" class=TextControl appearance="none" press=back testId="group-cancel"
                  text t("common.cancel")
                text t("group.new") role="heading" aria-level=1 class=PageTitle flex=1
                button buttonStyle="filled" press=makeGroup disabled=(not canMakeGroup) testId="group-create"
                  text (pending(groupMade) ? t("common.creating") : t("group.create"))
              scroll id="group-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  column align-items="center" gap="space.md"
                    Faces(faces=pickedFaces(bots, groupMembers), size=72, tuck=-28)
                    text (groupMembers.length == 0 ? t("group.pickFaces") : t("group.face")) color="ink.muted" font="-exact-footnote" text-align="center"
                  column gap="space.sm"
                    text t("common.name") font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=groupName input=editGroupName submit=makeGroup placeholder=t("group.namePlaceholder") aria-label=t("group.name") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-name"
                  column gap="space.sm"
                    text t("common.description") font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=groupAbout input=editGroupAbout placeholder=t("group.aboutPlaceholder") aria-label=t("common.description") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-about"
                  column gap="space.sm"
                    row align-items="baseline" gap="space.sm"
                      text t("common.bots") font="-exact-subheadline" font-weight=600 flex=1
                      text (groupMembers.length < 2 ? t("group.pickMore", n=groupMembers.length) : t("group.picked", n=groupMembers.length)) color="ink.muted" font="-exact-footnote" testId="group-count"
                    column gap="space.xs"
                      for b in pickableBots key=b.slug
                        button appearance="none" press=toggleGroupMember(b.slug) role="checkbox" aria-checked=groupMembers.includes(b.slug) aria-label=b.name testId=`pick-bot-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border=(groupMembers.includes(b.slug) ? "2px solid AccentColor" : "2px solid surface.line") border-radius="radius.md" background-color="surface.card" color="-exact-label"
                          row gap="space.md" align-items="center" width="100%"
                            Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=36, still=true, presence="")
                            text b.name font-weight=500 flex=1 min-width=0 text-align="left"
                            column width=24 height=24 align-items="center" justify-content="center" border-radius="radius.full" background-color=(groupMembers.includes(b.slug) ? "AccentColor" : "transparent") border=(groupMembers.includes(b.slug) ? "none" : "2px solid surface.line") color="ink.dark"
                              if groupMembers.includes(b.slug)
                                Glyph(name="check", size=14)
                  if groupError != "" and not pending(groupMade)
                    text groupError color="-exact-system-red" testId="group-error"
          else
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="new-form" position="absolute" inset=0
              header class=PageHeader
                button id="back" class=TextControl appearance="none" press=back testId="new-cancel"
                  text t("common.cancel")
                text t("inbox.newBot") role="heading" aria-level=1 class=PageTitle flex=1
                button buttonStyle="filled" press=create disabled=(newName.trim() == "" or pending(created)) testId="create"
                  text (pending(created) ? t("common.creating") : t("create.start"))
              scroll id="new-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  column align-items="center" gap="space.md"
                    Avatar(shape=newShape, color=faceColor(newColor), state="idle", size=96, still=false, presence="")
                    row gap="space.xs" flex-wrap="wrap" justify-content="center"
                      for c in pickerColours() key=c
                        button class=SwatchControl press=pick(c) appearance="none" aria-label=t("edit.colourNamed", name=faceColor(c)) aria-pressed=(newColor == c) testId=`colour-${c}` width=44 height=44 padding=0
                          column width=32 height=32 box-sizing="border-box" border-radius="radius.full" background-color=c border=(newColor == c ? "3px solid AccentColor" : "3px solid transparent")
                    row gap="space.xs" flex-wrap="wrap" justify-content="center"
                      for s in shapeNames() key=s
                        button class=SwatchControl press=pickShape(s) appearance="none" aria-label=t("edit.shapeNamed", name=s) aria-pressed=(newShape == s) testId=`shape-${s}` width=44 height=44 padding=0 border-radius="radius.md" background-color=(newShape == s ? "surface.raised" : "transparent")
                          Avatar(shape=s, color=faceColor(newColor), state="idle", size=30, still=true, presence="")
                  column gap="space.sm"
                    text t("common.name") font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=newName input=editName submit=create placeholder=t("create.namePlaceholder") aria-label=t("common.name") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-name"
                  if createError != "" and not pending(created)
                    text createError color="-exact-system-red" testId="create-error"
                  if suggestions.length > 0
                    column gap="space.sm"
                      text t("create.or") font="-exact-subheadline" color="ink.muted"
                      column gap="space.sm"
                        for s in suggestions key=s.name
                          button class=PanelRow appearance="none" press=useStart(s.name, s.color, s.shape, s.first) testId=`start-${s.name}`
                            Avatar(shape=s.shape, color=faceColor(s.color), state="idle", size=44, still=true, presence="")
                            column flex=1 gap="2px" min-width=0
                              text s.name font-weight=600
                              text s.about color="ink.muted" font="-exact-footnote"
      if computerEnlarged and not locked and onComputer and computer.image != ""
        column position="absolute" inset=0 z-index=40 align-items="center" justify-content="center" background-color="brand.black" testId="computer-overlay"
          button class=IconControl appearance="none" press=hideComputerLarge aria-label=t("computer.close") title=t("computer.close") testId="computer-close" position="absolute" top=12 right=12 z-index=1 color="ink.light" width=44 height=44
            Glyph(name="close", size=22)
          column id="computer-large" tabindex=(holding ? 0 : -1) key=largePageKey pointerdown=largePoint wheel=largeWheel paste=largePaste touch-action="none" width="100%" height="100%" testId="computer-large"
            image `data:image/jpeg;base64,${computer.image}` aria-label=t("computer.pageFor", name=nameOf(bots, slug)) width="100%" height="100%" object-fit="contain"
      if toast != ""
        row position="absolute" bottom=88 left="50%" translate="-50% 0" padding="space.md space.lg" border-radius="radius.full" background-color="-exact-label" color="surface.canvas" max-width="90%" box-sizing="border-box" testId="toast" role="status" aria-live="polite"
          text toast font="-exact-subheadline" font-weight=500

// A group's face is its members, at most three, overlapped. It has no colour or shape of its own.

// The empty roster: name a Face and create it. The phone inbox and the wide placeholder share this.
component FirstBot
  props
    name: string
    color: string
    shape: string
    suggestions: Suggestion[]
    error: string
    creating: bool
    editName: action
    pick: action
    pickShape: action
    useStart: action
    create: action
  view
    scroll flex=1 min-height=0 width="100%" background-color="surface.canvas" testId="first-bot"
      column width="100%" max-width="24rem" box-sizing="border-box" margin="0 auto" align-items="center" gap="space.md" padding="space.xl"
        Avatar(shape=shape, color=faceColor(color), state="idle", size=96, still=false, presence="")
        text t("inbox.emptyTitle") role="heading" aria-level=2 class=HeroTitle text-align="center"
        text t("inbox.emptyBody") color="ink.muted" text-align="center" max-width="22rem"
        input appearance="none" class=Field value=name input=editName submit=create placeholder=t("create.namePlaceholder") aria-label=t("common.name") width="100%" box-sizing="border-box" padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="first-name"
        if error != "" and not creating
          text error color="-exact-system-red" testId="create-error"
        row gap="space.xs" flex-wrap="wrap" justify-content="center"
          for c in pickerColours() key=c
            button class=SwatchControl press=pick(c) appearance="none" aria-label=t("edit.colourNamed", name=faceColor(c)) aria-pressed=(color == c) testId=`colour-${c}` width=44 height=44 padding=0
              column width=32 height=32 box-sizing="border-box" border-radius="radius.full" background-color=c border=(color == c ? "3px solid AccentColor" : "3px solid transparent")
        row gap="space.xs" flex-wrap="wrap" justify-content="center"
          for s in shapeNames() key=s
            button class=SwatchControl press=pickShape(s) appearance="none" aria-label=t("edit.shapeNamed", name=s) aria-pressed=(shape == s) testId=`shape-${s}` width=44 height=44 padding=0 border-radius="radius.md" background-color=(shape == s ? "surface.raised" : "transparent")
              Avatar(shape=s, color=faceColor(color), state="idle", size=30, still=true, presence="")
        button buttonStyle="filled" press=create disabled=(name.trim() == "" or creating) testId="first-create"
          text (creating ? t("common.creating") : t("inbox.emptyAction"))
        if suggestions.length > 0
          text t("create.or") color="ink.muted" text-align="center"
          column gap="space.sm" width="100%"
            for s in suggestions key=s.name
              button class=PanelRow appearance="none" press=useStart(s.name, s.color, s.shape, s.first) testId=`start-${s.name}`
                Avatar(shape=s.shape, color=faceColor(s.color), state="idle", size=44, still=true, presence="")
                column flex=1 gap="2px" min-width=0
                  text s.name font-weight=600
                  text s.about color="ink.muted" font="-exact-footnote"

// One inbox row, a Bot or a group. A normal click still opens the chat or the group.
// A secondary click or a long press (both a contextmenu) opens one menu on this row.
// A Bot can be pinned, hidden, edited, or made main, with the actions the panel already uses.
// A group can only be edited. The menu stays on the row, so it leaves when the row does or when a row is chosen.
component InboxRow
  props
    row: Convo
    bots: Bot[]
    current: bool
    menuOpen: bool
    openMenu: action
    closeMenu: action
    pin: action
    hide: action
    mute: action
    muteGroup: action
    makeMain: action
    editBot: action
    editGroup: action
  derive mine = bots.filter(b => row.kind == "bot" and b.slug == row.id)
  derive pinned = mine.filter(b => b.pinned).length > 0
  derive botMuted = mine.filter(b => not b.notifications).length > 0
  action openFromSecondary()
    preventDefault()
    openMenu(row.key)
  action choosePin()
    closeMenu()
    match first(mine)
      case some(b)
        pin(b.slug, not b.pinned)
      case none
  action chooseHide()
    closeMenu()
    match first(mine)
      case some(b)
        hide(b.slug, true)
      case none
  action chooseMute()
    closeMenu()
    if row.kind == "group"
      muteGroup(row.id, not row.notifications)
    else
      match first(mine)
        case some(b)
          mute(b.slug, not b.notifications)
        case none
  action chooseMain()
    closeMenu()
    match first(mine)
      case some(b)
        makeMain(b.slug)
      case none
  action chooseEdit()
    closeMenu()
    if row.kind == "group"
      editGroup(row.id)
    else
      editBot(row.id)
  view
    column
      link class=ConversationLink href=(row.kind == "group" ? path("group", row.id) : path("chat", row.id)) contextmenu=openFromSecondary testId=(row.kind == "group" ? `group-${row.id}` : `bot-${row.id}`) background-color=(current ? "surface.raised" : "transparent")
        row gap="space.md" align-items="center" flex=1 min-width=0
          if row.kind == "group"
            Faces(faces=row.faces, size=44, tuck=-18)
          else
            Avatar(shape=row.shape, color=faceColor(row.color), state=(row.ready ? (row.working ? "working" : "idle") : "asleep"), size=44, still=(not row.working), presence=(row.working ? "online" : ""))
          column gap="2px" flex=1 min-width=0
            row gap="space.sm" align-items="baseline"
              text row.name font-weight=(row.unread ? 700 : 600) flex=1 min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=(row.kind == "group" ? `group-title-${row.id}` : `bot-title-${row.id}`)
              text row.time font="-exact-footnote" color="ink.faint"
            row gap="space.sm" align-items="center"
              text row.line color=(row.unread ? "-exact-label" : "ink.muted") font="-exact-footnote" flex=1 min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
              if showUnread(row.unread, current, false)
                column width=8 height=8 flex-shrink=0 border-radius="radius.full" background-color="AccentColor" aria-label=t("inbox.unread") testId=`unread-${row.id}`
      if menuOpen and row.kind == "group"
        column role="menu" aria-label=row.name gap="2px" padding="space.xs" border-radius="radius.md" background-color="surface.card" border="1px solid surface.line" box-shadow="0 4px 16px rgba(0,0,0,0.25)" testId="row-menu"
          button class=TextControl appearance="none" press=chooseMute aria-label=(row.notifications ? t("edit.mute") : t("edit.unmute")) width="100%" justify-content="flex-start"
            text (row.notifications ? t("edit.mute") : t("edit.unmute")) testId=`menu-mute-${row.id}`
          button class=TextControl appearance="none" press=chooseEdit aria-label=t("group.edit") width="100%" justify-content="flex-start"
            text t("group.edit") testId=`menu-edit-${row.id}`
      if menuOpen and row.kind == "bot"
        column role="menu" aria-label=row.name gap="2px" padding="space.xs" border-radius="radius.md" background-color="surface.card" border="1px solid surface.line" box-shadow="0 4px 16px rgba(0,0,0,0.25)" testId="row-menu"
          button class=TextControl appearance="none" press=choosePin aria-label=(pinned ? t("edit.unpin") : t("edit.pin")) width="100%" justify-content="flex-start"
            text (pinned ? t("edit.unpin") : t("edit.pin")) testId=`menu-pin-${row.id}`
          button class=TextControl appearance="none" press=chooseMute aria-label=(botMuted ? t("edit.unmute") : t("edit.mute")) width="100%" justify-content="flex-start"
            text (botMuted ? t("edit.unmute") : t("edit.mute")) testId=`menu-mute-${row.id}`
          button class=TextControl appearance="none" press=chooseHide aria-label=t("edit.hide") width="100%" justify-content="flex-start"
            text t("edit.hide") testId=`menu-hide-${row.id}`
          button class=TextControl appearance="none" press=chooseEdit aria-label=t("panel.edit") width="100%" justify-content="flex-start"
            text t("panel.edit") testId=`menu-edit-${row.id}`
          button class=TextControl appearance="none" press=chooseMain aria-label=t("edit.makeMain") width="100%" justify-content="flex-start"
            text t("edit.makeMain") testId=`menu-main-${row.id}`

// One transcript message. Time and reply stay in the tree so the keyboard
// can focus the action. They paint while the pointer is over the message, while a tap
// has left them open, or while an action is focused. The tap that opens them
// does not close them on the way up; the next tap does. On a device that can
// hover, the pointer leaving the message closes them too. Hidden chrome takes
// no taps. An applied reaction is a chip overlapping the bubble corner; the add control sits beside a Bot bubble only while that chrome (or the picker) is showing.
// A secondary click or a long press (both a contextmenu) opens a menu inside this
// message. It offers reply, pin and react actions, and
// it goes away with that chrome or when a row is chosen. One message menu is open.
component ChatMessage
  props
    row: Row
    canHover: bool
    picking: bool
    menuOpen: bool
    react: action
    openPicker: action
    reply: action
    pin: action
    openMenu: action
    closeMenu: action
  state over = false
  state latched = false
  state closeOnLift = false
  state focused = false
  derive showChrome = over or latched or focused or picking or menuOpen
  action setOver(on: bool)
    over = on
    if not on and canHover
      latched = false
      closeOnLift = false
      closeMenu()
  action tapDown(e: PointerEvent)
    if e.button == 0
      if latched
        closeOnLift = true
      else
        latched = true
        closeOnLift = false
  action tapUp(e: PointerEvent)
    if e.button == 0 and closeOnLift
      latched = false
      closeOnLift = false
      closeMenu()
  action openFromSecondary()
    preventDefault()
    latched = true
    closeOnLift = false
    openMenu(row.id)
  action holdMenu()
    stopPropagation()
  action chooseReply()
    closeMenu()
    reply(row.id, row.text)
  action choosePin()
    closeMenu()
    pin(row.id, row.text)
  action chooseCopy()
    copyText(row.text)
    closeMenu()
  action chooseReact()
    closeMenu()
    if row.react != ""
      react(row.id, row.react)
    else
      openPicker(row.id)
  action chromeFocus(e: FocusEvent)
    focused = e.target == `reply-${row.id}` or e.target == `menu-reply-${row.id}` or e.target == `menu-pin-${row.id}` or e.target == `menu-copy-${row.id}` or e.target == `menu-react-${row.id}`
  action chromeBlur(e: FocusEvent)
    match e.relatedTarget
      case some(id)
        focused = id == `reply-${row.id}` or id == `menu-reply-${row.id}` or id == `menu-pin-${row.id}` or id == `menu-copy-${row.id}` or id == `menu-react-${row.id}`
      case none
        focused = false
  view
    row justify-content=(row.mine ? "flex-end" : "flex-start") padding=(row.head ? "space.sm space.lg 1px" : "1px space.lg")
      column gap="2px" max-width="82%" align-items=(row.mine ? "flex-end" : "flex-start") hover=setOver pointerdown=tapDown pointerup=tapUp contextmenu=openFromSecondary focusin=chromeFocus focusout=chromeBlur
        if row.quote != ""
          text row.quote color="ink.muted" font="-exact-footnote" testId=`quote-${row.id}`
        if row.text != "" or row.react != "" or not row.mine
          row gap="space.xs" align-items="center" max-width="100%"
            column position="relative" padding-bottom="6px" max-width="100%"
              if row.text != "" and row.mine
                text row.text class=Bubble testId=`message-${row.id}`
                  background-color="brand.default"
                  color="ink.dark"
                  border-top-left-radius="radius.lg"
                  border-top-right-radius="radius.lg"
                  border-bottom-left-radius="radius.lg"
                  border-bottom-right-radius=(row.tail ? "radius.sm" : "radius.lg")
              else if row.text != ""
                text row.text markup="markdown" class=Bubble white-space="normal" testId=`message-${row.id}`
                  background-color="surface.bubble"
                  color="-exact-label"
                  border-top-left-radius="radius.lg"
                  border-top-right-radius="radius.lg"
                  border-bottom-left-radius=(row.tail ? "radius.sm" : "radius.lg")
                  border-bottom-right-radius="radius.lg"
              if row.react != ""
                button class=ReactionChip appearance="none" position="absolute" bottom="-4px" left=(row.mine ? "0" : "auto") right=(row.mine ? "auto" : "0") z-index=1 press=react(row.id, row.react) aria-label=t("chat.removeReaction") testId=`react-${row.id}`
                  text row.react
            if not row.mine and row.react == ""
              button class=TextControl appearance="none" press=openPicker(row.id) aria-label=t("chat.react") title=t("chat.react") min-height=24 padding="0 space.xs" opacity=(showChrome ? 1 : 0) pointer-events=(showChrome ? "auto" : "none") testId=`add-react-${row.id}`
                Glyph(name="smile", size=14)
            button id=`reply-${row.id}` class=TextControl appearance="none" press=reply(row.id, row.text) aria-label=t("chat.reply") title=t("chat.reply") min-height=24 padding="0 space.xs" opacity=(showChrome ? 1 : 0) pointer-events=(showChrome ? "auto" : "none") testId=`reply-${row.id}`
              Glyph(name="reply", size=14)
        for f in row.files key=f.id
          if f.kind == "image"
            link href=f.url target="_blank" aria-label=t("common.openNamed", name=f.name) testId=`image-${f.id}`
              image f.url aria-label=f.name max-width="20rem" width="100%" border-radius="radius.lg"
          else if f.kind == "audio" and f.url != ""
            audio f.url controls=true testId=`audio-${f.id}`
          else
            link class=FileCard href=f.url target="_blank" aria-label=t("chat.downloadNamed", name=f.name) testId=`file-${f.id}`
              row gap="space.md" align-items="center"
                column class=IconTile color="AccentColor"
                  Glyph(name="file", size=18)
                column gap="2px" flex=1 min-width=0
                  text f.name font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                  text f.size font="-exact-footnote" color="ink.muted"
                column color="ink.muted"
                  Glyph(name="download", size=18)
        if row.tokens != ""
          text row.tokens color="ink.muted" font="-exact-footnote" testId=`tokens-${row.id}`
        if row.tail and row.time != ""
          row gap="space.xs" align-items="center" padding="0 space.xs"
            row gap="space.xs" align-items="center" opacity=(showChrome ? 1 : 0) pointer-events=(showChrome ? "auto" : "none")
              text row.time font="-exact-footnote" color="ink.faint"
        if menuOpen
          column role="menu" aria-label=t("chat.message") gap="2px" padding="space.xs" border-radius="radius.md" background-color="surface.card" border="1px solid surface.line" box-shadow="0 4px 16px rgba(0,0,0,0.25)" testId="message-menu"
            button id=`menu-reply-${row.id}` class=TextControl appearance="none" pointerdown=holdMenu press=chooseReply aria-label=t("chat.reply") testId=`menu-reply-${row.id}` width="100%" justify-content="flex-start"
              text t("chat.reply")
            button id=`menu-pin-${row.id}` class=TextControl appearance="none" pointerdown=holdMenu press=choosePin aria-label=t("chat.pin") testId=`menu-pin-${row.id}` width="100%" justify-content="flex-start"
              text t("chat.pin")
            if row.text != ""
              button id=`menu-copy-${row.id}` class=TextControl appearance="none" pointerdown=holdMenu press=chooseCopy aria-label=t("chat.copy") testId=`menu-copy-${row.id}` width="100%" justify-content="flex-start"
                text t("chat.copy")
            if not row.mine
              button id=`menu-react-${row.id}` class=TextControl appearance="none" pointerdown=holdMenu press=chooseReact aria-label=(row.react != "" ? t("chat.removeReaction") : t("chat.react")) testId=`menu-react-${row.id}` width="100%" justify-content="flex-start"
                text (row.react != "" ? t("chat.removeReaction") : t("chat.react"))
        if picking
          row gap="2px" flex-wrap="wrap" max-width="100%" box-sizing="border-box" padding="space.xs" border-radius="radius.lg" background-color="surface.raised" border="1px solid surface.line" box-shadow="0 4px 16px rgba(0,0,0,0.25)" testId="react-picker"
            for em in ["👍", "❤️", "😂", "😮", "🎉", "🙏"] key=em
              button class=TextControl appearance="none" press=react(row.id, em) aria-label=t("chat.reactWith", emoji=em) width=44 height=44 min-height=44 padding=0 border-radius="radius.md" font="-exact-title3" testId=`pick-${em}`
                text em

component MentionMenu
  props
    hits: MentionHit[]
    picked: number
    choose: action
  view
    if hits.length > 0
      column id="mention-menu" role="listbox" aria-label=t("chat.mentions") position="absolute" left=0 right=0 bottom="100%" margin-bottom="space.xs" z-index=12 max-height=220 overflow-y="auto" box-sizing="border-box" padding="space.xs" gap="2px" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" box-shadow="0 8px 24px rgba(0,0,0,0.18)" testId="mention-menu"
        for h, i in hits key=h.slug
          button appearance="none" role="option" aria-selected=(i == picked) press=choose(h.slug) aria-label=t("group.mention", name=h.name) title=`@${h.slug}` testId=`mention-opt-${h.slug}` width="100%" box-sizing="border-box" min-height=40 padding="space.xs space.sm" border-radius="radius.sm" border="none" background-color=(i == picked ? "surface.soft" : "transparent") color="-exact-label"
            row gap="space.sm" align-items="center" width="100%" min-width=0
              Avatar(shape=h.shape, color=faceColor(h.color), state="idle", size=24, still=true, presence="")
              column flex=1 min-width=0 align-items="flex-start" gap="0"
                text h.name font="-exact-footnote" font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" max-width="100%"
                text `@${h.slug}` font="-exact-caption2" color="ink.muted"

component Faces
  props
    faces: FaceBit[]
    size: number
    tuck: number
  view
    row align-items="center" testId="group-faces" aria-hidden="true" flex-shrink=0
      if faces.length == 0
        column width=size height=size border-radius="radius.full" border="2px dashed surface.line" background-color="surface.raised"
      if faces.length >= 1
        column z-index=1 flex-shrink=0 border="2px solid surface.canvas" border-radius="radius.full" background-color="surface.canvas"
          Avatar(shape=bitShape(faces, 0), color=faceColor(bitColor(faces, 0)), state=bitState(faces, 0), size=size, still=true, presence="")
      if faces.length >= 2
        column z-index=2 flex-shrink=0 margin-left=tuck border="2px solid surface.canvas" border-radius="radius.full" background-color="surface.canvas"
          Avatar(shape=bitShape(faces, 1), color=faceColor(bitColor(faces, 1)), state=bitState(faces, 1), size=size, still=true, presence="")
      if faces.length >= 3
        column z-index=3 flex-shrink=0 margin-left=tuck border="2px solid surface.canvas" border-radius="radius.full" background-color="surface.canvas"
          Avatar(shape=bitShape(faces, 2), color=faceColor(bitColor(faces, 2)), state=bitState(faces, 2), size=size, still=true, presence="")

// A Vault login's sheet. The password field starts empty: a saved password is shown only after Reveal.
component LoginSheet
  props
    route: number
    item: Login
    revealedFor: string
    revealedText: string
    error: string
    save: action
    reveal: action
    hide: action
    drop: action
    cancel: action
  state ttl = item.title
  state site = item.website
  state user = item.username
  state pass = ""
  state note = item.hints
  action editTitle(v: string)
    ttl = v
  action editWebsite(v: string)
    site = v
  action editUsername(v: string)
    user = v
  action editPassword(v: string)
    pass = v
  action editHints(v: string)
    note = v
  view
    column class=Screen navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
      header class=PageHeader justify-content="space-between"
        button press=cancel aria-label=t("common.cancel") testId="login-cancel"
          Glyph(name="close", size=20)
        text (item.id == "" ? t("vault.new") : item.title) role="heading" aria-level=1
        button press=save(item.id, ttl, site, user, pass, note) disabled=(ttl.trim() == "" and site.trim() == "") buttonStyle="filled" aria-label=t("common.save") testId="login-save"
          text t("common.save")
      list class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            text t("vault.titleField")
            input appearance="none" class=Field value=ttl input=editTitle placeholder=t("vault.titleField") aria-label=t("vault.titleField") text-align="end" flex=1 min-width=0 testId="login-title"
          row
            text t("vault.website")
            input appearance="none" class=Field type="url" value=site input=editWebsite placeholder=t("vault.website") aria-label=t("vault.website") autocapitalize="none" text-align="end" flex=1 min-width=0 testId="login-website"
          footer
            text t("vault.needsSite")
        section
          row
            text t("vault.username")
            input appearance="none" class=Field value=user input=editUsername placeholder=t("vault.username") aria-label=t("vault.username") autocapitalize="none" autocomplete="username" text-align="end" flex=1 min-width=0 testId="login-username"
          row
            text t("common.password")
            input appearance="none" class=Field type="password" value=pass input=editPassword placeholder=(item.hasPassword ? t("vault.passwordKeep") : t("common.password")) aria-label=t("common.password") autocomplete="new-password" text-align="end" flex=1 min-width=0 testId="login-password"
        section
          if item.hasPassword
            row
              text t("vault.savedPassword")
              if revealedFor == item.id and revealedText != ""
                text revealedText user-select="text" testId="revealed-password"
              else
                text "••••••••" color="-exact-secondary-label" testId="hidden-password"
            row
              if revealedFor == item.id and revealedText != ""
                button press=hide buttonStyle="bordered" testId="hide-password"
                  text t("common.hide")
              else
                button press=reveal(item.id) buttonStyle="bordered" testId="reveal-password"
                  text t("vault.reveal")
        section
          row
            text t("vault.notes")
            input appearance="none" class=Field value=note input=editHints placeholder=t("vault.notes") aria-label=t("vault.notes") text-align="end" flex=1 min-width=0 testId="login-notes"
        if error != ""
          section
            text error color="-exact-system-red" testId="login-error"
        if item.id != ""
          section
            button commandfor="drop-login" command="show-modal" testId="login-delete"
              text t("vault.delete")
      dialog id="drop-login" role="alertdialog" aria-label=t("vault.deleteAsk")
        text t("vault.deleteBody")
        button press=drop(item.id) destructive=true commandfor="drop-login" command="close" testId="drop-login-ok"
          text t("common.delete")
        button commandfor="drop-login" command="close" testId="drop-login-cancel"
          text t("common.cancel")

// ---------- the Bot panel ----------

// A row that opens a page: a title line, the value, and a chevron.
style PanelRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  padding="space.md"
  border="1px solid surface.line"
  border-radius="radius.md"
  background-color="surface.card"
  color="-exact-label"
  text-align="left"
  :hover
    background-color="surface.raised"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A choice in a list: a model, a shape.
style ChoiceRow
  display="flex"
  align-items="center"
  gap="space.md"
  width="100%"
  box-sizing="border-box"
  min-height=40
  padding="space.xs space.md"
  border="none"
  border-radius="radius.md"
  color="-exact-label"
  font="-exact-subheadline"
  text-align="left"
  :hover
    background-color="surface.raised"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// The Bot's right panel: its Face and name, then three tabs, and pages for its model, its usage and editing it.
// The details beside a group, as a Bot has: who is in it, and its name, look and members.
component GroupPanel
  props
    shown: bool
    wide: bool
    page: string
    room: Room
    bots: Bot[]
    closePanel: action
    openEdit: action
    goRoot: action
    patch: action
    toggleMember: action
    drop: action
    error: string
  state title = room.title
  state about = room.description
  derive picked = room.members.map(m => m.slug)
  derive pickable = bots.filter(b => not b.hideFromSidebar)
  action editTitle(v: string)
    title = v
  action editAbout(v: string)
    about = v
  view
    column id="group-panel" display=(shown ? "flex" : "none") position="absolute" top=(wide ? 0 : 72) right=0 bottom=0 width=(wide ? "20rem" : "100%") box-sizing="border-box" background-color="surface.canvas" border-left="1px solid surface.line" testId="group-panel"
      row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
        if page == "edit"
          button class=IconControl appearance="none" press=goRoot aria-label=t("common.back") title=t("common.back") testId="group-panel-back"
            column rotate="180deg"
              Glyph(name="chevron", size=20)
          text t("group.edit") role="heading" aria-level=2 class=PageTitle flex=1 testId="group-panel-title"
        else
          column flex=1
          button class=IconControl appearance="none" press=openEdit aria-label=t("group.edit") title=t("group.edit") testId="group-edit"
            Glyph(name="settings", size=20)
          button class=IconControl appearance="none" press=closePanel aria-label=t("panel.close") title=t("panel.close") testId="group-panel-close"
            Glyph(name="close", size=20)
      if page == "edit"
        scroll flex=1 min-height=0
          column gap="space.lg" padding="space.sm space.lg space.xl" testId="group-edit-page"
            column gap="space.sm"
              text t("common.name") class=SectionLabel
              input appearance="none" class=Field value=title input=editTitle change=patch("title") aria-label=t("group.name") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-edit-name"
            column gap="space.sm"
              text t("common.description") class=SectionLabel
              input appearance="none" class=Field value=about input=editAbout change=patch("description") placeholder=t("group.aboutPlaceholderShort") aria-label=t("common.description") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-edit-about"
            column gap="space.sm"
              text t("common.bots") class=SectionLabel
              for b in pickable key=b.slug
                button appearance="none" press=toggleMember(b.slug) role="checkbox" aria-checked=picked.includes(b.slug) aria-label=b.name testId=`group-edit-member-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border=(picked.includes(b.slug) ? "2px solid AccentColor" : "2px solid surface.line") border-radius="radius.md" background-color="surface.card" color="-exact-label"
                  row gap="space.md" align-items="center" width="100%"
                    Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=32, still=true, presence="")
                    text b.name font-weight=500 flex=1 min-width=0 text-align="left"
                    if picked.includes(b.slug)
                      column color="AccentColor"
                        Glyph(name="check", size=18)
            if error != ""
              text error color="-exact-system-red" testId="group-error-panel"
            row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
              column class=IconTile color="AccentColor"
                Glyph(name="bell", size=18)
              column flex=1 gap="2px"
                text t("edit.notify") font-weight=600 testId="mute-group-label"
                text t("edit.muteNote") color="ink.muted" font="-exact-footnote"
              button class=ToggleControl appearance="none" role="switch" aria-checked=room.notifications press=patch("notifications", room.notifications ? "false" : "true") aria-label=t("edit.notify") testId="mute-group"
                row width=44 height=26 border-radius="radius.full" background-color=(room.notifications ? "AccentColor" : "surface.line") align-items="center" justify-content=(room.notifications ? "flex-end" : "flex-start")
                  column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
            row align-items="center" gap="space.md" min-height=56 padding="0 space.md" border-top="1px solid surface.line"
              column class=IconTile color="-exact-system-red"
                Glyph(name="trash", size=18)
              column flex=1 gap="2px"
                text t("group.delete") font-weight=600 color="-exact-system-red"
                text t("group.deleteNote") color="ink.muted" font="-exact-footnote"
              button class=IconControl appearance="none" commandfor="drop-group" command="show-modal" aria-label=t("group.delete") title=t("group.delete") color="-exact-system-red" testId="group-delete"
                Glyph(name="trash", size=20)
            dialog id="drop-group" role="alertdialog" aria-label=t("group.deleteNamed", name=room.title)
              text t("group.deleteBody")
              button press=drop destructive=true commandfor="drop-group" command="close" testId="group-delete-ok"
                text t("common.delete")
              button commandfor="drop-group" command="close" testId="group-delete-cancel"
                text t("common.cancel")
      else
        scroll flex=1 min-height=0
          column gap="space.lg" padding="0 space.lg space.xl"
            column align-items="center" gap="space.xs"
              Faces(faces=memberFaces(bots, room.members), size=72, tuck=-28)
              text room.title font="-exact-title3" font-weight=700 letter-spacing="-0.3px" text-align="center" overflow-wrap="anywhere" testId="group-details-name"
              text (room.description != "" ? room.description : t("group.noAbout")) color="ink.muted" font="-exact-footnote" text-align="center" testId="group-details-about"
            column gap="2px"
              text t("group.botsCount", n=room.members.length) class=SectionLabel testId="group-members-label"
              for m in room.members key=m.slug
                link class=ConversationLink href=path("chat", m.slug) testId=`group-member-${m.slug}` padding="space.sm space.md"
                  row gap="space.md" align-items="center"
                    Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state=m.state, size=40, still=(m.state != "working"), presence="")
                    column gap="2px" flex=1 min-width=0
                      text m.name font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                      text m.line color="ink.muted" font="-exact-footnote"
            text t("group.hint") color="ink.muted" font="-exact-footnote" padding="0 space.md" testId="group-details-hint"

component BotPanel
  props
    working: bool
    shown: bool
    tab: string
    page: string
    pickTab: action
    openPage: action
    closePanel: action
    openChild: action
    wide: bool
    bot: Bot
    error: string
    rename: action
    recolour: action
    reshape: action
    pin: action
    hide: action
    mute: action
    makeMain: action
    drop: action
    models: ModelList
    modelsDown: bool
    pickModel: action
    modelError: string
    routines: RoutineList
    routinesDown: bool
    lineage: Lineage
    lineageDown: bool
    report: UsageReport
    reportDown: bool
    period: string
    usageView: string
    pickPeriod: action
    pickView: action
    retryDetails: action
    shelf: Shelf
    shelfDown: bool
    computer: Computer
    computerDown: bool
    showComputerLarge: action
    heldTab: string
    controlError: string
    driveError: string
    live: bool
    drive: action
    take: action
    release: action
    picked: string
    pick: action
    openBrowser: action
    opening: bool
    openError: string
    closeBrowser: action
    closing: bool
    closeError: string
    bots: Bot[]
    subSlug: string
    subName: string
    subShape: string
    subColor: string
    subPrompt: string
    subInherit: bool
    openNewSub: action
    editSub: action
    editSubName: action
    editSubPrompt: action
    pickSubColor: action
    pickSubShape: action
    toggleSubInherit: action
    createSub: action
    saveSub: action
    dropChild: action
    creating: bool
    saving: bool
    subError: string
    childModels: ModelList
    childModelsDown: bool
  derive children = bots.filter(c => c.parentSlug == bot.slug)
  action tabKey(k: string, event: KeyboardEvent)
    if not event.isComposing and (k == "ArrowRight" or k == "ArrowLeft" or k == "Home" or k == "End")
      preventDefault()
      let next = k == "Home" ? "details" : k == "End" ? "computer" : k == "ArrowRight" ? (tab == "details" ? "library" : tab == "library" ? "computer" : "details") : (tab == "details" ? "computer" : tab == "computer" ? "library" : "details")
      pickTab(next)
      focus(`panel-tab-${next}`)
  action goRoot
    openPage("root")
  action goModel
    openPage("model")
  action goUsage
    openPage("usage")
  action goEdit
    openPage("edit")
  view
    // On a narrow screen the panel is a full-height sheet with one identity
    // row (close, face, edit). The large Face stays for the wide side panel.
    column id="bot-panel" display=(shown ? "flex" : "none") position="absolute" top=0 right=0 bottom=0 width=(wide ? "20rem" : "100%") z-index=(wide ? 0 : 5) box-sizing="border-box" background-color="surface.canvas" border-left="1px solid surface.line" testId="bot-panel"
      if page != "root"
        row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
          button class=IconControl appearance="none" press=goRoot aria-label=t("common.back") title=t("common.back") testId="panel-back"
            column rotate="180deg"
              Glyph(name="chevron", size=20)
          text (page == "model" ? t("panel.model") : page == "usage" ? t("panel.usage") : page == "subagent" ? (subSlug != "" ? t("subagent.page") : t("subagent.new")) : t("panel.edit")) role="heading" aria-level=2 class=PageTitle flex=1 testId="panel-page-title"
      else if wide
        row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
          column flex=1
          button class=IconControl appearance="none" press=goEdit aria-label=t("panel.edit") title=t("panel.edit") testId="panel-edit"
            Glyph(name="settings", size=20)
          button class=IconControl appearance="none" press=closePanel aria-label=t("panel.close") title=t("panel.close") testId="panel-close"
            Glyph(name="close", size=20)
      else
        row align-items="center" gap="space.sm" padding="space.sm space.sm space.sm space.md" min-height=56 box-sizing="border-box" border-bottom="1px solid surface.line" testId="panel-compact-header"
          button class=IconControl appearance="none" press=closePanel aria-label=t("panel.close") title=t("panel.close") testId="panel-close"
            Glyph(name="close", size=20)
          row align-items="center" gap="space.sm" flex=1 min-width=0
            Avatar(shape=bot.shape, color=faceColor(bot.color), state=(bot.hidden ? "asleep" : working ? "working" : "idle"), size=36, still=(not working), presence="")
            column flex=1 min-width=0 gap="1px"
              text bot.name role="heading" aria-level=2 font="-exact-headline" font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="details-name"
              text (bot.hidden ? t("panel.hiddenInbox") : working ? t("status.working") : bot.ready ? t("status.ready") : t("status.settingUp")) color="ink.muted" font="-exact-footnote" overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="details-status"
          button class=IconControl appearance="none" press=goEdit aria-label=t("panel.edit") title=t("panel.edit") testId="panel-edit"
            Glyph(name="settings", size=20)
      if page == "model"
        scroll flex=1 min-height=0
          ModelPage(models=models, down=modelsDown, bot=bot, pick=pickModel, error=modelError)
      else if page == "usage"
        scroll flex=1 min-height=0
          UsageView(report=report, down=reportDown, period=period, view=usageView, pickPeriod=pickPeriod, pickView=pickView, showBots=false)
      else if page == "edit"
        scroll flex=1 min-height=0
          EditBotPage(bot=bot, error=error, rename=rename, recolour=recolour, reshape=reshape, pin=pin, hide=hide, mute=mute, makeMain=makeMain, drop=drop)
      else if page == "subagent"
        scroll flex=1 min-height=0
          column gap="space.lg" padding="space.sm space.lg space.xl" testId="subagent-page"
            column gap="space.sm"
              text t("common.name") class=SectionLabel
              input appearance="none" class=Field value=subName input=editSubName aria-label=t("common.name") placeholder=(subSlug == "" ? t("subagent.namePlaceholder") : "") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="subagent-name"
            column gap="space.sm"
              text t("edit.colour") class=SectionLabel
              row gap="space.xs" flex-wrap="wrap"
                for c in pickerColours() key=c
                  button class=SwatchControl press=pickSubColor(c) appearance="none" aria-label=t("edit.colourNamed", name=faceColor(c)) aria-pressed=(subColor == c) testId=`sub-colour-${c}` width=40 height=40 padding=0
                    column width=30 height=30 box-sizing="border-box" border-radius="radius.full" background-color=c border=(subColor == c ? "3px solid AccentColor" : "3px solid transparent")
            column gap="space.sm"
              text t("edit.shape") class=SectionLabel
              row gap="space.xs" flex-wrap="wrap"
                for s in shapeNames() key=s
                  button class=SwatchControl press=pickSubShape(s) appearance="none" aria-label=t("edit.shapeNamed", name=s) aria-pressed=(subShape == s) testId=`sub-shape-${s}` width=48 height=48 padding=0 border-radius="radius.md" background-color=(subShape == s ? "surface.raised" : "transparent")
                    Avatar(shape=s, color=faceColor(subColor), state="idle", size=34, still=true, presence="")
            column gap="space.sm"
              text t("subagent.prompt") class=SectionLabel
              input appearance="none" class=Field value=subPrompt input=editSubPrompt aria-label=t("subagent.prompt") placeholder=t("subagent.promptPlaceholder") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="subagent-prompt"
            row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
              column flex=1 gap="2px"
                text t("subagent.inherit") font-weight=600
                text t("subagent.inheritNote") color="ink.muted" font="-exact-footnote"
              button class=ToggleControl appearance="none" role="switch" aria-checked=subInherit press=toggleSubInherit aria-label=t("subagent.inherit") testId="subagent-inherit"
                row width=44 height=26 border-radius="radius.full" background-color=(subInherit ? "AccentColor" : "surface.line") align-items="center" justify-content=(subInherit ? "flex-end" : "flex-start")
                  column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
            if subSlug != ""
              text t("panel.model") class=SectionLabel
              for c in children.filter(c => c.slug == subSlug) key=c.slug
                ModelPage(models=childModels, down=childModelsDown, bot=c, pick=pickModel, error=modelError)
            if subError != ""
              text subError color="-exact-system-red" testId="subagent-error"
            if subSlug == ""
              button class=PrimaryButton buttonStyle="filled" press=createSub disabled=creating testId="subagent-create"
                text (creating ? t("subagent.creating") : t("subagent.create"))
            else
              button class=PrimaryButton buttonStyle="filled" press=saveSub disabled=saving testId="subagent-save"
                text (saving ? t("subagent.saving") : t("common.save"))
              button class=IconControl appearance="none" commandfor=`drop-sub-${subSlug}` command="show-modal" aria-label=t("subagent.delete") title=t("subagent.delete") color="-exact-system-red" testId="delete-subagent"
                Glyph(name="trash", size=20)
              dialog id=`drop-sub-${subSlug}` role="alertdialog" aria-label=t("subagent.deleteNamed", name=subName)
                text t("subagent.deleteBody")
                button press=dropChild(subSlug) destructive=true commandfor=`drop-sub-${subSlug}` command="close" testId="drop-sub-ok"
                  text t("common.delete")
                button commandfor=`drop-sub-${subSlug}` command="close" testId="drop-sub-cancel"
                  text t("common.cancel")
      else
        if wide
          column align-items="center" gap="space.xs" padding="0 space.lg space.md"
            Avatar(shape=bot.shape, color=faceColor(bot.color), state=(bot.hidden ? "asleep" : working ? "working" : "idle"), size=72, still=(not working), presence="")
            text bot.name font="-exact-title3" font-weight=700 letter-spacing="-0.3px" testId="details-name" text-align="center" overflow-wrap="anywhere"
            text (bot.hidden ? t("panel.hiddenInbox") : working ? t("status.working") : bot.ready ? t("status.ready") : t("status.settingUp")) color="ink.muted" font="-exact-footnote" testId="details-status"
        row role="tablist" appearance="none" background-color="surface.canvas" aria-label=t("panel.sidebar") justify-content="center" padding="space.xs space.md space.md" gap="space.xs"
          for t in ["details", "library", "computer"] key=t
            button id=`panel-tab-${t}` key=tabKey tabindex=(tab == t ? 0 : -1) class=Segment appearance="none" role="tab" aria-selected=(tab == t) aria-controls=`bot-tab-${t}` press=pickTab(t) min-height=36 padding="space.xs space.md" testId=`panel-tab-${t}` background-color=(tab == t ? "surface.raised" : "transparent") color=(tab == t ? "-exact-label" : "ink.muted")
              text (t == "details" ? t("panel.details") : t == "library" ? t("panel.library") : t("panel.computer")) font="-exact-subheadline"
        column id="bot-tab-details" role="tabpanel" aria-label=t("panel.details") display=(tab == "details" ? "flex" : "none") flex=1 min-height=0
          scroll id=`panel-${bot.slug}` flex=1 min-height=0
            column width="100%" box-sizing="border-box" padding="0 space.lg space.xl" gap="space.sm"
              if modelsDown
                text t("error.model") color="-exact-system-red" testId="model-error"
              else
                button class=PanelRow appearance="none" press=goModel testId="model-row" aria-label=t("panel.modelNamed", name=models.currentName)
                  column class=IconTile color="AccentColor"
                    text (models.providerName != "" ? models.providerName.slice(0, 1) : "?") font-weight=700
                  column flex=1 gap="2px" min-width=0
                    text (models.currentName != "" ? models.currentName : t("panel.choosingModel")) font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="model-name"
                    text (models.effortLabel != "" ? `${models.providerName}, ${models.effortLabel}` : models.providerName) color="ink.muted" font="-exact-footnote"
                  column color="ink.muted"
                    Glyph(name="chevron", size=18)
              button class=PanelRow appearance="none" press=goUsage testId="usage-card" aria-label=t("panel.usage")
                column flex=1 gap="space.xs" min-width=0
                  row gap="space.sm" align-items="baseline"
                    text t("panel.usagePeriod", period=(report.periodLabel != "" ? report.periodLabel : t("usage.days7"))) color="ink.muted" font="-exact-footnote" flex=1
                  if reportDown
                    text t("error.usageShort") color="-exact-system-red" font="-exact-footnote"
                  else
                    text t("panel.tokenCount", n=report.tokens) font="-exact-headline" font-weight=600 testId="usage-tokens"
                    row gap="3px" align-items="flex-end" height=30
                      for d in report.days key=d.day
                        column flex=1 height=d.spx border-radius="2px" background-color="brand.default"
                column color="ink.muted"
                  Glyph(name="chevron", size=18)
              text t("panel.routines") class=SectionLabel
              if routinesDown
                text t("error.routines") color="-exact-system-red" padding="0 space.md" testId="routine-error"
              else if routines.tasks.length == 0
                text t("panel.routineEmpty", name=bot.name) color="ink.muted" font="-exact-footnote" padding="0 space.md" testId="routine-empty"
              else
                column gap="2px"
                  for r in routines.tasks key=r.id
                    row gap="space.md" align-items="center" padding="space.sm space.md" testId=`routine-${r.id}`
                      column color=(r.paused ? "ink.faint" : "AccentColor")
                        Glyph(name=(r.paused ? "pause" : "clock"), size=18)
                      column flex=1 gap="2px" min-width=0
                        text r.title font-weight=500 overflow-wrap="anywhere"
                        text r.schedule color="ink.muted" font="-exact-footnote"
                        if r.next != "" and not r.paused
                          text r.next color="ink.faint" font="-exact-footnote"
                        if r.failed
                          text t("panel.runFailed") color="-exact-system-red" font="-exact-footnote"
                      if r.paused
                        text t("status.paused") color="ink.faint" font="-exact-footnote"
              if routines.error != "" and routines.tasks.length == 0
                text routines.error color="ink.muted" font="-exact-footnote" padding="0 space.md" testId="routine-setup"
              if children.length > 0
                text t("subagent.heading") class=SectionLabel testId="subagent-heading"
                column gap="2px"
                  for c in children key=c.slug
                    row align-items="center" gap="space.sm" padding="space.xs space.md" testId=`subagent-row-${c.slug}`
                      link class=ConversationLink href=path("chat", c.slug) testId=`subagent-${c.slug}` flex=1 min-width=0
                        row gap="space.md" align-items="center"
                          Avatar(shape=c.shape, color=faceColor(c.color), state=(c.ready ? (c.working ? "working" : "idle") : "asleep"), size=32, still=(not c.working), presence="")
                          text c.name font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=`subagent-name-${c.slug}`
                      button class=QuietButton appearance="none" press=editSub(c.slug, c.name, c.shape, c.color, c.prompt, c.inheritParentPrompt) min-height=44 testId=`edit-subagent-${c.slug}`
                        text t("subagent.edit")
              if lineageDown
                text t("panel.workingOn") class=SectionLabel testId="lineage-heading"
                text t("error.lineage") color="-exact-system-red" padding="0 space.md" testId="lineage-error"
              else if lineage.rows.length > 0
                text t("panel.workingOn") class=SectionLabel testId="lineage-heading"
                column gap="2px"
                  for line in lineage.rows key=line.id
                    row align-items="center" gap="space.md" padding="space.sm space.md" testId=`line-${line.id}`
                      column color="ink.faint"
                        Glyph(name="chevron", size=14)
                      column flex=1 gap="2px" min-width=0
                        text line.title font-weight=500 overflow-wrap="anywhere"
                        text (line.remote ? t("panel.remote") : line.threadId != "" ? t("panel.local") : t("panel.thisTurn")) color="ink.muted" font="-exact-footnote" testId=`where-${line.id}`
                      if not line.remote and line.threadId != ""
                        button class=TextControl appearance="none" press=openChild(line.threadId) min-height=28 padding="0 space.sm" font="-exact-footnote" color="AccentColor" testId=`open-${line.id}`
                          text t("common.open")
                      row class=Chip
                        text line.status
        column id="bot-tab-library" role="tabpanel" aria-label=t("panel.library") display=(tab == "library" ? "flex" : "none") flex=1 min-height=0
          scroll id="panel-library-scroll" flex=1 min-height=0
            BotShelf(shelf=shelf, down=shelfDown, name=bot.name)
        column id="bot-tab-computer" role="tabpanel" aria-label=t("panel.computer") display=(tab == "computer" ? "flex" : "none") flex=1 min-height=0
          scroll id="panel-computer-scroll" flex=1 min-height=0
            ScreenCard(name=bot.name, computer=computer, down=computerDown, showLarge=showComputerLarge, heldTab=heldTab, controlError=controlError, driveError=driveError, live=live, drive=drive, take=take, release=release, picked=picked, pick=pick, openBrowser=openBrowser, opening=opening, openError=openError, closeBrowser=closeBrowser, closing=closing, closeError=closeError)

// Pick the provider, the model and how hard it thinks. Each choice applies to the Bot's next message.
// Provider, model and effort as one picker. The Bot's panel and Settings both use it.
component ModelPicker
  props
    providers: Provider[]
    instanceId: string
    model: string
    effort: string
    prefix: string
    pick: action
  state viewing = ""
  action showProvider(id: string)
    viewing = id
  derive shownProvider = viewing != "" ? viewing : instanceId
  view
    column gap="space.md" testId=`${prefix}-picker`
      if providers.length > 1
        row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label=t("model.provider")
          for p in providers key=p.instanceId
            button class=Segment appearance="none" role="radio" aria-checked=(shownProvider == p.instanceId) press=showProvider(p.instanceId) testId=`provider-${p.instanceId}` border="1px solid surface.line" background-color=(shownProvider == p.instanceId ? "surface.raised" : "transparent")
              text p.name
      for p in providers.filter(x => x.instanceId == shownProvider and x.account != "") key=p.instanceId
        text p.account color="ink.muted" font="-exact-footnote" padding="0 space.xs"
      column gap="2px" role="radiogroup" aria-label=t("panel.model")
        for p in providers.filter(x => x.instanceId == shownProvider) key=p.instanceId
          for m in p.models key=m.slug
            button class=ChoiceRow appearance="none" role="radio" aria-checked=(instanceId == p.instanceId and model == m.slug) press=pick(p.instanceId, m.slug, keptEffort(m.efforts, effort)) testId=`${prefix}-${m.slug}` background-color=(instanceId == p.instanceId and model == m.slug ? "surface.raised" : "transparent")
              text m.name font-weight=500 flex=1 min-width=0
              if m.recommended
                text t("model.recommended") color="ink.faint" font="-exact-footnote"
              if instanceId == p.instanceId and model == m.slug
                column color="AccentColor"
                  Glyph(name="check", size=16)
      if modelEfforts(providers, instanceId, model).length > 0
        row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label=t("model.effort")
          for e in modelEfforts(providers, instanceId, model) key=e.id
            button class=Segment appearance="none" role="radio" aria-checked=(effort == e.id) press=pick(instanceId, model, e.id) testId=`effort-${e.id}` border="1px solid surface.line" background-color=(effort == e.id ? "AccentColor" : "transparent") color=(effort == e.id ? "AccentColorText" : "-exact-label")
              text e.label

component ModelPage
  props
    models: ModelList
    down: bool
    bot: Bot
    pick: action
    error: string
  action choose(i: string, m: string, e: string)
    pick(bot.slug, i, m, e, "")
  action chooseMode(mode: string)
    pick(bot.slug, models.instanceId, models.current, models.effort, mode)
  view
    column gap="space.lg" padding="space.sm space.lg space.xl" testId="model-page"
      if down
        text t("error.providers") color="-exact-system-red" testId="provider-error"
      else if models.providers.length == 0
        text t("model.noProviderLong") color="ink.muted" testId="provider-none"
      else
        column gap="space.xs"
          ModelPicker(providers=models.providers, instanceId=models.instanceId, model=models.current, effort=models.effort, prefix="model", pick=choose)
          text t("model.applies", name=bot.name) color="ink.muted" font="-exact-footnote" padding="0 space.xs"
        column gap="space.xs"
          row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label=t("model.access")
            button class=Segment appearance="none" role="radio" aria-checked=(models.runtimeMode == "approval-required") press=chooseMode("approval-required") testId="access-ask" border="1px solid surface.line" background-color=(models.runtimeMode == "approval-required" ? "surface.raised" : "transparent")
              text t("model.ask")
            button class=Segment appearance="none" role="radio" aria-checked=(models.runtimeMode == "auto") press=chooseMode("auto") testId="access-auto" border="1px solid surface.line" background-color=(models.runtimeMode == "auto" ? "surface.raised" : "transparent")
              text t("model.auto")
            button class=Segment appearance="none" role="radio" aria-checked=(models.runtimeMode == "full-access") press=chooseMode("full-access") testId="access-full" border="1px solid surface.line" background-color=(models.runtimeMode == "full-access" ? "surface.raised" : "transparent")
              text t("model.fullAccess")
          text t("model.nextThread") color="ink.muted" font="-exact-footnote" padding="0 space.xs"
        if error != ""
          text error color="-exact-system-red" font="-exact-footnote" testId="model-save-error"

// One report of what a Bot (or every Bot) used: a period, a summary or a detail, always with the figures as a table.
component UsageView
  props
    report: UsageReport
    down: bool
    period: string
    view: string
    pickPeriod: action
    pickView: action
    showBots: bool
  view
    column gap="space.lg" padding="space.sm space.lg space.xl" testId="usage-view"
      row gap="space.xs" role="radiogroup" aria-label=t("usage.period") flex-wrap="wrap"
        for p in ["today", "7d", "30d", "all"] key=p
          button class=Segment appearance="none" role="radio" aria-checked=(period == p) press=pickPeriod(p) testId=`period-${p}` border="1px solid surface.line" min-height=32 padding="2px space.xs" font="-exact-footnote" white-space="nowrap" box-sizing="border-box"
            background-color=(period == p ? "surface.raised" : "transparent")
            text (p == "today" ? t("usage.today") : p == "7d" ? t("usage.days7") : p == "30d" ? t("usage.days30") : t("usage.all"))
      row gap="space.xs" role="radiogroup" aria-label=t("usage.view")
        for v in ["summary", "detail"] key=v
          button class=Segment appearance="none" role="radio" aria-checked=(view == v) press=pickView(v) testId=`view-${v}` min-height=28 font="-exact-footnote" padding="2px space.md"
            background-color=(view == v ? "surface.raised" : "transparent")
            color=(view == v ? "-exact-label" : "ink.muted")
            text (v == "summary" ? t("usage.summary") : t("usage.detail"))
      if down or not report.ok
        text (report.error != "" ? report.error : t("error.loadUsage")) color="-exact-system-red" testId="usage-error"
      else if report.empty
        text t("usage.empty") color="ink.muted" testId="usage-empty"
      else
        row gap="space.lg"
          column gap="2px" flex=1
            text report.tokens font="-exact-headline" font-weight=700 testId="figure-tokens"
            text t("usage.tokensWord") color="ink.muted" font="-exact-footnote"
          column gap="2px" flex=1
            text report.messages font="-exact-headline" font-weight=700 testId="figure-messages"
            text t("usage.messagesWord") color="ink.muted" font="-exact-footnote"
          column gap="2px" flex=1
            text report.turns font="-exact-headline" font-weight=700 testId="figure-turns"
            text t("usage.turnsWord") color="ink.muted" font="-exact-footnote"
        column gap="space.xs"
          row gap="4px" align-items="flex-end" width="100%" height=72 role="img" aria-label=t("usage.perDay", first=report.first, last=report.last)
            for d in report.days key=d.day
              column flex=1 min-width=0 height=d.px border-radius="3px" background-color="brand.default"
          row justify-content="space-between"
            text report.first color="ink.faint" font="-exact-footnote"
            text report.last color="ink.faint" font="-exact-footnote"
        if report.sentence != ""
          text report.sentence color="ink.muted" font="-exact-footnote"
        if view == "detail"
          column gap="space.sm" testId="usage-detail"
            text t("usage.byDay") class=SectionLabel
            column gap="2px"
              for d in report.rows key=d.day
                row gap="space.md" align-items="center" padding="space.xs space.md"
                  column flex=1 gap="2px" min-width=0
                    text d.label font-weight=500
                    text t("usage.dayLine", input=d.input, output=d.output, cached=d.cached) color="ink.muted" font="-exact-footnote" white-space="normal" overflow-wrap="anywhere"
                  column align-items="flex-end" gap="2px"
                    text d.tokens font-weight=600
                    text t("usage.msg", n=d.messages) color="ink.faint" font="-exact-footnote"
            text t("usage.byModel") class=SectionLabel
            column gap="space.sm" padding="0 space.md"
              for m in report.models key=m.name
                column gap="space.xs"
                  row gap="space.md" align-items="baseline"
                    text m.name font-weight=500 flex=1 min-width=0
                    text t("usage.modelLine", tokens=m.tokens, turns=m.turns) color="ink.muted" font="-exact-footnote"
                  row height=6 border-radius="3px" background-color="surface.line"
                    column width=`${m.share}%` height=6 border-radius="3px" background-color="brand.default"
            if showBots
              text t("usage.byBot") class=SectionLabel
              column gap="space.sm" padding="0 space.md"
                for b in report.bots key=b.slug
                  column gap="space.xs"
                    row gap="space.md" align-items="center"
                      Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=22, still=true, presence="")
                      text b.name font-weight=500 flex=1 min-width=0
                      text t("usage.botLine", tokens=b.tokens, messages=b.messages) color="ink.muted" font="-exact-footnote"
                    row height=6 border-radius="3px" background-color="surface.line"
                      column width=`${b.share}%` height=6 border-radius="3px" background-color="brand.default"
            text t("usage.totals") class=SectionLabel
            column gap="2px" padding="0 space.md"
              row justify-content="space-between"
                text t("usage.input") color="ink.muted"
                text report.input
              row justify-content="space-between"
                text t("usage.output") color="ink.muted"
                text report.output
              row justify-content="space-between"
                text t("usage.cached") color="ink.muted"
                text report.cached
              row justify-content="space-between"
                text t("usage.cacheWrite") color="ink.muted"
                text report.cacheWrite
              row justify-content="space-between"
                text t("usage.attachments") color="ink.muted"
                text report.attachments

// What a Bot has kept, to look at: pictures, files and links. Nothing here can be changed.
component BotShelf
  props
    shelf: Shelf
    down: bool
    name: string
  view
    column gap="space.lg" padding="0 space.lg space.xl" testId="shelf"
      if down or not shelf.ok
        text t("error.library") color="-exact-system-red" testId="library-error"
      else if shelf.total == 0
        text t("library.empty", name=name) color="ink.muted" testId="library-status"
      else
        if shelf.pictures.length > 0
          column gap="space.sm"
            text t("library.pictures") class=SectionLabel
            row gap="space.xs" flex-wrap="wrap"
              for p in shelf.pictures key=p.id
                link href=p.url target="_blank" aria-label=t("common.openNamed", name=p.title) testId=`picture-${p.id}`
                  image p.url aria-label=p.title width=88 height=88 border-radius="radius.md" object-fit="cover"
        if shelf.files.length > 0
          column gap="space.sm"
            text t("library.files") class=SectionLabel
            column gap="space.xs"
              for f in shelf.files key=f.id
                link class=FileCard href=f.url target="_blank" aria-label=t("common.openNamed", name=f.title) testId=`shelf-file-${f.id}` min-width=0
                  row gap="space.md" align-items="center"
                    column class=IconTile color="AccentColor"
                      Glyph(name="file", size=18)
                    column gap="2px" flex=1 min-width=0
                      text f.title font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                      text f.detail color="ink.muted" font="-exact-footnote" overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
        if shelf.links.length > 0
          column gap="space.sm"
            text t("library.links") class=SectionLabel
            column gap="space.xs"
              for l in shelf.links key=l.id
                link class=FileCard href=l.url target="_blank" aria-label=t("common.openNamed", name=l.title) testId=`shelf-link-${l.id}` min-width=0
                  row gap="space.md" align-items="center"
                    column class=IconTile color="AccentColor"
                      Glyph(name="globe", size=18)
                    column gap="2px" flex=1 min-width=0
                      text l.title font-weight=500 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                      text l.detail color="ink.muted" font="-exact-footnote" overflow="hidden" text-overflow="ellipsis" white-space="nowrap"

// The page a Bot has open, as a picture. Watching changes nothing; taking control is a second step.
// Click the picture to open it large. Take control opens large and drives there.
component ScreenCard
  props
    name: string
    computer: Computer
    down: bool
    showLarge: action
    heldTab: string
    controlError: string
    driveError: string
    live: bool
    drive: action
    take: action
    release: action
    picked: string
    pick: action
    openBrowser: action
    opening: bool
    openError: string
    closeBrowser: action
    closing: bool
    closeError: string
  derive current = tabId(computer.tabs, picked, computer.selected)
  view
    column gap="space.md" padding="0 space.lg space.xl" testId="screen"
      if down or not computer.ok
        text t("error.computer") color="-exact-system-red" testId="computer-error"
      else if computer.tabs.length == 0
        column align-items="center" gap="space.sm" padding="space.xl 0"
          column color="ink.faint"
            Glyph(name="monitor", size=32)
          text t("computer.none", name=name) color="ink.muted" text-align="center" testId="computer-status"
          if opening
            text t("computer.opening", name=name) color="ink.muted" font="-exact-footnote" text-align="center" testId="computer-opening"
          else
            button class=PrimaryButton buttonStyle="bordered" press=openBrowser testId="computer-open"
              text t("computer.open")
          if openError != ""
            text openError color="-exact-system-red" testId="computer-open-error"
      else
        column position="relative" border-radius="radius.md" overflow="hidden" border="1px solid surface.line" background-color="surface.card"
          if computer.image != ""
            button appearance="none" press=showLarge padding=0 border="none" background-color="transparent" width="100%" aria-label=t("computer.openScreen", name=name) testId="computer-frame"
              image `data:image/jpeg;base64,${computer.image}` aria-label=t("computer.pageFor", name=name) width="100%"
          else
            column align-items="center" justify-content="center" height=140 color="ink.faint"
              Glyph(name="monitor", size=28)
          button class=IconControl appearance="none" press=closeBrowser disabled=closing aria-label=t("computer.closePage", name=name) title=t("computer.closePage", name=name) testId="computer-close-page" position="absolute" top=8 right=8 z-index=1 width=36 height=36 border-radius="radius.full" background-color="brand.black" color="ink.light" opacity=(closing ? 0.5 : 0.85)
            Glyph(name="close", size=18)
        column gap="space.xs" align-items="center"
          text t("computer.screen", name=name) color="ink.muted" testId="computer-status"
          text tabTitle(computer.tabs, current) font-weight=500 text-align="center" overflow-wrap="anywhere" testId="computer-tab-title"
          if closing
            text t("computer.closing", name=name) color="ink.muted" font="-exact-footnote" text-align="center" testId="computer-closing"
          if closeError != ""
            text closeError color="-exact-system-red" testId="computer-close-error"
        if computer.tabs.length > 1
          column gap="2px" width="100%"
            for t in computer.tabs key=t.id
              button appearance="none" press=pick(t.id) min-height=44 padding="0 space.md" aria-pressed=(t.id == current) testId=`tab-${t.id}`
                text t.title font-weight=(t.id == current ? 600 : 400) overflow-wrap="anywhere"
        if heldTab == current
          button class=PrimaryButton buttonStyle="filled" press=release testId="computer-release"
            text t("computer.release")
        else
          button class=PrimaryButton buttonStyle="bordered" press=take(current) testId="computer-take"
            text t("computer.take")
        if heldTab != ""
          text t("computer.held") color="ink.muted" font="-exact-footnote" text-align="center"
        else
          text t("computer.watching") color="ink.muted" font="-exact-footnote" text-align="center"
        if controlError != ""
          text controlError color="-exact-system-red" testId="computer-error"
        else if driveError != ""
          text driveError color="-exact-system-red" testId="computer-error"

// Everything about a Bot that is not what it is doing: its name, colour and shape, and where it sits.
component EditBotPage
  props
    bot: Bot
    error: string
    rename: action
    recolour: action
    reshape: action
    pin: action
    hide: action
    mute: action
    makeMain: action
    drop: action
  state name = bot.name
  action editName(v: string)
    name = v
  view
    column gap="space.lg" padding="space.sm space.lg space.xl" testId="edit-page"
      column gap="space.sm"
        text t("common.name") class=SectionLabel
        input appearance="none" class=Field value=name input=editName change=rename(bot.slug) aria-label=t("common.name") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="bot-name"
      column gap="space.sm"
        text t("edit.colour") class=SectionLabel
        row gap="space.xs" flex-wrap="wrap"
          for c in pickerColours() key=c
            button class=SwatchControl press=recolour(bot.slug, c) appearance="none" aria-label=t("edit.colourNamed", name=faceColor(c)) aria-pressed=(bot.color == c) testId=`colour-${c}` width=40 height=40 padding=0
              column width=30 height=30 box-sizing="border-box" border-radius="radius.full" background-color=c border=(bot.color == c ? "3px solid AccentColor" : "3px solid transparent")
      column gap="space.sm"
        text t("edit.shape") class=SectionLabel
        row gap="space.xs" flex-wrap="wrap"
          for s in shapeNames() key=s
            button class=SwatchControl press=reshape(bot.slug, s) appearance="none" aria-label=t("edit.shapeNamed", name=s) aria-pressed=(bot.shape == s) testId=`shape-${s}` width=48 height=48 padding=0 border-radius="radius.md" background-color=(bot.shape == s ? "surface.raised" : "transparent")
              Avatar(shape=s, color=faceColor(bot.color), state="idle", size=34, still=true, presence="")
      column gap="2px"
        row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
          column class=IconTile color="AccentColor"
            Glyph(name="pin", size=18)
          column flex=1 gap="2px"
            text t("edit.pin") font-weight=600
            text t("edit.pinNote") color="ink.muted" font="-exact-footnote"
          button class=ToggleControl appearance="none" role="switch" aria-checked=bot.pinned disabled=bot.main press=pin(bot.slug, not bot.pinned) aria-label=t("edit.pin") testId="pin-bot"
            row width=44 height=26 border-radius="radius.full" background-color=(bot.pinned or bot.main ? "AccentColor" : "surface.line") align-items="center" justify-content=(bot.pinned or bot.main ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
        row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
          column class=IconTile color="AccentColor"
            Glyph(name="star", size=18)
          column flex=1 gap="2px"
            text t("edit.main") font-weight=600
            text (bot.main ? t("edit.isDefault") : t("edit.makeDefault")) color="ink.muted" font="-exact-footnote"
          if bot.main
            column color="AccentColor" aria-label=t("edit.main") testId="is-main"
              Glyph(name="check", size=20)
          else
            button class=IconControl appearance="none" press=makeMain(bot.slug) aria-label=t("edit.makeMain") title=t("edit.makeMain") testId="make-main"
              Glyph(name="star", size=20)
        row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
          column class=IconTile color="ink.muted"
            Glyph(name="eye-off", size=18)
          column flex=1 gap="2px"
            text t("edit.hide") font-weight=600
            text t("edit.hideNote") color="ink.muted" font="-exact-footnote"
          button class=ToggleControl appearance="none" role="switch" aria-checked=bot.hidden disabled=bot.main press=hide(bot.slug, not bot.hidden) aria-label=t("edit.hidden") testId="hide-bot"
            row width=44 height=26 border-radius="radius.full" background-color=(bot.hidden ? "AccentColor" : "surface.line") align-items="center" justify-content=(bot.hidden ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
        row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
          column class=IconTile color="AccentColor"
            Glyph(name="bell", size=18)
          column flex=1 gap="2px"
            text t("edit.notify") font-weight=600 testId="mute-label"
            text t("edit.muteNote") color="ink.muted" font="-exact-footnote"
          button class=ToggleControl appearance="none" role="switch" aria-checked=bot.notifications press=mute(bot.slug, not bot.notifications) aria-label=t("edit.notify") testId="mute-bot"
            row width=44 height=26 border-radius="radius.full" background-color=(bot.notifications ? "AccentColor" : "surface.line") align-items="center" justify-content=(bot.notifications ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
      if bot.main
        text t("edit.mainStays") color="ink.muted" font="-exact-footnote" padding="0 space.md"
      if error != ""
        text error color="-exact-system-red" testId="bot-error" padding="0 space.md"
      row align-items="center" gap="space.md" min-height=56 padding="0 space.md" border-top="1px solid surface.line"
        column class=IconTile color="-exact-system-red"
          Glyph(name="trash", size=18)
        column flex=1 gap="2px"
          text t("edit.delete") font-weight=600 color=(bot.main ? "ink.muted" : "-exact-system-red")
          text t("edit.deleteMove") color="ink.muted" font="-exact-footnote"
        button class=IconControl appearance="none" commandfor=`drop-bot-${bot.slug}` command="show-modal" disabled=bot.main aria-label=t("edit.delete") title=t("edit.delete") color="-exact-system-red" testId="delete-bot"
          Glyph(name="trash", size=20)
      dialog id=`drop-bot-${bot.slug}` role="alertdialog" aria-label=t("edit.deleteNamed", name=bot.name)
        text t("edit.deleteBody")
        button press=drop(bot.slug) destructive=true commandfor=`drop-bot-${bot.slug}` command="close" testId="drop-bot-ok"
          text t("common.delete")
        button commandfor=`drop-bot-${bot.slug}` command="close" testId="drop-bot-cancel"
          text t("common.cancel")
