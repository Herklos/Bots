                    text t("group.emptyBody") color="ink.muted" text-align="center" max-width="24rem"
                else
                  column flex=1 min-height=0 justify-content="flex-end" position="relative" z-index=(messageMenu != "" ? 21 : 0) pointer-events=(messageMenu != "" ? "none" : "auto")
                    if away
                      button class=IconControl appearance="none" press=toEnd aria-label=t("chat.jump") title=t("chat.jumpShort") testId="to-end" position="absolute" left="50%" translate="-50% 0" bottom=8 z-index=1 width=32 height=32 border-radius="radius.full" background-color="surface.raised" border="1px solid surface.line"
                        Glyph(name="arrow-down", size=16)
                    ChatLog(rows=roomRows, inRoom=true, logId="room-log", logTestId="room-log", bots=bots, slug="", pins=chat.pins, workers=paintedWorkers, hover=(pointerFacts.hover == "hover"), reactFor=reactFor, messageMenu=messageMenu, copiedMenu=copiedMenu, answerText=answerText, answerError=answerError, answering=pending(answered), react=doReact, openPicker=openReact, reply=startReply, pin=doPinMessage, openMenu=openMessageMenu, closeMenu=closeMessageMenu, noteCopied=noteCopied, answer=answer, editAnswer=editAnswer, retry=retry, scrolled=moved)
                column width="calc(100% - 32px)" max-width="44rem" min-width=0 align-self="center" box-sizing="border-box" margin="space.sm space.lg space.xl" gap="space.sm" flex-shrink=0 position="relative"
                  if roomError != "" and not pending(roomSent)
                    text roomError color="-exact-system-red" font="-exact-footnote" testId="room-send-error"
                  row gap="space.xs" flex-wrap="wrap" width="100%" min-width=0 box-sizing="border-box" testId="mention-chips"
                    button appearance="none" press=mention("everyone") aria-label=t("group.mention", name=t("group.everyone")) title=t("group.hintEveryone") testId="mention-everyone" min-height=32 padding="0 space.md" border-radius="radius.full" border="1px solid surface.line" background-color=(roomText.includes("@everyone") ? "surface.soft" : "surface.card") color="-exact-label"
                      text `@everyone` font="-exact-footnote" font-weight=500
                    for m in room.members key=m.slug
                      button appearance="none" press=mention(m.slug) aria-label=t("group.mention", name=m.name) title=t("group.mention", name=m.name) testId=`mention-${m.slug}` min-height=32 padding="0 space.md 0 4px" border-radius="radius.full" border="1px solid surface.line" background-color=(roomText.includes(`@${m.slug}`) ? "surface.soft" : "surface.card") color="-exact-label"
                        row gap="space.xs" align-items="center"
                          Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state="idle", size=22, still=true, presence="")
                          text `@${m.slug}` font="-exact-footnote" font-weight=500
                  MentionMenu(hits=mentionHits, picked=mentionIdx, choose=completeMention)
                  row align-items="flex-end" padding="space.xs" gap="space.xs" border-radius="radius.lg" border="1px solid surface.line" background-color="surface.card"
                    textarea id="room-composer" value=roomText input=editRoomText key=roomKey outline="none" border-radius="radius.md" rows=1 field-sizing="content" max-height=140 placeholder=(room.title != "" ? t("chat.messageTo", name=room.title) : t("chat.write")) aria-label=t("group.message") aria-expanded=(mentionHits.length > 0) aria-controls="mention-menu" testId="room-composer" flex=1 min-width=0 padding="space.sm space.sm" border="none" background-color="transparent" color="-exact-label"
                    button class=SendControl appearance="none" press=postRoom disabled=(roomText.trim() == "" or pending(roomSent)) margin="2px 0" retainFocus=true aria-label=t("common.send") testId="room-send"
                      Glyph(name="send", size=18)
                  text (roomText.includes("@everyone") ? t("group.hintEveryone") : (roomText.includes("@") ? t("group.hintMention") : t("group.hintNone"))) color="ink.muted" font="-exact-footnote" testId="room-hint"
              GroupPanel(shown=groupPanel, wide=wide, page=groupPage, room=room, bots=bots, closePanel=toggleGroupPanel, openEdit=openGroupEdit, goRoot=groupBack, openAdd=openGroupAdd, closeAdd=closeGroupAdd, patch=patchGroup, removeMember=removeGroupMember, addMember=addGroupMember, drop=dropGroup, error=groupSaveError)
          else if e.name == "settings"
            column class=Screen navigationKey=`${e.id}` navigationScroll="settings-form" position="absolute" inset=0
              header class=PageHeader
                text t("settings.title") role="heading" aria-level=1 class=PageTitle flex=1
              column width="100%" max-width="40rem" align-self="center" box-sizing="border-box" padding="space.md space.lg space.sm"
                row class=SettingsTrack role="tablist" aria-label=t("settings.domains")
                  for d in ["user", "notifications", "models", "access", "updates"] key=d
                    button class=SettingsTab appearance="none" role="tab" aria-selected=(settingsDomain == d) press=pickSettingsDomain(d) testId=`settings-domain-${d}` background-color=(settingsDomain == d ? "surface.card" : "transparent") color=(settingsDomain == d ? "-exact-label" : "ink.muted")
                      text settingsDomainLabel(d, t("settings.domainUser"), t("settings.domainNotifications"), t("settings.domainModels"), t("settings.domainAccess"), t("settings.about"))
              scroll id="settings-form" flex=1 min-height=0
                column width="100%" max-width="40rem" align-self="center" box-sizing="border-box" margin="0 auto" padding="space.lg space.lg space.xl" gap="space.xl"
                  if settingsDomain == "user"
                    column
                      text t("settings.you") class=SectionLabel
                      row class=GroupCard gap="space.lg" align-items="center" padding="space.lg" min-height=44
                        column width=56 height=56 border-radius="radius.full" background-color="surface.raised" align-items="center" justify-content="center"
                          if initialsOf(prefs.userName) != ""
                            text initialsOf(prefs.userName) font="-exact-title3" font-weight=600
                          else
                            Glyph(name="person", size=24)
                        column flex=1 gap="2px" min-width=0
                          input appearance="none" class=Field value=(nameEditing ? nameDraft : prefs.userName) input=doEditName change=doSaveName placeholder=t("settings.yourName") aria-label=t("settings.yourName") font="-exact-headline" testId="user-name"
                          text botCountLabel(bots.length, t("bots.one"), t("bots.many", n=bots.length)) color="ink.muted" font="-exact-footnote"
                    column
                      text t("settings.appearance") class=SectionLabel
                      column class=GroupCard padding="space.md"
                        row gap="space.sm" role="radiogroup" aria-label=t("settings.theme")
                          for t in ["system", "light", "dark"] key=t
                            button press=doPickTheme(t) role="radio" aria-checked=(prefs.theme == t) appearance="none" flex=1 padding="space.sm" border-radius="radius.md" testId=`theme-${t}` border=(prefs.theme == t ? "2px solid AccentColor" : "2px solid transparent") background-color="surface.canvas"
                              column gap="space.xs" align-items="center"
