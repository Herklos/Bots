                          if storage.canRestart
                            button appearance="none" press=doRestartStorage min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="storage-restart"
                              text t("settings.storage.restartNow")
                      if storageRestartError != "" and not pending(storageRestarted)
                        text storageRestartError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="storage-restart-error"
                  else if settingsDomain == "updates"
                    column gap="space.xl"
                      column
                        text t("settings.domainUpdates") class=SectionLabel
                        column class=GroupCard padding="0"
                          row align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box"
                            if updateTo != "" and not updateStuck
                              text t("settings.updating", version=updateTo) font="-exact-subheadline" testId="update-status"
                            else if updateStuck
                              text t("settings.updateStuck", version=(updateFrom != "" ? updateFrom : system.version)) font="-exact-subheadline" color="-exact-system-red" testId="update-status"
                            else if pending(system) and not system.ok
                              text t("settings.updateChecking") font="-exact-subheadline" color="ink.muted" testId="update-status"
                            else if system.error != ""
                              text system.error font="-exact-subheadline" color="ink.muted" testId="update-status"
                            else if not system.ok
                              text t("settings.updateFailed") font="-exact-subheadline" color="ink.muted" testId="update-status"
                            else if not system.installed
                              text t("settings.updateSource") font="-exact-subheadline" testId="update-status"
                            else if system.updateAvailable
                              text t("settings.updateAvailable", version=system.latest) font="-exact-subheadline" testId="update-status"
                            else
                              text t("settings.updateCurrent", version=system.version) font="-exact-subheadline" testId="update-status"
                          if canUpdate
                            row align-items="center" min-height=44 padding="space.sm space.md" box-sizing="border-box" border-top="1px solid surface.line"
                              button appearance="none" press=doStartUpdate disabled=pending(updateStarted) testId="start-update" min-height=36 padding="0 space.lg" border="none" border-radius="radius.full" background-color="brand.default" color="ink.dark" font="-exact-subheadline" font-weight=600
                                text t("settings.updateRestart")
                        if updateNeedsService
                          text t("settings.updateNotService") class=SettingsFoot
                        if updateError != "" and updateTo == ""
                          text updateError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="update-error"
                      column
                        text t("settings.about") class=SectionLabel
                        column class=GroupCard padding="0"
                          row justify-content="space-between" align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box" font="-exact-subheadline"
                            text "hbots" color="ink.muted"
                            text (about.ok ? about.version : t("settings.unknown")) testId="about-version"
                          row justify-content="space-between" align-items="center" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line" font="-exact-subheadline"
                            text about.harness color="ink.muted"
                            text (about.connected ? t("settings.connected") : t("settings.disconnected")) color=(about.connected ? "-exact-label" : "-exact-system-red") testId="about-harness"
                          link class=SettingsRow href="https://github.com/Herklos/HBots/blob/main/CHANGELOG.md" target="_blank" border-top="1px solid surface.line" testId="about-changelog"
                            text t("settings.changelog") font-weight=500 flex=1
                            column color="ink.muted"
                              Glyph(name="chevron", size=18)
                      if session.passwordRequired
                        column class=GroupCard padding="0"
                          button class=SettingsRow appearance="none" press=logout justify-content="flex-start" color="-exact-system-red" testId="sign-out"
                            text t("settings.signOut") font-weight=500
          else if e.name == "vault"
            column class=Screen navigationKey=`${e.id}` navigationScroll="vault-list" position="absolute" inset=0
              header class=PageHeader flex-wrap="wrap"
                text t("vault.title") role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=open("/vault/new") aria-label=t("vault.new") title=t("vault.new") testId="new-login"
                  Glyph(name="add", size=20)
                input type="search" class=SearchField value=vaultQuery input=editVaultQuery placeholder=t("vault.search") aria-label=t("vault.search") testId="vault-search" width="100%"
              if failed(vault)
                EmptyState(symbol="symbol:alert", title=t("error.vaultTitle"), message=t("error.hbotsCode"))
              else if vault.length == 0 and not pending(vault)
                EmptyState(symbol="symbol:lock", title=t("vault.emptyTitle"), message=t("vault.emptyBody"))
                  button press=open("/vault/new") testId="empty-login"
                    text t("vault.add")
              else if vquery != "" and shownVault.length == 0
                column flex=1 min-height=0 align-items="center" justify-content="center" padding="space.xl" testId="no-vault-match"
                  EmptyState(symbol="symbol:search", title=t("vault.noMatch", query=vaultQuery.trim()), message=t("vault.searchHint"))
              else
                list id="vault-list" appearance="none" width="100%" box-sizing="border-box" flex=1 min-height=0 gap="space.sm" padding="space.md max(space.lg, calc((100% - 40rem) / 2))"
                  for v in shownVault key=v.id
                    link href=path("vaultEdit", v.id) testId=`login-${v.id}`
                      row class=BotRow background-color="surface.card" border="1px solid surface.line" border-radius="radius.md" padding="space.md"
                        column class=IconTile color="AccentColor" overflow="hidden"
                          if v.icon != ""
                            image v.icon aria-label="" width=24 height=24 border-radius="radius.sm"
                          else
                            Glyph(name="lock", size=18)
                        column flex=1 min-width=0 gap="space.xs"
                          text v.title font-weight=600
                          text (v.username != "" ? v.username : v.website) color="ink.muted" font="-exact-footnote"
                        Glyph(name="chevron", size=20)
          else if e.name == "vaultAdd"
            LoginSheet(route=e.id, item=Login(id="", title="", website="", username="", hasPassword=false, hints="", icon=""), revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "vaultEdit"
            for l in vault.filter(x => x.id == e.params.id) key=l.id
              LoginSheet(route=e.id, item=l, revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "newGroup"
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="group-form" position="absolute" inset=0
              header class=PageHeader
                if groupStep != "name"
                  button id="back" class=TextControl appearance="none" press=groupStepBack testId="group-back"
                    text t("common.back")
                text t("group.new") role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=back aria-label=t("common.close") title=t("common.close") testId="group-close"
                  Glyph(name="close", size=20)
              scroll id="group-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  if groupStep == "face" or groupStep == "review"
                    column align-items="center" gap="space.md" testId="group-face-preview"
                      Faces(faces=pickedFaces(bots, groupMembers), size=72, tuck=-28)
                      text (groupMembers.length == 0 ? t("group.pickFaces") : t("group.face")) color="ink.muted" font="-exact-footnote" text-align="center"
                  if groupStep == "name"
                    column gap="space.sm"
                      text t("group.askName") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-name"
                      input appearance="none" class=Field value=groupName input=editGroupName submit=groupStepNext placeholder=t("group.namePlaceholder") aria-label=t("group.name") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-name"
                  else if groupStep == "face"
                    column gap="space.sm"
                      text t("group.askFace") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-face"
                      row align-items="baseline" gap="space.sm"
                        text t("common.bots") font="-exact-subheadline" font-weight=600 flex=1
                        text (groupMembers.length < 2 ? t("group.pickMore", n=groupMembers.length) : t("group.picked", n=groupMembers.length)) color="ink.muted" font="-exact-footnote" testId="group-count"
                      column gap="space.xs"
                        for b in pickableBots key=b.slug
                          button appearance="none" press=toggleGroupMember(b.slug) role="checkbox" aria-checked=groupMembers.includes(b.slug) aria-label=b.name testId=`pick-bot-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border=(groupMembers.includes(b.slug) ? "2px solid AccentColor" : "2px solid surface.line") border-radius="radius.md" background-color="surface.card" color="-exact-label"
                            row gap="space.md" align-items="center" width="100%"
                              Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=36, still=true, presence="")
                              text b.name font-weight=500 flex=1 min-width=0 text-align="left"
                              column width=24 height=24 align-items="center" justify-content="center" border-radius="radius.full" background-color=(groupMembers.includes(b.slug) ? "AccentColor" : "transparent") border=(groupMembers.includes(b.slug) ? "none" : "2px solid surface.line") color="ink.dark"
                                if groupMembers.includes(b.slug)
                                  Glyph(name="check", size=14)
                  else if groupStep == "policy"
                    column gap="space.sm" width="100%"
                      text t("group.askPolicy") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-policy"
                      button class=ChoiceRow appearance="none" press=pickGroupPolicy("last") role="radio" aria-checked=(groupPolicy == "last") testId="policy-last"
                        column flex=1 gap="2px" min-width=0 align-items="flex-start"
                          text t("group.policyLast") font-weight=600
                          text t("group.policyLastAbout") color="ink.muted" font="-exact-footnote"
                      button class=ChoiceRow appearance="none" press=pickGroupPolicy("everyone") role="radio" aria-checked=(groupPolicy == "everyone") testId="policy-everyone"
                        column flex=1 gap="2px" min-width=0 align-items="flex-start"
                          text t("group.policyEveryone") font-weight=600
                          text t("group.policyEveryoneAbout") color="ink.muted" font="-exact-footnote"
                      button class=ChoiceRow appearance="none" press=pickGroupPolicy("chief") role="radio" aria-checked=(groupPolicy == "chief") testId="policy-chief"
                        column flex=1 gap="2px" min-width=0 align-items="flex-start"
                          text t("group.policyChief") font-weight=600
                          text t("group.policyChiefAbout") color="ink.muted" font="-exact-footnote"
                  else if groupStep == "kickoff"
                    column gap="space.sm"
                      text t("group.askKickoff") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-kickoff"
                      textarea appearance="none" class=Field value=groupAbout input=editGroupAbout placeholder=t("group.kickoffPlaceholder") aria-label=t("group.stepKickoff") rows=4 maxlength=2000 padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-about"
                  else
                    column gap="space.sm" testId="step-group-review"
                      text t("create.review") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2
                      column class=GroupCard padding="0"
                        button class=SettingsRow appearance="none" press=goGroupStep("name") min-height=56 padding="space.sm space.md" testId="review-edit-name"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("common.name") color="ink.muted" font="-exact-footnote"
                            text groupName font-weight=600 testId="review-group-name"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goGroupStep("policy") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-policy"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("group.stepPolicy") color="ink.muted" font="-exact-footnote"
                            text (groupPolicy == "everyone" ? t("group.policyEveryone") : groupPolicy == "chief" ? t("group.policyChief") : t("group.policyLast")) font-weight=600 testId="review-policy"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goGroupStep("kickoff") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-kickoff"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("group.stepKickoff") color="ink.muted" font="-exact-footnote"
                            text (groupAbout.trim() == "" ? t("group.noKickoff") : groupAbout) font-weight=600 testId="review-kickoff"
                          Glyph(name="chevron", size=18)
                  if groupError != "" and not pending(groupMade)
                    text groupError color="-exact-system-red" testId="group-error"
              row justify-content="center" padding="space.md space.lg" border-top="1px solid surface.line" box-sizing="border-box"
                column width="100%" max-width="34rem"
                  if groupStep == "review"
                    button class=PrimaryButton buttonStyle="filled" press=makeGroup disabled=(not canMakeGroup) width="100%" testId="group-create"
                      text (pending(groupMade) ? t("common.creating") : t("group.create"))
                  else
                    button class=PrimaryButton buttonStyle="filled" press=groupStepNext disabled=((groupStep == "name" and groupName.trim() == "") or (groupStep == "face" and groupMembers.length < 2)) width="100%" testId="group-next"
                      text t("create.next")
          else
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="new-form" position="absolute" inset=0
              header class=PageHeader
                if createStep != "name"
                  button id="back" class=TextControl appearance="none" press=createBack testId="create-back"
                    text t("common.back")
                text t("inbox.newBot") role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=back aria-label=t("common.close") title=t("common.close") testId="new-close"
                  Glyph(name="close", size=20)
              scroll id="new-form" flex=1 min-height=0
                column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
                  column align-items="center" gap="space.md" testId="create-face"
                    Avatar(shape=newShape, color=faceColor(newColor), state="idle", size=96, still=false, presence="")
                  if createStep == "name"
                    column gap="space.sm"
                      text t("create.askName") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-name"
                      input appearance="none" class=Field value=newName input=editName submit=createNext placeholder=t("create.namePlaceholder") aria-label=t("common.name") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-name"
                  else if createStep == "colour"
                    column gap="space.sm"
                      text t("create.askColour") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-colour"
                      row gap="space.xs" flex-wrap="wrap" justify-content="center"
                        for c in pickerColours() key=c
                          button class=SwatchControl press=pick(c) appearance="none" aria-label=t("edit.colourNamed", name=faceColor(c)) aria-pressed=(newColor == c) testId=`colour-${c}` width=44 height=44 padding=0
                            column width=32 height=32 box-sizing="border-box" border-radius="radius.full" background-color=c border=(newColor == c ? "3px solid AccentColor" : "3px solid transparent")
                  else if createStep == "shape"
                    column gap="space.sm"
                      text t("create.askShape") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-shape"
                      row gap="space.xs" flex-wrap="wrap" justify-content="center"
                        for s in shapeNames() key=s
                          button class=SwatchControl press=pickShape(s) appearance="none" aria-label=t("edit.shapeNamed", name=s) aria-pressed=(newShape == s) testId=`shape-${s}` width=44 height=44 padding=0 border-radius="radius.md" background-color=(newShape == s ? "surface.raised" : "transparent")
                            Avatar(shape=s, color=faceColor(newColor), state="idle", size=30, still=true, presence="")
                  else if createStep == "template"
                    column gap="space.sm" width="100%"
                      text t("create.askTemplate") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-template"
                      text t("create.or") color="ink.muted"
                      if suggestions.length > 0
                        column gap="space.sm"
                          for s in suggestions key=s.name
                            button class=PanelRow appearance="none" press=useStart(s.name, s.color, s.shape, s.first) testId=`start-${s.name}`
                              Avatar(shape=s.shape, color=faceColor(s.color), state="idle", size=44, still=true, presence="")
                              column flex=1 gap="2px" min-width=0
                                text s.name font-weight=600
                                text s.about color="ink.muted" font="-exact-footnote"
                  else if createStep == "message"
                    column gap="space.sm"
                      text t("create.askMessage") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-message"
                      textarea appearance="none" class=Field value=newFirst input=editFirst placeholder=t("create.messagePlaceholder") aria-label=t("create.firstMessage") rows=4 maxlength=2000 padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-first"
                  else
                    column gap="space.sm" testId="step-review"
                      text t("create.review") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2
                      column class=GroupCard padding="0"
                        button class=SettingsRow appearance="none" press=goCreateStep("name") min-height=56 padding="space.sm space.md" testId="review-edit-name"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("common.name") color="ink.muted" font="-exact-footnote"
                            text newName font-weight=600 testId="review-name"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goCreateStep("colour") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-colour"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("edit.colour") color="ink.muted" font="-exact-footnote"
                            text faceColor(newColor) font-weight=600 testId="review-colour"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goCreateStep("shape") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-shape"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("edit.shape") color="ink.muted" font="-exact-footnote"
                            text newShape font-weight=600 testId="review-shape"
                          Glyph(name="chevron", size=18)
                        button class=SettingsRow appearance="none" press=goCreateStep("message") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-message"
                          column flex=1 min-width=0 gap="2px" align-items="flex-start"
                            text t("create.firstMessage") color="ink.muted" font="-exact-footnote"
                            text (newFirst.trim() == "" ? t("create.noMessage") : newFirst) font-weight=600 testId="review-first"
                          Glyph(name="chevron", size=18)
                  if createError != "" and not pending(created)
                    text createError color="-exact-system-red" testId="create-error"
              row justify-content="center" padding="space.md space.lg" border-top="1px solid surface.line" box-sizing="border-box"
                column width="100%" max-width="34rem"
                  if createStep == "review"
                    button class=PrimaryButton buttonStyle="filled" press=create disabled=(newName.trim() == "" or pending(created)) width="100%" testId="create"
                      text (pending(created) ? t("common.creating") : t("create.start"))
                  else if createStep == "template"
                    button class=PrimaryButton buttonStyle="filled" press=createNext width="100%" testId="create-skip"
                      text t("create.skip")
                  else
                    button class=PrimaryButton buttonStyle="filled" press=createNext disabled=(createStep == "name" and newName.trim() == "") width="100%" testId="create-next"
                      text t("create.next")
      if computerEnlarged and not locked and onComputer and computer.image != ""
        column position="absolute" inset=0 z-index=40 align-items="center" justify-content="center" background-color="brand.black" testId="computer-overlay"
          button class=IconControl appearance="none" press=hideComputerLarge aria-label=t("computer.close") title=t("computer.close") testId="computer-close" position="absolute" top=12 right=12 z-index=1 color="ink.light" width=44 height=44
            Glyph(name="close", size=22)
          column id="computer-large" tabindex=(holding ? 0 : -1) key=largePageKey pointerdown=largePoint wheel=largeWheel paste=largePaste touch-action="none" width="100%" height="100%" testId="computer-large"
            image `data:image/jpeg;base64,${computer.image}` aria-label=t("computer.pageFor", name=nameOf(bots, slug)) width="100%" height="100%" object-fit="contain"
      if toast != ""
        row position="absolute" bottom=88 left="50%" translate="-50% 0" padding="space.md space.lg" border-radius="radius.full" background-color="-exact-label" color="surface.canvas" max-width="90%" box-sizing="border-box" testId="toast" role="status" aria-live="polite"
          text toast font="-exact-subheadline" font-weight=500
