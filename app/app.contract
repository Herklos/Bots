// hbots: the messaging app, written once in Contract. The Rust gateway
// (`hbots`, in ../gateway) keeps the Bots, the Vault and the Projects board and talks to a
// harness. T3 Code is the harness wired today; other backends may be added.
// This app is the same screen on the web, macOS, iOS and Linux.
use EmptyState from "exact:content"
use Face from "./face.contract"
use Glyph from "./glyph.contract"

// Shared screen rhythm. Colours are generated from design/tokens.json.
style Screen
  background-color="surface.canvas"
  color="-exact-label"

style PageTitle
  font="-exact-headline"
  font-weight=600
  letter-spacing="-0.2px"

style HeroTitle
  font="-exact-large-title"
  font-weight=700
  letter-spacing="-0.8px"

style PageHeader
  display="flex"
  align-items="center"
  gap="space.sm"
  padding="space.md space.xl"
  min-height=72
  box-sizing="border-box"
  background-color="surface.canvas"
  border-bottom="1px solid surface.line"

style QuietButton
  min-width=44
  min-height=44

style TextControl
  box-sizing="border-box"
  min-height=44
  padding="space.sm space.md"
  border="none"
  border-radius="radius.sm"
  color="ink.muted"
  background-color="transparent"
  font="-exact-subheadline"
  font-weight=500
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style IconControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=44
  height=44
  padding=0
  border="none"
  border-radius="radius.md"
  color="ink.muted"
  background-color="transparent"
  :disabled
    opacity=0.4
    color="ink.muted"
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// The composer's send: a Tide circle with Night ink, the brand's filled look.
// The chat header's Bot name: one button that toggles the right panel.
style HeaderToggle
  display="flex"
  align-items="center"
  min-height=44
  padding="0 space.xs"
  border="none"
  border-radius="radius.md"
  background-color="transparent"
  :hover
    background-color="surface.soft"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style SendControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="brand.default"
  color="ink.dark"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"
  :disabled
    background-color="surface.line"
    color="ink.muted"

style StopControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="-exact-system-red"
  color="ink.light"
  :active
    opacity=0.7
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style ToggleControl
  display="flex"
  align-items="center"
  justify-content="center"
  width=48
  height=44
  padding=0
  border="none"
  border-radius="radius.sm"
  background-color="transparent"
  :checked
    background-color="transparent"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"
  :disabled
    opacity=0.4

style SwatchControl
  width=44
  height=44
  box-sizing="border-box"
  padding=0
  border="none"
  border-radius="radius.full"
  background-color="transparent"
  :checked
    background-color="transparent"
  :hover
    background-color="surface.soft"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

style ConversationLink
  color="-exact-label"
  text-decoration="none"
  padding="space.md"
  border-radius="radius.md"
  :hover
    background-color="surface.card"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// A search field: a pill with a magnifier beside it.
style SearchField
  box-sizing="border-box"
  min-height=36
  padding="space.xs space.md"
  border="1px solid surface.line"
  border-radius="radius.full"
  background-color="surface.card"
  color="-exact-label"

// A section label above a grouped card, like the panel labels in Threebot.
style SectionLabel
  font="-exact-footnote"
  font-weight=600
  color="ink.muted"
  padding="space.md space.md space.xs"

style GroupCard
  background-color="surface.card"
  border="1px solid surface.line"
  border-radius="radius.md"
  padding="space.xs space.md"
  box-sizing="border-box"

// A small status chip: a dot and a word.
style Chip
  display="flex"
  align-items="center"
  gap="space.xs"
  padding="4px space.sm"
  border-radius="radius.full"
  background-color="surface.soft"
  font="-exact-footnote"
  font-weight=500

// A rounded tile behind a row's glyph.
style IconTile
  display="flex"
  align-items="center"
  justify-content="center"
  width=36
  height=36
  border-radius="radius.sm"
  background-color="surface.soft"

// Segmented choices (the theme picker): one pill, filled when chosen. The
// chosen fill is a node attribute, so the class keeps only literal states.
style Segment
  border="none"
  min-height=40
  padding="space.xs space.md"
  border-radius="radius.full"
  background-color="transparent"
  color="-exact-label"
  font-weight=500
  :hover
    background-color="surface.soft"
  :focus-visible
    box-shadow="0 0 0 2px AccentColor"

// Chat bubbles. Mine is the brand fill (Tide with Night ink, 8.2:1); the
// Bot's is a card. Fill, ink and the tail corner are node attributes.
style Bubble
  padding="space.sm space.lg"
  line-height=1.55
  white-space="pre-wrap"
  overflow-wrap="break-word"

style FileChip
  padding="space.xs space.sm"
  border-radius="radius.full"
  font="-exact-footnote"
  overflow-wrap="anywhere"

style BotRow
  padding="space.md space.xs"
  gap="space.md"
  align-items="center"
  min-height=52

style Field
  box-sizing="border-box"
  min-height=44
  border="none"
  background-color="transparent"
  padding="space.xs 0"
  color="-exact-label"

style FormList
  background-color="surface.canvas"
  width="100%"
  max-width="44rem"
  align-self="center"
  box-sizing="border-box"

style PrimaryButton
  min-height=44

routes nav
  inbox "/"
    chat "/bot/:slug"
      library "/bot/:slug/library"
      computer "/bot/:slug/computer"
    create "/new"
    settings "/settings"
      vault "/vault"
        vaultAdd "/vault/new"
        vaultEdit "/vault/:id"

shape Reply
  ok: bool
  error: string

shape Session
  authenticated: bool
  passwordRequired: bool

shape Bot
  slug: string
  name: string
  label: string
  initials: string
  color: string
  main: bool
  hidden: bool
  ready: bool

// One row of the transcript: a message, a card the Bot is waiting on, or the working line.
// `head`/`tail` mark a run of same-sender messages, for the bubble corners and spacing.
shape Row
  id: string
  kind: string
  mine: bool
  text: string
  files: string
  head: bool
  tail: bool

shape Chat
  slug: string
  rows: Row[]
  working: bool

shape Prefs
  userName: string
  theme: string
  projects: bool

// Result of uploading one chat attachment to the gateway.
shape Attached
  ok: bool
  id: string
  name: string
  error: string

// A Vault login, as the list may see it: the password is never in this shape.
shape Login
  id: string
  title: string
  website: string
  username: string
  hasPassword: bool
  hints: string

// The one password the person asked to see, for the login it names.
shape Revealed
  ok: bool
  id: string
  password: string
  error: string

shape Project
  id: string
  kind: string
  title: string
  status: string
  area: string
  body: string

// Counts on this machine. `ok` is false until a read succeeds, so an empty
// fallback is not "nothing counted yet".
shape Usage
  ok: bool
  messages: number
  attachments: number
  vaultWrites: number
  iconFetches: number

shape ModelChoice
  instanceId: string
  model: string
  label: string

shape ModelList
  ok: bool
  current: string
  instanceId: string
  choices: ModelChoice[]

shape Routine
  id: string
  title: string
  enabled: bool
  schedule: string

shape RoutineList
  ok: bool
  tasks: Routine[]
  error: string

shape LineRow
  id: string
  title: string
  status: string
  remote: bool
  threadId: string

shape Lineage
  ok: bool
  rows: LineRow[]
  error: string

shape LibEntry
  id: string
  kind: string
  title: string
  detail: string
  group: string
  status: string
  body: string
  path: string
  open: string

shape Connector
  name: string
  url: string
  enabled: bool
  locked: bool
  hasSecret: bool

shape Library
  ok: bool
  entries: LibEntry[]
  connectors: Connector[]

shape PageTab
  id: string
  title: string
  url: string

shape Computer
  ok: bool
  tabs: PageTab[]
  image: string
  error: string

fn nameOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.name, case none => "" }
fn labelOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.ready ? (b.label != "" ? b.label : "Ready to chat") : "Getting set up…", case none => "" }
fn initialsOf(name: string): string = name.trim().split(" ").filter(w => w != "").slice(0, 2).map(w => w.slice(0, 1).toUpperCase()).join("")
fn botCountLabel(n: number): string = n == 1 ? "1 Bot" : `${n} Bots`
// Colours come from design/tokens.json: change them there.
// design:begin colours
fn pickerColours(): string[] = ["brand.default", "brand.blue", "brand.violet", "brand.pink", "brand.orange", "brand.green"]
fn avatarInk(c: string): string = c == "brand.black" || c == "brand.brown" || c == "brand.gray" ? "ink.light" : "ink.dark"
// design:end colours
fn colorOf(bots: Bot[], slug: string): string = match first(bots.filter(b => b.slug == slug)) { case some(b) => b.color, case none => "brand.default" }
fn kindTitle(k: string): string = k == "project" ? "Projects" : k == "task" ? "Tasks" : k == "plan" ? "Plans" : k == "machine" ? "Machines" : k == "service" ? "Services" : k == "repo" ? "Repos" : k == "note" ? "Notes" : "Links"
fn nText(n: number, one: string, many: string): string = n == 1 ? `1 ${one}` : `${n} ${many}`
fn usageLine(m: number, a: number, v: number, i: number): string = `${nText(m, "message", "messages")}, ${nText(a, "attachment", "attachments")}, ${nText(v, "vault write", "vault writes")}, and ${nText(i, "icon fetch", "icon fetches")} on this machine.`
fn libraryLine(n: number, name: string): string = n == 1 ? `1 thing with ${name}.` : `${n} things with ${name}.`
fn filterLabel(f: string): string = f == "all" ? "All" : f == "page" ? "Pages" : f == "media" ? "Media" : f == "link" ? "Links" : f == "file" ? "Files" : f == "project" ? "Projects" : f == "note" ? "Notes" : f == "task" ? "Tasks" : f == "plan" ? "Plans" : "More"
fn shownKind(kind: string, filter: string): bool = filter == "all" or kind == filter or (filter == "more" and (kind == "repo" or kind == "machine" or kind == "service"))
fn keptHere(id: string): bool = not id.startsWith("file:") and not id.startsWith("attachment:") and not id.startsWith("http://") and not id.startsWith("https://")
fn kindLabel(k: string): string = k == "page" ? "Page" : k == "media" ? "Media" : k == "file" ? "File" : k == "project" ? "Project" : k == "task" ? "Task" : k == "plan" ? "Plan" : k == "note" ? "Note" : k == "link" ? "Link" : k == "repo" ? "Repo" : k == "machine" ? "Machine" : k == "service" ? "Service" : "Item"
fn statusWord(s: string): string = s == "todo" ? "To do" : s == "doing" ? "Doing" : s == "waiting" ? "Waiting" : s == "done" ? "Done" : s == "active" ? "Active" : s == "paused" ? "Paused" : s == "idea" ? "Idea" : s == "draft" ? "Draft" : s == "online" ? "Online" : s == "offline" ? "Offline" : s == "unknown" ? "Unknown" : s == "running" ? "Running" : s == "stopped" ? "Stopped" : s == "failing" ? "Failing" : s == "archived" ? "Archived" : s
fn routineKindLabel(k: string): string = k == "day" ? "Daily" : k == "once" ? "Once" : "Hourly"
fn attachmentName(entry: string): string = match entry.split("\\t").at(-1) { case some(name) => name, case none => "Attachment" }
fn themeLabel(t: string): string = t == "system" ? "System" : t == "dark" ? "Dark" : "Light"
// Face colours are plain names; Bot colours are brand.* tokens from the design package.
fn faceColor(c: string): string = c == "brand.default" ? "teal" : c == "brand.blue" ? "blue" : c == "brand.violet" ? "violet" : c == "brand.pink" ? "pink" : c == "brand.orange" ? "orange" : c == "brand.green" ? "green" : c == "brand.black" ? "black" : c == "brand.white" ? "white" : c == "brand.brown" ? "brown" : c == "brand.red" ? "red" : c == "brand.amber" ? "amber" : c == "brand.yellow" ? "yellow" : c == "brand.cyan" ? "cyan" : c == "brand.purple" ? "purple" : c == "brand.magenta" ? "magenta" : c == "brand.gray" ? "gray" : "teal"

component Bots
  state password = ""
  state draft = ""
  state newName = ""
  state newColor = "brand.default"
  state nameDraft = ""
  state nameEditing = false
  state newPassword = ""
  state botQuery = ""
  state vaultQuery = ""
  // Wide windows show the Bot's panel beside the chat, like Threebot's desktop.
  state wide = false
  // The right panel (the Bot's settings) opens and closes from the chat header's
  // Bot name. It opens by default when the window turns wide.
  state panelOpen = false
  state panelTab = "details"
  // Each entry is `id\\tname` for a file waiting to go out with the next send.
  state pendingAttaches: string[] = []
  // The page the person is driving. Cleared after Release, including when they leave.
  state wantHold = false
  state heldTab = ""
  resource session = loadSession() as shape Session else empty()
  resource bots = loadBots() as shape Bot[] else empty()
  resource chat = loadChat(slug) as shape Chat else empty()
  resource prefs = loadPrefs() as shape Prefs else empty()
  resource vault = loadVault() as shape Login[] else empty()
  resource board = loadProjects() as shape Project[] else empty()
  resource usage = loadUsage(usageGate) as shape Usage else empty()
  resource models = loadModels(slug, detailGate) as shape ModelList else empty()
  resource routines = loadRoutines(slug, detailGate) as shape RoutineList else empty()
  resource lineage = loadLineage(slug, detailGate) as shape Lineage else empty()
  resource library = loadLibrary(slug, libraryGate) as shape Library else empty()
  resource computer = loadComputer(slug, computerGate) as shape Computer else empty()
  mutation signedIn as shape Reply refreshes session, bots
  mutation signedOut as shape Reply refreshes session, bots
  mutation created as shape Reply refreshes bots then afterCreate
  mutation sent as shape Reply refreshes chat then afterSend
  mutation stopped as shape Reply refreshes chat
  mutation renamed as shape Reply refreshes bots
  mutation recoloured as shape Reply refreshes bots
  mutation hidSaved as shape Reply refreshes bots
  mutation mainSaved as shape Reply refreshes bots
  mutation botRemoved as shape Reply refreshes bots then afterBotRemove
  mutation prefsSaved as shape Reply refreshes prefs
  mutation passwordSet as shape Reply refreshes session then afterPassword
  mutation loginSaved as shape Reply refreshes vault then afterLoginSave
  mutation loginRemoved as shape Reply refreshes vault then afterLoginRemove
  mutation revealed as shape Revealed
  mutation projectSaved as shape Reply refreshes board then afterProjectSave
  mutation projectRemoved as shape Reply refreshes board then afterProjectRemove
  mutation attached as shape Attached then afterAttach
  mutation modelSaved as shape Reply refreshes models
  mutation routineSaved as shape Reply refreshes routines
  mutation routineChanged as shape Reply refreshes routines
  mutation libSaved as shape Reply refreshes library
  mutation libRemoved as shape Reply refreshes library
  mutation connectorSaved as shape Reply refreshes library
  mutation connectorRemoved as shape Reply refreshes library
  mutation controlled as shape Reply refreshes computer then afterControl
  derive slug = match stack(nav).filter(e => e.name == "chat" or e.name == "library" or e.name == "computer").at(-1) { case some(e) => e.params.slug, case none => "" }
  derive signInError = match signedIn { case some(r) => r.error, case none => "" }
  derive createError = match created { case some(r) => r.error, case none => "" }
  derive sendError = match sent { case some(r) => r.error, case none => "" }
  derive lastId = match chat.rows.at(-1) { case some(m) => m.id, case none => "" }
  derive locked = session.passwordRequired and not session.authenticated
  derive query = botQuery.trim().toLowerCase()
  derive visibleBots = bots.filter(b => not b.hidden and (query == "" or b.name.toLowerCase().includes(query) or b.label.toLowerCase().includes(query)))
  derive hiddenBots = bots.filter(b => b.hidden and (query == "" or b.name.toLowerCase().includes(query) or b.label.toLowerCase().includes(query)))
  derive vquery = vaultQuery.trim().toLowerCase()
  derive shownVault = vault.filter(v => vquery == "" or v.title.toLowerCase().includes(vquery) or v.username.toLowerCase().includes(vquery) or v.website.toLowerCase().includes(vquery))
  derive renameError = match renamed { case some(r) => r.error, case none => "" }
  derive colourError = match recoloured { case some(r) => r.error, case none => "" }
  derive hideError = match hidSaved { case some(r) => r.error, case none => "" }
  derive mainError = match mainSaved { case some(r) => r.error, case none => "" }
  derive botError = renameError != "" ? renameError : colourError != "" ? colourError : hideError != "" ? hideError : mainError
  derive botRemoveError = match botRemoved { case some(r) => r.error, case none => "" }
  derive prefsError = match prefsSaved { case some(r) => r.error, case none => "" }
  derive passwordError = match passwordSet { case some(r) => r.error, case none => "" }
  derive loginError = match loginSaved { case some(r) => r.error, case none => "" }
  derive loginRemoveError = match loginRemoved { case some(r) => r.error, case none => "" }
  derive revealedFor = match revealed { case some(r) => r.id, case none => "" }
  derive revealedText = match revealed { case some(r) => (r.ok ? r.password : ""), case none => "" }
  derive projectError = match projectSaved { case some(r) => r.error, case none => "" }
  derive projectRemoveError = match projectRemoved { case some(r) => r.error, case none => "" }
  derive attachError = match attached { case some(r) => r.error, case none => "" }
  derive canSend = draft.trim() != "" or pendingAttaches.length > 0
  derive onBot = top(nav).name == "chat" or top(nav).name == "library" or top(nav).name == "computer"
  derive onLibrary = top(nav).name == "library" or (top(nav).name == "chat" and panelTab == "library")
  derive onComputer = top(nav).name == "computer" or (top(nav).name == "chat" and panelOpen and panelTab == "computer")
  derive detailGate = (onBot and slug != "") ? "1" : "0"
  derive libraryGate = (onLibrary and slug != "") ? "1" : "0"
  derive computerGate = (onComputer and slug != "") ? "1" : "0"
  derive usageGate = top(nav).name == "settings" ? "1" : "0"
  derive modelError = match modelSaved { case some(r) => r.error, case none => "" }
  derive routineSaveError = match routineSaved { case some(r) => r.error, case none => "" }
  derive routineChangeError = match routineChanged { case some(r) => r.error, case none => "" }
  derive libError = match libSaved { case some(r) => r.error, case none => "" }
  derive libRemoveError = match libRemoved { case some(r) => r.error, case none => "" }
  derive connectorSaveError = match connectorSaved { case some(r) => r.error, case none => "" }
  derive connectorRemoveError = match connectorRemoved { case some(r) => r.error, case none => "" }
  derive controlError = match controlled { case some(r) => r.error, case none => "" }
  derive holding = wantHold and controlError == "" and not pending(controlled)

  // Chats are read while they are open; the inbox while it is.
  task poll mount
    every(1500, pull)

  task fit mount
    every(200, fitView)

  task letGo when holding and not onComputer
    after(1, releaseHeld)

  action fitView
    let box = frame("app-shell")
    // A missing measurement is not a resize. Keep the last stable layout.
    if not box.unavailable and box.width > 0
      let w = box.width >= 1200
      if w != wide
        wide = w
        panelOpen = w
  action togglePanel
    panelOpen = not panelOpen
    if failed(models)
      refresh models
    if failed(routines)
      refresh routines
  action pickPanelTab(tab: string)
    panelTab = tab
  action openHidden(bslug: string)
    panelTab = "details"
    panelOpen = true
    nav = go(nav, path("chat", bslug))

  action pull
    refresh bots
    refresh chat
    if top(nav).name == "settings"
      refresh usage
    if onLibrary
      refresh library
    if onComputer
      refresh computer
    if onBot and panelOpen and panelTab == "details"
      refresh lineage
    if top(nav).name == "projects"
      refresh board
  action editPassword(v: string)
    password = v
  action login
    if password != "" and not pending(signedIn)
      send signedIn = signIn(password)
      password = ""
  action logout
    send signedOut = signOut()
  // A wide window shows the list beside the open chat. Opening another Bot
  // replaces that chat, so the conversation swaps instead of stacking.
  action open(url: string)
    nav = top(nav).name == "chat" and url.startsWith("/bot/") and not url.includes("/library") and not url.includes("/computer") ? replace(nav, url) : go(nav, url)
  action back
    nav = back(nav)
  action openNew
    newName = ""
    newColor = "brand.default"
    nav = push(nav, "/new")
  action editBotQuery(v: string)
    botQuery = v
  action editVaultQuery(v: string)
    vaultQuery = v
  action editName(v: string)
    newName = v
  action pick(c: string)
    newColor = c
  action create
    if newName.trim() != "" and not pending(created)
      send created = createBot(newName.trim(), newColor)
  action afterCreate
    if createError == "" and top(nav).name == "create"
      nav = back(nav)
  action edit(v: string)
    draft = v
  action pickFiles
    showPicker("chat-attach")
  action filesPicked(files: Picked[])
    if slug != "" and not pending(attached) and files.length > 0
      match files.at(0)
        case some(f)
          send attached = uploadAttachment(slug, f.path, f.name, f.type)
        case none
  action afterAttach
    match attached
      case some(r)
        if r.ok and r.id != ""
          pendingAttaches = pendingAttaches.concat([`${r.id}\\t${r.name}`])
      case none
  action dropPending(entry: string)
    pendingAttaches = pendingAttaches.filter(e => e != entry)
  action post
    if canSend and not pending(sent)
      // pendingAttaches entries are `id\\tname`; the data module keeps the ids.
      send sent = sendMessage(slug, draft.trim(), pendingAttaches.join("\n"))
      draft = ""
    focus("composer")
  action afterSend
    if sendError == ""
      pendingAttaches = []
    toEnd()
  action stop
    send stopped = stopRun(slug)
  action toEnd
    scrollIntoView("transcript", lastId, block="end")
  // Bot details: a Bot's name, colour, visibility and main status, and its deletion.
  action doRename(bslug: string, name: string)
    if name.trim() != ""
      send renamed = renameBot(bslug, name.trim())
  action doRecolour(bslug: string, color: string)
    send recoloured = recolourBot(bslug, color)
  action doHide(bslug: string, on: bool)
    send hidSaved = hideBot(bslug, on)
  action doMain(bslug: string)
    send mainSaved = makeMainBot(bslug)
  action doDropBot(bslug: string)
    send botRemoved = deleteBot(bslug)
  action afterBotRemove
    if botRemoveError == ""
      nav = go(nav, "/")

  // Settings: name, theme, the Projects beta and the remote-access password.
  action doEditName(v: string)
    nameDraft = v
    nameEditing = true
  action doSaveName(v: string)
    nameEditing = false
    if v.trim() != "" and v.trim() != prefs.userName
      send prefsSaved = setUserName(v.trim())
  action doPickTheme(t: string)
    send prefsSaved = setTheme(t)
  action doSetBeta(on: bool)
    send prefsSaved = setProjects(on)
  action editNewPassword(v: string)
    newPassword = v
  action doSavePassword
    if newPassword != "" and not pending(passwordSet)
      send passwordSet = setPassword(newPassword)
  action afterPassword
    if passwordError == ""
      newPassword = ""

  // Vault: a login is edited in a sheet. The password is kept unless a new one is typed.
  action doCommitLogin(id: string, title: string, website: string, username: string, password: string, hints: string)
    if (title.trim() != "" or website.trim() != "") and not pending(loginSaved)
      send loginSaved = saveLogin(id, title.trim(), website.trim(), username.trim(), password, hints.trim())
  action afterLoginSave
    if loginError == ""
      nav = back(nav)
  action doDropLogin(id: string)
    send loginRemoved = deleteLogin(id)
  action afterLoginRemove
    if loginRemoveError == ""
      nav = back(nav)
  action doReveal(id: string)
    if not pending(revealed)
      send revealed = revealPassword(id)
  action doHideReveal
    revealed = none
  action doCloseLogin
    revealed = none
    nav = back(nav)

  // Projects: a board of items by kind, edited in a sheet.
  action doCommitProject(id: string, kind: string, title: string, status: string, area: string, body: string)
    if title.trim() != "" and not pending(projectSaved)
      send projectSaved = saveProject(id, kind, title.trim(), status.trim(), area.trim(), body)
  action afterProjectSave
    if projectError == ""
      nav = back(nav)
  action doDropProject(id: string)
    send projectRemoved = deleteProject(id)
  action afterProjectRemove
    if projectRemoveError == ""
      nav = back(nav)

  action doPickModel(bslug: string, instanceId: string, model: string)
    if not pending(modelSaved)
      send modelSaved = setModel(bslug, instanceId, model)
  action doAddRoutine(bslug: string, title: string, kind: string)
    if title.trim() != "" and not pending(routineSaved)
      send routineSaved = saveRoutine(bslug, title.trim(), kind)
  action doToggleRoutine(bslug: string, id: string, on: bool)
    send routineChanged = setRoutineEnabled(bslug, id, on)
  action doRunRoutine(bslug: string, id: string)
    send routineChanged = runRoutine(bslug, id)
  action doDropRoutine(bslug: string, id: string)
    send routineChanged = deleteRoutine(bslug, id)
  action doSaveLibrary(bslug: string, id: string, kind: string, title: string, status: string, body: string)
    if title.trim() != "" and not pending(libSaved)
      send libSaved = saveLibraryItem(bslug, id, kind, title.trim(), status, body)
  action doDropLibrary(bslug: string, id: string)
    send libRemoved = deleteLibraryItem(bslug, id)
  action doSaveConnector(bslug: string, name: string, url: string, enabled: bool, secret: string)
    if name.trim() != "" and url.trim() != "" and not pending(connectorSaved)
      send connectorSaved = saveConnector(bslug, name.trim(), url.trim(), enabled, secret)
  action doDropConnector(bslug: string, name: string)
    send connectorRemoved = deleteConnector(bslug, name)
  action doTake(tab: string)
    wantHold = true
    heldTab = tab
    send controlled = computerControl(slug, tab, "take")
  action doRelease
    wantHold = false
    if heldTab != ""
      send controlled = computerControl(slug, heldTab, "release")
  action releaseHeld
    wantHold = false
    if heldTab != ""
      send controlled = computerControl(slug, heldTab, "release")
  action afterControl
    if not wantHold
      heldTab = ""

  view
    main id="app-shell" class=Screen navigationKey=`${top(nav).id}` navigationBack="back" navigate=open interactive-widget="resizes-content" width="100%" height="100%" testId="app"
      if locked
        column flex=1 justify-content="center" align-items="center" padding="space.xl" testId="sign-in"
          column width="100%" max-width="22rem" gap="space.lg" box-sizing="border-box" padding="space.xl" border="1px solid surface.line" border-radius="radius.lg" background-color="surface.card"
            column align-items="center" gap="space.sm"
              Face(shape="ball", color="teal", state="idle", size=72, still=false)
              text "hbots" role="heading" aria-level=1 class=HeroTitle
              text "Your own Bots, in one place." color="-exact-secondary-label"
            text "Enter the password you set in Settings → Remote access." color="-exact-secondary-label"
            input appearance="none" class=Field type="password" value=password input=editPassword submit=login placeholder="Password" aria-label="Password" testId="password" width="100%"
            if signInError != "" and not pending(signedIn)
              text signInError color="-exact-system-red" testId="sign-in-error"
            button press=login disabled=(password == "" or pending(signedIn)) buttonStyle="filled" testId="sign-in-button"
              text (pending(signedIn) ? "Signing in…" : "Sign In")
      else
        for e in stack(nav) key=e.id
          if e.name == "inbox"
            column class=Screen background-color="surface.sidebar" navigationSplit="288" navigationKey=`${e.id}` navigationScroll="bots-list" position="absolute" inset=0
              header class=PageHeader background-color="surface.sidebar" flex-wrap="wrap"
                text "hbots" role="heading" aria-level=1 font-size=22 font-weight=700 letter-spacing="-0.6px" flex=1
                button class=IconControl appearance="none" press=openNew aria-label="New Bot" title="New Bot" testId="new-bot" color="AccentColor" background-color="surface.soft"
                  Glyph(name="add", size=20)
                input type="search" class=SearchField value=botQuery input=editBotQuery placeholder="Search Bots" aria-label="Search Bots" testId="bot-search" width="100%"
              column navigationSplit="placeholder" flex=1 align-items="center" justify-content="center" gap="space.lg" padding="space.xl"
                Face(shape="ball", color="teal", state="idle", size=72, still=false)
                text "Your own Bots, in one place." class=HeroTitle text-align="center"
                text "Choose a Bot to pick up where you left off, or create someone new." color="ink.muted" text-align="center" max-width="24rem"
                button class=PrimaryButton press=openNew buttonStyle="filled"
                  text "New Bot"
              if failed(bots) and bots.length == 0
                EmptyState(symbol="symbol:alert", title="Can’t Reach the Gateway", message="Start the `hbots` gateway on this machine or on your server, then try again.")
                  button press=pull testId="retry"
                    text "Try Again"
              else if bots.length == 0 and not pending(bots)
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="empty-bots"
                  Face(shape="ball", color="teal", state="idle", size=72, still=false)
                  text "Meet your first Bot" role="heading" aria-level=2 class=PageTitle
                  text "Give your Bot a name, then make it your own. Your conversations stay together, right here." color="-exact-secondary-label" text-align="center" max-width="22rem"
                  button press=openNew buttonStyle="filled" testId="empty-new"
                    text "Create Your First Bot"
              else if query != "" and visibleBots.length == 0 and hiddenBots.length == 0
                column flex=1 min-height=0 align-items="center" justify-content="center" padding="space.xl" testId="no-bot-match"
                  EmptyState(symbol="symbol:search", title=`No Bots match “${botQuery.trim()}”`, message="Check the spelling, or clear the search to see every Bot.")
              else
                list id="bots-list" appearance="none" flex=1 min-height=0 padding="space.xs space.sm" gap="space.xs"
                  for b in visibleBots key=b.slug
                    link class=ConversationLink href=path("chat", b.slug) testId=`bot-${b.slug}` background-color=(slug == b.slug ? "surface.card" : "transparent")
                      row gap="space.md" align-items="center"
                        Face(shape="ball", color=faceColor(b.color), state=(b.ready ? "idle" : "asleep"), size=40, still=true)
                        column gap="2px" flex=1 min-width=0
                          row gap="space.xs" align-items="center"
                            text b.name font-weight=600 flex=1 min-width=0 overflow-wrap="break-word"
                            if b.main
                              column color="AccentColor"
                                Glyph(name="star", size=12)
                          text (b.ready ? (b.label != "" ? b.label : "Ready to chat") : "Getting set up…") color="ink.muted" font="-exact-footnote" overflow-wrap="break-word"
                  if hiddenBots.length > 0
                    text "Hidden Bots" padding="space.lg space.md space.xs" font="-exact-footnote" color="ink.muted"
                    for b in hiddenBots key=b.slug
                      button class=ConversationLink appearance="none" press=openHidden(b.slug) testId=`hidden-${b.slug}`
                        row gap="space.md" align-items="center"
                          Face(shape="ball", color=faceColor(b.color), state="asleep", size=32, still=true)
                          text b.name flex=1 color="ink.muted"
              row padding="space.sm space.md" border-top="1px solid surface.line"
                link href="/settings" aria-label="Settings" title="Settings" testId="open-settings" color="-exact-label" text-decoration="none" flex=1 min-width=0
                  row align-items="center" gap="space.md"
                    column width="2rem" height="2rem" border-radius="radius.full" background-color="surface.soft" color="AccentColor" align-items="center" justify-content="center"
                      if initialsOf(prefs.userName) != ""
                        text initialsOf(prefs.userName) font="-exact-footnote" font-weight=600
                      else
                        Glyph(name="person", size=16)
                    column flex=1 min-width=0 gap="2px"
                      text (prefs.userName != "" ? prefs.userName : "You") font-weight=600 overflow-wrap="break-word" testId="you-name"
                      text botCountLabel(bots.length) color="ink.muted" font="-exact-footnote"
                    column color="ink.muted"
                      Glyph(name="settings", size=20)
          else if e.name == "chat"
            column class=Screen navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0 padding-right=((wide and panelOpen) ? "20rem" : "0px")
              header appearance="none" class=PageHeader position="relative" testId="chat-header"
                button id="back" class=IconControl appearance="none" press=back aria-label="Back" title="Back" display=(wide ? "none" : "flex")
                  column rotate="180deg"
                    Glyph(name="chevron", size=20)
                button class=HeaderToggle appearance="none" press=togglePanel aria-label=(panelOpen ? "Hide Bot details" : "Show Bot details") aria-expanded=panelOpen aria-controls="bot-panel" title="Bot settings" testId="panel-toggle" position="absolute" left="50%" translate="-50% 0" gap="space.sm" padding="0 space.md" max-width="75%"
                  if nameOf(bots, e.params.slug) != ""
                    column testId="chat-avatar"
                      Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state=(chat.working ? "working" : "idle"), size=28, still=true)
                  text nameOf(bots, e.params.slug) role="heading" aria-level=1 class=PageTitle overflow-wrap="anywhere" testId="chat-title" min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
              if failed(chat)
                EmptyState(symbol="symbol:alert", title="Can’t Load This Conversation", message="Your messages haven’t loaded. Check the gateway, then try again.")
                  button press=pull testId="retry-chat"
                    text "Try Again"
              else if pending(chat) and chat.rows.length == 0
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" aria-busy=true
                  Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state="working", size=44, still=false)
                  text "Loading your conversation…" color="ink.muted"
              else if chat.rows.length == 0 and not chat.working
                column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="empty-chat"
                  Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state="idle", size=72, still=false)
                  text nameOf(bots, e.params.slug) class=HeroTitle
                  text "A little help, a new idea, or just a hello." color="ink.muted" text-align="center"
                  column gap="space.sm" width="100%" max-width="24rem" margin-top="space.lg"
                    button press=edit("Help me make a plan for today.") class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-plan"
                      text "Make a plan for today"
                    button press=edit("I have an idea I’d like to think through.") class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-idea"
                      text "Think through an idea"
                    button press=edit("What can we work on together?") class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-help"
                      text "See what we can do together"
              else
                column flex=1 min-height=0 justify-content="flex-end"
                  list id="transcript" testId="transcript" width="100%" max-width="46rem" align-self="center" box-sizing="border-box" padding="space.xl 0" appearance="none" virtualized=true scroll-start="end" scrollFollowEnd=true max-height="100%" min-height=0 flex-shrink=1
                    for m in chat.rows key=m.id
                      column
                        if m.kind == "message"
                          row justify-content=(m.mine ? "flex-end" : "flex-start") padding=(m.head ? "space.sm space.lg" : "2px space.lg")
                            column gap="space.xs" max-width="82%" align-items=(m.mine ? "flex-end" : "flex-start")
                              if m.text != ""
                                text m.text class=Bubble testId=`message-${m.id}`
                                  background-color=(m.mine ? "brand.default" : "surface.card")
                                  color=(m.mine ? "ink.dark" : "-exact-label")
                                  border-top-left-radius="radius.lg"
                                  border-top-right-radius="radius.lg"
                                  border-bottom-left-radius=((not m.mine and m.tail) ? "radius.sm" : "radius.lg")
                                  border-bottom-right-radius=((m.mine and m.tail) ? "radius.sm" : "radius.lg")
                              if m.files != ""
                                text m.files class=FileChip testId=`files-${m.id}`
                                  background-color=(m.mine ? "brand.default" : "surface.card")
                                  color=(m.mine ? "ink.dark" : "-exact-secondary-label")
                                  border=(m.mine ? "none" : "1px solid surface.line")
                        else if m.kind == "request"
                          row padding=(m.head ? "space.sm space.md" : "2px space.md")
                            column gap="space.xs" padding="space.md space.lg" border-radius="radius.lg" background-color="surface.card" border="1px solid surface.line" flex=1 testId=`request-${m.id}`
                              row gap="space.sm" align-items="center"
                                column color="AccentColor"
                                  Glyph(name="info", size=16)
                                text m.text font-weight=600 flex=1 min-width=0
                              text "Answer this in T3 Code for now. It will show up here once the Bot can take your answer." color="-exact-secondary-label" font="-exact-footnote"
                        else
                          row padding="space.sm space.lg" gap="space.sm" align-items="center" testId="working"
                            Face(shape="ball", color=faceColor(colorOf(bots, e.params.slug)), state="working", size=24, still=false)
                            text "Working…" class=Bubble background-color="surface.card" color="-exact-secondary-label" border-top-left-radius="radius.lg" border-top-right-radius="radius.lg" border-bottom-left-radius="radius.sm" border-bottom-right-radius="radius.lg"
              if sendError != "" and not pending(sent)
                text sendError color="-exact-system-red" padding="0 space.lg" testId="send-error"
              if attachError != "" and not pending(attached)
                text attachError color="-exact-system-red" padding="0 space.lg" testId="attach-error"
              if pendingAttaches.length > 0
                row gap="space.sm" flex-wrap="wrap" padding="0 space.md space.xs" testId="pending-files"
                  for entry in pendingAttaches key=entry
                    row gap="space.xs" align-items="center" padding="4px 6px 4px space.sm" border="1px solid surface.line" border-radius="radius.full" background-color="surface.card" max-width="100%" box-sizing="border-box"
                      column color="ink.muted"
                        Glyph(name="attach", size=14)
                      text attachmentName(entry) font="-exact-footnote" color="-exact-label" overflow-wrap="anywhere" flex=1 min-width=0
                      button class=IconControl appearance="none" press=dropPending(entry) aria-label=`Remove ${attachmentName(entry)}` title="Remove attachment" testId="pending-file" width=28 height=28
                        Glyph(name="close", size=14)
              row align-items="flex-end" width="calc(100% - 32px)" max-width="44rem" align-self="center" box-sizing="border-box" margin="space.md space.lg space.xl" padding="space.xs" gap="space.xs" border-radius="radius.lg" border="1px solid surface.line"
                button class=IconControl press=pickFiles disabled=(slug == "" or pending(attached) or pendingAttaches.length >= 8) appearance="none" aria-label="Attach a file" testId="attach" width=36 height=36 border-radius="radius.full"
                  Glyph(name="attach", size=20)
                input type="file" id="chat-attach" display="none" change=filesPicked testId="chat-attach"
                textarea id="composer" value=draft input=edit rows=1 field-sizing="content" max-height=140 placeholder="Write a message…" aria-label="Message" testId="composer" flex=1 min-width=0 padding="space.sm space.xs" border="none" background-color="transparent" color="-exact-label"
                if chat.working and not canSend
                  button class=StopControl appearance="none" press=stop margin="2px 0" aria-label="Stop" testId="stop"
                    Glyph(name="stop", size=16)
                else
                  button class=SendControl appearance="none" press=post disabled=(not canSend or pending(sent)) margin="2px 0" retainFocus=true aria-label="Send" testId="send"
                    Glyph(name="send", size=18)
              for b in bots.filter(x => x.slug == e.params.slug) key=b.slug
                BotPanel(working=chat.working, shown=panelOpen, tab=panelTab, pickTab=pickPanelTab, wide=wide, bot=b, error=botError, rename=doRename, recolour=doRecolour, hide=doHide, makeMain=doMain, drop=doDropBot, go=open, models=models, modelsDown=failed(models), routines=routines, routinesDown=failed(routines), lineage=lineage, lineageDown=failed(lineage), modelError=modelError, routineSaveError=routineSaveError, routineChangeError=routineChangeError, pickModel=doPickModel, addRoutine=doAddRoutine, toggleRoutine=doToggleRoutine, runRoutine=doRunRoutine, dropRoutine=doDropRoutine, library=library, libraryDown=failed(library), itemError=libError, removeError=libRemoveError, connectorSaveError=connectorSaveError, connectorRemoveError=connectorRemoveError, saveItem=doSaveLibrary, dropItem=doDropLibrary, saveConnector=doSaveConnector, dropConnector=doDropConnector, computer=computer, computerDown=failed(computer), heldTab=heldTab, controlError=controlError, take=doTake, release=doRelease)
          else if e.name == "library"
            LibraryScreen(route=e.id, slug=e.params.slug, name=nameOf(bots, e.params.slug), color=colorOf(bots, e.params.slug), library=library, down=failed(library), itemError=libError, removeError=libRemoveError, connectorSaveError=connectorSaveError, connectorRemoveError=connectorRemoveError, saveItem=doSaveLibrary, dropItem=doDropLibrary, saveConnector=doSaveConnector, dropConnector=doDropConnector)
          else if e.name == "computer"
            ComputerScreen(route=e.id, slug=e.params.slug, name=nameOf(bots, e.params.slug), color=colorOf(bots, e.params.slug), computer=computer, down=failed(computer), heldTab=heldTab, controlError=controlError, take=doTake, release=doRelease)
          else if e.name == "settings"
            column class=Screen navigationKey=`${e.id}` navigationScroll="settings-form" position="absolute" inset=0
              header class=PageHeader
                text "Settings" role="heading" aria-level=1 class=PageTitle flex=1
              list id="settings-form" class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                section
                  row
                    text "Name"
                    input appearance="none" class=Field value=(nameEditing ? nameDraft : prefs.userName) input=doEditName change=doSaveName placeholder="Your name" aria-label="Your name" text-align="end" flex=1 min-width=0 testId="user-name"
                section
                  header
                    text "Appearance"
                  row gap="space.xs" padding="space.xs" role="radiogroup" aria-label="Theme"
                    for t in ["system", "light", "dark"] key=t
                      button press=doPickTheme(t) role="radio" aria-checked=(prefs.theme == t) class=Segment appearance="none" flex=1 testId=`theme-${t}`
                        background-color=(prefs.theme == t ? "AccentColor" : "transparent")
                        color=(prefs.theme == t ? "AccentColorText" : "-exact-label")
                        text themeLabel(t)
                section
                  header
                    text "This machine"
                  if failed(usage)
                    text "Can’t load usage. Check that hbots is running, then try again." color="-exact-system-red" testId="usage-line"
                  else if usage.ok and usage.messages == 0 and usage.attachments == 0 and usage.vaultWrites == 0 and usage.iconFetches == 0
                    text "Nothing counted yet." color="ink.muted" testId="usage-line"
                  else if usage.ok
                    text usageLine(usage.messages, usage.attachments, usage.vaultWrites, usage.iconFetches) testId="usage-line"
                  footer
                    text "Counted on this machine. Nothing is sent anywhere."
                section
                  header
                    text "Private data"
                  button press=open("/vault") testId="open-vault"
                    row gap="space.md" align-items="center"
                      column class=IconTile color="AccentColor"
                        Glyph(name="lock", size=18)
                      column flex=1 gap="space.xs" min-width=0
                        text "Vault" font-weight=600
                        text "Manage saved logins" color="ink.muted" font="-exact-footnote"
                      Glyph(name="chevron", size=18)
                section
                  header
                    text "Remote access"
                  row align-items="center" gap="space.md"
                    column class=IconTile color="ink.muted"
                      Glyph(name="globe", size=18)
                    input appearance="none" class=Field type="password" value=newPassword input=editNewPassword submit=doSavePassword placeholder=(session.passwordRequired ? "New password" : "Set a password") aria-label="Password" autocomplete="new-password" flex=1 min-width=0 testId="new-password"
                  if passwordError != "" and not pending(passwordSet)
                    text passwordError color="-exact-system-red" testId="password-error"
                  button press=doSavePassword disabled=(newPassword == "" or pending(passwordSet)) testId="save-password"
                    text (session.passwordRequired ? "Change Password" : "Set Password")
                  footer
                    text "Anyone who opens hbots from another device signs in with this password."
                if session.passwordRequired
                  section
                    button press=logout testId="sign-out"
                      text "Sign Out"
          else if e.name == "vault"
            column class=Screen navigationKey=`${e.id}` navigationScroll="vault-list" position="absolute" inset=0
              header class=PageHeader flex-wrap="wrap"
                text "Vault" role="heading" aria-level=1 class=PageTitle flex=1
                button class=IconControl appearance="none" press=open("/vault/new") aria-label="New Login" title="New Login" testId="new-login"
                  Glyph(name="add", size=20)
                input type="search" class=SearchField value=vaultQuery input=editVaultQuery placeholder="Search Vault" aria-label="Search Vault" testId="vault-search" width="100%"
              if failed(vault)
                EmptyState(symbol="symbol:alert", title="Can’t Open the Vault", message="Check that `hbots` is running, then try again.")
              else if vault.length == 0 and not pending(vault)
                EmptyState(symbol="symbol:lock", title="No Logins Yet", message="Save a login here. Its password stays in the Vault and shows only when you press Reveal.")
                  button press=open("/vault/new") testId="empty-login"
                    text "Add a Login"
              else if vquery != "" and shownVault.length == 0
                column flex=1 min-height=0 align-items="center" justify-content="center" padding="space.xl" testId="no-vault-match"
                  EmptyState(symbol="symbol:search", title=`No logins match “${vaultQuery.trim()}”`, message="Check the spelling, or clear the search to see every login.")
              else
                list id="vault-list" class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                  section
                    for v in shownVault key=v.id
                      link href=path("vaultEdit", v.id) testId=`login-${v.id}`
                        row class=BotRow
                          column class=IconTile color="AccentColor"
                            Glyph(name="lock", size=18)
                          column flex=1 min-width=0 gap="space.xs"
                            text v.title font-weight=600
                            text (v.username != "" ? v.username : v.website) color="ink.muted" font="-exact-footnote"
                          Glyph(name="chevron", size=20)
          else if e.name == "vaultAdd"
            LoginSheet(route=e.id, item=Login(id="", title="", website="", username="", hasPassword=false, hints=""), revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else if e.name == "vaultEdit"
            for l in vault.filter(x => x.id == e.params.id) key=l.id
              LoginSheet(route=e.id, item=l, revealedFor=revealedFor, revealedText=revealedText, error=loginError, save=doCommitLogin, reveal=doReveal, hide=doHideReveal, drop=doDropLogin, cancel=doCloseLogin)
          else
            column class=Screen navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="new-form" position="absolute" inset=0
              header class=PageHeader
                button class=IconControl appearance="none" press=back aria-label="Cancel" title="Cancel" testId="new-cancel"
                  Glyph(name="close", size=20)
                text "New Bot" role="heading" aria-level=1 class=PageTitle flex=1
              scroll id="new-form" flex=1 min-height=0
                column width="100%" max-width="25rem" box-sizing="border-box" margin="0 auto" padding="space.xl" gap="space.xl"
                  column align-items="center" gap="space.md" padding="space.xl 0"
                    Face(shape="ball", color=faceColor(newColor), state="idle", size=96, still=false)
                    text "Pick a name and a colour." color="ink.muted" font="-exact-subheadline" text-align="center"
                  column gap="space.sm"
                    text "Name" font="-exact-subheadline" font-weight=600
                    input appearance="none" class=Field value=newName input=editName submit=create placeholder="What should we call your Bot?" aria-label="Name" padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="new-name"
                  column gap="space.md"
                    text "Colour" font="-exact-subheadline" font-weight=600
                    row gap="space.xs" flex-wrap="wrap"
                      for c in pickerColours() key=c
                        button class=SwatchControl press=pick(c) appearance="none" aria-label=`Colour ${faceColor(c)}` aria-pressed=(newColor == c) testId=`colour-${c}` width=44 height=44 padding=0
                          column width=36 height=36 box-sizing="border-box" margin="space.xs" border-radius="radius.full" background-color=c border=(newColor == c ? "3px solid AccentColor" : "3px solid transparent")
                  if createError != "" and not pending(created)
                    text createError color="-exact-system-red" testId="create-error"
              row padding="space.lg space.xl space.xl" width="100%" max-width="25rem" box-sizing="border-box" align-self="center"
                button class=PrimaryButton buttonStyle="filled" press=create disabled=(newName.trim() == "" or pending(created)) flex=1 testId="create"
                  text (pending(created) ? "Creating…" : "Create Bot")

// The Details tab: identity, inbox preferences, model, routines and activity.
// Its state stays mounted while the panel is closed or another tab is shown.
component BotEditor
  props
    bot: Bot
    error: string
    rename: action
    recolour: action
    hide: action
    makeMain: action
    drop: action
    go: action
    models: ModelList
    modelsDown: bool
    routines: RoutineList
    routinesDown: bool
    lineage: Lineage
    lineageDown: bool
    modelError: string
    routineSaveError: string
    routineChangeError: string
    pickModel: action
    addRoutine: action
    toggleRoutine: action
    runRoutine: action
    dropRoutine: action
  state name = bot.name
  state routineTitle = ""
  state routineKind = "hour"
  action edit(v: string)
    name = v
  action editRoutine(v: string)
    routineTitle = v
  action pickRoutineKind(k: string)
    routineKind = k
  action addThis
    if routineTitle.trim() != ""
      addRoutine(bot.slug, routineTitle, routineKind)
      routineTitle = ""
  view
    column width="100%" gap="space.lg"
      text "Identity" class=SectionLabel
      column class=GroupCard
        row align-items="center" gap="space.md" min-height=52
          text "Name" font="-exact-subheadline"
          input appearance="none" class=Field value=name input=edit change=rename(bot.slug) aria-label="Name" text-align="end" flex=1 min-width=0 testId="bot-name"
        column gap="space.xs" padding="space.sm 0" border-top="1px solid surface.line"
          text "Colour" font="-exact-subheadline"
          row gap="space.xs" flex-wrap="wrap"
            for c in pickerColours() key=c
              button class=SwatchControl press=recolour(bot.slug, c) appearance="none" aria-label=`Colour ${faceColor(c)}` aria-pressed=(bot.color == c) testId=`colour-${c}` width=36 height=36 padding=0
                column width=28 height=28 box-sizing="border-box" border-radius="radius.full" background-color=c border=(bot.color == c ? "2px solid AccentColor" : "2px solid transparent")
      text "Inbox" class=SectionLabel
      column class=GroupCard
        row align-items="center" gap="space.md" min-height=64
          column class=IconTile color="AccentColor"
            Glyph(name="star", size=18)
          column flex=1 gap="space.xs" min-width=0
            text "Main Bot" font="-exact-subheadline" font-weight=600
            text (bot.main ? "Your default Bot" : "Make this your default Bot") color="ink.muted" font="-exact-footnote"
          if bot.main
            column color="AccentColor" aria-label="Main Bot" testId="is-main"
              Glyph(name="check", size=20)
          else
            button class=IconControl appearance="none" press=makeMain(bot.slug) aria-label="Make main Bot" title="Make main Bot" testId="make-main"
              Glyph(name="star", size=20)
        row align-items="center" gap="space.md" min-height=64 border-top="1px solid surface.line"
          column class=IconTile color="ink.muted"
            Glyph(name="eye-off", size=18)
          column flex=1 gap="space.xs" min-width=0
            text "Hide from inbox" font="-exact-subheadline" font-weight=600
            text "Keep this conversation tucked away" color="ink.muted" font="-exact-footnote"
          button class=ToggleControl appearance="none" role="switch" aria-checked=bot.hidden disabled=bot.main press=hide(bot.slug, not bot.hidden) aria-label="Hidden from the list" testId="hide-bot"
            row width=44 height=26 border-radius="radius.full" background-color=(bot.hidden ? "AccentColor" : "surface.line") align-items="center" justify-content=(bot.hidden ? "flex-end" : "flex-start")
              column width=20 height=20 margin="0 3px" border-radius="radius.full" background-color="ink.light"
      text "Model" class=SectionLabel
      column class=GroupCard gap="space.sm" padding="space.md"
        if modelsDown
          text "Can’t load models. Check that hbots is running, then try again." color="-exact-system-red" testId="model-error"
        else if models.choices.length == 0
          text "Getting set up…" color="ink.muted" testId="model-wait"
        else
          row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label="Model"
            for c in models.choices key=`${c.instanceId}-${c.model}`
              button press=pickModel(bot.slug, c.instanceId, c.model) role="radio" aria-checked=(models.current == c.model and models.instanceId == c.instanceId) class=Segment appearance="none" min-height=44 testId=`model-${c.model}`
                background-color=(models.current == c.model and models.instanceId == c.instanceId ? "AccentColor" : "transparent")
                color=(models.current == c.model and models.instanceId == c.instanceId ? "AccentColorText" : "-exact-label")
                text c.label
        if modelError != ""
          text modelError color="-exact-system-red" testId="model-save-error"
      text "Routines" class=SectionLabel
      column class=GroupCard
        if routinesDown
          text "Can’t load routines. Check that hbots is running, then try again." color="-exact-system-red" padding="space.sm 0" testId="routine-error"
        else if routines.error != "" and routines.tasks.length == 0
          text routines.error color="ink.muted" padding="space.sm 0" testId="routine-setup"
        else
          for task in routines.tasks key=task.id
            row align-items="center" gap="space.md" min-height=64 border-top="1px solid surface.line" testId=`routine-${task.id}`
              column flex=1 gap="space.xs" min-width=0
                text task.title font="-exact-subheadline" font-weight=600 overflow-wrap="anywhere"
                text task.schedule color="ink.muted" font="-exact-footnote"
              button class=QuietButton appearance="none" press=runRoutine(bot.slug, task.id) aria-label=`Run ${task.title}` title="Run" testId=`run-routine-${task.id}`
                text "Run" font="-exact-footnote"
              button class=ToggleControl appearance="none" role="switch" aria-checked=task.enabled press=toggleRoutine(bot.slug, task.id, not task.enabled) aria-label=`Enabled ${task.title}` testId=`routine-on-${task.id}`
                row width=44 height=26 border-radius="radius.full" background-color=(task.enabled ? "AccentColor" : "surface.line") align-items="center" justify-content=(task.enabled ? "flex-end" : "flex-start")
                  column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
              button class=IconControl appearance="none" press=dropRoutine(bot.slug, task.id) aria-label=`Delete ${task.title}` title="Delete" color="-exact-system-red" testId=`drop-routine-${task.id}`
                Glyph(name="trash", size=18)
          column gap="space.sm" padding="space.sm 0"
            input appearance="none" class=Field value=routineTitle input=editRoutine placeholder="Routine name" aria-label="Routine name" testId="routine-title"
            row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label="How often"
              for k in ["hour", "day", "once"] key=k
                button press=pickRoutineKind(k) role="radio" aria-checked=(routineKind == k) class=Segment appearance="none" min-height=44 testId=`routine-kind-${k}`
                  background-color=(routineKind == k ? "AccentColor" : "transparent")
                  color=(routineKind == k ? "AccentColorText" : "-exact-label")
                  text routineKindLabel(k)
            button press=addThis disabled=(routineTitle.trim() == "") buttonStyle="filled" min-height=44 testId="add-routine"
              text "Add Routine"
        if routineSaveError != ""
          text routineSaveError color="-exact-system-red" testId="routine-save-error"
        if routineChangeError != ""
          text routineChangeError color="-exact-system-red" testId="routine-change-error"
      text "Working on" class=SectionLabel
      column class=GroupCard
        if lineageDown
          text "Can’t load what this Bot is doing. Check that hbots is running, then try again." color="-exact-system-red" padding="space.sm 0" testId="lineage-error"
        else if lineage.error != ""
          text lineage.error color="ink.muted" padding="space.sm 0" testId="lineage-setup"
        else if lineage.rows.length == 0
          text "No other threads yet." color="ink.muted" padding="space.sm 0" testId="lineage-empty"
        else
          for line in lineage.rows key=line.id
            row align-items="center" gap="space.md" min-height=52 border-top="1px solid surface.line" testId=`line-${line.id}`
              column flex=1 gap="space.xs" min-width=0
                text line.title font="-exact-subheadline" font-weight=600 overflow-wrap="anywhere"
                text (line.remote ? "On another machine" : line.threadId != "" ? "On this machine" : "") color="ink.muted" font="-exact-footnote"
              row class=Chip
                text line.status
      if bot.main
        text "Your main Bot stays in the inbox. Choose another main Bot before hiding or deleting this one." color="ink.muted" font="-exact-footnote" padding="0 space.md"
      if error != ""
        text error color="-exact-system-red" testId="bot-error" padding="0 space.md"
      column class=GroupCard
        row align-items="center" gap="space.md" min-height=64
          column class=IconTile color="-exact-system-red"
            Glyph(name="trash", size=18)
          column flex=1 gap="space.xs" min-width=0
            text "Delete Bot" font="-exact-subheadline" color=(bot.main ? "ink.muted" : "-exact-system-red")
            text "Moves its folder to the trash" color="ink.muted" font="-exact-footnote"
          button class=IconControl appearance="none" commandfor=`drop-bot-${bot.slug}` command="show-modal" disabled=bot.main aria-label="Delete Bot" title="Delete Bot" color="-exact-system-red" testId="delete-bot"
            Glyph(name="trash", size=20)
    dialog id=`drop-bot-${bot.slug}` role="alertdialog" aria-label=`Delete ${bot.name}?`
      text "Its folder moves to the trash. This can’t be undone from here."
      button press=drop(bot.slug) destructive=true commandfor=`drop-bot-${bot.slug}` command="close" testId="drop-bot-ok"
        text "Delete"
      button commandfor=`drop-bot-${bot.slug}` command="close" testId="drop-bot-cancel"
        text "Cancel"

// A Bot's own page, pushed from its chat or the inbox's Hidden section.
// The right panel with the Bot's settings, toggled by the Bot's name in the
// chat header. On a wide window it sits beside the chat and the chat column
// keeps 320 points clear for it; on a narrow screen it overlays the chat
// below the header, so the name stays tappable to close it.
component BotPanel
  props
    working: bool
    shown: bool
    tab: string
    pickTab: action
    wide: bool
    bot: Bot
    error: string
    rename: action
    recolour: action
    hide: action
    makeMain: action
    drop: action
    go: action
    models: ModelList
    modelsDown: bool
    routines: RoutineList
    routinesDown: bool
    lineage: Lineage
    lineageDown: bool
    modelError: string
    routineSaveError: string
    routineChangeError: string
    pickModel: action
    addRoutine: action
    toggleRoutine: action
    runRoutine: action
    dropRoutine: action
    library: Library
    libraryDown: bool
    itemError: string
    removeError: string
    connectorSaveError: string
    connectorRemoveError: string
    saveItem: action
    dropItem: action
    saveConnector: action
    dropConnector: action
    computer: Computer
    computerDown: bool
    heldTab: string
    controlError: string
    take: action
    release: action
  action tabKey(k: string, event: KeyboardEvent)
    if not event.isComposing and (k == "ArrowRight" or k == "ArrowLeft" or k == "Home" or k == "End")
      preventDefault()
      let next = k == "Home" ? "details" : k == "End" ? "computer" : k == "ArrowRight" ? (tab == "details" ? "library" : tab == "library" ? "computer" : "details") : (tab == "details" ? "computer" : tab == "computer" ? "library" : "details")
      pickTab(next)
      focus(`panel-tab-${next}`)
  view
    column id="bot-panel" display=(shown ? "flex" : "none") position="absolute" top=(wide ? 0 : 72) right=0 bottom=0 width=(wide ? "20rem" : "100%") box-sizing="border-box" background-color="surface.canvas" border-left="1px solid surface.line" testId="bot-panel"
      column align-items="center" gap="space.xs" padding="space.lg"
        Face(shape="ball", color=faceColor(bot.color), state=(bot.hidden ? "asleep" : working ? "working" : "idle"), size=64, still=(not working))
        text bot.name font="-exact-headline" font-weight=600 testId="details-name" text-align="center" overflow-wrap="anywhere"
        text (bot.hidden ? "Hidden from your inbox" : working ? "Working…" : bot.ready ? "Ready to chat" : "Getting set up…") color="ink.muted" font="-exact-footnote" testId="details-status"
      row role="tablist" appearance="none" background-color="surface.canvas" aria-label="Bot sidebar" padding="space.sm" gap="space.xs" border-bottom="1px solid surface.line"
        for t in ["details", "library", "computer"] key=t
          button id=`panel-tab-${t}` key=tabKey tabindex=(tab == t ? 0 : -1) class=Segment appearance="none" role="tab" aria-selected=(tab == t) aria-controls=`bot-tab-${t}` press=pickTab(t) flex=1 min-width=0 min-height=44 padding="space.xs" testId=`panel-tab-${t}` background-color=(tab == t ? "surface.card" : "transparent") color=(tab == t ? "-exact-label" : "ink.muted")
            text (t == "details" ? "Details" : t == "library" ? "Library" : "Computer") font="-exact-subheadline"
      column id="bot-tab-details" role="tabpanel" aria-label="Details" display=(tab == "details" ? "flex" : "none") flex=1 min-height=0
        scroll id=`panel-${bot.slug}` flex=1 min-height=0
          column width="100%" box-sizing="border-box" padding="space.lg"
            BotEditor(bot=bot, error=error, rename=rename, recolour=recolour, hide=hide, makeMain=makeMain, drop=drop, go=go, models=models, modelsDown=modelsDown, routines=routines, routinesDown=routinesDown, lineage=lineage, lineageDown=lineageDown, modelError=modelError, routineSaveError=routineSaveError, routineChangeError=routineChangeError, pickModel=pickModel, addRoutine=addRoutine, toggleRoutine=toggleRoutine, runRoutine=runRoutine, dropRoutine=dropRoutine)
      column id="bot-tab-library" role="tabpanel" aria-label="Library" display=(tab == "library" ? "flex" : "none") flex=1 min-height=0
        LibraryContent(inPanel=true, slug=bot.slug, name=bot.name, color=bot.color, library=library, down=libraryDown, itemError=itemError, removeError=removeError, connectorSaveError=connectorSaveError, connectorRemoveError=connectorRemoveError, saveItem=saveItem, dropItem=dropItem, saveConnector=saveConnector, dropConnector=dropConnector)
      column id="bot-tab-computer" role="tabpanel" aria-label="Computer" display=(tab == "computer" ? "flex" : "none") flex=1 min-height=0
        ComputerContent(inPanel=true, slug=bot.slug, name=bot.name, color=bot.color, computer=computer, down=computerDown, heldTab=heldTab, controlError=controlError, take=take, release=release)

// A Vault login's sheet. The password field starts empty: a saved password is shown only after Reveal.
component LoginSheet
  props
    route: number
    item: Login
    revealedFor: string
    revealedText: string
    error: string
    save: action
    reveal: action
    hide: action
    drop: action
    cancel: action
  state ttl = item.title
  state site = item.website
  state user = item.username
  state pass = ""
  state note = item.hints
  action editTitle(v: string)
    ttl = v
  action editWebsite(v: string)
    site = v
  action editUsername(v: string)
    user = v
  action editPassword(v: string)
    pass = v
  action editHints(v: string)
    note = v
  view
    column class=Screen navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
      header class=PageHeader justify-content="space-between"
        button press=cancel aria-label="Cancel" testId="login-cancel"
          Glyph(name="close", size=20)
        text (item.id == "" ? "New Login" : item.title) role="heading" aria-level=1
        button press=save(item.id, ttl, site, user, pass, note) disabled=(ttl.trim() == "" and site.trim() == "") buttonStyle="filled" aria-label="Save" testId="login-save"
          text "Save"
      list class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            text "Title"
            input appearance="none" class=Field value=ttl input=editTitle placeholder="Title" aria-label="Title" text-align="end" flex=1 min-width=0 testId="login-title"
          row
            text "Website"
            input appearance="none" class=Field type="url" value=site input=editWebsite placeholder="Website" aria-label="Website" autocapitalize="none" text-align="end" flex=1 min-width=0 testId="login-website"
          footer
            text "A login needs a website or a title."
        section
          row
            text "Username"
            input appearance="none" class=Field value=user input=editUsername placeholder="Username" aria-label="Username" autocapitalize="none" autocomplete="username" text-align="end" flex=1 min-width=0 testId="login-username"
          row
            text "Password"
            input appearance="none" class=Field type="password" value=pass input=editPassword placeholder=(item.hasPassword ? "New password (blank keeps it)" : "Password") aria-label="Password" autocomplete="new-password" text-align="end" flex=1 min-width=0 testId="login-password"
        section
          if item.hasPassword
            row
              text "Saved password"
              if revealedFor == item.id and revealedText != ""
                text revealedText user-select="text" testId="revealed-password"
              else
                text "••••••••" color="-exact-secondary-label" testId="hidden-password"
            row
              if revealedFor == item.id and revealedText != ""
                button press=hide buttonStyle="bordered" testId="hide-password"
                  text "Hide"
              else
                button press=reveal(item.id) buttonStyle="bordered" testId="reveal-password"
                  text "Reveal"
        section
          row
            text "Notes"
            input appearance="none" class=Field value=note input=editHints placeholder="Notes" aria-label="Notes" text-align="end" flex=1 min-width=0 testId="login-notes"
        if error != ""
          section
            text error color="-exact-system-red" testId="login-error"
        if item.id != ""
          section
            button commandfor="drop-login" command="show-modal" testId="login-delete"
              text "Delete Login"
      dialog id="drop-login" role="alertdialog" aria-label="Delete this login?"
        text "It is removed from the Vault. This can’t be undone."
        button press=drop(item.id) destructive=true commandfor="drop-login" command="close" testId="drop-login-ok"
          text "Delete"
        button commandfor="drop-login" command="close" testId="drop-login-cancel"
          text "Cancel"

// A project's sheet. Its kind is chosen when it is made and fixed after.
component ProjectSheet
  props
    route: number
    item: Project
    error: string
    save: action
    drop: action
    cancel: action
  state kind = item.kind
  state ttl = item.title
  state status = item.status
  state area = item.area
  state body = item.body
  action pickKind(v: string)
    kind = v
  action editTitle(v: string)
    ttl = v
  action editStatus(v: string)
    status = v
  action editArea(v: string)
    area = v
  action editBody(v: string)
    body = v
  view
    column class=Screen navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
      header class=PageHeader justify-content="space-between"
        button press=cancel aria-label="Cancel" testId="project-cancel"
          Glyph(name="close", size=20)
        text (item.id == "" ? "New Project" : item.title) role="heading" aria-level=1
        button press=save(item.id, kind, ttl, status, area, body) disabled=(ttl.trim() == "") buttonStyle="filled" aria-label="Save" testId="project-save"
          text "Save"
      list class=FormList appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
        section
          row
            text "Title"
            input appearance="none" class=Field value=ttl input=editTitle placeholder="Title" aria-label="Title" text-align="end" flex=1 min-width=0 testId="project-title"
          row
            text "Kind"
            if item.id == ""
              select value=kind change=pickKind aria-label="Kind" testId="project-kind"
                option "Project" value="project"
                option "Task" value="task"
                option "Machine" value="machine"
                option "Service" value="service"
                option "Repo" value="repo"
                option "Note" value="note"
                option "Link" value="link"
            else
              text kind color="-exact-secondary-label"
        section
          row
            text "Status"
            input appearance="none" class=Field value=status input=editStatus placeholder="Status" aria-label="Status" text-align="end" flex=1 min-width=0 testId="project-status"
          row
            text "Area"
            input appearance="none" class=Field value=area input=editArea placeholder="Area" aria-label="Area" text-align="end" flex=1 min-width=0 testId="project-area"
        section
          row
            textarea value=body input=editBody rows=6 placeholder="Notes" aria-label="Notes" flex=1 min-width=0 testId="project-body"
        if error != ""
          section
            text error color="-exact-system-red" testId="project-error"
        if item.id != ""
          section
            button commandfor="drop-project" command="show-modal" testId="project-delete"
              text "Delete"
      dialog id="drop-project" role="alertdialog" aria-label="Delete this item?"
        text "It is removed from the board. This can’t be undone."
        button press=drop(item.id) destructive=true commandfor="drop-project" command="close" testId="drop-project-ok"
          text "Delete"
        button commandfor="drop-project" command="close" testId="drop-project-cancel"
          text "Cancel"

// One dated group of library rows. A blank label is the undated group.
component LibList
  props
    label: string
    entries: LibEntry[]
    slug: string
    drop: action
  view
    column
      if label != "" and entries.length > 0
        text label class=SectionLabel
      if entries.length > 0
        column class=GroupCard
          for e in entries key=e.id
            row align-items="center" gap="space.md" min-height=52 padding="space.xs 0" border-top="1px solid surface.line"
              column flex=1 gap="2px" min-width=0
                if e.open != ""
                  link href=e.open target="_blank" color="-exact-label"
                    text e.title font-weight=600 overflow-wrap="anywhere"
                else
                  text e.title font-weight=600 overflow-wrap="anywhere"
                text (e.detail != "" ? e.detail : kindLabel(e.kind)) color="ink.muted" font="-exact-footnote" overflow-wrap="anywhere"
              if e.status != ""
                row class=Chip
                  text statusWord(e.status)
              if keptHere(e.id)
                button class=IconControl appearance="none" commandfor=`drop-lib-${e.id}` command="show-modal" aria-label=`Delete ${e.title}` title="Delete" color="-exact-system-red"
                  Glyph(name="trash", size=18)
                dialog id=`drop-lib-${e.id}` role="alertdialog" aria-label=`Delete ${e.title}?`
                  text "It is removed from this Bot’s library. This can’t be undone."
                  button press=drop(slug, e.id) destructive=true commandfor=`drop-lib-${e.id}` command="close"
                    text "Delete"
                  button commandfor=`drop-lib-${e.id}` command="close"
                    text "Cancel"

// The Bot's shelf: the Face and one count, then filters and grouped rows.
component LibraryScreen
  props
    route: number
    slug: string
    name: string
    color: string
    library: Library
    down: bool
    itemError: string
    removeError: string
    connectorSaveError: string
    connectorRemoveError: string
    saveItem: action
    dropItem: action
    saveConnector: action
    dropConnector: action
  view
    column class=Screen navigationKey=`${route}` navigationScroll="library-scroll" position="absolute" inset=0
      header class=PageHeader
        text "Library" role="heading" aria-level=1 class=PageTitle flex=1
      LibraryContent(inPanel=false, slug=slug, name=name, color=color, library=library, down=down, itemError=itemError, removeError=removeError, connectorSaveError=connectorSaveError, connectorRemoveError=connectorRemoveError, saveItem=saveItem, dropItem=dropItem, saveConnector=saveConnector, dropConnector=dropConnector)

component LibraryContent
  props
    inPanel: bool
    slug: string
    name: string
    color: string
    library: Library
    down: bool
    itemError: string
    removeError: string
    connectorSaveError: string
    connectorRemoveError: string
    saveItem: action
    dropItem: action
    saveConnector: action
    dropConnector: action
  state filter = "all"
  state kind = "note"
  state title = ""
  state cName = ""
  state cUrl = ""
  state cSecret = ""
  derive who = name != "" ? name : "this Bot"
  derive shown = library.entries.filter(e => shownKind(e.kind, filter))
  derive today = shown.filter(e => e.group == "Today")
  derive week = shown.filter(e => e.group == "This week")
  derive older = shown.filter(e => e.group == "Older")
  derive undated = shown.filter(e => e.group == "")
  action pickFilter(v: string)
    filter = v
  action pickKind(v: string)
    kind = v
  action editTitle(v: string)
    title = v
  action addItem
    if title.trim() != ""
      saveItem(slug, "", kind, title, "", "")
      title = ""
  action editConnector(v: string)
    cName = v
  action editUrl(v: string)
    cUrl = v
  action editSecret(v: string)
    cSecret = v
  action addConnector
    if cName.trim() != "" and cUrl.trim() != ""
      saveConnector(slug, cName, cUrl, true, cSecret)
      cName = ""
      cUrl = ""
      cSecret = ""
  view
    scroll id=(inPanel ? "panel-library-scroll" : "library-scroll") flex=1 min-height=0
      column width="100%" max-width="40rem" box-sizing="border-box" margin="0 auto" padding="space.lg space.xl space.xl" gap="space.lg"
        if down or not library.ok
          column align-items="center" justify-content="center" padding="space.xl" gap="space.md"
            Face(shape="ball", color=faceColor(color), state="asleep", size=72, still=true)
            text "Can’t open this library. Check that hbots is running, then try again." color="-exact-system-red" text-align="center" testId="library-status"
        else
          if inPanel
            text (library.entries.length == 0 ? "Files and notes shared with this Bot appear here." : libraryLine(library.entries.length, who)) color="ink.muted" font="-exact-footnote" testId="library-summary"
          else
            row gap="space.lg" align-items="center"
              Face(shape="ball", color=faceColor(color), state="idle", size=72, still=false)
              column flex=1 gap="space.xs" min-width=0
                text who class=PageTitle overflow-wrap="anywhere"
                if library.entries.length == 0
                  text `Files and pages shared with ${who} appear here.` color="ink.muted" testId="library-status"
                else
                  text libraryLine(library.entries.length, who) color="ink.muted" testId="library-count"
          row gap="space.xs" flex-wrap="wrap" role="radiogroup" aria-label="Show"
            for f in ["all", "page", "media", "link", "file", "project", "note", "task", "plan", "more"] key=f
              button press=pickFilter(f) role="radio" aria-checked=(filter == f) class=Segment appearance="none" min-height=44 testId=`filter-${f}`
                background-color=(filter == f ? "AccentColor" : "transparent")
                color=(filter == f ? "AccentColorText" : "-exact-label")
                text filterLabel(f)
          if library.entries.length > 0 and shown.length == 0
            text `Nothing in ${filterLabel(filter)}.` color="ink.muted" testId="library-none"
          else
            column testId="library-list"
              LibList(label="Today", entries=today, slug=slug, drop=dropItem)
              LibList(label="This week", entries=week, slug=slug, drop=dropItem)
              LibList(label="Older", entries=older, slug=slug, drop=dropItem)
              LibList(label="", entries=undated, slug=slug, drop=dropItem)
          text "Keep something" class=SectionLabel
          column class=GroupCard gap="space.sm" padding="space.md"
            select value=kind change=pickKind aria-label="Kind" testId="library-kind"
              option "Note" value="note"
              option "Task" value="task"
              option "Plan" value="plan"
              option "Project" value="project"
              option "Link" value="link"
              option "Repo" value="repo"
              option "Machine" value="machine"
              option "Service" value="service"
            input appearance="none" class=Field value=title input=editTitle submit=addItem placeholder="Title" aria-label="Title" testId="library-title"
            button press=addItem disabled=(title.trim() == "") buttonStyle="filled" min-height=44 testId="add-library"
              text "Add"
            if itemError != ""
              text itemError color="-exact-system-red" testId="library-error"
            if removeError != ""
              text removeError color="-exact-system-red" testId="library-remove-error"
          text "Connectors" class=SectionLabel
          text "Applies when this Bot starts its next session." color="ink.muted" font="-exact-footnote" padding="0 space.md"
          column class=GroupCard
            for c in library.connectors key=c.name
              row align-items="center" gap="space.md" min-height=64 border-top="1px solid surface.line" testId=`connector-${c.name}`
                column flex=1 gap="space.xs" min-width=0
                  text c.name font-weight=600
                  text c.url color="ink.muted" font="-exact-footnote" overflow-wrap="anywhere"
                  if c.hasSecret and not c.locked
                    text "A token is saved." color="ink.muted" font="-exact-footnote"
                if c.locked
                  text "On" color="ink.muted" testId="connector-bot"
                else
                  button class=ToggleControl appearance="none" role="switch" aria-checked=c.enabled press=saveConnector(slug, c.name, c.url, not c.enabled, "") aria-label=`Enabled ${c.name}` testId=`connector-on-${c.name}`
                    row width=44 height=26 border-radius="radius.full" background-color=(c.enabled ? "AccentColor" : "surface.line") align-items="center" justify-content=(c.enabled ? "flex-end" : "flex-start")
                      column width=20 height=20 margin="0 3px" border-radius="radius.full" background-color="ink.light"
                  button class=IconControl appearance="none" press=dropConnector(slug, c.name) aria-label=`Remove ${c.name}` title="Remove" color="-exact-system-red" testId=`drop-connector-${c.name}`
                    Glyph(name="trash", size=18)
            column gap="space.sm" padding="space.sm 0"
              input appearance="none" class=Field value=cName input=editConnector placeholder="Name" aria-label="Connector name" autocapitalize="none" testId="connector-name"
              input appearance="none" class=Field value=cUrl input=editUrl placeholder="https://" aria-label="Connector URL" autocapitalize="none" testId="connector-url"
              input appearance="none" class=Field type="password" value=cSecret input=editSecret placeholder="Token, if it asks" aria-label="Connector token" testId="connector-secret"
              button press=addConnector disabled=(cName.trim() == "" or cUrl.trim() == "") buttonStyle="filled" min-height=44 testId="add-connector"
                text "Add Connector"
              if connectorSaveError != ""
                text connectorSaveError color="-exact-system-red" testId="connector-error"
              if connectorRemoveError != ""
                text connectorRemoveError color="-exact-system-red" testId="connector-remove-error"

// One page this Bot has open. Watching does not take the page. Release gives it back.
component ComputerScreen
  props
    route: number
    slug: string
    name: string
    color: string
    computer: Computer
    down: bool
    heldTab: string
    controlError: string
    take: action
    release: action
  view
    column class=Screen navigationKey=`${route}` navigationScroll="computer-scroll" position="absolute" inset=0
      header class=PageHeader
        text "Computer" role="heading" aria-level=1 class=PageTitle flex=1
      ComputerContent(inPanel=false, slug=slug, name=name, color=color, computer=computer, down=down, heldTab=heldTab, controlError=controlError, take=take, release=release)

component ComputerContent
  props
    inPanel: bool
    slug: string
    name: string
    color: string
    computer: Computer
    down: bool
    heldTab: string
    controlError: string
    take: action
    release: action
  derive who = name != "" ? name : "this Bot"
  derive page = match first(computer.tabs) { case some(t) => t, case none => PageTab(id="", title="", url="") }
  view
    scroll id=(inPanel ? "panel-computer-scroll" : "computer-scroll") flex=1 min-height=0
      column width="100%" max-width="40rem" box-sizing="border-box" margin="0 auto" padding="space.lg space.xl space.xl" gap="space.lg"
        if down or not computer.ok
          column align-items="center" gap="space.md" padding="space.xl"
            Face(shape="ball", color=faceColor(color), state="asleep", size=72, still=true)
            text "Can’t open this Bot’s browser. Check that hbots is running, then try again." color="-exact-system-red" text-align="center" testId="computer-status"
        else if computer.tabs.length == 0
          column align-items="center" gap="space.md" padding="space.xl"
            if not inPanel
              Face(shape="ball", color=faceColor(color), state="idle", size=72, still=false)
              text who class=PageTitle
            text (computer.error != "" ? computer.error : "This Bot has not opened a page.") color="ink.muted" text-align="center" testId="computer-status"
        else
          row gap="space.lg" align-items="center"
            if not inPanel
              Face(shape="ball", color=faceColor(color), state=(heldTab != "" ? "working" : "idle"), size=44, still=false)
            column flex=1 gap="space.xs" min-width=0
              text page.title class=PageTitle overflow-wrap="anywhere" testId="computer-title"
              text page.url color="ink.muted" font="-exact-footnote" overflow-wrap="anywhere"
          if computer.image != ""
            image `data:image/jpeg;base64,${computer.image}` aria-label=`Page open for ${who}` width="100%" border-radius="radius.md" testId="computer-frame"
          if heldTab != ""
            button press=release buttonStyle="filled" min-height=44 testId="release-computer"
              text "Release"
          else
            button press=take(page.id) buttonStyle="filled" min-height=44 testId="take-computer"
              text "Take Control"
          text "Release when you are done, so the Bot can use the page." color="ink.muted" font="-exact-footnote"
          if computer.error != ""
            text computer.error color="ink.muted" testId="computer-frame-error"
          if controlError != ""
            text controlError color="-exact-system-red" testId="control-error"
