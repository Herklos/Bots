use EmptyState from "exact:content"
use shapeOf, colorOf, faceColor from "../ui/fns.contract"
use Bot, Row, Chat, RoomMember, MentionHit, ModelList, RoutineList, Lineage, UsageReport, Shelf, Computer from "../ui/shapes.contract"
use Reply, Sent, SystemStatus, PageState, Attached, PointerFacts, nameOf, attachmentName from "../ui/root-types.contract"
use Screen, PageTitle, HeroTitle, PageHeader, TextControl, IconControl from "../ui/controls.contract"
use HeaderToggle, SendControl, StopControl, SearchField from "../ui/sidebar.contract"
use ChatLog from "./log.contract"
use MentionMenu from "./mention.contract"
use Face from "../face.contract"
use Glyph from "../glyph.contract"
use BotPanel from "../bot/panel.contract"
// ChatScreen: one route of the root view, moved out with its values and actions injected.
component ChatScreen
  props
    route: number
  inject
    system: SystemStatus
    models: ModelList
    modelError: string
    doPickModel: action
    shownRows: Row[]
    searchNote: string
    away: bool
    toEnd: action
    moved: action
    answerText: string
    chatSearching: bool
    messageQuery: string
    reactFor: string
    messageMenu: string
    copiedMenu: string
    replyTo: string
    replyQuote: string
    childThread: string
    sent: option<Sent>
    answered: option<Reply>
    attached: option<Attached>
    pendingText: string
    attachError: string
    answerError: string
    editChatQuery: action
    toggleChatSearch: action
    edit: action
    pickFiles: action
    filesPicked: action
    dropPending: action
    post: action
    composerKey: action
    retry: action
    startReply: action
    cancelReply: action
    doPinMessage: action
    doReact: action
    openReact: action
    openMessageMenu: action
    closeMessageMenu: action
    noteCopied: action
    filesDropped: action
    editAnswer: action
    answer: action
    stop: action
    pasted: action
    paintedWorkers: RoomMember[]
    openPage: action
    pickPeriod: action
    pickView: action
    open: action
    back: action
    closeChild: action
    openChild: action
    draft: string
    mentionIdx: number
    mentionHits: MentionHit[]
    mention: action
    completeMention: action
    usagePeriod: string
    usageView: string
    report: UsageReport
    childModels: ModelList
    routines: RoutineList
    lineage: Lineage
    shelf: Shelf
    voiceRecorder: string
    voiceError: string
    voiceSent: option<Reply>
    voiceHold: string
    voiceId: string
    voicePreview: string
    holdVoice: action
    sendHeldVoice: action
    discardVoice: action
    wide: bool
    panelOpen: bool
    panelTab: string
    panelPage: string
    subSlug: string
    subName: string
    subShape: string
    subColor: string
    subPrompt: string
    subInherit: bool
    subCreated: option<Reply>
    subSaved: option<Reply>
    botError: string
    subError: string
    subSaveError: string
    childRemoveError: string
    togglePanel: action
    retryDetails: action
    pickPanelTab: action
    pick: action
    doRename: action
    doRecolour: action
    doHide: action
    doMute: action
    doMain: action
    doDropBot: action
    openNewSub: action
    editSub: action
    editSubName: action
    editSubPrompt: action
    pickSubColor: action
    pickSubShape: action
    toggleSubInherit: action
    doCreateSub: action
    doSaveSub: action
    doDropChild: action
    doReshape: action
    doPin: action
    heldTab: string
    computerTab: string
    computer: Computer
    controlError: string
    openError: string
    openingBrowser: bool
    closeError: string
    closingBrowser: bool
    driveError: string
    holding: bool
    doTake: action
    doRelease: action
    pickComputerTab: action
    doDrive: action
    doOpenBrowser: action
    doCloseBrowser: action
    showComputerLarge: action
    pointerFacts: PointerFacts
    bots: Bot[]
    page: PageState
    chat: Chat
    slug: string
    pendingAttaches: string[]
    canSend: bool
    pull: action
    chatFailed: bool
    chatPending: bool
    answeredPending: bool
    attachedPending: bool
    voiceSentPending: bool
    sentPending: bool
    modelsFailed: bool
    routinesFailed: bool
    lineageFailed: bool
    reportFailed: bool
    shelfFailed: bool
    computerFailed: bool
    subCreatedPending: bool
    subSavedPending: bool
    childModelsFailed: bool
  view
    column class=Screen navigationKey=`${route}` navigationScroll="transcript" drop=filesDropped position="absolute" inset=0 padding-right=((wide and panelOpen) ? "20rem" : "0px")
      if messageMenu != ""
        button appearance="none" position="absolute" inset=0 z-index=20 background-color="transparent" border="none" press=closeMessageMenu aria-label=t("common.cancel") testId="message-menu-scrim"
      header appearance="none" class=PageHeader position="relative" testId="chat-header"
        button id="back" class=IconControl appearance="none" press=back aria-label=t("common.back") title=t("common.back") display=(wide ? "none" : "flex")
          column rotate="180deg"
            Glyph(name="chevron", size=20)
        button class=HeaderToggle appearance="none" press=togglePanel aria-label=(panelOpen ? t("chat.hideDetails") : t("chat.showDetails")) aria-expanded=panelOpen aria-controls="bot-panel" title=t("chat.botSettings") testId="panel-toggle" position="absolute" left="50%" translate="-50% 0" gap="space.sm" padding="0 space.md" max-width="75%"
          if nameOf(bots, slug) != ""
            column testId="chat-avatar"
              Face(shape=shapeOf(bots, slug), color=faceColor(colorOf(bots, slug)), state=(chat.working ? "working" : "idle"), size=28, still=true)
          text nameOf(bots, slug) role="heading" aria-level=1 class=PageTitle overflow-wrap="anywhere" testId="chat-title" min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
        column flex=1
        button class=IconControl appearance="none" press=toggleChatSearch aria-label=t("chat.search") title=t("chat.search") testId="chat-search-open" width=36 height=36
          Glyph(name=(chatSearching ? "close" : "search"), size=18)
      if childThread != ""
        row align-items="center" gap="space.sm" padding="space.xs space.md" min-height=44 box-sizing="border-box" background-color="surface.raised" border-bottom="1px solid surface.line" testId="child-strip"
          button class=TextControl appearance="none" press=closeChild display="flex" align-items="center" aria-label=(nameOf(bots, slug) != "" ? t("chat.backToNamed", name=nameOf(bots, slug)) : t("chat.backToChat")) testId="close-child" min-height=44 padding="0 space.sm" color="AccentColor" flex=1 min-width=0
            column color="AccentColor" rotate="180deg" flex-shrink=0
              Glyph(name="chevron", size=16)
            text (nameOf(bots, slug) != "" ? t("chat.backToNamed", name=nameOf(bots, slug)) : t("chat.backToChat")) font="-exact-subheadline" font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
          text (chat.readOnly ? t("status.done") : chat.working ? t("status.working") : t("status.done")) color="ink.muted" font="-exact-footnote" flex-shrink=0 testId="child-strip-status"
      if chatFailed
        EmptyState(symbol="symbol:alert", title=t("error.chatTitle"), message=t("error.chatHint"))
          button press=pull testId="retry-chat"
            text t("common.tryAgain")
      else if chatPending and chat.rows.length == 0
        column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" aria-busy=true
          Face(shape=shapeOf(bots, slug), color=faceColor(colorOf(bots, slug)), state="working", size=44, still=false)
          text t("chat.loading") color="ink.muted"
      else if chat.rows.length == 0 and not chat.working and pendingText == ""
        column flex=1 align-items="center" justify-content="center" gap="space.md" padding="space.xl" testId="empty-chat"
          Face(shape=shapeOf(bots, slug), color=faceColor(colorOf(bots, slug)), state="idle", size=72, still=false)
          text nameOf(bots, slug) class=HeroTitle
          text t("chat.emptyBody") color="ink.muted" text-align="center"
          column gap="space.sm" width="100%" max-width="24rem" margin-top="space.lg"
            button press=edit(t("chat.starter.planSend")) class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-plan"
              text t("chat.starter.plan")
            button press=edit(t("chat.starter.ideaSend")) class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-idea"
              text t("chat.starter.idea")
            button press=edit(t("chat.starter.helpSend")) class=TextControl appearance="none" background-color="surface.card" border="1px solid surface.line" border-radius="radius.full" testId="starter-help"
              text t("chat.starter.help")
      else
        column flex=1 min-height=0 justify-content="flex-end" position="relative" z-index=(messageMenu != "" ? 21 : 0) pointer-events=(messageMenu != "" ? "none" : "auto")
          if chatSearching
            input type="search" class=SearchField value=messageQuery input=editChatQuery placeholder=t("chat.search") aria-label=t("chat.search") testId="chat-search" width="calc(100% - 32px)" max-width="44rem" align-self="center" box-sizing="border-box" margin="0 space.lg space.xs"
          if chatSearching and searchNote != ""
            text searchNote color="ink.muted" font="-exact-footnote" testId="search-note" width="100%" max-width="46rem" align-self="center" box-sizing="border-box" padding="0 space.lg"
          if away
            button class=IconControl appearance="none" press=toEnd aria-label=t("chat.jump") title=t("chat.jumpShort") testId="to-end" position="absolute" left="50%" translate="-50% 0" bottom=8 z-index=1 width=32 height=32 border-radius="radius.full" background-color="surface.raised" border="1px solid surface.line"
              Glyph(name="arrow-down", size=16)
          for p in chat.pins key=p.id
            text p.text color="ink.muted" font="-exact-footnote" testId=`pin-${p.id}` width="100%" max-width="46rem" align-self="center" box-sizing="border-box" padding="0 space.lg"
          ChatLog(rows=shownRows, inRoom=false, logId="transcript", logTestId=(childThread != "" ? "child-transcript" : "transcript"), bots=bots, slug=slug, pins=chat.pins, workers=paintedWorkers, hover=(pointerFacts.hover == "hover"), reactFor=reactFor, messageMenu=messageMenu, copiedMenu=copiedMenu, answerText=answerText, answerError=answerError, answering=answeredPending, react=doReact, openPicker=openReact, reply=startReply, pin=doPinMessage, openMenu=openMessageMenu, closeMenu=closeMessageMenu, noteCopied=noteCopied, answer=answer, editAnswer=editAnswer, retry=retry, scrolled=moved)
      if attachError != "" and not attachedPending
        text attachError color="-exact-system-red" padding="0 space.lg" testId="attach-error"
      if pendingAttaches.length > 0
        row gap="space.sm" flex-wrap="wrap" padding="0 space.lg space.xs" align-self="center" width="100%" max-width="44rem" box-sizing="border-box" testId="pending-files"
          for entry in pendingAttaches key=entry
            row gap="space.xs" align-items="center" padding="4px 6px 4px space.sm" border="1px solid surface.line" border-radius="radius.full" background-color="surface.card" max-width="100%" box-sizing="border-box"
              column color="ink.muted"
                Glyph(name="attach", size=14)
              text attachmentName(entry, t("chat.attachment")) font="-exact-footnote" color="-exact-label" overflow-wrap="anywhere" flex=1 min-width=0
              button class=IconControl appearance="none" press=dropPending(entry) aria-label=t("chat.removeNamed", name=attachmentName(entry, t("chat.attachment"))) title=t("chat.removeAttachment") testId="pending-file" width=28 height=28
                Glyph(name="close", size=14)
      if chat.readOnly
        text t("chat.readOnly") color="ink.muted" padding="space.md space.lg space.xl" testId="child-readonly"
      else
        column width="calc(100% - 32px)" max-width="44rem" align-self="center" box-sizing="border-box" margin="space.sm space.lg space.xl" gap="space.xs" position="relative"
          if replyTo != ""
            row gap="space.sm" align-items="center" padding="space.xs space.sm" border-radius="radius.md" background-color="surface.raised" border="1px solid surface.line" testId="reply-bar"
              text replyQuote font="-exact-footnote" color="ink.muted" flex=1 min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="reply-quote"
              button class=TextControl appearance="none" press=cancelReply aria-label=t("chat.cancelReply") testId="reply-cancel" min-height=44 padding="0 space.sm"
                text t("common.cancel")
          if voicePreview != ""
            audio voicePreview controls=true testId="voice-preview"
          if voiceError != ""
            text voiceError color="-exact-system-red" font="-exact-footnote" testId="voice-error"
          MentionMenu(hits=mentionHits, picked=mentionIdx, choose=completeMention)
          row align-items="flex-end" width="100%" box-sizing="border-box" padding="space.xs" gap="space.xs" border-radius="radius.lg" border="1px solid surface.line" background-color="surface.card"
            button class=IconControl press=pickFiles disabled=(slug == "" or attachedPending or pendingAttaches.length >= 8) appearance="none" aria-label=t("chat.attach") title=t("chat.attach") testId="attach" width=36 height=36 border-radius="radius.full" background-color="surface.raised"
              Glyph(name="add", size=18)
            if voiceHold != ""
              text voiceHold font="-exact-footnote" color="ink.muted" testId="voice-hold"
            if voiceId != ""
              button class=IconControl appearance="none" press=discardVoice aria-label=t("chat.discardClip") title=t("chat.discardClip") testId="voice-discard" width=36 height=36
                Glyph(name="close", size=16)
            input type="file" id="chat-attach" display="none" change=filesPicked testId="chat-attach"
            textarea id="composer" value=draft input=edit key=composerKey paste=pasted maxlength=8000 outline="none" border-radius="radius.md" rows=1 field-sizing="content" max-height=140 placeholder=(nameOf(bots, slug) != "" ? t("chat.messageTo", name=nameOf(bots, slug)) : t("chat.write")) aria-label=t("chat.message") aria-expanded=(mentionHits.length > 0) aria-controls="mention-menu" testId="composer" flex=1 min-width=0 padding="space.sm space.xs" border="none" background-color="transparent" color="-exact-label"
            if voiceRecorder != ""
              button class=SendControl appearance="none" press=holdVoice margin="2px 0" aria-label=t("chat.stopRecording") title=t("chat.stopRecording") testId="voice-record" background-color="-exact-system-red" color="ink.dark"
                Glyph(name="stop", size=16)
            else if voiceId != ""
              button class=SendControl appearance="none" press=sendHeldVoice disabled=voiceSentPending margin="2px 0" aria-label=t("chat.sendVoice") title=t("chat.sendVoice") testId="voice-send"
                Glyph(name="send", size=18)
            else if chat.working and not canSend
              button class=StopControl appearance="none" press=stop margin="2px 0" aria-label=t("common.stop") testId="stop"
                Glyph(name="stop", size=16)
            else if not canSend
              button class=SendControl appearance="none" press=holdVoice margin="2px 0" aria-label=t("chat.record") title=t("chat.record") testId="voice-record" background-color="-exact-label" color="surface.canvas"
                Glyph(name="mic", size=18)
            else
              button class=SendControl appearance="none" press=post disabled=(not canSend or sentPending) margin="2px 0" retainFocus=true aria-label=t("common.send") testId="send"
                Glyph(name="send", size=18)
      for b in bots.filter(x => x.slug == slug) key=b.slug
        BotPanel(working=chat.working, shown=panelOpen, tab=panelTab, page=panelPage, pickTab=pickPanelTab, openPage=openPage, closePanel=togglePanel, openChild=openChild, wide=wide, bot=b, bots=bots, error=botError, rename=doRename, recolour=doRecolour, reshape=doReshape, pin=doPin, hide=doHide, mute=doMute, makeMain=doMain, drop=doDropBot, models=models, modelsDown=modelsFailed, pickModel=doPickModel, modelError=modelError, routines=routines, routinesDown=routinesFailed, lineage=lineage, lineageDown=lineageFailed, report=report, reportDown=reportFailed, period=usagePeriod, usageView=usageView, pickPeriod=pickPeriod, pickView=pickView, retryDetails=retryDetails, shelf=shelf, shelfDown=shelfFailed, computer=computer, computerDown=computerFailed, showComputerLarge=showComputerLarge, heldTab=heldTab, controlError=controlError, driveError=driveError, live=holding, drive=doDrive, take=doTake, release=doRelease, picked=computerTab, pick=pickComputerTab, openBrowser=doOpenBrowser, opening=openingBrowser, openError=openError, closeBrowser=doCloseBrowser, closing=closingBrowser, closeError=closeError, subSlug=subSlug, subName=subName, subShape=subShape, subColor=subColor, subPrompt=subPrompt, subInherit=subInherit, openNewSub=openNewSub, editSub=editSub, editSubName=editSubName, editSubPrompt=editSubPrompt, pickSubColor=pickSubColor, pickSubShape=pickSubShape, toggleSubInherit=toggleSubInherit, createSub=doCreateSub, saveSub=doSaveSub, dropChild=doDropChild, creating=subCreatedPending, saving=subSavedPending, subError=(subSlug == "" ? subError : (subSaveError != "" ? subSaveError : childRemoveError)), childModels=childModels, childModelsDown=childModelsFailed)
