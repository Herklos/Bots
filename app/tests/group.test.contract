locale "en-US"

test "a room shows who is working and who is still getting set up"
  at "/group/fixture"
  clock data
  expect text "member-ada-name" == "Ada"
  expect text "member-ada-state" == "Working"
  expect text "member-bea-name" == "Bea"
  expect text "member-bea-state" == "Getting set up…"
  expect tree has "room-working"
  expect tree has "room-working-dots"
  expect tree has "room-working-ada"
  expect tree missing "room-working-bea"
  expect tree has "room-msg-r1"
  expect tree has "room-msg-r2"
test "a room shows one working mark when several members are working"
  at "/group/fixture-busy"
  clock data
  expect tree has "room-working"
  expect tree has "room-working-dots"
  expect tree has "room-working-ada"
  expect tree has "room-working-bea"
  expect tree has "room-msg-r1"
test "the plus button offers a Bot or a group, and a group needs a name and two Bots"
  size 1200x800
  at "/bot/fixture"
  clock data
  expect tree missing "new-menu"
  tap "new-bot"
  expect tree has "new-bot-option"
  expect tree has "new-group-option"
  tap "new-group-option"
  clock settle
  expect tree missing "new-menu"
  expect disabled "group-next"
  expect tree missing "group-create"
  type "group-name" "Crew"
  tap "group-next"
  expect disabled "group-next"
  tap "pick-bot-fixture"
  expect text "group-count" == "Pick at least two (1 so far)"
  expect disabled "group-next"
  tap "pick-bot-bea"
  expect text "group-count" == "2 picked"
  expect tree has "group-faces"
  expect tree missing "group-colour-brand.blue"
  expect tree missing "group-shape-hex"
  tap "group-next"
  tap "group-next"
  tap "group-next"
  expect enabled "group-create"
  tap "group-create"
  clock settle
  expect text "room-title" == "Crew"
  expect tree has "room-composer"
  expect tree missing "room-working"
test "groups sit in the same list as Bots, with no section of their own"
  size 1200x800
  at "/bot/fixture"
  clock data
  expect tree has "bot-fixture"
  expect tree has "group-fixture"
  expect text "group-title-fixture" == "Design"
  expect tree missing "groups-label"
  expect tree missing "new-group"
test "a group shows who said what and its mention chips"
  size 1200x800
  at "/group/fixture"
  clock data
  expect text "room-title" == "Design"
  expect text "room-text-r1" == "Hello"
  expect text "room-from-r2" == "Ada"
  expect text "room-text-r2" == "On it"
  expect tree has "mention-ada"
  expect tree has "mention-bea"
  expect text "room-hint" == "No @mention: the Bot that spoke last answers, or everyone at first."
  expect disabled "room-send"
  tap "mention-ada"
  expect text "room-hint" == "Only the Bots you mention are woken."
  expect enabled "room-send"
test "a group has a details panel like a Bot, and deleting lives inside it"
  size 1200x800
  at "/group/fixture"
  clock data
  expect tree missing "group-delete"
  tap "group-toggle"
  expect text "group-details-name" == "Design"
  expect text "group-details-about" == "Where Ada and Bea trade drafts"
  expect text "group-members-label" == "Bots, 2"
  expect tree has "group-member-ada"
  expect tree has "group-member-bea"
  expect tree missing "group-delete"
  tap "group-edit"
  expect tree has "group-edit-name"
  expect tree has "group-edit-about"
  expect tree has "group-roster-ada"
  expect tree has "group-roster-bea"
  expect tree missing "group-edit-member-fixture"
  expect tree missing "group-edit-colour-brand.blue"
  expect tree missing "group-edit-shape-hex"
  expect tree has "group-delete"
  tap "group-panel-back"
  expect tree missing "group-edit-name"
  tap "group-panel-close"
test "adding and removing a Bot on a group saves one member at a time"
  size 1200x800
  at "/group/fixture"
  clock data
  tap "group-toggle"
  tap "group-edit"
  expect disabled "group-remove-ada"
  expect disabled "group-remove-bea"
  expect tree missing "group-edit-member-ada"
  tap "group-add-open"
  expect tree missing "group-add-search"
  expect tree has "group-add-fixture"
  expect tree missing "group-add-bea"
  expect tree missing "pick-bot-fixture"
  tap "group-add-fixture"
  expect tree has "group-edit-page"
  expect tree missing "group-add-page"
  clock data
  expect tree has "group-roster-fixture"
  expect enabled "group-remove-fixture"
  tap "group-remove-fixture"
  clock data
  expect tree missing "group-roster-fixture"
  expect disabled "group-remove-ada"
  expect disabled "group-remove-bea"
  tap "group-panel-back"
  tap "new-bot"
  tap "new-group-option"
  clock settle
  type "group-name" "Crew"
  tap "group-next"
  expect tree has "pick-bot-fixture"
  expect tree has "pick-bot-bea"
  expect tree missing "group-add-open"
  expect tree missing "group-roster-ada"
test "the new Group walk keeps each step to its own field"
  size 340x740
  tap "new-bot"
  tap "new-group-option"
  clock settle
  expect tree has "step-group-name"
  expect tree has "group-name"
  expect tree missing "pick-bot-fixture"
  expect tree missing "policy-last"
  expect tree missing "group-about"
  expect tree missing "review-group-name"
  expect tree missing "group-create"
  expect disabled "group-next"
  type "group-name" "   "
  expect disabled "group-next"
  type "group-name" "Policy"
  tap "group-next"
  expect tree has "step-group-face"
  expect tree has "group-faces"
  expect tree missing "group-name"
  expect tree missing "policy-last"
  expect disabled "group-next"
  tap "pick-bot-fixture"
  expect disabled "group-next"
  tap "pick-bot-bea"
  tap "group-back"
  expect text "group-name" == "Policy"
  tap "group-next"
  expect checked "pick-bot-fixture"
  expect checked "pick-bot-bea"
  tap "group-next"
  expect tree has "step-group-policy"
  expect tree has "policy-last"
  expect tree has "policy-everyone"
  expect tree has "policy-chief"
  expect tree missing "pick-bot-fixture"
  expect tree missing "group-about"
  tap "policy-everyone"
  tap "group-back"
  expect tree has "pick-bot-bea"
  expect state groupPolicy == "everyone"
  tap "group-next"
  tap "group-next"
  expect tree has "step-group-kickoff"
  expect tree missing "policy-everyone"
  expect tree missing "review-kickoff"
  type "group-about" "Stand up"
  tap "group-back"
  expect state groupAbout == "Stand up"
  expect tree has "policy-everyone"
  tap "group-next"
  tap "group-next"
  expect tree has "step-group-review"
  expect text "review-group-name" == "Policy"
  expect tree has "group-faces"
  expect text "review-policy" == "Everyone"
  expect text "review-kickoff" == "Stand up"
  expect tree missing "group-name"
  expect tree missing "pick-bot-fixture"
  expect tree missing "group-about"
  tap "group-create"
  clock data
  clock settle
  expect text "room-title" == "Policy"
  tap "group-toggle"
  expect text "group-details-name" == "Policy"
  expect text "group-details-about" == "Stand up"
  expect tree has "group-member-fixture"
  expect tree has "group-member-bea"
test "searching Bots to add appears only when more than six can be added"
  size 1200x800
  at "/group/fixture-crowd"
  clock data
  tap "group-toggle"
  tap "group-edit"
  tap "group-add-open"
  expect tree has "group-add-search"
  expect tree has "group-add-fixture"
  expect tree has "group-add-one"
  expect tree has "group-add-seven"
  expect tree missing "group-add-bea"
  expect tree missing "group-add-ada-junior-1"
  type "group-add-search" "sev"
  expect tree has "group-add-seven"
  expect tree missing "group-add-one"
  expect tree missing "group-add-fixture"
test "a group's edit page saves who answers"
  size 1200x800
  at "/group/fixture"
  clock data
  tap "group-toggle"
  tap "group-edit"
  expect checked "group-policy-default"
  expect text "group-policy-default" == "Default (Last speaker)"
  expect text "group-policy-last" == "Last speaker"
  tap "group-policy-chief"
  clock data
  expect checked "group-policy-chief"
  expect text "group-policy-chief" == "A chief"
test "a chief group names the second Bot and sends that slug"
  size 340x740
  tap "new-bot"
  tap "new-group-option"
  clock settle
  type "group-name" "Crew"
  tap "group-next"
  tap "pick-bot-fixture"
  tap "pick-bot-bea"
  tap "group-next"
  expect tree missing "group-chief-bea"
  tap "policy-chief"
  expect checked "group-chief-fixture"
  expect tree has "group-chief-bea"
  tap "group-chief-bea"
  expect checked "group-chief-bea"
  tap "group-next"
  tap "group-next"
  expect text "review-policy" == "A chief"
  expect text "review-chief" == "Bea"
  tap "group-create"
  clock data
  clock settle
  expect text "room-title" == "Crew"
  expect text "room-hint" == "No @mention: Bea answers and can ask the others."
  tap "group-toggle"
  tap "group-edit"
  expect checked "group-chief-bea"
  expect text "group-chief-bea" == "Bea"
test "the room hint follows each answer policy"
  size 340x740
  at "/group/fixture"
  clock data
  expect text "room-hint" == "No @mention: the Bot that spoke last answers, or everyone at first."
  tap "group-toggle"
  expect text "group-details-hint" == "No @mention: the Bot that spoke last answers, or everyone at first."
  tap "group-edit"
  tap "group-policy-everyone"
  clock data
  tap "group-panel-back"
  expect text "group-details-hint" == "No @mention: every Bot answers."
  tap "group-panel-close"
  expect text "room-hint" == "No @mention: every Bot answers."
  tap "group-toggle"
  tap "group-edit"
  tap "group-policy-chief"
  clock data
  expect checked "group-chief-ada"
  tap "group-panel-back"
  expect text "group-details-hint" == "No @mention: Ada answers and can ask the others."
  tap "group-panel-close"
  expect text "room-hint" == "No @mention: Ada answers and can ask the others."
