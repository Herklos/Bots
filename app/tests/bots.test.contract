locale "en-US"

test "the model page shows ask, auto, and full access"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  clock data
  tap "model-row"
  clock settle
  expect tree has "model-page"
  expect tree has "access-ask"
  expect tree has "access-auto"
  expect tree has "access-full"
  expect text "access-ask" == "Ask"
  expect text "access-auto" == "Auto"
  expect text "access-full" == "Full access"
test "a secondary click on a Bot row offers pin and hide"
  size 1200x800
  at "/bot/fixture"
  clock data
  expect tree missing "row-menu"
  tap "bot-fixture" contextmenu
  expect tree has "row-menu"
  expect tree has "menu-pin-fixture"
  expect tree has "menu-hide-fixture"
  expect text "menu-pin-fixture" == "Pin to the top"
  expect text "menu-hide-fixture" == "Hide from inbox"
test "a local child opens and a remote child stays on the other machine"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  expect text "where-remote-1" == "One-off child thread, other machine"
  expect text "where-local-1" == "One-off child thread"
  expect tree missing "open-remote-1"
  tap "open-local-1"
  clock data
  expect tree has "child-transcript"
  expect tree has "child-strip"
  expect tree has "close-child"
  expect text "child-strip-status" == "Done"
  expect tree has "composer"
  expect tree missing "child-readonly"
  type "composer" "On the child"
  expect tree has "send"
test "a read-only child keeps the back strip"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  tap "open-local-ro"
  clock data
  expect tree has "child-transcript"
  expect tree has "child-strip"
  expect tree has "close-child"
  expect text "child-strip-status" == "Done"
  expect tree has "child-readonly"
  expect tree missing "composer"
  tap "close-child"
  clock data
  expect tree missing "child-strip"
  expect tree has "transcript"
test "creating a Bot opens that chat"
  size 340x740
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  type "new-name" "fixture"
  tap "create-next"
  tap "colour-brand.violet"
  tap "create-next"
  tap "shape-hex"
  tap "create-next"
  tap "create-skip"
  type "new-first" "Hello from the walk"
  type "new-prompt" "Stay terse."
  tap "create-next"
  expect text "review-name" == "fixture"
  expect text "review-colour" == "violet"
  expect text "review-shape" == "hex"
  expect text "review-first" == "Hello from the walk"
  tap "create"
  clock data
  clock settle
  expect tree missing "new-name"
  expect text "chat-title" == "Bea"
test "a main Bot saves instructions on blur"
  at "/bot/fixture"
  tap "panel-toggle"
  tap "panel-edit"
  type "bot-prompt" "Be brief."
  tap "panel-back"
  tap "panel-edit"
  expect text "bot-prompt" == "Be brief."
test "creating a Bot works on a narrow screen"
  size 340x740
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect disabled "create-next"
  type "new-name" "Milo"
  tap "create-next"
  tap "colour-brand.violet"
  tap "create-back"
  expect text "new-name" == "Milo"
  tap "new-close"
  clock settle
  expect tree missing "new-name"
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect disabled "create-next"
  expect text "new-name" == ""
test "the new Bot walk keeps each step to its own field"
  size 340x740
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect tree has "create-face"
  expect tree has "new-name"
  expect tree missing "colour-brand.violet"
  expect tree missing "shape-hex"
  expect tree missing "start-Night Shift"
  expect tree missing "new-first"
  expect tree missing "review-name"
  expect tree missing "create"
  expect disabled "create-next"
  type "new-name" "   "
  expect disabled "create-next"
  type "new-name" "Milo"
  tap "create-next"
  expect tree missing "new-name"
  expect tree has "colour-brand.violet"
  expect tree missing "shape-hex"
  expect tree has "create-face"
  tap "colour-brand.orange"
  tap "create-next"
  expect tree missing "colour-brand.orange"
  expect tree has "shape-hex"
  expect tree missing "new-first"
  tap "shape-hex"
  tap "create-back"
  expect state newColor == "brand.orange"
  expect tree has "colour-brand.orange"
  expect tree missing "shape-hex"
  tap "create-next"
  tap "create-next"
  expect tree has "start-Night Shift"
  expect tree missing "new-name"
  expect tree missing "new-first"
  expect tree missing "shape-hex"
  tap "start-Night Shift"
  expect state newName == "Night Shift"
  expect state newColor == "brand.orange"
  expect state newShape == "hex"
  expect state newFirst == "You are my night shift. While I sleep, go through what came in and have a short digest ready for the morning."
  expect tree has "new-first"
  expect text "new-first" == "You are my night shift. While I sleep, go through what came in and have a short digest ready for the morning."
  expect tree missing "start-Night Shift"
  tap "create-back"
  expect tree has "start-Night Shift"
  expect state newFirst == "You are my night shift. While I sleep, go through what came in and have a short digest ready for the morning."
  tap "create-back"
  tap "create-back"
  tap "create-back"
  expect text "new-name" == "Night Shift"
  type "new-name" ""
  expect disabled "create-next"
  expect tree missing "create"
test "the parent sheet lists its subagents without a new subagent button"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  expect tree has "subagent-heading"
  expect text "subagent-name-ada-junior-1" == "Ada junior 1"
  expect tree has "subagent-ada-junior-1"
  expect tree has "lineage-heading"
  expect tree has "line-local-1"
  expect tree missing "new-subagent"
  tap "edit-subagent-ada-junior-1"
  clock settle
  expect text "panel-page-title" == "Subagent"
  expect tree has "subagent-prompt"
  expect tree missing "bot-prompt"
  expect tree has "subagent-inherit"
  expect tree has "subagent-save"
  expect tree has "delete-subagent"
test "a subagent stays out of the inbox, Hidden, search, and group pickers"
  size 1200x800
  at "/bot/fixture"
  clock data
  expect tree missing "bot-ada-junior-1"
  expect tree has "bot-fixture"
  tap "hidden-toggle"
  expect tree has "hidden-bea"
  expect tree missing "hidden-ada-junior-1"
  tap "search-open"
  type "bot-search" "junior"
  expect tree has "no-bot-match"
  expect tree missing "bot-ada-junior-1"
  expect tree missing "hidden-ada-junior-1"
  expect tree missing "hidden-bea"
  tap "search-cancel"
  tap "new-bot"
  tap "new-group-option"
  clock settle
  type "group-name" "Crew"
  tap "group-next"
  expect tree missing "pick-bot-ada-junior-1"
  expect tree has "pick-bot-fixture"
  expect tree has "pick-bot-bea"
  back
  at "/group/fixture"
  clock data
  tap "group-toggle"
  tap "group-edit"
  expect tree has "group-roster-ada"
  expect tree has "group-roster-bea"
  tap "group-add-open"
  expect tree missing "group-add-ada-junior-1"
  expect tree has "group-add-fixture"
  expect tree missing "group-add-bea"
test "the model page shows five effort levels and keeps the current one"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  tap "model-row"
  clock data
  expect tree has "model-page"
  expect tree has "effort-low"
  expect tree has "effort-medium"
  expect tree has "effort-high"
  expect tree has "effort-xhigh"
  expect tree has "effort-max"
  expect checked "effort-high"
  tap "model-sonnet"
  clock data
  expect checked "model-sonnet"
  expect checked "effort-high"
