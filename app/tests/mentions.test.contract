locale "en-US"

test "typing @ in a group offers bot slug completions"
  size 1200x800
  at "/group/fixture"
  clock data
  expect tree missing "mention-menu"
  type "room-composer" "@"
  expect tree has "mention-menu"
  expect tree has "mention-opt-all"
  expect tree has "mention-opt-ada"
  expect tree has "mention-opt-bea"
  type "room-composer" "@a"
  expect tree has "mention-opt-ada"
  expect tree has "mention-opt-all"
  expect tree missing "mention-opt-bea"
  tap "mention-opt-ada"
  expect tree missing "mention-menu"
  expect text "room-hint" == "Only the Bots you mention are woken."
  expect enabled "room-send"
test "typing @ in a bot chat offers bot slug completions"
  size 1200x800
  at "/bot/fixture"
  clock data
  type "composer" "@"
  expect tree has "mention-menu"
  expect tree has "mention-opt-fixture"
  tap "mention-opt-fixture"
  expect tree missing "mention-menu"
test "the everyone chip inserts that mention and the hint says it wakes the group"
  size 1200x800
  at "/group/fixture"
  clock data
  expect tree has "mention-everyone"
  tap "mention-everyone"
  expect text "room-composer" == "@everyone "
  expect text "room-hint" == "@everyone wakes every Bot in the group."
  expect enabled "room-send"
test "the mention menu offers everyone"
  size 1200x800
  at "/group/fixture"
  clock data
  type "room-composer" "@e"
  expect tree has "mention-menu"
  expect tree has "mention-opt-everyone"
  tap "mention-opt-everyone"
  expect tree missing "mention-menu"
  expect text "room-hint" == "@everyone wakes every Bot in the group."
test "a mention names a Bot and leaves the group selected"
  size 1440x900
  at "/group/fixture"
  clock +600
  clock data
  expect tree has "open-group-fixture"
  expect tree missing "open-bot-fixture"
  tap "mention-ada"
  expect text "room-composer" == "@ada "
  expect text "room-hint" == "Only the Bots you mention are woken."
  expect tree has "open-group-fixture"
  expect tree missing "open-bot-fixture"
  tap "hidden-toggle"
  tap "hidden-bea"
  clock data
  expect text "chat-title" == "Bea"
  expect tree missing "open-group-fixture"
  expect tree missing "room-title"
  back
  expect tree missing "chat-title"
  expect tree missing "room-title"
