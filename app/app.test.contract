  expect tree has "subagent-inherit"
  expect tree has "subagent-save"
  expect tree has "delete-subagent"

test "the reaction picker opens beside a Bot message"
  // The smile stays mounted. Opacity and pointer-events hide it until chrome shows, same as reply and pin.
  at "/bot/fixture"
