test "a mention names a Bot and leaves the group selected"
  size 1440x900
  at "/group/fixture"
  clock +600
  clock data
  expect tree has "open-group-fixture"
  expect tree missing "open-bot-fixture"
  tap "mention-ada"
  expect text "room-composer" == "@ada "
  expect text "room-hint" == "Only the Bots you mention are woken."
  expect tree has "open-group-fixture"
  expect tree missing "open-bot-fixture"
  tap "hidden-toggle"
  tap "hidden-bea"
  clock data
  expect text "chat-title" == "Bea"
  expect tree missing "open-group-fixture"
  expect tree missing "room-title"
  back
  expect tree missing "chat-title"
  expect tree missing "room-title"

