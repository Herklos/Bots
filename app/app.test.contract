locale "en-US"

// Navigation reflects the features available today. No live gateway is used.
test "Settings owns the Vault and does not expose Projects"
  expect tree missing "open-vault"
  expect tree missing "open-projects"
  tap "Settings"
  clock data
  expect tree has "user-name"
  expect tree missing "beta-projects"
  expect tree has "open-vault"
  expect tree has "new-password"
  expect disabled "save-password"
  type "new-password" "a-password"
  expect enabled "save-password"

test "a login is reached through Settings and needs a title or website"
  tap "Settings"
  clock data
  tap "open-vault"
  clock data
  expect tree has "new-login"
  tap "new-login"
  clock settle
  expect disabled "login-save"
  expect tree missing "reveal-password"
  type "login-title" "Mail"
  expect enabled "login-save"
  back
  back
  expect tree has "user-name"
  expect tree has "open-vault"

test "Settings counts usage and still hides Projects"
  tap "Settings"
  clock data
  expect tree has "usage-error"
  expect text "usage-error" == "Can’t load usage. Check that hbots is running, then try again."
  expect tree missing "open-projects"
  expect tree missing "beta-projects"
  expect tree has "open-vault"
  expect tree has "user-name"

test "the library says when it cannot open"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  tap "panel-tab-library"
  clock data
  expect tree has "library-error"
  expect text "library-error" == "Can’t open this library. Check that hbots is running, then try again."
  expect tree missing "open-projects"
  expect tree missing "add-library"
  expect tree missing "add-connector"

test "the computer says when it cannot open"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  tap "panel-tab-computer"
  clock data
  expect tree has "computer-error"
  expect text "computer-error" == "Can’t open this Bot’s browser. Check that hbots is running, then try again."
  expect tree missing "computer-frame"
  expect tree missing "open-projects"

test "a missing Bot has no model, routine, or library row"
  size 340x740
  at "/bot/ada"
  clock data
  tap "panel-toggle"
  clock settle
  expect tree missing "bot-panel"
  expect tree missing "open-library"
  expect tree missing "open-computer"
  expect tree missing "add-routine"
  expect tree missing "model-error"
  expect tree missing "lineage-error"
  expect tree missing "open-projects"

test "the header does not invent Bot details when the Bot is missing"
  size 340x740
  at "/bot/ada"
  clock data
  expect tree missing "bot-panel"
  expect tree has "panel-toggle"
  tap "panel-toggle"
  clock settle
  expect tree missing "bot-panel"
  expect tree missing "open-library"
  tap "panel-toggle"
  clock settle
  expect tree missing "bot-panel"

test "a wide window does not invent a panel for a missing Bot"
  size 1440x900
  at "/bot/ada"
  clock +600
  clock data
  expect tree missing "bot-panel"
  expect tree missing "open-library"
  expect tree missing "open-projects"
  expect tree has "panel-toggle"

test "a room shows who is working and who is still getting set up"
  at "/group/fixture"
  clock data
  expect text "member-ada-name" == "Ada"
  expect text "member-ada-state" == "Working"
  expect text "member-bea-name" == "Bea"
  expect text "member-bea-state" == "Getting set up…"
  expect tree has "room-working"
  expect tree has "room-working-dots"
  expect tree has "room-working-ada"
  expect tree missing "room-working-bea"
  expect tree has "room-msg-r1"
  expect tree has "room-msg-r2"

test "a room shows one working mark when several members are working"
  at "/group/fixture-busy"
  clock data
  expect tree has "room-working"
  expect tree has "room-working-dots"
  expect tree has "room-working-ada"
  expect tree has "room-working-bea"
  expect tree has "room-msg-r1"

test "a message shows a reaction, a quote, and a pin that is not in view"
  at "/bot/fixture"
  clock data
  expect text "react-m2" == "🔥"
  expect text "quote-m2" == "Hello"
  expect text "pin-missing" == "This message is not in view."

test "reply quotes a line and pin toggles a row"
  at "/bot/fixture"
  clock data
  expect text "pin-missing" == "This message is not in view."
  tap "reply-m2"
  expect text "reply-quote" == "Hi there"
  expect tree has "reply-cancel"
  tap "reply-cancel"
  expect tree missing "reply-cancel"
  tap "pin-message-m2"
  clock data
  expect text "pin-m2" == "Hi there"
  expect text "pin-missing" == "This message is not in view."
  tap "pin-message-m2"
  clock data
  expect tree missing "pin-m2"
  expect text "pin-missing" == "This message is not in view."

test "the open chat is clear and a hidden Bot keeps its mark"
  size 1440x900
  at "/bot/fixture"
  clock data
  expect tree missing "unread-fixture"
  tap "hidden-toggle"
  expect tree has "unread-bea"

test "search filters the loaded conversation"
  at "/bot/fixture"
  clock data
  expect tree has "message-m1"
  tap "chat-search-open"
  type "chat-search" "there"
  expect tree missing "message-m1"
  expect tree has "message-m2"
  expect text "search-note" == "Search covers the loaded conversation."

test "a local child opens and a remote child stays on the other machine"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  expect text "where-remote-1" == "On another machine"
  expect tree missing "open-remote-1"
  tap "open-local-1"
  clock data
  expect tree has "child-transcript"
  expect tree has "composer"
  expect tree missing "child-readonly"
  type "composer" "On the child"
  expect tree has "send"

test "a token line shows only when the turn shares an id"
  at "/bot/fixture"
  clock data
  expect text "tokens-m2" == "12 in, 3 out, 4 read from cache, 1 written to cache."
  expect tree missing "tokens-m3"

test "the composer holds a voice clip and the sent clip is that attachment"
  at "/bot/fixture"
  clock data
  expect tree has "audio-voice"
  tap "voice-record"
  clock settle
  expect text "voice-hold" == "voice.m4a"

test "a draft stays with its Bot and a child keeps its own"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  tap "voice-record"
  clock settle
  expect text "voice-hold" == "voice.m4a"
  type "composer" "Ada draft"
  expect text "composer" == "Ada draft"
  tap "hidden-toggle"
  tap "hidden-bea"
  clock data
  expect tree missing "voice-hold"
  type "composer" "Bea draft"
  expect text "composer" == "Bea draft"
  tap "bot-fixture"
  clock +600
  clock data
  expect text "composer" == "Ada draft"
  expect text "voice-hold" == "voice.m4a"
  tap "open-local-1"
  clock data
  expect tree missing "voice-hold"
  type "composer" "Child draft"
  expect text "composer" == "Child draft"
  tap "close-child"
  clock data
  expect text "composer" == "Ada draft"
  expect text "voice-hold" == "voice.m4a"
  tap "open-local-1"
  clock data
  expect text "composer" == "Child draft"
  clock +1
  clock data
  reload
  clock +1
  clock data
  clock +600
  expect text "composer" == "Ada draft"
  expect text "voice-hold" == "voice.m4a"
  tap "open-local-1"
  clock data
  expect text "composer" == "Child draft"

test "creating a Bot works on a narrow screen"
  size 340x740
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect disabled "create"
  type "new-name" "Milo"
  tap "colour-brand.violet"
  expect enabled "create"
  tap "Cancel"
  clock settle
  expect tree missing "new-name"
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect disabled "create"

test "the parent sheet lists its subagents without a new subagent button"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  expect tree has "subagent-heading"
  expect text "subagent-name-ada-junior-1" == "Ada junior 1"
  expect tree has "subagent-ada-junior-1"
  expect tree has "lineage-heading"
  expect tree has "line-local-1"
  expect tree missing "new-subagent"
  tap "edit-subagent-ada-junior-1"
  clock settle
  expect text "panel-page-title" == "Subagent"
  expect tree has "subagent-prompt"
  expect tree has "subagent-inherit"
  expect tree has "subagent-save"
  expect tree has "delete-subagent"

test "the reaction picker opens under a Bot message"
  at "/bot/fixture"
  clock data
  tap "add-react-m3"
  expect tree has "react-picker"
  expect tree has "pick-🎉"

test "the plus button offers a Bot or a group, and a group needs a name and two Bots"
  size 1200x800
  at "/bot/fixture"
  clock data
  expect tree missing "new-menu"
  tap "new-bot"
  expect tree has "new-bot-option"
  expect tree has "new-group-option"
  tap "new-group-option"
  clock settle
  expect tree missing "new-menu"
  expect disabled "group-create"
  type "group-name" "Crew"
  expect disabled "group-create"
  tap "pick-bot-fixture"
  expect text "group-count" == "Pick at least two (1 so far)"
  expect disabled "group-create"
  tap "pick-bot-bea"
  expect text "group-count" == "2 picked"
  expect tree has "group-faces"
  expect tree missing "group-colour-brand.blue"
  expect tree missing "group-shape-hex"
  expect enabled "group-create"
  tap "group-create"
  clock settle
  expect text "room-title" == "Crew"
  expect tree has "room-composer"
  expect tree missing "room-working"

test "groups sit in the same list as Bots, with no section of their own"
  size 1200x800
  at "/bot/fixture"
  clock data
  expect tree has "bot-fixture"
  expect tree has "group-fixture"
  expect text "group-title-fixture" == "Design"
  expect tree missing "groups-label"
  expect tree missing "new-group"

test "a group shows who said what and its mention chips"
  size 1200x800
  at "/group/fixture"
  clock data
  expect text "room-title" == "Design"
  expect text "room-text-r1" == "Hello"
  expect text "room-from-r2" == "Ada"
  expect text "room-text-r2" == "On it"
  expect tree has "mention-ada"
  expect tree has "mention-bea"
  expect text "room-hint" == "No @mention: the Bot that spoke last answers, or everyone at first."
  expect disabled "room-send"
  tap "mention-ada"
  expect text "room-hint" == "Only the Bots you mention are woken."
  expect enabled "room-send"

test "a group has a details panel like a Bot, and deleting lives inside it"
  size 1200x800
  at "/group/fixture"
  clock data
  expect tree missing "group-delete"
  tap "group-toggle"
  expect text "group-details-name" == "Design"
  expect text "group-details-about" == "Where Ada and Bea trade drafts"
  expect text "group-members-label" == "Bots, 2"
  expect tree has "group-member-ada"
  expect tree has "group-member-bea"
  expect tree missing "group-delete"
  tap "group-edit"
  expect tree has "group-edit-name"
  expect tree has "group-edit-about"
  expect tree has "group-edit-member-fixture"
  expect tree has "group-edit-member-bea"
  expect tree missing "group-edit-colour-brand.blue"
  expect tree missing "group-edit-shape-hex"
  expect tree has "group-delete"
  tap "group-panel-back"
  expect tree missing "group-edit-name"
  tap "group-panel-close"

test "the library says when it cannot open, in French"
  locale "fr"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  tap "panel-tab-library"
  clock data
  expect tree has "library-error"
  expect text "library-error" == "Impossible d’ouvrir cette bibliothèque. Vérifiez qu’hbots tourne, puis réessayez."

test "one server tab shows its title once"
  size 340x740
  at "/bot/page"
  clock data
  tap "panel-toggle"
  tap "panel-tab-computer"
  clock data
  expect text "computer-tab-title" == "Only"
  expect tree missing "tab-only"
  expect tree has "computer-take"
  expect tree missing "computer-frame"

test "tapping the page picture covers the screen until close"
  size 340x740
  at "/bot/frame"
  clock data
  tap "panel-toggle"
  tap "panel-tab-computer"
  clock data
  expect tree has "computer-frame"
  expect tree missing "computer-overlay"
  expect tree has "computer-take"
  expect tree missing "tab-only"
  expect text "computer-status" == "Frame’s screen"
  tap "computer-frame"
  expect tree has "computer-overlay"
  expect tree has "computer-large"
  expect tree has "computer-close"
  expect tree has "computer-take"
  tap "computer-close"
  expect tree missing "computer-overlay"
  expect tree has "computer-frame"
  expect tree has "computer-take"

test "taking control sends the picture's keys and does not open the overlay from a click"
  size 340x740
  at "/bot/frame"
  clock data
  tap "panel-toggle"
  tap "panel-tab-computer"
  clock data
  tap "computer-frame"
  expect tree has "computer-overlay"
  tap "computer-close"
  expect tree missing "computer-overlay"
  tap "computer-take"
  clock data
  expect tree has "computer-release"
  expect tree has "computer-enlarge"
  expect tree missing "computer-overlay"
  tap "computer-frame" at 12 12
  expect tree missing "computer-overlay"
  expect tree missing "computer-error"
  type "computer-frame" key "Enter"
  expect tree missing "computer-error"
  tap "computer-enlarge"
  expect tree has "computer-overlay"
  expect tree has "computer-large"
  expect tree missing "tab-only"
  tap "computer-release"
  clock data
  expect tree has "computer-take"
  expect tree missing "computer-enlarge"
  tap "computer-frame"
  expect tree has "computer-overlay"

test "two server tabs are listed and the second can be chosen"
  size 340x740
  at "/bot/tabs"
  clock data
  tap "panel-toggle"
  tap "panel-tab-computer"
  clock data
  expect tree has "tab-one"
  expect tree has "tab-two"
  expect text "computer-tab-title" == "One"
  tap "tab-two"
  clock data
  expect text "computer-tab-title" == "Two"
