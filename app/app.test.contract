  expect tree has "no-bot-match"
  expect tree missing "bot-ada-junior-1"
  expect tree missing "hidden-ada-junior-1"
  expect tree missing "hidden-bea"
  tap "search-cancel"
  tap "new-bot"
  tap "new-group-option"
  clock settle
  type "group-name" "Crew"
  tap "group-next"
  expect tree missing "pick-bot-ada-junior-1"
  expect tree has "pick-bot-fixture"
  expect tree has "pick-bot-bea"
  back
  at "/group/fixture"
  clock data
  tap "group-toggle"
  tap "group-edit"
  expect tree has "group-roster-ada"
  expect tree has "group-roster-bea"
  tap "group-add-open"
  expect tree missing "group-add-ada-junior-1"
  expect tree has "group-add-fixture"
  expect tree missing "group-add-bea"

