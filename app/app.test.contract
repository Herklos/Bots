locale "en-US"

// Navigation reflects the features available today. No live gateway is used.
test "About shows the version and changelog and no update when none is available"
  tap "Settings"
  clock data
  tap "settings-domain-updates"
  clock data
  expect text "settings-domain-updates" == "About"
  expect tree has "about-version"
  expect tree has "about-changelog"
  expect tree has "update-status"
  expect tree missing "start-update"

test "Settings owns the Vault and does not expose Projects"
  expect tree missing "open-vault"
  expect tree missing "open-projects"
  tap "Settings"
  clock data
  expect tree has "user-name"
  expect tree missing "beta-projects"
  tap "settings-domain-access"
  expect tree has "open-vault"
  expect tree has "new-password"
  expect disabled "save-password"
  type "new-password" "a-password"
  expect enabled "save-password"

test "a login is reached through Settings and needs a title or website"
  tap "Settings"
  clock data
  expect tree has "user-name"
  tap "settings-domain-access"
  tap "open-vault"
  clock data
  expect tree has "new-login"
  tap "new-login"
  clock settle
  expect disabled "login-save"
  expect tree missing "reveal-password"
  type "login-title" "Mail"
  expect enabled "login-save"
  back
  back
  expect tree has "open-vault"
  tap "settings-domain-user"
  expect tree has "user-name"

test "Settings counts usage and still hides Projects"
  tap "Settings"
  clock data
  expect tree has "user-name"
  tap "settings-domain-user"
  expect tree has "usage-error"
  expect text "usage-error" == "Can’t load usage. Check that hbots is running, then try again."
  expect tree missing "open-projects"
  expect tree missing "beta-projects"
  tap "settings-domain-access"
  expect tree has "open-vault"

test "the library says when it cannot open"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  tap "panel-tab-library"
  clock data
  expect tree has "library-error"
  expect text "library-error" == "Can’t open this library. Check that hbots is running, then try again."
  expect tree missing "open-projects"
  expect tree missing "add-library"
  expect tree missing "add-connector"

test "the computer says when it cannot open"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  tap "panel-tab-computer"
  clock data
  expect tree has "computer-error"
  expect text "computer-error" == "Can’t open this Bot’s browser. Check that hbots is running, then try again."
  expect tree missing "computer-frame"
  expect tree missing "open-projects"

test "the model page shows ask, auto, and full access"
  size 340x740
  at "/bot/fixture"
  clock data
  tap "panel-toggle"
  clock data
  tap "model-row"
  clock settle
  expect tree has "model-page"
  expect tree has "access-ask"
  expect tree has "access-auto"
  expect tree has "access-full"
  expect text "access-ask" == "Ask"
  expect text "access-auto" == "Auto"
  expect text "access-full" == "Full access"

test "a missing Bot has no model, routine, or library row"
  size 340x740
  at "/bot/ada"
  clock data
  tap "panel-toggle"
  clock settle
  expect tree missing "bot-panel"
  expect tree missing "open-library"
  expect tree missing "open-computer"
  expect tree missing "add-routine"
  expect tree missing "model-error"
  expect tree missing "lineage-error"
  expect tree missing "open-projects"

test "the header does not invent Bot details when the Bot is missing"
  size 340x740
  at "/bot/ada"
  clock data
  expect tree missing "bot-panel"
  expect tree has "panel-toggle"
  tap "panel-toggle"
  clock settle
  expect tree missing "bot-panel"
  expect tree missing "open-library"
  tap "panel-toggle"
  clock settle
  expect tree missing "bot-panel"

test "a wide window does not invent a panel for a missing Bot"
  size 1440x900
  at "/bot/ada"
  clock +600
  clock data
  expect tree missing "bot-panel"
  expect tree missing "open-library"
  expect tree missing "open-projects"
  expect tree has "panel-toggle"

test "a room shows who is working and who is still getting set up"
  at "/group/fixture"
  clock data
  expect text "member-ada-name" == "Ada"
  expect text "member-ada-state" == "Working"
  expect text "member-bea-name" == "Bea"
  expect text "member-bea-state" == "Getting set up…"
  expect tree has "room-working"
  expect tree has "room-working-dots"
  expect tree has "room-working-ada"
  expect tree missing "room-working-bea"
  expect tree has "room-msg-r1"
  expect tree has "room-msg-r2"

test "a room shows one working mark when several members are working"
  at "/group/fixture-busy"
  clock data
  expect tree has "room-working"
  expect tree has "room-working-dots"
  expect tree has "room-working-ada"
  expect tree has "room-working-bea"
  expect tree has "room-msg-r1"

test "a tool line is a chip with the translated verb, not a message bubble"
  at "/bot/fixture"
  clock data
  expect tree has "event-e1"
  expect text "event-verb-e1" == "Created routine"
  expect text "event-title-e1" == "Morning"
  expect tree missing "event-bot-e1"
  expect tree missing "message-e1"
  expect text "event-verb-e2" == "Messaged"
  expect text "event-bot-e2" == "Inbox"

test "an unchanged open chat keeps its transcript"
  at "/bot/quiet"
  clock data
  expect text "message-q1" == "Still here"
  clock +1600
  clock data
  expect text "message-q1" == "Still here"

test "a message shows a reaction, a quote, and a pin that is not in view"
  at "/bot/fixture"
  clock data
  expect text "react-m2" == "🔥"
  expect text "quote-m2" == "Hello"
  expect text "pin-missing" == "This message is not in view."

test "reply quotes a line and pin toggles a row"
  at "/bot/fixture"
  clock data
  expect text "pin-missing" == "This message is not in view."
  expect tree missing "pin-message-m2"
  tap "reply-m2"
  expect text "reply-quote" == "Hi there"
  expect tree has "reply-cancel"
  tap "reply-cancel"
  expect tree missing "reply-cancel"
  tap "message-m2" contextmenu
  tap "menu-pin-m2"
  clock data
  expect text "pin-m2" == "Hi there"
  expect text "pin-missing" == "This message is not in view."
  tap "message-m2" contextmenu
  tap "menu-pin-m2"
  clock data
  expect tree missing "pin-m2"
  expect text "pin-missing" == "This message is not in view."

test "a secondary click on a Bot row offers pin and hide"
  size 1200x800
  at "/bot/fixture"
  clock data
  expect tree missing "row-menu"
  tap "bot-fixture" contextmenu
  expect tree has "row-menu"
  expect tree has "menu-pin-fixture"
  expect tree has "menu-hide-fixture"
  expect text "menu-pin-fixture" == "Pin to the top"
  expect text "menu-hide-fixture" == "Hide from inbox"

test "a secondary click on a Bot message offers reply and pin"
  at "/bot/fixture"
  clock data
  expect tree missing "message-menu"
  tap "message-m2" contextmenu
  expect tree has "message-menu"
  expect tree has "menu-reply-m2"
  expect tree has "menu-pin-m2"
  expect tree has "menu-copy-m2"
  expect tree has "menu-react-m2"
  expect text "menu-pin-m2" == "Pin"
  expect text "menu-reply-m2" == "Reply"
  expect text "menu-copy-m2" == "Copy"

test "the message menu copies, unpins, and closes from the strip, Esc, outside, and arrows"
  at "/bot/fixture"
  clock data
  tap "message-m1" contextmenu
  expect text "menu-pin-m1" == "Unpin"
  tap "message-menu-scrim"
  expect tree missing "message-menu"
  tap "message-m2" contextmenu
  expect tree has "pick-🔥"
  expect tree has "pick-👍"
  tap "pick-🔥"
  expect tree missing "message-menu"
  tap "message-m3" contextmenu
  expect tree missing "react-picker"
  tap "pick-👍"
  expect tree missing "message-menu"
  tap "message-m2" contextmenu
  key "menu-reply-m2" "ArrowDown"
  key "menu-pin-m2" "ArrowDown"
  expect tree has "menu-copy-m2"
  key "menu-copy-m2" "Escape"
  expect tree missing "message-menu"
  tap "message-m2" contextmenu
  tap "menu-copy-m2"
  expect text "menu-copy-m2" == "Copied"
  expect tree has "toast"
  clock +700
  clock settle
  expect tree missing "message-menu"

test "a group message uses the same menu"
  at "/group/fixture"
  clock data
  expect tree missing "message-menu"
  tap "room-text-r2" contextmenu
  expect tree has "message-menu"
  expect tree has "menu-reply-r2"
  expect tree has "menu-pin-r2"
  expect tree has "menu-copy-r2"
  expect tree has "menu-react-r2"
  expect text "menu-pin-r2" == "Pin"
  expect text "room-from-r2" == "Ada"
  tap "message-menu-scrim"
  expect tree missing "message-menu"

test "the open chat is clear and a hidden Bot keeps its mark"
  size 1440x900
  at "/bot/fixture"
  clock data
  expect tree missing "unread-fixture"
  tap "hidden-toggle"
  expect tree has "unread-bea"

test "a pipe table is a grid"
  at "/bot/fixture"
  clock data
  expect tree has "message-m4-table-0"
  expect tree has "message-m2"
  expect tree missing "message-m4"

test "search filters the loaded conversation"
  at "/bot/fixture"
  clock data
  expect tree has "message-m1"
  tap "chat-search-open"
  type "chat-search" "there"
  expect tree missing "message-m1"
  expect tree has "message-m2"
  expect text "search-note" == "Search covers the loaded conversation."

test "a local child opens and a remote child stays on the other machine"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  expect text "where-remote-1" == "One-off child thread, other machine"
  expect text "where-local-1" == "One-off child thread"
  expect tree missing "open-remote-1"
  tap "open-local-1"
  clock data
  expect tree has "child-transcript"
  expect tree has "child-strip"
  expect tree has "close-child"
  expect text "child-strip-status" == "Done"
  expect tree has "composer"
  expect tree missing "child-readonly"
  type "composer" "On the child"
  expect tree has "send"

test "a read-only child keeps the back strip"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  tap "open-local-ro"
  clock data
  expect tree has "child-transcript"
  expect tree has "child-strip"
  expect tree has "close-child"
  expect text "child-strip-status" == "Done"
  expect tree has "child-readonly"
  expect tree missing "composer"
  tap "close-child"
  clock data
  expect tree missing "child-strip"
  expect tree has "transcript"

test "a token line shows only when the turn shares an id"
  at "/bot/fixture"
  clock data
  expect text "tokens-m2" == "12 in, 3 out, 4 read from cache, 1 written to cache."
  expect tree missing "tokens-m3"

test "the composer holds a voice clip and the sent clip is that attachment"
  at "/bot/fixture"
  clock data
  expect tree has "audio-voice"
  tap "voice-record"
  clock settle
  expect text "voice-hold" == "voice.m4a"

test "rapid composer edits save once, and a pause saves the latest text"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  type "composer" "a"
  clock +300
  type "composer" "ab"
  clock +300
  type "composer" "abc"
  clock +300
  expect state savedRev == 0
  expect text "composer" == "abc"
  clock +100
  clock data
  expect state savedRev == 3
  expect text "composer" == "abc"

test "a draft stays with its Bot and a child keeps its own"
  size 1440x900
  at "/bot/fixture"
  clock +600
  clock data
  tap "voice-record"
  clock settle
  expect text "voice-hold" == "voice.m4a"
  type "composer" "Ada draft"
  expect text "composer" == "Ada draft"
  tap "hidden-toggle"
  tap "hidden-bea"
  clock data
  expect tree missing "voice-hold"
  type "composer" "Bea draft"
  expect text "composer" == "Bea draft"
  tap "bot-fixture"
  clock +600
  clock data
  expect text "composer" == "Ada draft"
  expect text "voice-hold" == "voice.m4a"
  tap "open-local-1"
  clock data
  expect tree missing "voice-hold"
  type "composer" "Child draft"
  expect text "composer" == "Child draft"
  tap "close-child"
  clock data
  expect text "composer" == "Ada draft"
  expect text "voice-hold" == "voice.m4a"
  tap "open-local-1"
  clock data
  expect text "composer" == "Child draft"
  clock +1
  clock data
  reload
  clock +1
  clock data
  clock +600
  expect text "composer" == "Ada draft"
  expect text "voice-hold" == "voice.m4a"
  tap "open-local-1"
  clock data
  expect text "composer" == "Child draft"

test "creating a Bot opens that chat"
  size 340x740
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  type "new-name" "fixture"
  tap "create-next"
  tap "colour-brand.violet"
  tap "create-next"
  tap "shape-hex"
  tap "create-next"
  tap "create-skip"
  type "new-first" "Hello from the walk"
  tap "create-next"
  expect text "review-name" == "fixture"
  expect text "review-colour" == "Colour violet"
  expect text "review-shape" == "Shape hex"
  expect text "review-first" == "Hello from the walk"
  tap "create"
  clock data
  clock settle
  expect tree missing "new-name"
  expect text "chat-title" == "Bea"

test "creating a Bot works on a narrow screen"
  size 340x740
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect disabled "create-next"
  type "new-name" "Milo"
  tap "create-next"
  tap "colour-brand.violet"
  tap "create-back"
  expect text "new-name" == "Milo"
  tap "Cancel"
  clock settle
  expect tree missing "new-name"
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect disabled "create-next"
  expect text "new-name" == ""

test "the new Bot walk keeps each step to its own field"
  size 340x740
  tap "new-bot"
  tap "new-bot-option"
  clock settle
  expect tree has "create-face"
  expect tree has "new-name"
  expect tree missing "colour-brand.violet"
  expect tree missing "shape-hex"
  expect tree missing "start-Night Shift"
  expect tree missing "new-first"
  expect tree missing "review-name"
  expect tree missing "create"
  expect disabled "create-next"
  type "new-name" "   "
  expect disabled "create-next"
  type "new-name" "Milo"
  tap "create-next"
  expect tree missing "new-name"
  expect tree has "colour-brand.violet"
  expect tree missing "shape-hex"
  expect tree has "create-face"
  tap "colour-brand.orange"
  tap "create-next"
  expect tree missing "colour-brand.orange"
  expect tree has "shape-hex"
  expect tree missing "new-first"
  tap "shape-hex"
  tap "create-back"
  expect state newColor == "brand.orange"
  expect tree has "colour-brand.orange"
  expect tree missing "shape-hex"
  tap "create-next"
  tap "create-next"
  expect tree has "start-Night Shift"
  expect tree missing "new-name"
  expect tree missing "new-first"
  expect tree missing "shape-hex"
  tap "start-Night Shift"
  expect state newName == "Night Shift"
  expect state newColor == "brand.orange"
  expect state newShape == "hex"
  expect state newFirst == "You are my night shift. While I sleep, go through what came in and have a short digest ready for the morning."
  expect tree has "new-first"
  expect text "new-first" == "You are my night shift. While I sleep, go through what came in and have a short digest ready for the morning."
  expect tree missing "start-Night Shift"
  tap "create-back"
  expect tree has "start-Night Shift"
  expect state newFirst == "You are my night shift. While I sleep, go through what came in and have a short digest ready for the morning."
  tap "create-back"
  tap "create-back"
  tap "create-back"
  expect text "new-name" == "Night Shift"
  type "new-name" ""
  expect disabled "create-next"
  expect tree missing "create"

test "the parent sheet lists its subagents without a new subagent button"
