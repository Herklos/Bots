use NotificationStatus from "@exact/notifications"
use Glyph from "../glyph.contract"
use ModelPicker, UsageView from "./settings.contract"
use Screen, PageTitle, PageHeader, ToggleControl, SectionLabel, IconTile, Field from "../ui/controls.contract"
use Reply, Session, Network, Storage, Pairing, AnytypeCheck, About, SystemStatus, UpdateStart, Prefs, NoticeState, initialsOf, botCountLabel, settingsDomainLabel, noticeOn, mutedBots, mutedGroups, firstMutedBot, firstMutedGroup, noticeStatusLabel, networkModeLabel, themeLabel from "../ui/root-types.contract"
use Bot, Convo, Provider, UsageReport from "../ui/shapes.contract"
use GroupCard, SettingsTrack, SettingsTab, SettingsRow, SettingsFoot, FieldLabel, FieldBox, ActionMain, ActionQuiet from "../ui/sidebar.contract"
use AccessSettings from "./access.contract"
use ModelSettings from "./models.contract"
use NoticeSettings from "./notice.contract"
use UpdateSettings from "./updates.contract"
use UserSettings from "./user.contract"
// SettingsScreen: one route of the root view, moved out with its values and actions injected.
use SettingsBag from "./bag.contract"
component SettingsScreen
  props
    route: number
  inject
    copyMcpToken: action
    hideMcpToken: action
    toggleMcp: action
    createMcp: action
    revokeMcp: action
    settingsBag: SettingsBag
    doAllowNotices: action
    doAnytypeCheck: action
    doCopyStorage: action
    doDefaultMode: action
    doEditFolder: action
    doEditName: action
    doEditPairCode: action
    doEditSpace: action
    doGroupAnswer: action
    doMakeDefault: action
    doMute: action
    doMuteGroup: action
    doPairConfirm: action
    doPairStart: action
    doPrepareAnytype: action
    doPickBackend: action
    doPickTheme: action
    doRestartNetwork: action
    doRestartStorage: action
    doSaveName: action
    doSavePassword: action
    doSaveSpace: action
    doSaveStorage: action
    doSetNetwork: action
    doStartUpdate: action
    doTestStorage: action
    editNewPassword: action
    logout: action
    open: action
    pickPeriod: action
    pickSettingsDomain: action
    pickView: action
    saveNoticePart: action
    saveNotifications: action
  provide
    mcpStatus = settingsBag.mcpStatus
    mcpToken = settingsBag.mcpToken
    mcpError = settingsBag.mcpError
    mcpPending = settingsBag.mcpPending
    copyMcpToken
    hideMcpToken
    toggleMcp
    createMcp
    revokeMcp
    about = settingsBag.about
    anytypeChecked = settingsBag.anytypeChecked
    anytypeCheckedPending = settingsBag.anytypeCheckedPending
    anytypePrepareError = settingsBag.anytypePrepareError
    anytypePreparedPending = settingsBag.anytypePreparedPending
    anytypeError = settingsBag.anytypeError
    anytypeFound = settingsBag.anytypeFound
    anytypeOn = settingsBag.anytypeOn
    anytypeShared = settingsBag.anytypeShared
    anytypeSpace = settingsBag.anytypeSpace
    bots = settingsBag.bots
    canUpdate = settingsBag.canUpdate
    convos = settingsBag.convos
    doAllowNotices
    doAnytypeCheck
    doCopyStorage
    doDefaultMode
    doEditFolder
    doEditName
    doEditPairCode
    doEditSpace
    doGroupAnswer
    doMakeDefault
    doMute
    doMuteGroup
    doPairConfirm
    doPairStart
    doPrepareAnytype
    doPickBackend
    doPickTheme
    doRestartNetwork
    doRestartStorage
    doSaveName
    doSavePassword
    doSaveSpace
    doSaveStorage
    doSetNetwork
    doStartUpdate
    doTestStorage
    editNewPassword
    logout
    nameDraft = settingsBag.nameDraft
    nameEditing = settingsBag.nameEditing
    network = settingsBag.network
    networkError = settingsBag.networkError
    networkRestartError = settingsBag.networkRestartError
    networkRestartedPending = settingsBag.networkRestartedPending
    networkSetPending = settingsBag.networkSetPending
    newPassword = settingsBag.newPassword
    notice = settingsBag.notice
    noticeAskedPending = settingsBag.noticeAskedPending
    open
    pairCode = settingsBag.pairCode
    pairConfirmError = settingsBag.pairConfirmError
    pairConfirmedPending = settingsBag.pairConfirmedPending
    pairError = settingsBag.pairError
    pairStartedPending = settingsBag.pairStartedPending
    pairStep = settingsBag.pairStep
    passwordError = settingsBag.passwordError
    passwordSetPending = settingsBag.passwordSetPending
    pickPeriod
    pickView
    prefs = settingsBag.prefs
    prefsError = settingsBag.prefsError
    providers = settingsBag.providers
    report = settingsBag.report
    reportFailed = settingsBag.reportFailed
    saveNoticePart
    saveNotifications
    session = settingsBag.session
    shownBackend = settingsBag.shownBackend
    spaceEditing = settingsBag.spaceEditing
    spaceName = settingsBag.spaceName
    spaceSaveError = settingsBag.spaceSaveError
    spaceSavedPending = settingsBag.spaceSavedPending
    storage = settingsBag.storage
    storageCopiedPending = settingsBag.storageCopiedPending
    storageCopyError = settingsBag.storageCopyError
    storageHint = settingsBag.storageHint
    storagePath = settingsBag.storagePath
    storageRestartError = settingsBag.storageRestartError
    storageRestartedPending = settingsBag.storageRestartedPending
    storageSaveError = settingsBag.storageSaveError
    storageSavedPending = settingsBag.storageSavedPending
    storageTestError = settingsBag.storageTestError
    storageTestedPending = settingsBag.storageTestedPending
    system = settingsBag.system
    systemPending = settingsBag.systemPending
    updateError = settingsBag.updateError
    updateFrom = settingsBag.updateFrom
    updateNeedsService = settingsBag.updateNeedsService
    updateStartedPending = settingsBag.updateStartedPending
    updateStuck = settingsBag.updateStuck
    updateTo = settingsBag.updateTo
    usagePeriod = settingsBag.usagePeriod
    usageView = settingsBag.usageView
  view
    column class=Screen navigationKey=`${route}` navigationScroll="settings-form" position="absolute" inset=0
      header class=PageHeader
        text t("settings.title") role="heading" aria-level=1 class=PageTitle flex=1
      column width="100%" max-width="40rem" align-self="center" box-sizing="border-box" padding="space.md space.lg space.sm"
        row class=SettingsTrack role="tablist" aria-label=t("settings.domains")
          for d in ["user", "notifications", "models", "access", "updates"] key=d
            button class=SettingsTab appearance="none" role="tab" aria-selected=(settingsBag.settingsDomain == d) press=pickSettingsDomain(d) testId=`settings-domain-${d}` background-color=(settingsBag.settingsDomain == d ? "surface.card" : "transparent") color=(settingsBag.settingsDomain == d ? "-exact-label" : "ink.muted")
              text settingsDomainLabel(d, t("settings.domainUser"), t("settings.domainNotifications"), t("settings.domainModels"), t("settings.domainAccess"), t("settings.about"))
      scroll id="settings-form" flex=1 min-height=0
        column width="100%" max-width="40rem" align-self="center" box-sizing="border-box" margin="0 auto" padding="space.lg space.lg space.xl" gap="space.xl"
          if settingsBag.settingsDomain == "user"
            UserSettings()
          else if settingsBag.settingsDomain == "notifications"
            NoticeSettings()
          else if settingsBag.settingsDomain == "models"
            ModelSettings()
          else if settingsBag.settingsDomain == "access"
            AccessSettings()
          else if settingsBag.settingsDomain == "updates"
            UpdateSettings()
