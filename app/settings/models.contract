use ModelPicker from "./settings.contract"
use ProviderLimits, LimitList from "./limits.contract"
use SectionLabel, ToggleControl from "../ui/controls.contract"
use Prefs from "../ui/root-types.contract"
use Provider from "../ui/shapes.contract"
use GroupCard, SettingsTrack, SettingsTab, SettingsRow, SettingsFoot from "../ui/sidebar.contract"
// ModelSettings: one settings domain, values injected from the root through SettingsScreen.
component ModelSettings
  inject
    doDefaultMode: action
    doGroupAnswer: action
    doActivityLevel: action
    doFinalOnly: action
    doMakeDefault: action
    prefs: Prefs
    prefsError: string
    providers: Provider[]
    limits: LimitList
    limitCooling: bool
    limitError: string
    doRefreshLimits: action
  view
    column
      text t("limits.title") class=SectionLabel
      ProviderLimits(limits=limits, cooling=limitCooling, error=limitError, refresh=doRefreshLimits)
    column
      text t("settings.defaultModel") class=SectionLabel
      column class=GroupCard padding="space.sm"
        if providers.length == 0
          text t("settings.noProvider") color="ink.muted" font="-exact-subheadline" padding="space.sm" min-height=44
        else
          ModelPicker(providers=providers, instanceId=prefs.defaultInstance, model=prefs.defaultModel, effort=prefs.defaultEffort, prefix="default", pick=doMakeDefault, limits=limits.providers, focus="")
    column
      text t("settings.defaultAccess") class=SectionLabel
      column class=GroupCard padding="space.sm"
        row class=SettingsTrack role="radiogroup" aria-label=t("settings.defaultAccess")
          for mode in ["approval-required", "auto", "full-access", "independent"] key=mode
            button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.defaultRuntimeMode == mode) press=doDefaultMode(mode) testId=`default-access-${mode}` background-color=(prefs.defaultRuntimeMode == mode ? "surface.card" : "transparent") color=(prefs.defaultRuntimeMode == mode ? "-exact-label" : "ink.muted")
              text (mode == "approval-required" ? t("model.ask") : mode == "auto" ? t("model.auto") : mode == "full-access" ? t("model.fullAccess") : t("model.independent"))
      text t("settings.defaultAccessNote") class=SettingsFoot
    column
      text t("settings.maxAccess") class=SectionLabel
      column class=GroupCard padding="space.sm"
        row class=SettingsTrack role="radiogroup" aria-label=t("settings.maxAccess")
          for mode in ["approval-required", "auto", "full-access"] key=mode
            button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.maxRuntimeMode == mode) press=doDefaultMode(`cap:${mode}`) testId=`cap-${mode}` background-color=(prefs.maxRuntimeMode == mode ? "surface.card" : "transparent") color=(prefs.maxRuntimeMode == mode ? "-exact-label" : "ink.muted")
              text (mode == "approval-required" ? t("model.ask") : mode == "auto" ? t("model.auto") : t("model.fullAccess"))
      text t("settings.maxAccessNote") class=SettingsFoot
      if prefs.defaultRuntimeMode == "independent"
        text t("model.independentNote") class=SettingsFoot testId="default-access-independent-note"
    column
      text t("settings.groupAnswer") class=SectionLabel
      column class=GroupCard padding="space.sm"
        row class=SettingsTrack role="radiogroup" aria-label=t("settings.groupAnswer")
          for policy in ["last", "everyone", "chief"] key=policy
            button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.groupAnswerPolicy == policy) press=doGroupAnswer(policy) testId=`group-answer-${policy}` background-color=(prefs.groupAnswerPolicy == policy ? "surface.card" : "transparent") color=(prefs.groupAnswerPolicy == policy ? "-exact-label" : "ink.muted")
              text (policy == "last" ? t("group.policyLast") : policy == "everyone" ? t("group.policyEveryone") : t("group.policyChief"))
      text t("settings.groupAnswerNote") class=SettingsFoot
    column
      text t("settings.activity") class=SectionLabel
      column class=GroupCard padding="space.sm"
        row class=SettingsTrack role="radiogroup" aria-label=t("settings.activity")
          for level in ["quiet", "problems", "summary", "detail"] key=level
            button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.activityLevel == level) press=doActivityLevel(level) testId=`activity-${level}` background-color=(prefs.activityLevel == level ? "surface.card" : "transparent") color=(prefs.activityLevel == level ? "-exact-label" : "ink.muted")
              text (level == "quiet" ? t("settings.activityQuiet") : level == "problems" ? t("settings.activityProblems") : level == "summary" ? t("settings.activitySummary") : t("settings.activityDetail"))
      text t("settings.activityNote") class=SettingsFoot
      row class=SettingsRow align-items="center"
        text t("settings.finalOnly") flex=1
        button class=ToggleControl appearance="none" role="switch" aria-checked=prefs.finalOnly press=doFinalOnly(prefs.finalOnly ? "off" : "on") aria-label=t("settings.finalOnly") testId="activity-final-only"
      text t("settings.finalOnlyNote") class=SettingsFoot
      if prefsError != ""
        text prefsError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0"
