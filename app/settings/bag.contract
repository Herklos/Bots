use Reply, Session, Network, Storage, Pairing, AnytypeCheck, About, SystemStatus, UpdateStart, Prefs, NoticeState from "../ui/root-types.contract"
use MachineList from "./machines.contract"
use Bot, Convo, Provider, UsageReport from "../ui/shapes.contract"

use NotificationStatus from "@exact/notifications"

use McpStatus from "./mcp.contract"

shape SettingsBag
  mcpStatus: McpStatus
  mcpToken: string
  mcpError: string
  mcpPending: bool
  about: About
  anytypeChecked: option<AnytypeCheck>
  anytypePrepareError: string
  anytypePreparedPending: bool
  anytypeError: string
  anytypeFound: bool
  anytypeOn: bool
  anytypeShared: bool
  anytypeSpace: string
  bots: Bot[]
  canUpdate: bool
  convos: Convo[]
  nameDraft: string
  nameEditing: bool
  network: Network
  networkError: string
  networkRestartError: string
  networkRestarted: option<Reply>
  networkSet: option<Reply>
  newPassword: string
  notice: NoticeState
  noticeAsked: option<NotificationStatus>
  pairCode: string
  pairConfirmError: string
  pairConfirmed: option<Reply>
  pairError: string
  pairStarted: option<Pairing>
  pairStep: string
  passwordError: string
  passwordSet: option<Reply>
  prefs: Prefs
  prefsError: string
  providers: Provider[]
  report: UsageReport
  reportFailed: bool
  session: Session
  settingsDomain: string
  shownBackend: string
  spaceEditing: bool
  spaceName: string
  spaceSaveError: string
  spaceSaved: option<Reply>
  storage: Storage
  storageCopied: option<Reply>
  storageCopyError: string
  storageHint: string
  storagePath: string
  storageRestartError: string
  storageRestarted: option<Reply>
  storageSaveError: string
  storageSaved: option<Reply>
  storageTestError: string
  storageTested: option<Reply>
  system: SystemStatus
  updateError: string
  updateFrom: string
  updateNeedsService: bool
  updateStarted: option<UpdateStart>
  updateStuck: bool
  updateTo: string
  usagePeriod: string
  usageView: string
  anytypeCheckedPending: bool
  networkRestartedPending: bool
  networkSetPending: bool
  noticeAskedPending: bool
  pairConfirmedPending: bool
  pairStartedPending: bool
  passwordSetPending: bool
  spaceSavedPending: bool
  storageCopiedPending: bool
  storageRestartedPending: bool
  storageSavedPending: bool
  storageTestedPending: bool
  systemPending: bool
  updateStartedPending: bool
  machines: MachineList
  machinesFailed: bool
  machinesPending: bool
