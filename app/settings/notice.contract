use ToggleControl, SectionLabel from "../ui/controls.contract"
use Prefs, NoticeState, noticeOn, mutedBots, mutedGroups, firstMutedBot, firstMutedGroup, noticeStatusLabel from "../ui/root-types.contract"
use Bot, Convo from "../ui/shapes.contract"
use GroupCard, SettingsTrack, SettingsTab, SettingsFoot from "../ui/sidebar.contract"
// NoticeSettings: one settings domain, values injected from the root through SettingsScreen.
component NoticeSettings
  inject
    bots: Bot[]
    convos: Convo[]
    doAllowNotices: action
    doMute: action
    doMuteGroup: action
    notice: NoticeState
    noticeAskedPending: bool
    prefs: Prefs
    saveNoticePart: action
    saveNotifications: action
  view
    column
      text t("settings.notifications") class=SectionLabel
      column class=GroupCard padding="0"
        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box"
          text noticeStatusLabel(notice.available, notice.state, t("settings.noticeAllowed"), t("settings.noticeDenied"), t("settings.noticeUnavailable"), t("settings.noticeAllow")) flex=1 font="-exact-subheadline" testId="notice-status"
          if notice.available and notice.state != "granted"
            button appearance="none" press=doAllowNotices disabled=noticeAskedPending min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="notice-allow"
              text t("settings.noticeAllow")
        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line"
          text t("settings.noticeNew") flex=1 font="-exact-subheadline"
          button class=ToggleControl appearance="none" role="switch" aria-checked=noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state) press=saveNotifications(not noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state), prefs.noticeSound, prefs.noticePreview, prefs.noticeWhen) aria-label=t("settings.noticeNew") testId="notice-enabled"
            row width=44 height=26 border-radius="radius.full" background-color=(noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state) ? "AccentColor" : "surface.line") align-items="center" justify-content=(noticeOn(prefs.noticeEnabledMissing, prefs.noticeEnabled, notice.state) ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line"
          text t("settings.noticeSound") flex=1 font="-exact-subheadline"
          button class=ToggleControl appearance="none" role="switch" aria-checked=prefs.noticeSound press=saveNoticePart(not prefs.noticeSound, prefs.noticePreview, prefs.noticeWhen) aria-label=t("settings.noticeSound") testId="notice-sound"
            row width=44 height=26 border-radius="radius.full" background-color=(prefs.noticeSound ? "AccentColor" : "surface.line") align-items="center" justify-content=(prefs.noticeSound ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
        row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top="1px solid surface.line"
          text t("settings.noticePreview") flex=1 font="-exact-subheadline"
          button class=ToggleControl appearance="none" role="switch" aria-checked=(prefs.noticePreview == "full") press=saveNoticePart(prefs.noticeSound, prefs.noticePreview == "full" ? "hidden" : "full", prefs.noticeWhen) aria-label=t("settings.noticePreview") testId="notice-preview"
            row width=44 height=26 border-radius="radius.full" background-color=(prefs.noticePreview == "full" ? "AccentColor" : "surface.line") align-items="center" justify-content=(prefs.noticePreview == "full" ? "flex-end" : "flex-start")
              column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
      text t("settings.notificationsNote") class=SettingsFoot
    column
      text t("settings.noticeAlso") class=SectionLabel
      column class=GroupCard padding="space.sm"
        row class=SettingsTrack role="radiogroup" aria-label=t("settings.noticeAlso")
          button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.noticeWhen == "any") press=saveNoticePart(prefs.noticeSound, prefs.noticePreview, "any") testId="notice-when-any" background-color=(prefs.noticeWhen == "any" ? "surface.card" : "transparent") color=(prefs.noticeWhen == "any" ? "-exact-label" : "ink.muted")
            text t("settings.noticeWhen")
          button class=SettingsTab appearance="none" role="radio" aria-checked=(prefs.noticeWhen == "background") press=saveNoticePart(prefs.noticeSound, prefs.noticePreview, "background") testId="notice-when-background" background-color=(prefs.noticeWhen == "background" ? "surface.card" : "transparent") color=(prefs.noticeWhen == "background" ? "-exact-label" : "ink.muted")
            text t("settings.noticeAway")
    column
      text t("settings.muted") class=SectionLabel
      column class=GroupCard padding="0"
        for b in mutedBots(bots) key=b.slug
          row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top=(b.slug == firstMutedBot(bots) ? "none" : "1px solid surface.line")
            text b.name flex=1 font="-exact-subheadline"
            button appearance="none" press=doMute(b.slug, true) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId=`unmute-bot-${b.slug}`
              text t("settings.unmute")
        for c in mutedGroups(convos) key=c.key
          row align-items="center" gap="space.md" min-height=44 padding="0 space.md" box-sizing="border-box" border-top=(firstMutedBot(bots) != "" or c.id != firstMutedGroup(convos) ? "1px solid surface.line" : "none")
            text c.name flex=1 font="-exact-subheadline"
            button appearance="none" press=doMuteGroup(c.id, true) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId=`unmute-group-${c.id}`
              text t("settings.unmute")
