use McpSettings from "./mcp.contract"
use Glyph from "../glyph.contract"
use SectionLabel, IconTile, Field from "../ui/controls.contract"
use Session, Network, Storage, AnytypeCheck, networkModeLabel from "../ui/root-types.contract"
use GroupCard, SettingsTrack, SettingsTab, SettingsRow, SettingsFoot, FieldLabel, FieldBox, ActionMain, ActionQuiet from "../ui/sidebar.contract"
// AccessSettings: one settings domain, values injected from the root through SettingsScreen.
component AccessSettings
  inject
    anytypeChecked: option<AnytypeCheck>
    anytypeCheckedPending: bool
    anytypePrepareError: string
    anytypePreparedPending: bool
    anytypeError: string
    anytypeFound: bool
    anytypeOn: bool
    anytypeShared: bool
    anytypeSpace: string
    doAnytypeCheck: action
    doCopyStorage: action
    doEditFolder: action
    doEditPairCode: action
    doEditSpace: action
    doPairConfirm: action
    doPairStart: action
    doPrepareAnytype: action
    doPickBackend: action
    doRestartNetwork: action
    doRestartStorage: action
    doSavePassword: action
    doSaveSpace: action
    doSaveStorage: action
    doSetNetwork: action
    doTestStorage: action
    editNewPassword: action
    network: Network
    networkError: string
    networkRestartError: string
    networkRestartedPending: bool
    networkSetPending: bool
    newPassword: string
    open: action
    pairCode: string
    pairConfirmError: string
    pairConfirmedPending: bool
    pairError: string
    pairStartedPending: bool
    pairStep: string
    passwordError: string
    passwordSetPending: bool
    session: Session
    shownBackend: string
    spaceEditing: bool
    spaceName: string
    spaceSaveError: string
    spaceSavedPending: bool
    storage: Storage
    storageCopiedPending: bool
    storageCopyError: string
    storageHint: string
    storagePath: string
    storageRestartError: string
    storageRestartedPending: bool
    storageSaveError: string
    storageSavedPending: bool
    storageTestError: string
    storageTestedPending: bool
  view
    column
      text t("settings.private") class=SectionLabel
      column class=GroupCard padding="0"
        button class=SettingsRow appearance="none" press=open("/vault") testId="open-vault"
          column class=IconTile color="AccentColor"
            Glyph(name="lock", size=18)
          column flex=1 gap="2px" min-width=0
            text t("vault.title") font-weight=600
            text t("settings.vaultNote") color="ink.muted" font="-exact-footnote"
          column color="ink.muted"
            Glyph(name="chevron", size=18)
    column
      text t("settings.remote") class=SectionLabel
      column class=GroupCard padding="0"
        row class=SettingsRow min-height=44
          input appearance="none" class=Field type="password" value=newPassword input=editNewPassword submit=doSavePassword placeholder=(session.passwordRequired ? t("settings.newPassword") : t("settings.setPassword")) aria-label=t("common.password") autocomplete="new-password" flex=1 min-width=0 testId="new-password"
          button appearance="none" press=doSavePassword disabled=(newPassword == "" or passwordSetPending) min-height=44 padding="0 space.sm" border="none" background-color="transparent" color=(newPassword == "" ? "ink.muted" : "AccentColor") font="-exact-subheadline" font-weight=500 testId="save-password"
            text (session.passwordRequired ? t("settings.change") : t("settings.set"))
      text (session.passwordRequired ? t("settings.passwordOn") : t("settings.passwordOff")) class=SettingsFoot
      if passwordError != "" and not passwordSetPending
        text passwordError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="password-error"
    column
      text t("settings.network") class=SectionLabel
      column class=GroupCard padding="space.sm"
        row class=SettingsTrack role="radiogroup" aria-label=t("settings.network")
          for mode in ["local", "lan", "tailscale"] key=mode
            button class=SettingsTab appearance="none" role="radio" aria-checked=(network.mode == mode) press=doSetNetwork(mode) disabled=network.locked opacity=(network.locked and network.mode != mode ? 0.4 : 1) testId=`network-${mode}` background-color=(network.mode == mode ? "surface.card" : "transparent") color=(network.mode == mode ? "-exact-label" : "ink.muted")
              text networkModeLabel(mode, t("settings.networkLocal"), t("settings.networkLan"), t("settings.networkTailscale"))
      text (network.mode == "lan" ? t("settings.networkLanNote") : network.mode == "tailscale" ? t("settings.networkTailscaleNote") : t("settings.networkLocalNote")) class=SettingsFoot
      if network.locked
        text t("settings.networkManaged") class=SettingsFoot testId="network-managed"
      if network.listening != ""
        text t("settings.networkListening", address=network.listening) class=SettingsFoot testId="network-listening"
      if network.urls != ""
        text network.urls class=SettingsFoot testId="network-urls"
      if network.http
        text t("settings.networkHttp") class=SettingsFoot
      if network.error != ""
        text network.error color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="network-error"
      if networkError != "" and not networkSetPending
        text networkError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="network-save-error"
      if networkRestartedPending
        text t("settings.networkRestarting") class=SettingsFoot
      else if network.restartRequired
        row class=SettingsRow padding="space.xs space.md 0" min-height=44
          text t("settings.networkRestart") color="ink.muted" font="-exact-footnote" flex=1 testId="network-restart-note"
          if network.canRestart
            button appearance="none" press=doRestartNetwork min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="network-restart"
              text t("settings.networkRestartButton")
      if networkRestartError != "" and not networkRestartedPending
        text networkRestartError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0"
    column
      text t("settings.storage") class=SectionLabel
      column class=GroupCard padding="space.md" gap="space.sm"
        text t("settings.storage.where") font="-exact-subheadline" font-weight=600
        row class=SettingsTrack role="radiogroup" aria-label=t("settings.storage.where")
          button class=SettingsTab appearance="none" role="radio" aria-checked=(shownBackend != "anytype") press=doPickBackend("filesystem") disabled=(storage.backendLock != "") testId="storage-filesystem" background-color=(shownBackend != "anytype" ? "surface.card" : "transparent") color=(shownBackend != "anytype" ? "-exact-label" : "ink.muted")
            text t("settings.storage.filesystem")
          button class=SettingsTab appearance="none" role="radio" aria-checked=(shownBackend == "anytype") press=doPickBackend("anytype") disabled=(storage.backendLock != "" or not anytypeOn) testId="storage-anytype" background-color=(shownBackend == "anytype" ? "surface.card" : "transparent") color=(shownBackend == "anytype" ? "-exact-label" : "ink.muted")
            text t("settings.storage.anytype")
        text (shownBackend == "anytype" ? t("settings.storage.activeAnytype") : t("settings.storage.activeFile")) color="-exact-label" font="-exact-footnote" testId="storage-active"
        if not anytypeOn
          text t("settings.storage.anytypeConnect") color="ink.muted" font="-exact-footnote" testId="storage-anytype-note"
        if storage.backendLock != ""
          text t("settings.storage.locked", variable=storage.backendLock) color="ink.muted" font="-exact-footnote" testId="storage-locked-backend"
      if shownBackend == "anytype" or not anytypeOn
        text t("settings.anytype.title") class=SectionLabel
        column class=GroupCard padding="space.md" gap="space.md" testId="anytype-connect"
          text t("settings.anytype.intro") color="ink.muted" font="-exact-footnote"
          row gap="space.sm" align-items="center"
            button appearance="none" class=ActionMain press=doPairStart disabled=pairStartedPending min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-connect-start"
              text (pairStep == "" ? t("settings.anytype.connect") : t("settings.anytype.again"))
            button appearance="none" class=ActionQuiet press=doAnytypeCheck disabled=anytypeCheckedPending min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-check"
              text t("settings.anytype.check")
          if pairStep == "code"
            column gap="space.xs"
              text t("settings.anytype.approve") color="ink.muted" font="-exact-footnote" testId="anytype-approve"
              row gap="space.sm" align-items="center"
                input appearance="none" class=FieldBox value=pairCode input=doEditPairCode maxlength=4 inputmode="numeric" placeholder="0000" aria-label=t("settings.anytype.code") flex=1 min-width=0 testId="anytype-code"
                button appearance="none" class=ActionMain press=doPairConfirm disabled=(pairCode.length != 4 or pairConfirmedPending) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-confirm"
                  text t("settings.anytype.confirm")
          if pairError != "" and not pairStartedPending
            text pairError color="-exact-system-red" font="-exact-footnote" testId="anytype-pair-error"
          if pairConfirmError != "" and not pairConfirmedPending
            text pairConfirmError color="-exact-system-red" font="-exact-footnote" testId="anytype-confirm-error"
          if anytypeError != "" and not anytypeCheckedPending
            text anytypeError color="-exact-system-red" font="-exact-footnote" testId="anytype-check-error"
          if pairStep == "checked" and anytypeError == "" and not anytypeCheckedPending and pairConfirmError == ""
            text t("settings.anytype.reachable") color="-exact-label" font="-exact-footnote" font-weight=600 testId="anytype-reachable"
          column gap="space.xs"
            text t("settings.anytype.spaceLabel") class=FieldLabel
            row gap="space.sm" align-items="center"
              input appearance="none" class=FieldBox value=spaceName placeholder=t("settings.anytype.spaceDefault") input=doEditSpace aria-label=t("settings.anytype.spaceName") flex=1 min-width=0 disabled=(storage.spaceLock != "") testId="anytype-space-name"
              button appearance="none" class=ActionMain press=doSaveSpace disabled=(storage.spaceLock != "" or not spaceEditing or spaceSavedPending) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-space-save"
                text t("settings.storage.save")
            text t("settings.anytype.spaceHelp") color="ink.muted" font="-exact-footnote"
            if storage.spaceLock != ""
              text t("settings.storage.locked", variable=storage.spaceLock) color="ink.muted" font="-exact-footnote" testId="anytype-space-locked"
            if spaceSaveError != "" and not spaceSavedPending
              text spaceSaveError color="-exact-system-red" font="-exact-footnote" testId="anytype-space-error"
            if pairStep == "checked" and anytypeError == "" and not anytypeCheckedPending and pairConfirmError == ""
              if anytypeFound
                text t("settings.anytype.space", name=anytypeSpace) color="-exact-label" font="-exact-footnote" testId="anytype-space"
                text (anytypeShared ? t("settings.anytype.shared") : t("settings.anytype.private")) color="ink.muted" font="-exact-footnote" testId="anytype-shared"
                if match anytypeChecked { case some(r) => r.schemaReady, case none => false }
                  text t("settings.anytype.ready") color="-exact-label" font="-exact-footnote" font-weight=600 testId="anytype-ready"
                else
                  button appearance="none" class=ActionMain press=doPrepareAnytype disabled=anytypePreparedPending min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="anytype-prepare"
                    text t("settings.anytype.prepare")
                if anytypePrepareError != "" and not anytypePreparedPending
                  text anytypePrepareError color="-exact-system-red" font="-exact-footnote" testId="anytype-prepare-error"
              else
                text t("settings.anytype.missing", name=anytypeSpace) color="-exact-system-red" font="-exact-footnote" testId="anytype-missing"
      text t("settings.storage.folder") class=SectionLabel
      column class=GroupCard padding="space.md" gap="space.sm"
        text t("settings.storage.folderLabel") class=FieldLabel
        row gap="space.sm" align-items="center"
          input appearance="none" class=FieldBox value=storagePath placeholder=t("settings.storage.defaultFolder") input=doEditFolder aria-label=t("settings.storage.folder") flex=1 min-width=0 disabled=(storage.rootLock != "") testId="storage-folder"
          button appearance="none" class=ActionMain press=doSaveStorage disabled=(storagePath == "" or (storage.rootLock != "" and storage.backendLock != "") or storageSavedPending) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="storage-save"
            text t("settings.storage.save")
        text t("settings.storage.folderNote") color="ink.muted" font="-exact-footnote"
        if storage.rootLock != ""
          text t("settings.storage.locked", variable=storage.rootLock) color="ink.muted" font="-exact-footnote" testId="storage-locked-folder"
        row gap="space.sm" align-items="center"
          button appearance="none" class=ActionQuiet press=doTestStorage disabled=(storagePath == "" or storageTestedPending) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="storage-test"
            text t("settings.storage.test")
          button appearance="none" class=ActionQuiet press=doCopyStorage disabled=(storagePath == "" or storageCopiedPending) min-height=36 padding="0 space.md" border-radius="radius.full" font="-exact-subheadline" font-weight=500 testId="storage-copy"
            text t("settings.storage.copy")
        text t("settings.storage.copyNote") color="ink.muted" font="-exact-footnote"
        if storageHint == "test" and storageTestError == "" and not storageTestedPending
          text t("settings.storage.testOk") color="-exact-label" font="-exact-footnote" font-weight=600 testId="storage-test-ok"
        if storageHint == "copy" and storageCopyError == "" and not storageCopiedPending
          text t("settings.storage.copyOk") color="-exact-label" font="-exact-footnote" font-weight=600 testId="storage-copy-ok"
        if storage.error != ""
          text storage.error color="-exact-system-red" font="-exact-footnote" testId="storage-error"
        if storageSaveError != "" and not storageSavedPending
          text storageSaveError color="-exact-system-red" font="-exact-footnote" testId="storage-save-error"
        if storageTestError != "" and not storageTestedPending
          text storageTestError color="-exact-system-red" font="-exact-footnote" testId="storage-test-error"
        if storageCopyError != "" and not storageCopiedPending
          text storageCopyError color="-exact-system-red" font="-exact-footnote" testId="storage-copy-error"
      if storageRestartedPending
        text t("settings.storage.restarting") class=SettingsFoot
      else if storage.restartRequired
        row class=SettingsRow padding="space.xs space.md 0" min-height=44
          text t("settings.storage.restart") color="ink.muted" font="-exact-footnote" flex=1 testId="storage-restart-note"
          if storage.canRestart
            button appearance="none" press=doRestartStorage min-height=44 padding="0 space.sm" border="none" background-color="transparent" color="AccentColor" font="-exact-subheadline" font-weight=500 testId="storage-restart"
              text t("settings.storage.restartNow")
      if storageRestartError != "" and not storageRestartedPending
        text storageRestartError color="-exact-system-red" font="-exact-footnote" padding="space.xs space.md 0" testId="storage-restart-error"
    McpSettings()
