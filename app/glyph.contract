// Lucide outline geometry: see assets/lucide-LICENSE.txt (ISC / Feather MIT).
// A single rounded, 1.7-point line family on every host. Decorative: the
// containing control owns the accessible name and the 44-point target.
component GlyphGallery
  view
    row gap=16
      for name in ["add", "attach", "send", "stop", "lock", "chevron", "chevron-down", "trash", "close", "check", "settings", "info", "star", "eye-off", "search", "person", "globe", "file", "download", "clock", "arrow-down", "monitor", "pause", "image", "more", "pin", "bell", "copy", "smile", "reply", "mic", "chat"] key=name
        Glyph(name=name, size=20)

component Glyph
  props
    name: string
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width=1.7 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      if name == "add"
        path d="M12 5v14M5 12h14"
      else if name == "attach"
        path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
      else if name == "send"
        path d="M12 19V5M6 11l6-6 6 6"
      else if name == "stop"
        rect x=6 y=6 width=12 height=12 rx=2 fill="currentcolor" stroke="none"
      else if name == "lock"
        rect x=5 y=10 width=14 height=11 rx=2
        path d="M8 10V7a4 4 0 0 1 8 0v3"
      else if name == "chevron"
        path d="M9 5l7 7-7 7"
      else if name == "chevron-down"
        path d="M6 9l6 6 6-6"
      else if name == "trash"
        path d="M4 7h16M9 7V4h6v3M6 7l1 14h10l1-14M10 11v6M14 11v6"
      else if name == "info"
        circle cx=12 cy=12 r=9
        path d="M12 11v6M12 7h.01"
      else if name == "settings"
        path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
        circle cx=12 cy=12 r=3
      else if name == "star"
        path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"
      else if name == "eye-off"
        path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.2A10 10 0 0 1 12 5c6 0 10 7 10 7a16 16 0 0 1-3.1 3.7M6.1 6.1A19 19 0 0 0 2 12s4 7 10 7a10 10 0 0 0 5.4-1.6"
      else if name == "search"
        circle cx=11 cy=11 r=7
        path d="M20.5 20.5 16 16"
      else if name == "person"
        circle cx=12 cy=7.5 r=4
        path d="M19 21v-1a5 5 0 0 0-5-5H10a5 5 0 0 0-5 5v1"
      else if name == "globe"
        circle cx=12 cy=12 r=9
        path d="M3 12h18"
        path d="M12 3c2.5 2.3 4 5.5 4 9s-1.5 6.7-4 9c-2.5-2.3-4-5.5-4-9s1.5-6.7 4-9z"
      else if name == "close"
        path d="M6 6l12 12M6 18L18 6"
      else if name == "file"
        path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"
        path d="M14 3v5h5"
      else if name == "download"
        path d="M12 4v11M7 11l5 5 5-5M5 20h14"
      else if name == "clock"
        circle cx=12 cy=12 r=9
        path d="M12 7v5l3 2"
      else if name == "arrow-down"
        path d="M12 5v14M6 13l6 6 6-6"
      else if name == "monitor"
        rect x=3 y=4 width=18 height=12 rx=2
        path d="M8 20h8M12 16v4"
      else if name == "pause"
        path d="M9 6v12M15 6v12"
      else if name == "image"
        rect x=3 y=3 width=18 height=18 rx=2
        circle cx=9 cy=9 r=1.5
        path d="M21 15l-5-5L5 21"
      else if name == "more"
        path d="M5 12h.01M12 12h.01M19 12h.01"
      else if name == "pin"
        path d="M12 17v5"
        path d="M9 10.8a2 2 0 0 1-1.1 1.8l-1.8.9A2 2 0 0 0 5 15.2V16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-.8a2 2 0 0 0-1.1-1.8l-1.8-.9A2 2 0 0 1 15 10.8V7a1 1 0 0 1 1-1 2 2 0 0 0 0-4H8a2 2 0 0 0 0 4 1 1 0 0 1 1 1z"
      else if name == "bell"
        path d="M10.268 21a2 2 0 0 0 3.464 0"
        path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"
      else if name == "copy"
        rect x=9 y=9 width=13 height=13 rx=2
        path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
      else if name == "chat"
        path d="M21 12a8 8 0 0 1-11.5 7.2L4 20l1-4.5A8 8 0 1 1 21 12z"
      else if name == "reply"
        path d="M9 17l-5-5 5-5M4 12h10a6 6 0 0 1 6 6"
      else if name == "mic"
        rect x=9 y=3 width=6 height=11 rx=3
        path d="M5 11a7 7 0 0 0 14 0M12 18v3"
      else if name == "smile"
        circle cx=12 cy=12 r=9
        path d="M8 14s1.5 2 4 2 4-2 4-2M9 9h.01M15 9h.01"
      else
        path d="M5 12l4 4L19 6"
