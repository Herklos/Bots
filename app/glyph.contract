// Lucide outline geometry: see assets/lucide-LICENSE.txt (ISC / Feather MIT).
// A single rounded, 1.7-point line family on every host. Decorative: the
// containing control owns the accessible name and the 44-point target.
component GlyphGallery
  view
    row gap=16
      for name in ["add", "attach", "send", "stop", "lock", "chevron", "chevron-down", "trash", "close", "check", "settings", "info", "star", "eye-off", "search", "person", "globe"] key=name
        Glyph(name=name, size=20)

component Glyph
  props
    name: string
    size: number
  view
    svg width=size height=size viewBox="0 0 24 24" fill="none" stroke="currentcolor" stroke-width=1.7 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"
      if name == "add"
        path d="M12 5v14M5 12h14"
      else if name == "attach"
        path d="M21.44 11.05l-9.19 9.19a6 6 0 0 1-8.49-8.49l9.19-9.19a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"
      else if name == "send"
        path d="M12 19V5M6 11l6-6 6 6"
      else if name == "stop"
        rect x=6 y=6 width=12 height=12 rx=2 fill="currentcolor" stroke="none"
      else if name == "lock"
        rect x=5 y=10 width=14 height=11 rx=2
        path d="M8 10V7a4 4 0 0 1 8 0v3"
      else if name == "chevron"
        path d="M9 5l7 7-7 7"
      else if name == "chevron-down"
        path d="M6 9l6 6 6-6"
      else if name == "trash"
        path d="M4 7h16M9 7V4h6v3M6 7l1 14h10l1-14M10 11v6M14 11v6"
      else if name == "info"
        circle cx=12 cy=12 r=9
        path d="M12 11v6M12 7h.01"
      else if name == "settings"
        path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
        circle cx=12 cy=12 r=3
      else if name == "star"
        path d="M12 3l2.8 5.7 6.2.9-4.5 4.4 1.1 6.2-5.6-3-5.6 3 1.1-6.2L3 9.6l6.2-.9z"
      else if name == "eye-off"
        path d="M3 3l18 18M10.6 10.6a2 2 0 0 0 2.8 2.8M9.9 5.2A10 10 0 0 1 12 5c6 0 10 7 10 7a16 16 0 0 1-3.1 3.7M6.1 6.1A19 19 0 0 0 2 12s4 7 10 7a10 10 0 0 0 5.4-1.6"
      else if name == "search"
        circle cx=11 cy=11 r=7
        path d="M20.5 20.5 16 16"
      else if name == "person"
        circle cx=12 cy=7.5 r=4
        path d="M19 21v-1a5 5 0 0 0-5-5H10a5 5 0 0 0-5 5v1"
      else if name == "globe"
        circle cx=12 cy=12 r=9
        path d="M3 12h18"
        path d="M12 3c2.5 2.3 4 5.5 4 9s-1.5 6.7-4 9c-2.5-2.3-4-5.5-4-9s1.5-6.7 4-9z"
      else if name == "close"
        path d="M6 6l12 12M6 18L18 6"
      else
        path d="M5 12l4 4L19 6"
