use faceColor from "../ui/fns.contract"
use PanelRow from "../ui/panel.contract"
use Bot, ModelList, RoutineList, Lineage, UsageReport, Shelf, Computer from "../ui/shapes.contract"
use PageTitle, QuietButton, TextControl, IconControl, ConversationLink, SectionLabel, Chip, IconTile from "../ui/controls.contract"
use ModelPage, UsageView from "../settings/settings.contract"
use ProviderLimit from "../settings/limits.contract"
use Avatar from "../face.contract"
use Glyph from "../glyph.contract"
use EditBotPage from "./edit.contract"
use HelpersPage from "./helpers.contract"
use MemoryTab from "./memory.contract"
use SubagentPage from "./subagent-page.contract"
use BotShelf, ScreenCard from "../computer/computer.contract"
use ComputerPlace from "../computer/place.contract"
use CodeTab from "./code.contract"
use RoutineSection from "./routines.contract"
use DeliveriesPage from "./deliveries.contract"
use CodeView from "./code.contract"
use PanelTabs from "./tabs.contract"
component BotPanel
  props
    working: bool
    shown: bool
    tab: string
    page: string
    pickTab: action
    openPage: action
    closePanel: action
    openChild: action
    wide: bool
    bot: Bot
    error: string
    rename: action
    recolour: action
    reshape: action
    pin: action
    hide: action
    mute: action
    makeMain: action
    drop: action
    savePrompt: action
    models: ModelList
    modelsDown: bool
    pickModel: action
    modelError: string
    limits: ProviderLimit[]
    limitFocus: string
    routines: RoutineList
    routinesDown: bool
    lineage: Lineage
    lineageDown: bool
    report: UsageReport
    reportDown: bool
    period: string
    usageView: string
    pickPeriod: action
    pickView: action
    retryDetails: action
    shelf: Shelf
    shelfDown: bool
    computer: Computer
    computerDown: bool
    showComputerLarge: action
    heldTab: string
    controlError: string
    driveError: string
    live: bool
    drive: action
    take: action
    release: action
    picked: string
    pick: action
    openBrowser: action
    opening: bool
    openError: string
    closeBrowser: action
    closing: bool
    closeError: string
    bots: Bot[]
    subSlug: string
    subName: string
    subShape: string
    subColor: string
    subPrompt: string
    subInherit: bool
    openNewSub: action
    editSub: action
    editSubName: action
    editSubPrompt: action
    pickSubColor: action
    pickSubShape: action
    toggleSubInherit: action
    createSub: action
    saveSub: action
    dropChild: action
    creating: bool
    saving: bool
    subError: string
    childModels: ModelList
    childModelsDown: bool
    places: ComputerPlace
    placesFailed: bool
    placeError: string
    doPickComputer: action
    codeOn: bool
    code: CodeView
  inject
    leaveDeliveries: action
  derive children = bots.filter(c => c.parentSlug == bot.slug)
  derive names = codeOn ? ["details", "library", "computer", "code"] : ["details", "library", "computer"]
  derive active = names.includes(tab) ? tab : "details"
  action goRoot
    if page == "deliveries"
      leaveDeliveries()
    else
      openPage("root")
  action goModel
    openPage("model")
  action goUsage
    openPage("usage")
  action goEdit
    openPage("edit")
  action goHelpers
    openPage("helpers")
  view
    // On a narrow screen the panel is a full-height sheet with one identity
    // row (close, face, edit). The large Face stays for the wide side panel.
    column id="bot-panel" display=(shown ? "flex" : "none") position="absolute" top=0 right=0 bottom=0 width=(wide ? "20rem" : "100%") z-index=(wide ? 0 : 5) box-sizing="border-box" background-color="surface.canvas" border-left="1px solid surface.line" testId="bot-panel"
      if page != "root"
        row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
          button class=IconControl appearance="none" press=goRoot aria-label=t("common.back") title=t("common.back") testId="panel-back"
            column rotate="180deg"
              Glyph(name="chevron", size=20)
          text (page == "model" ? t("panel.model") : page == "usage" ? t("panel.usage") : page == "deliveries" ? t("hook.deliveries") : page == "subagent" ? (subSlug != "" ? t("subagent.page") : t("subagent.new")) : page == "helpers" ? t("helpers.title") : t("panel.edit")) role="heading" aria-level=2 class=PageTitle flex=1 testId="panel-page-title"
      else if wide
        row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
          column flex=1
          button class=IconControl appearance="none" press=goEdit aria-label=t("panel.edit") title=t("panel.edit") testId="panel-edit"
            Glyph(name="settings", size=20)
          button class=IconControl appearance="none" press=closePanel aria-label=t("panel.close") title=t("panel.close") testId="panel-close"
            Glyph(name="close", size=20)
      else
        row align-items="center" gap="space.sm" padding="space.sm space.sm space.sm space.md" min-height=56 box-sizing="border-box" border-bottom="1px solid surface.line" testId="panel-compact-header"
          button class=IconControl appearance="none" press=closePanel aria-label=t("panel.close") title=t("panel.close") testId="panel-close"
            Glyph(name="close", size=20)
          row align-items="center" gap="space.sm" flex=1 min-width=0
            Avatar(shape=bot.shape, color=faceColor(bot.color), state=(bot.hidden ? "asleep" : working ? "working" : "idle"), size=36, still=(not working), presence="")
            column flex=1 min-width=0 gap="1px"
              text bot.name role="heading" aria-level=2 font="-exact-headline" font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="details-name"
              text (bot.hidden ? t("panel.hiddenInbox") : working ? t("status.working") : bot.ready ? t("status.ready") : t("status.settingUp")) color="ink.muted" font="-exact-footnote" overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="details-status"
          button class=IconControl appearance="none" press=goEdit aria-label=t("panel.edit") title=t("panel.edit") testId="panel-edit"
            Glyph(name="settings", size=20)
      if page == "model"
        scroll flex=1 min-height=0
          ModelPage(models=models, down=modelsDown, bot=bot, pick=pickModel, error=modelError, limits=limits, limitFocus=limitFocus)
      else if page == "usage"
        scroll flex=1 min-height=0
          UsageView(report=report, down=reportDown, period=period, view=usageView, pickPeriod=pickPeriod, pickView=pickView, showBots=false)
      else if page == "edit"
        scroll flex=1 min-height=0
          EditBotPage(bot=bot, error=error, rename=rename, recolour=recolour, reshape=reshape, pin=pin, hide=hide, mute=mute, makeMain=makeMain, drop=drop, savePrompt=savePrompt)
      else if page == "subagent"
        scroll flex=1 min-height=0
          SubagentPage(children=children, subSlug=subSlug, subName=subName, subShape=subShape, subColor=subColor, subPrompt=subPrompt, subInherit=subInherit, editSubName=editSubName, editSubPrompt=editSubPrompt, pickSubColor=pickSubColor, pickSubShape=pickSubShape, toggleSubInherit=toggleSubInherit, createSub=createSub, saveSub=saveSub, dropChild=dropChild, creating=creating, saving=saving, subError=subError, childModels=childModels, childModelsDown=childModelsDown, pickModel=pickModel, modelError=modelError, limits=limits, limitFocus=limitFocus)
      else if page == "helpers"
        scroll flex=1 min-height=0
          HelpersPage(subagent=bot.subagent, providers=models.providers, modelsDown=modelsDown)
      else if page == "deliveries"
        scroll flex=1 min-height=0
          DeliveriesPage()
      else
        if wide
          column align-items="center" gap="space.xs" padding="0 space.lg space.md"
            Avatar(shape=bot.shape, color=faceColor(bot.color), state=(bot.hidden ? "asleep" : working ? "working" : "idle"), size=72, still=(not working), presence="")
            text bot.name font="-exact-title3" font-weight=700 letter-spacing="-0.3px" testId="details-name" text-align="center" overflow-wrap="anywhere"
            text (bot.hidden ? t("panel.hiddenInbox") : working ? t("status.working") : bot.ready ? t("status.ready") : t("status.settingUp")) color="ink.muted" font="-exact-footnote" testId="details-status"
        PanelTabs(tab=active, names=names, pickTab=pickTab)
        column id="bot-tab-details" role="tabpanel" aria-label=t("panel.details") display=(active == "details" ? "flex" : "none") flex=1 min-height=0
          scroll id=`panel-${bot.slug}` flex=1 min-height=0
            column width="100%" box-sizing="border-box" padding="0 space.lg space.xl" gap="space.sm"
              if modelsDown
                text t("error.model") color="-exact-system-red" testId="model-error"
              else
                button class=PanelRow appearance="none" press=goModel testId="model-row" aria-label=t("panel.modelNamed", name=models.currentName)
                  column class=IconTile color="AccentColor"
                    text (models.providerName != "" ? models.providerName.slice(0, 1) : "?") font-weight=700
                  column flex=1 gap="2px" min-width=0
                    text (models.currentName != "" ? models.currentName : t("panel.choosingModel")) font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId="model-name"
                    text (models.effortLabel != "" ? `${models.providerName}, ${models.effortLabel}` : models.providerName) color="ink.muted" font="-exact-footnote"
                  column color="ink.muted"
                    Glyph(name="chevron", size=18)
              button class=PanelRow appearance="none" press=goUsage testId="usage-card" aria-label=t("panel.usage")
                column flex=1 gap="space.xs" min-width=0
                  row gap="space.sm" align-items="baseline"
                    text t("panel.usagePeriod", period=(report.periodLabel != "" ? report.periodLabel : t("usage.days7"))) color="ink.muted" font="-exact-footnote" flex=1
                  if reportDown
                    text t("error.usageShort") color="-exact-system-red" font="-exact-footnote"
                  else
                    text t("panel.tokenCount", n=report.tokens) font="-exact-headline" font-weight=600 testId="usage-tokens"
                    row gap="3px" align-items="flex-end" height=30
                      for d in report.days key=d.day
                        column flex=1 height=d.spx border-radius="2px" background-color="brand.default"
                column color="ink.muted"
                  Glyph(name="chevron", size=18)
              if not bot.subagent
                button class=PanelRow appearance="none" press=goHelpers testId="helpers-row" aria-label=t("helpers.open")
                  column flex=1 gap="2px" min-width=0
                    text t("helpers.title") font-weight=600 testId="helpers-row-title"
                    text t("helpers.rowNote") color="ink.muted" font="-exact-footnote"
                  column color="ink.muted"
                    Glyph(name="chevron", size=18)
              RoutineSection(routines=routines, down=routinesDown, name=bot.name)
              if children.length > 0
                text t("subagent.heading") class=SectionLabel testId="subagent-heading"
                column gap="2px"
                  for c in children key=c.slug
                    row align-items="center" gap="space.sm" padding="space.xs space.md" testId=`subagent-row-${c.slug}`
                      link class=ConversationLink href=path("chat", c.slug) testId=`subagent-${c.slug}` flex=1 min-width=0
                        row gap="space.md" align-items="center"
                          Avatar(shape=c.shape, color=faceColor(c.color), state=(c.ready ? (c.working ? "working" : "idle") : "asleep"), size=32, still=(not c.working), presence="")
                          text c.name font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" testId=`subagent-name-${c.slug}`
                      button class=QuietButton appearance="none" press=editSub(c.slug, c.name, c.shape, c.color, c.prompt, c.inheritParentPrompt) min-height=44 testId=`edit-subagent-${c.slug}`
                        text t("subagent.edit")
              if lineageDown
                text t("panel.workingOn") class=SectionLabel testId="lineage-heading"
                text t("error.lineage") color="-exact-system-red" padding="0 space.md" testId="lineage-error"
              else if lineage.rows.length > 0
                text t("panel.workingOn") class=SectionLabel testId="lineage-heading"
                column gap="2px"
                  for line in lineage.rows key=line.id
                    row align-items="center" gap="space.md" padding="space.sm space.md" testId=`line-${line.id}`
                      column color="ink.faint"
                        Glyph(name="chevron", size=14)
                      column flex=1 gap="2px" min-width=0
                        text line.title font-weight=500 overflow-wrap="anywhere"
                        text (line.remote ? t("panel.remote") : line.threadId != "" ? t("panel.local") : t("panel.thisTurn")) color="ink.muted" font="-exact-footnote" testId=`where-${line.id}`
                      if not line.remote and line.threadId != ""
                        button class=TextControl appearance="none" press=openChild(line.threadId) min-height=28 padding="0 space.sm" font="-exact-footnote" color="AccentColor" testId=`open-${line.id}`
                          text t("common.open")
                      row class=Chip
                        text line.status
              MemoryTab(name=bot.name)
        column id="bot-tab-library" role="tabpanel" aria-label=t("panel.library") display=(active == "library" ? "flex" : "none") flex=1 min-height=0
          scroll id="panel-library-scroll" flex=1 min-height=0
            BotShelf(shelf=shelf, down=shelfDown, name=bot.name)
        column id="bot-tab-computer" role="tabpanel" aria-label=t("panel.computer") display=(active == "computer" ? "flex" : "none") flex=1 min-height=0
          scroll id="panel-computer-scroll" flex=1 min-height=0
            ScreenCard(name=bot.name, computer=computer, down=computerDown, showLarge=showComputerLarge, heldTab=heldTab, controlError=controlError, driveError=driveError, live=live, drive=drive, take=take, release=release, picked=picked, pick=pick, openBrowser=openBrowser, opening=opening, openError=openError, closeBrowser=closeBrowser, closing=closing, closeError=closeError)
            ComputerPlace(name=bot.name, place=places, down=placesFailed, error=placeError, pick=doPickComputer)
        if codeOn
          column id="bot-tab-code" role="tabpanel" aria-label=t("panel.code") display=(active == "code" ? "flex" : "none") flex=1 min-height=0
            scroll flex=1 min-height=0
              CodeTab(view=code)
