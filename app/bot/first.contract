use Face from "../face.contract"
use Avatar from "../face.contract"
use shapeNames from "../face.contract"
use Glyph from "../glyph.contract"
use ModelPage, UsageView from "../settings/settings.contract"
use BotShelf, ScreenCard from "../computer/computer.contract"
use pickerColours, faceColor from "../ui/fns.contract"
use PanelRow, dot from "../ui/panel.contract"
use Bot, ModelList, RoutineList, Lineage, UsageReport, Shelf, Computer from "../ui/shapes.contract"
use PageTitle, HeroTitle, QuietButton, TextControl, IconControl, ToggleControl, SwatchControl, ConversationLink, SectionLabel, Chip, IconTile, Segment, Field, PrimaryButton from "../ui/controls.contract"

component WorkingDots
  view
    row gap="6px" align-items="center"
      for n in [0, 1, 2] key=n
        column width=7 height=7 border-radius="radius.full" background-color="ink.muted" animation=`dot 1.2s ease-in-out infinite ${n * 0.16}s`

// A group's face is its members, at most three, overlapped. It has no colour or shape of its own.
// The empty roster. Creating still uses the new-Bot walk. The phone inbox and the wide placeholder share this.
component FirstBot
  props
    color: string
    shape: string
    start: action
  view
    scroll flex=1 min-height=0 width="100%" background-color="surface.canvas" testId="first-bot"
      column width="100%" max-width="24rem" box-sizing="border-box" margin="0 auto" align-items="center" gap="space.md" padding="space.xl"
        Avatar(shape=shape, color=faceColor(color), state="idle", size=96, still=false, presence="")
        text t("inbox.emptyTitle") role="heading" aria-level=2 class=HeroTitle text-align="center"
        text t("inbox.emptyBody") color="ink.muted" text-align="center" max-width="22rem"
        button buttonStyle="filled" press=start testId="first-create"
          text t("inbox.emptyAction")
