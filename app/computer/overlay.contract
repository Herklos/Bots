use Bot, Computer from "../ui/shapes.contract"
use nameOf from "../ui/root-types.contract"
use IconControl from "../ui/controls.contract"
use Glyph from "../glyph.contract"
// ComputerOverlay: one route of the root view, moved out with its values and actions injected.
use ComputerBag from "./bag.contract"

// One layer of the large preview. The back layer decodes the next JPEG.
// It stays slightly see-through so the browser keeps painting it while it is behind.
component PreviewLayer
  props
    src: string
    front: bool
    ready: action
    label: string
  view
    image `data:image/jpeg;base64,${src}` load=ready aria-hidden=(not front) aria-label=(front ? label : "") z-index=(front ? 1 : 0) position="absolute" inset=0 width="100%" height="100%" object-fit="contain" opacity=0.99

component ComputerOverlay
  props
    paneA: string
    paneB: string
    showA: bool
    paneLoadedA: action
    paneLoadedB: action
  inject
    computerBag: ComputerBag
    largePageKey: action
    largePoint: action
    largeWheel: action
    largePaste: action
    hideComputerLarge: action
  derive pageLabel = t("computer.pageFor", name=nameOf(computerBag.bots, computerBag.slug))
  view
    column position="absolute" inset=0 z-index=40 align-items="center" justify-content="center" background-color="brand.black" testId="computer-overlay"
      button class=IconControl appearance="none" press=hideComputerLarge aria-label=t("computer.close") title=t("computer.close") testId="computer-close" position="absolute" top=12 right=12 z-index=1 color="ink.light" width=44 height=44
        Glyph(name="close", size=22)
      column id="computer-large" position="relative" z-index=0 tabindex=(computerBag.holding ? 0 : -1) key=largePageKey pointerdown=largePoint wheel=largeWheel paste=largePaste touch-action="none" width="100%" height="100%" testId="computer-large"
        if paneA != ""
          PreviewLayer(src=paneA, front=showA, ready=paneLoadedA, label=pageLabel)
        if paneB != ""
          PreviewLayer(src=paneB, front=(not showA), ready=paneLoadedB, label=pageLabel)
