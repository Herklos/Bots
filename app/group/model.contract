use Reply, Sent, Made, botMentions, roomMentions from "../ui/root-types.contract"
members Bots
  state groupName = ""

  state groupAbout = ""

  state groupMembers: string[] = []

  // The new-Group walk: name, the member face, the answer policy, a kickoff, then review.
  state groupStep = "name"

  state groupPolicy = "last"

  // A member slug. Empty unless the policy is chief, and cleared when the members change.
  state groupChief = ""

  state groupPage = "root"

  // Group chat has no server row until room_send returns. This is that text, faded, in the log.
  state roomPending = ""

  // Slugs kept for a moment after they stop, so the working row does not unmount between turns.
  state heldSlugs: string[] = []

  mutation groupMade as shape Made refreshes convos then afterGroupMade

  mutation roomSent as shape Sent refreshes room, convos then afterRoomSend

  mutation groupGone as shape Reply refreshes convos

  mutation groupSaved as shape Reply refreshes room, convos

  mutation roomSeen as shape Reply refreshes convos, room

  derive groupSaveError = match groupSaved { case some(r) => r.error, case none => "" }

  derive groupError = match groupMade { case some(r) => r.error, case none => "" }

  derive canMakeGroup = groupName.trim() != "" and groupMembers.length >= 2 and not pending(groupMade)

  derive roomError = match roomSent { case some(r) => r.error, case none => "" }

  derive workingMembers = room.members.filter(m => m.working)

  derive workerKey = workingMembers.map(m => m.slug).join(",")

  derive paintedWorkers = workingMembers.length > 0 ? workingMembers : room.members.filter(m => heldSlugs.filter(s => s == m.slug).length > 0)

  derive mentionPool = roomId != "" ? roomMentions(bots, room.members, t("group.everyone")) : botMentions(bots).filter(h => h.slug != slug)

  // A later Bot line ends the turn at once. Working that stays false after the send settles drops the row.
  task releaseWorkSoon when holdWork and not pending(sent) and laterBot
    after(1, dropWork)

  task releaseWorkLater when holdWork and not pending(sent) and not laterBot and not chat.working
    after(800, dropWork)

  // Remember who is working, then drop that row shortly after the last one stops.
  task catchWorkers when workerKey != "" key=workerKey
    after(1, keepWorkers)

  task releaseWorkers when roomId != "" and workerKey == "" and heldSlugs.length > 0
    after(800, dropWorkers)

  task leaveWorkers when roomId == "" and heldSlugs.length > 0
    after(1, dropWorkers)

  action keepWorkers()
    heldSlugs = workingMembers.map(m => m.slug)

  action dropWorkers()
    if workingMembers.length == 0
      heldSlugs = []

  action openNewGroup
    writeDrafts()
    plusOpen = false
    groupName = ""
    groupAbout = ""
    groupMembers = []
    groupStep = "name"
    groupPolicy = "last"
    groupChief = ""
    nav = push(nav, "/new-group")

  action editGroupName(v: string)
    groupName = v

  action editGroupAbout(v: string)
    groupAbout = v

  action pickGroupPolicy(p: string)
    groupPolicy = p
    if p == "chief"
      if not groupMembers.includes(groupChief)
        groupChief = match first(groupMembers) { case some(s) => s, case none => "" }
    else
      groupChief = ""

  action pickGroupChief(m: string)
    if groupMembers.includes(m)
      groupChief = m

  action toggleGroupMember(m: string)
    groupMembers = groupMembers.includes(m) ? groupMembers.filter(x => x != m) : groupMembers.concat([m])
    groupChief = ""
    if groupPolicy == "chief"
      groupChief = match first(groupMembers) { case some(s) => s, case none => "" }

  action groupStepBack
    if groupStep == "face"
      groupStep = "name"
    else if groupStep == "policy"
      groupStep = "face"
    else if groupStep == "kickoff"
      groupStep = "policy"
    else if groupStep == "review"
      groupStep = "kickoff"

  action groupStepNext
    if groupStep == "name"
      if groupName.trim() != ""
        groupStep = "face"
    else if groupStep == "face"
      if groupMembers.length >= 2
        groupStep = "policy"
    else if groupStep == "policy"
      groupStep = "kickoff"
    else if groupStep == "kickoff"
      groupStep = "review"

  action makeGroup
    if canMakeGroup
      send groupMade = createGroup(groupName.trim(), groupAbout.trim(), "brand.default", "ball", groupMembers.join("\n"), groupPolicy, groupPolicy == "chief" ? groupChief : "")

  action afterGroupMade
    match groupMade
      case some(r)
        if r.ok and r.id != "" and top(nav).name == "newGroup"
          nav = push(back(nav), path("group", r.id))
      case none

  action toggleGroupPanel
    groupPanel = not groupPanel
    groupPage = "root"

  action openGroupEdit
    refresh prefs
    groupPage = "edit"

  action groupBack
    groupPage = "root"

  action openGroupAdd
    groupPage = "add"

  action closeGroupAdd
    groupPage = "edit"

  action patchGroup(field: string, value: string)
    if roomId != ""
      send groupSaved = updateGroup(roomId, field, value)

  action removeGroupMember(m: string)
    if roomId != "" and room.members.length > 2
      let next = room.members.map(x => x.slug).filter(x => x != m)
      send groupSaved = updateGroup(roomId, "members", next.join("\n"))

  action addGroupMember(m: string)
    if roomId != ""
      let current = room.members.map(x => x.slug)
      if not current.includes(m)
        send groupSaved = updateGroup(roomId, "members", current.concat([m]).join("\n"))
        groupPage = "edit"

  action dropGroup
    if roomId != ""
      send groupGone = deleteGroup(roomId)
      groupPanel = false
      groupPage = "root"
      nav = back(nav)

  action postRoom
    if roomText.trim() != "" and not pending(roomSent) and roomId != ""
      let text = roomText.trim()
      away = false
      stickToEnd = true
      let id = `m-${sendTick + 1}`
      sendTick = sendTick + 1
      roomSentId = id
      roomPending = text
      send roomSent = sendRoom(roomId, text, id)
      roomText = ""
      clearMention()
    focus("room-composer")

  action afterRoomSend
    if roomError != "" or room.messages.filter(m => m.id == roomSentId).length > 0
      roomPending = ""

  action forgetRoomPending
    if room.messages.filter(m => m.id == roomSentId).length > 0
      roomPending = ""

  action roomKey(k: string, event: KeyboardEvent)
    if mentionOn and mentionHits.length > 0 and (k == "ArrowDown" or k == "ArrowUp" or k == "Enter" or k == "Tab" or k == "Escape")
      preventDefault()
      if k == "Escape"
        dismissMention()
      else if k == "ArrowDown"
        mentionIdx = mentionIdx + 1 >= mentionHits.length ? 0 : mentionIdx + 1
      else if k == "ArrowUp"
        mentionIdx = mentionIdx <= 0 ? mentionHits.length - 1 : mentionIdx - 1
      else if not event.repeat
        match mentionHits.at(mentionIdx)
          case some(h)
            completeMention(h.slug)
          case none
    else if k == "Enter" and not event.shiftKey and not event.isComposing
      preventDefault()
      if not event.repeat
        postRoom()

  action doMuteGroup(id: string, on: bool)
    if id != ""
      send groupSaved = updateGroup(id, "notifications", on ? "true" : "false")
