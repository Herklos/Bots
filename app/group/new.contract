use Avatar from "../face.contract"
use Glyph from "../glyph.contract"
use Faces, ChiefList from "./group.contract"
use Screen, PageTitle, PageHeader, TextControl, IconControl, Field, PrimaryButton from "../ui/controls.contract"
use faceColor from "../ui/fns.contract"
use ChoiceRow from "../ui/panel.contract"
use Made, nameOf, pickedFaces from "../ui/root-types.contract"
use Bot from "../ui/shapes.contract"
use GroupCard, SettingsRow from "../ui/sidebar.contract"
// NewGroupScreen: one route of the root view, moved out with its values and actions injected.
use NewGroupBag from "./new-bag.contract"
component NewGroupScreen
  props
    route: number
  inject
    newGroupBag: NewGroupBag
    back: action
    editGroupAbout: action
    editGroupName: action
    goGroupStep: action
    groupStepBack: action
    groupStepNext: action
    makeGroup: action
    pickGroupChief: action
    pickGroupPolicy: action
    toggleGroupMember: action
  view
    column class=Screen navigationKey=`${route}` navigationPresentation="modal" navigationScroll="group-form" position="absolute" inset=0
      header class=PageHeader
        if newGroupBag.groupStep != "name"
          button id="back" class=TextControl appearance="none" press=groupStepBack testId="group-back"
            text t("common.back")
        text t("group.new") role="heading" aria-level=1 class=PageTitle flex=1
        button class=IconControl appearance="none" press=back aria-label=t("common.close") title=t("common.close") testId="group-close"
          Glyph(name="close", size=20)
      scroll id="group-form" flex=1 min-height=0
        column width="100%" max-width="34rem" box-sizing="border-box" margin="0 auto" padding="space.lg" gap="space.lg"
          if newGroupBag.groupStep == "face" or newGroupBag.groupStep == "review"
            column align-items="center" gap="space.md" testId="group-face-preview"
              Faces(faces=pickedFaces(newGroupBag.bots, newGroupBag.groupMembers), size=72, tuck=-28)
              text (newGroupBag.groupMembers.length == 0 ? t("group.pickFaces") : t("group.face")) color="ink.muted" font="-exact-footnote" text-align="center"
          if newGroupBag.groupStep == "name"
            column gap="space.sm"
              text t("group.askName") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-name"
              input appearance="none" class=Field value=newGroupBag.groupName input=editGroupName submit=groupStepNext placeholder=t("group.namePlaceholder") aria-label=t("group.name") padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-name"
          else if newGroupBag.groupStep == "face"
            column gap="space.sm"
              text t("group.askFace") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-face"
              row align-items="baseline" gap="space.sm"
                text t("common.bots") font="-exact-subheadline" font-weight=600 flex=1
                text (newGroupBag.groupMembers.length < 2 ? t("group.pickMore", n=newGroupBag.groupMembers.length) : t("group.picked", n=newGroupBag.groupMembers.length)) color="ink.muted" font="-exact-footnote" testId="group-count"
              column gap="space.xs"
                for b in newGroupBag.pickableBots key=b.slug
                  button appearance="none" press=toggleGroupMember(b.slug) role="checkbox" aria-checked=newGroupBag.groupMembers.includes(b.slug) aria-label=b.name testId=`pick-bot-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border=(newGroupBag.groupMembers.includes(b.slug) ? "2px solid AccentColor" : "2px solid surface.line") border-radius="radius.md" background-color="surface.card" color="-exact-label"
                    row gap="space.md" align-items="center" width="100%"
                      Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=36, still=true, presence="")
                      text b.name font-weight=500 flex=1 min-width=0 text-align="left"
                      column width=24 height=24 align-items="center" justify-content="center" border-radius="radius.full" background-color=(newGroupBag.groupMembers.includes(b.slug) ? "AccentColor" : "transparent") border=(newGroupBag.groupMembers.includes(b.slug) ? "none" : "2px solid surface.line") color="ink.dark"
                        if newGroupBag.groupMembers.includes(b.slug)
                          Glyph(name="check", size=14)
          else if newGroupBag.groupStep == "policy"
            column gap="space.sm" width="100%"
              text t("group.askPolicy") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-policy"
              button class=ChoiceRow appearance="none" press=pickGroupPolicy("last") role="radio" aria-checked=(newGroupBag.groupPolicy == "last") testId="policy-last"
                column flex=1 gap="2px" min-width=0 align-items="flex-start"
                  text t("group.policyLast") font-weight=600
                  text t("group.policyLastAbout") color="ink.muted" font="-exact-footnote"
              button class=ChoiceRow appearance="none" press=pickGroupPolicy("everyone") role="radio" aria-checked=(newGroupBag.groupPolicy == "everyone") testId="policy-everyone"
                column flex=1 gap="2px" min-width=0 align-items="flex-start"
                  text t("group.policyEveryone") font-weight=600
                  text t("group.policyEveryoneAbout") color="ink.muted" font="-exact-footnote"
              button class=ChoiceRow appearance="none" press=pickGroupPolicy("chief") role="radio" aria-checked=(newGroupBag.groupPolicy == "chief") testId="policy-chief"
                column flex=1 gap="2px" min-width=0 align-items="flex-start"
                  text t("group.policyChief") font-weight=600
                  text t("group.policyChiefAbout") color="ink.muted" font="-exact-footnote"
              if newGroupBag.groupPolicy == "chief"
                ChiefList(bots=newGroupBag.pickableBots, slugs=newGroupBag.groupMembers, selected=newGroupBag.groupChief, pick=pickGroupChief)
          else if newGroupBag.groupStep == "kickoff"
            column gap="space.sm"
              text t("group.askKickoff") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2 testId="step-group-kickoff"
              textarea appearance="none" class=Field value=newGroupBag.groupAbout input=editGroupAbout placeholder=t("group.kickoffPlaceholder") aria-label=t("group.stepKickoff") rows=4 maxlength=2000 padding="space.md space.lg" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-about"
          else
            column gap="space.sm" testId="step-group-review"
              text t("create.review") font="-exact-title3" font-weight=600 letter-spacing="-0.3px" role="heading" aria-level=2
              column class=GroupCard padding="0"
                button class=SettingsRow appearance="none" press=goGroupStep("name") min-height=56 padding="space.sm space.md" testId="review-edit-name"
                  column flex=1 min-width=0 gap="2px" align-items="flex-start"
                    text t("common.name") color="ink.muted" font="-exact-footnote"
                    text newGroupBag.groupName font-weight=600 testId="review-group-name"
                  Glyph(name="chevron", size=18)
                button class=SettingsRow appearance="none" press=goGroupStep("policy") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-policy"
                  column flex=1 min-width=0 gap="2px" align-items="flex-start"
                    text t("group.stepPolicy") color="ink.muted" font="-exact-footnote"
                    row gap="space.sm" align-items="baseline" flex-wrap="wrap" min-width=0
                      text (newGroupBag.groupPolicy == "everyone" ? t("group.policyEveryone") : newGroupBag.groupPolicy == "chief" ? t("group.policyChief") : t("group.policyLast")) font-weight=600 testId="review-policy" overflow-wrap="anywhere"
                      if newGroupBag.groupPolicy == "chief"
                        text nameOf(newGroupBag.bots, newGroupBag.groupChief) testId="review-chief" overflow-wrap="anywhere"
                  Glyph(name="chevron", size=18)
                button class=SettingsRow appearance="none" press=goGroupStep("kickoff") min-height=56 padding="space.sm space.md" border-top="1px solid surface.line" testId="review-edit-kickoff"
                  column flex=1 min-width=0 gap="2px" align-items="flex-start"
                    text t("group.stepKickoff") color="ink.muted" font="-exact-footnote"
                    text (newGroupBag.groupAbout.trim() == "" ? t("group.noKickoff") : newGroupBag.groupAbout) font-weight=600 testId="review-kickoff"
                  Glyph(name="chevron", size=18)
          if newGroupBag.groupError != "" and not newGroupBag.groupMadePending
            text newGroupBag.groupError color="-exact-system-red" testId="group-error"
      row justify-content="center" padding="space.md space.lg" border-top="1px solid surface.line" box-sizing="border-box"
        column width="100%" max-width="34rem"
          if newGroupBag.groupStep == "review"
            button class=PrimaryButton buttonStyle="filled" press=makeGroup disabled=(not newGroupBag.canMakeGroup) width="100%" testId="group-create"
              text (newGroupBag.groupMadePending ? t("common.creating") : t("group.create"))
          else
            button class=PrimaryButton buttonStyle="filled" press=groupStepNext disabled=((newGroupBag.groupStep == "name" and newGroupBag.groupName.trim() == "") or (newGroupBag.groupStep == "face" and newGroupBag.groupMembers.length < 2)) width="100%" testId="group-next"
              text t("create.next")
