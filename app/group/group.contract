use Avatar from "../face.contract"
use Glyph from "../glyph.contract"
use shapeOf, colorOf, faceColor, bitShape, bitColor, bitState, memberFaces, memberCalled, quietPolicyHint from "../ui/fns.contract"
use ChoiceRow from "../ui/panel.contract"
use Bot, Room, FaceBit from "../ui/shapes.contract"
use PageTitle, TextControl, IconControl, ToggleControl, ConversationLink, SectionLabel, IconTile, Field from "../ui/controls.contract"

component Faces
  props
    faces: FaceBit[]
    size: number
    tuck: number
  view
    row align-items="center" testId="group-faces" aria-hidden="true" flex-shrink=0
      if faces.length == 0
        column width=size height=size border-radius="radius.full" border="2px dashed surface.line" background-color="surface.raised"
      if faces.length >= 1
        column z-index=1 flex-shrink=0 border="2px solid surface.canvas" border-radius="radius.full" background-color="surface.canvas"
          Avatar(shape=bitShape(faces, 0), color=faceColor(bitColor(faces, 0)), state=bitState(faces, 0), size=size, still=(bitState(faces, 0) != "working"), presence=(bitState(faces, 0) == "working" ? "online" : ""))
      if faces.length >= 2
        column z-index=2 flex-shrink=0 margin-left=tuck border="2px solid surface.canvas" border-radius="radius.full" background-color="surface.canvas"
          Avatar(shape=bitShape(faces, 1), color=faceColor(bitColor(faces, 1)), state=bitState(faces, 1), size=size, still=(bitState(faces, 1) != "working"), presence=(bitState(faces, 1) == "working" ? "online" : ""))
      if faces.length >= 3
        column z-index=3 flex-shrink=0 margin-left=tuck border="2px solid surface.canvas" border-radius="radius.full" background-color="surface.canvas"
          Avatar(shape=bitShape(faces, 2), color=faceColor(bitColor(faces, 2)), state=bitState(faces, 2), size=size, still=(bitState(faces, 2) != "working"), presence=(bitState(faces, 2) == "working" ? "online" : ""))

// A Vault login's sheet. The password field starts empty: a saved password is shown only after Reveal.
component GroupPanel
  props
    shown: bool
    wide: bool
    page: string
    room: Room
    bots: Bot[]
    closePanel: action
    openEdit: action
    goRoot: action
    openAdd: action
    closeAdd: action
    patch: action
    removeMember: action
    addMember: action
    drop: action
    error: string
  state title = room.title
  state about = room.description
  state memberQuery = ""
  derive memberSlugs = room.members.map(m => m.slug)
  derive chiefSlug = match first(room.members.filter(m => m.slug == room.chief)) { case some(m) => m.slug, case none => match first(room.members) { case some(m) => m.slug, case none => "" } }
  derive candidates = bots.filter(b => not b.hideFromSidebar and not memberSlugs.includes(b.slug))
  derive memberQ = memberQuery.trim().toLowerCase()
  derive shownCandidates = (candidates.length > 6 and memberQ != "") ? candidates.filter(b => b.name.toLowerCase().includes(memberQ) or b.slug.toLowerCase().includes(memberQ)) : candidates
  action editTitle(v: string)
    title = v
  action editAbout(v: string)
    about = v
  action editMemberQuery(v: string)
    memberQuery = v
  action beginAdd
    memberQuery = ""
    openAdd()
  view
    column id="group-panel" display=(shown ? "flex" : "none") position="absolute" top=(wide ? 0 : 72) right=0 bottom=0 width=(wide ? "20rem" : "100%") box-sizing="border-box" background-color="surface.canvas" border-left="1px solid surface.line" testId="group-panel"
      row align-items="center" gap="space.xs" padding="space.sm space.sm space.sm space.md" min-height=52 box-sizing="border-box"
        if page == "add"
          button class=IconControl appearance="none" press=closeAdd aria-label=t("common.back") title=t("common.back") testId="group-add-back"
            column rotate="180deg"
              Glyph(name="chevron", size=20)
          text t("group.addBot") role="heading" aria-level=2 class=PageTitle flex=1 testId="group-panel-title"
        else if page == "edit"
          button class=IconControl appearance="none" press=goRoot aria-label=t("common.back") title=t("common.back") testId="group-panel-back"
            column rotate="180deg"
              Glyph(name="chevron", size=20)
          text t("group.edit") role="heading" aria-level=2 class=PageTitle flex=1 testId="group-panel-title"
        else
          column flex=1
          button class=IconControl appearance="none" press=openEdit aria-label=t("group.edit") title=t("group.edit") testId="group-edit"
            Glyph(name="settings", size=20)
          button class=IconControl appearance="none" press=closePanel aria-label=t("panel.close") title=t("panel.close") testId="group-panel-close"
            Glyph(name="close", size=20)
      if page == "add"
        scroll flex=1 min-height=0
          column gap="space.lg" padding="space.sm space.lg space.xl" testId="group-add-page"
            if candidates.length > 6
              input type="search" appearance="none" class=Field value=memberQuery input=editMemberQuery placeholder=t("group.searchBots") aria-label=t("group.searchBots") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-add-search"
            if shownCandidates.length == 0
              text (candidates.length == 0 ? t("group.everyoneIn") : t("group.noMatch")) color="ink.muted" testId="group-add-empty"
            column gap="space.xs"
              for b in shownCandidates key=b.slug
                button appearance="none" press=addMember(b.slug) aria-label=b.name testId=`group-add-${b.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" color="-exact-label"
                  row gap="space.md" align-items="center" width="100%"
                    Avatar(shape=b.shape, color=faceColor(b.color), state="idle", size=32, still=true, presence="")
                    text b.name font-weight=500 flex=1 min-width=0 text-align="left"
      else if page == "edit"
        scroll flex=1 min-height=0
          column gap="space.lg" padding="space.sm space.lg space.xl" testId="group-edit-page"
            column gap="space.sm"
              text t("common.name") class=SectionLabel
              input appearance="none" class=Field value=title input=editTitle change=patch("title") aria-label=t("group.name") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-edit-name"
            column gap="space.sm"
              text t("common.description") class=SectionLabel
              input appearance="none" class=Field value=about input=editAbout change=patch("description") placeholder=t("group.aboutPlaceholderShort") aria-label=t("common.description") padding="0 space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId="group-edit-about"
            column gap="space.sm"
              text t("group.stepPolicy") class=SectionLabel
              column role="radiogroup" aria-label=t("group.stepPolicy") gap="space.xs"
                for policy in ["default", "last", "everyone", "chief"] key=policy
                  button class=ChoiceRow appearance="none" press=patch("answerPolicy", policy) role="radio" aria-checked=(room.answerPolicy == policy) testId=`group-policy-${policy}` background-color=(room.answerPolicy == policy ? "surface.raised" : "transparent")
                    text (policy == "default" ? t("group.policyDefaultNamed", policy=(room.answerPolicyEffective == "everyone" ? t("group.policyEveryone") : room.answerPolicyEffective == "chief" ? t("group.policyChief") : t("group.policyLast"))) : policy == "last" ? t("group.policyLast") : policy == "everyone" ? t("group.policyEveryone") : t("group.policyChief"))
            if room.answerPolicyEffective == "chief"
              column gap="space.xs" width="100%" min-width=0
                text t("group.chief") class=SectionLabel
                column role="radiogroup" aria-label=t("group.chief") gap="space.xs" width="100%" min-width=0
                  for m in room.members key=m.slug
                    button class=ChoiceRow appearance="none" press=patch("chief", m.slug) role="radio" aria-checked=(chiefSlug == m.slug) aria-label=m.name testId=`group-chief-${m.slug}` width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border="1px solid surface.line" border-radius="radius.md" background-color=(chiefSlug == m.slug ? "surface.raised" : "surface.card")
                      Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state=m.state, size=32, still=(m.state != "working"), presence="")
                      text m.name font-weight=500 flex=1 min-width=0 text-align="left" overflow-wrap="anywhere"
                      column width=22 height=22 flex-shrink=0 align-items="center" justify-content="center" border-radius="radius.full" background-color=(chiefSlug == m.slug ? "AccentColor" : "transparent") border=(chiefSlug == m.slug ? "none" : "2px solid surface.line")
                        if chiefSlug == m.slug
                          column width=8 height=8 border-radius="radius.full" background-color="ink.dark"
            column gap="space.sm"
              row align-items="center" gap="space.sm"
                text t("common.bots") class=SectionLabel flex=1
                button class=TextControl appearance="none" press=beginAdd testId="group-add-open"
                  text t("group.add")
              for m in room.members key=m.slug
                row gap="space.md" align-items="center" width="100%" box-sizing="border-box" min-height=52 padding="space.sm space.md" border="1px solid surface.line" border-radius="radius.md" background-color="surface.card" testId=`group-roster-${m.slug}`
                  Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state=m.state, size=32, still=(m.state != "working"), presence="")
                  text m.name font-weight=500 flex=1 min-width=0 text-align="left"
                  button appearance="none" press=removeMember(m.slug) disabled=(room.members.length < 3) aria-label=t("group.removeNamed", name=m.name) testId=`group-remove-${m.slug}` color=(room.members.length < 3 ? "ink.muted" : "-exact-system-red")
                    text t("group.remove")
            if error != ""
              text error color="-exact-system-red" testId="group-error-panel"
            row align-items="center" gap="space.md" min-height=56 padding="0 space.md"
              column class=IconTile color="AccentColor"
                Glyph(name="bell", size=18)
              column flex=1 gap="2px"
                text t("edit.notify") font-weight=600 testId="mute-group-label"
                text t("edit.muteNote") color="ink.muted" font="-exact-footnote"
              button class=ToggleControl appearance="none" role="switch" aria-checked=room.notifications press=patch("notifications", room.notifications ? "false" : "true") aria-label=t("edit.notify") testId="mute-group"
                row width=44 height=26 border-radius="radius.full" background-color=(room.notifications ? "AccentColor" : "surface.line") align-items="center" justify-content=(room.notifications ? "flex-end" : "flex-start")
                  column width="1.25rem" height="1.25rem" margin="0 3px" border-radius="radius.full" background-color="ink.light"
            row align-items="center" gap="space.md" min-height=56 padding="0 space.md" border-top="1px solid surface.line"
              column class=IconTile color="-exact-system-red"
                Glyph(name="trash", size=18)
              column flex=1 gap="2px"
                text t("group.delete") font-weight=600 color="-exact-system-red"
                text t("group.deleteNote") color="ink.muted" font="-exact-footnote"
              button class=IconControl appearance="none" commandfor="drop-group" command="show-modal" aria-label=t("group.delete") title=t("group.delete") color="-exact-system-red" testId="group-delete"
                Glyph(name="trash", size=20)
            dialog id="drop-group" role="alertdialog" aria-label=t("group.deleteNamed", name=room.title)
              text t("group.deleteBody")
              button press=drop destructive=true commandfor="drop-group" command="close" testId="group-delete-ok"
                text t("common.delete")
              button commandfor="drop-group" command="close" testId="group-delete-cancel"
                text t("common.cancel")
      else
        scroll flex=1 min-height=0
          column gap="space.lg" padding="0 space.lg space.xl"
            column align-items="center" gap="space.xs"
              Faces(faces=memberFaces(bots, room.members), size=72, tuck=-28)
              text room.title font="-exact-title3" font-weight=700 letter-spacing="-0.3px" text-align="center" overflow-wrap="anywhere" testId="group-details-name"
              text (room.description != "" ? room.description : t("group.noAbout")) color="ink.muted" font="-exact-footnote" text-align="center" testId="group-details-about"
            column gap="2px"
              text t("group.botsCount", n=room.members.length) class=SectionLabel testId="group-members-label"
              for m in room.members key=m.slug
                link class=ConversationLink href=path("chat", m.slug) testId=`group-member-${m.slug}` padding="space.sm space.md"
                  row gap="space.md" align-items="center"
                    Avatar(shape=shapeOf(bots, m.slug), color=faceColor(colorOf(bots, m.slug)), state=m.state, size=40, still=(m.state != "working"), presence="")
                    column gap="2px" flex=1 min-width=0
                      text m.name font-weight=600 overflow="hidden" text-overflow="ellipsis" white-space="nowrap"
                      text m.line color="ink.muted" font="-exact-footnote"
            text quietPolicyHint(room.answerPolicyEffective, t("group.hintNoneLast"), t("group.hintNoneEveryone"), t("group.hintNoneChief", chief=memberCalled(room.members, room.chief))) color="ink.muted" font="-exact-footnote" testId="group-details-hint" width="100%" min-width=0 overflow-wrap="anywhere"
