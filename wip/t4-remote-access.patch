+        assert_eq!(get(tailnet_port, "/api/bots", &[("cf-access-jwt-assertion", "a.b.c")]).await.0, 401);
+        assert!(get(tailnet_port, "/api/config", &you).await.1.contains("\"accessLogout\":false"), "signing out on the tailnet stays on the tailnet");
