+
+    #[tokio::test]
+    async fn the_local_tool_server_stays_reachable_but_not_through_cloudflare() {
+        let dir = tempfile::tempdir().unwrap();
+        let s = state(dir.path(), Exposure { landing_only: true, ..Default::default() });
+        let port = serve(on_public(app(s.clone()), s.clone())).await;
+        let res = reqwest::Client::new().post(format!("http://127.0.0.1:{port}/mcp/bot")).header("authorization", "Bearer fixture-only").body("{}").send().await.unwrap();
+        assert_ne!(res.status().as_u16(), 404);
+        let res = reqwest::Client::new().post(format!("http://127.0.0.1:{port}/mcp/bot")).header("cf-ray", "x").header("authorization", "Bearer fixture-only").body("{}").send().await.unwrap();
+        assert_eq!(res.status().as_u16(), 404);
+    }
+
+    #[tokio::test]
+    async fn the_tailnet_listener_serves_the_app_to_its_user_only() {
