+        let mut h = HeaderMap::new();
+        assert!(!tailnet_user_allowed(&h, &users));
+        h.insert("tailscale-user-login", HeaderValue::from_static("ME@example.com "));
+        assert!(tailnet_user_allowed(&h, &users));
+        h.insert("tailscale-user-login", HeaderValue::from_static("guest@example.com"));
+        assert!(!tailnet_user_allowed(&h, &users));
