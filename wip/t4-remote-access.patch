+        // Cloudflare Access on: a request without a valid token or session is refused, as in Threebot.
+        let access = crate::access::Access::new("https://fixture.invalid".into(), "http://127.0.0.1:1/certs".into(), "fixture".into(), vec!["me@example.com".into()]);
