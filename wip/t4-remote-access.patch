+        let port = serve(on_public(app(s.clone()), s.clone())).await;
+        assert_eq!(get(port, "/", &[]).await, (200, "LANDING".into()));
+        assert_eq!(get(port, "/welcome/", &[]).await, (200, "LANDING".into()));
+        assert_eq!(get(port, "/welcome/img/ball.webp", &[]).await, (200, "BALL".into()));
+        for url in ["/index.html", "/sw.js", "/login", "/api/session", "/api/bots", "/t3/ws", "/welcome/img/missing.png"] {
+            assert_eq!(get(port, url, &[]).await.0, 404, "{url}");
+        }
+        assert_eq!(get(port, "/api/bots", &[("tailscale-user-login", "me@example.com")]).await.0, 404);
+        assert_eq!(get(port, "/api/health", &[]).await.0, 200, "health stays up for the updater");
