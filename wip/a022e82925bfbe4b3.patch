+
+// A project's sheet. Its kind is chosen when it is made and fixed after.
+component ProjectSheet
+  props
+    route: number
+    item: Project
+    error: string
+    save: action
+    drop: action
+    cancel: action
+  state kind = item.kind
+  state ttl = item.title
+  state status = item.status
+  state area = item.area
+  state body = item.body
+  action pickKind(v: string)
+    kind = v
+  action editTitle(v: string)
+    ttl = v
+  action editStatus(v: string)
+    status = v
+  action editArea(v: string)
+    area = v
+  action editBody(v: string)
+    body = v
+  view
+    column navigationKey=`${route}` navigationPresentation="modal" position="absolute" inset=0
+      header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
+        button press=cancel aria-label="Cancel" testId="project-cancel"
+          image "symbol:close"
+        text (item.id == "" ? "New Project" : item.title) role="heading" aria-level=1
+        button press=save(item.id, kind, ttl, status, area, body) disabled=(ttl.trim() == "") buttonStyle="filled" aria-label="Save" testId="project-save"
+          image "symbol:checkmark"
+      list appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
+        section
+          row
+            input value=ttl input=editTitle placeholder="Title" aria-label="Title" flex=1 min-width=0 testId="project-title"
+          row
+            text "Kind"
+            if item.id == ""
+              select value=kind change=pickKind aria-label="Kind" testId="project-kind"
+                option "Project" value="project"
+                option "Task" value="task"
+                option "Machine" value="machine"
+                option "Service" value="service"
+                option "Repo" value="repo"
+                option "Note" value="note"
+                option "Link" value="link"
+            else
+              text kind color="-exact-secondary-label"
+        section
+          row
+            input value=status input=editStatus placeholder="Status" aria-label="Status" flex=1 min-width=0 testId="project-status"
+          row
+            input value=area input=editArea placeholder="Area" aria-label="Area" flex=1 min-width=0 testId="project-area"
+        section
+          row
+            textarea value=body input=editBody rows=6 placeholder="Notes" aria-label="Notes" flex=1 min-width=0 testId="project-body"
+        if error != ""
+          section
+            text error color="-exact-system-red" testId="project-error"
+        if item.id != ""
+          section
+            button commandfor="drop-project" command="show-modal" testId="project-delete"
+              text "Delete"
+      dialog id="drop-project" role="alertdialog" aria-label="Delete this item?"
+        text "It is removed from the board. This can’t be undone."
+        button press=drop(item.id) destructive=true commandfor="drop-project" command="close" testId="drop-project-ok"
+          text "Delete"
+        button commandfor="drop-project" command="close" testId="drop-project-cancel"
+          text "Cancel"
