+++ b/tests/compat/run.sh
@@ -0,0 +1,240 @@
+#!/usr/bin/env bash
+# hbots <-> Bots compatibility harness (T10).
+#
+# Runs hbots Node gateway and the Rust `bots` gateway in turn against one HBOTS_HOME and checks that
+# each one reads and writes the other's files, and that a sign-in cookie issued by one is accepted by the other
+# (both use the same session-secret). Each check prints PASS or FAIL. INFO lines record differences in behaviour
+# on the same input; they are observations, not pass/fail.
+#
+# Usage: tests/compat/run.sh
+# Env:   HBOTS_SRC  hbots checkout (default: the read-only clone in the agent scratchpad)
+#        BOTS_BIN      prebuilt `bots` binary (default: cargo build of gateway/)
+#        COMPAT_WORK   scratch directory (default: a new mktemp directory, kept afterwards)
+#        COMPAT_PORT   port both gateways listen on, one at a time (default 37810)
+# Exit:  0 when every check passes, 1 otherwise, 2 when the setup fails.
+set -u
+
+HERE=$(cd "$(dirname "$0")" && pwd)
+REPO=$(cd "$HERE/../.." && pwd)
+HBOTS_SRC=${HBOTS_SRC:-/tmp/claude-0/-home-user-Bots/0044585a-cb11-55a6-921c-f38153a8540a/scratchpad/src/hbots}
+WORK=${COMPAT_WORK:-$(mktemp -d "${TMPDIR:-/tmp}/bots-compat.XXXXXX")}
+PORT=${COMPAT_PORT:-37810}
+PASS_WORD=compat-pass
+PASSED=0
+FAILED=0
+GW_PID=""
+
+ok() { PASSED=$((PASSED + 1)); echo "PASS $1 $2"; }
+bad() { FAILED=$((FAILED + 1)); echo "FAIL $1 $2${3:+ (got: $3)}"; }
+info() { echo "INFO $1 $2"; }
+expect() { # id description actual expected
+  if [ "$3" = "$4" ]; then ok "$1" "$2"; else bad "$1" "$2" "$3"; fi
+}
+# jv FILE EXPR: EXPR runs with j = the parsed JSON in FILE. Prints the value as JSON (strings bare).
+jv() {
+  node -e 'const j = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8")); const v = eval(process.argv[2]); console.log(typeof v === "string" ? v : JSON.stringify(v));' "$1" "$2" 2>/dev/null || echo "<unreadable>"
+}
+leaks() { if grep -q -F -- "$2" "$1" 2>/dev/null; then echo yes; else echo no; fi; }
+sha() { sha256sum < "$1" | cut -d' ' -f1; }
+
+# code METHOD PATH JAR BODY: HTTP status; the response body is left in $WORK/last.body.
+code() {
+  local args=(-s -o "$WORK/last.body" -w '%{http_code}' -X "$1" "http://127.0.0.1:$PORT$2")
+  [ -n "$3" ] && args+=(-H "Cookie: $(cat "$3")")
+  [ -n "$4" ] && args+=(-H 'content-type: application/json' --data-binary "$4")
+  curl "${args[@]}" 2>/dev/null || echo 000
+}
+# login JAR: signs in with the shared password and keeps the bot_session cookie in JAR.
+login() {
+  curl -s -D - -o /dev/null -X POST -H 'content-type: application/json' --data-binary "{\"password\":\"$PASS_WORD\"}" "http://127.0.0.1:$PORT/api/login" \
+    | tr -d '\r' | sed -n 's/^[Ss]et-[Cc]ookie: \(bot_session=[^;]*\).*/\1/p' > "$1"
+}
+
+# start KIND HOME: runs one gateway on HOME and waits for /api/health.
+start() {
+  local kind=$1 home=$2 log="$WORK/logs/$1-$(date +%s%N).log"
+  mkdir -p "$WORK/logs"
+  if [ "$kind" = node ]; then
+    (cd "$NODE_DIR" && exec env HBOTS_HOME="$home" PORT=$PORT HOST=127.0.0.1 HBOTS_PASSWORD=$PASS_WORD T3_TOKEN=compat-token T3_URL=http://127.0.0.1:9 node gateway.mjs) >"$log" 2>&1 &
+  else
+    (cd "$WORK" && exec env HBOTS_HOME="$home" PORT=$PORT HOST=127.0.0.1 HBOTS_PASSWORD=$PASS_WORD T3_TOKEN=compat-token T3_URL=http://127.0.0.1:9 "$BOTS_BIN") >"$log" 2>&1 &
+  fi
+  GW_PID=$!
+  for _ in $(seq 1 100); do
+    if curl -s -o /dev/null "http://127.0.0.1:$PORT/api/health"; then return 0; fi
+    sleep 0.2
+  done
+  echo "$kind gateway did not answer /api/health. Log $log:"; tail -20 "$log"; exit 2
+}
+stop() {
+  if [ -n "$GW_PID" ]; then kill "$GW_PID" 2>/dev/null; wait "$GW_PID" 2>/dev/null; fi
+  GW_PID=""
+  sleep 0.3
+}
+trap stop EXIT
+
+# fixtures HOME: hbots-format Bots (Ada is main, Grace second), written the way hbots writes them.
+fixtures() {
+  local home=$1
+  mkdir -p "$home/bots/b-ada/.bot" "$home/bots/b-grace/.bot"
+  cp "$HERE/fixtures/bot-ada.json" "$home/bots/b-ada/.bot/bot.json"
+  cp "$HERE/fixtures/bot-grace.json" "$home/bots/b-grace/.bot/bot.json"
+}
+
+# ---------------------------------------------------------------- setup
+echo "== setup (work dir: $WORK)"
+NODE_DIR=$WORK/node-server
+if [ ! -d "$NODE_DIR/node_modules" ]; then
+  [ -d "$HBOTS_SRC/server" ] || { echo "No hbots server at $HBOTS_SRC/server (set HBOTS_SRC)."; exit 2; }
+  rm -rf "$NODE_DIR" && mkdir -p "$NODE_DIR"
+  (cd "$HBOTS_SRC/server" && tar --exclude=node_modules -cf - .) | (cd "$NODE_DIR" && tar -xf -)
+  (cd "$NODE_DIR" && npm ci --no-audit --no-fund >"$WORK/npm-ci.log" 2>&1) || { echo "npm ci failed, see $WORK/npm-ci.log"; exit 2; }
+fi
+if [ -z "${BOTS_BIN:-}" ]; then
+  cargo build --quiet --manifest-path "$REPO/gateway/Cargo.toml" || { echo "cargo build failed"; exit 2; }
+  TARGET=$(cargo metadata --no-deps --format-version 1 --manifest-path "$REPO/gateway/Cargo.toml" | node -pe 'JSON.parse(require("fs").readFileSync(0, "utf8")).target_directory')
+  BOTS_BIN=$TARGET/debug/bots
+fi
+echo "node gateway: $NODE_DIR/gateway.mjs"
+echo "rust gateway: $BOTS_BIN ($("$BOTS_BIN" --version))"
+
+HOME_DIR=$WORK/home
+APP=$HOME_DIR/bots/.botapp
+rm -rf "$HOME_DIR" && fixtures "$HOME_DIR"
+
+# ---------------------------------------------------------------- phase 1: hbots writes
+echo "== phase 1: hbots Node gateway on the shared home"
+start node "$HOME_DIR"
+login "$WORK/node.jar"
+expect N0 "Node refuses /api/bots without a session" "$(code GET /api/bots "" "")" 401
+
+c=$(code GET /api/bots "$WORK/node.jar"); expect N1 "Node answers GET /api/bots" "$c" 200
+expect N1b "Node reads both bot.json files, Ada main" "$(jv "$WORK/last.body" 'j.bots.map(b => b.slug + ":" + b.primary).join(",")')" "b-ada:true,b-grace:false"
+
+c=$(code PUT /api/bots/b-grace "$WORK/node.jar" '{"label":"Node label"}'); expect N2 "Node saves a Bot" "$c" 200
+expect N2b "Node writes bot.json, keeps mainThreadId and createdAt" "$(jv "$HOME_DIR/bots/b-grace/.bot/bot.json" 'j.label + "|" + j.mainThreadId + "|" + j.createdAt')" "Node label|thread-grace|2026-01-02T00:00:00.000Z"
+
+c=$(code PUT /api/main-bot "$WORK/node.jar" '{"slug":"b-grace"}'); expect N3 "Node selects the main Bot" "$c" 200
+expect N3b "Node writes main-bot.json and moves the primary flag" "$(jv "$APP/main-bot.json" 'j.slug')|$(jv "$HOME_DIR/bots/b-grace/.bot/bot.json" 'j.primary')|$(jv "$HOME_DIR/bots/b-ada/.bot/bot.json" 'j.primary')" "b-grace|true|false"
+
+c=$(code PUT /api/settings "$WORK/node.jar" '{"userName":"Node User","beta":{"projects":true}}'); expect N4 "Node saves settings" "$c" 200
+expect N4b "Node writes settings.json with the Beta switch" "$(jv "$APP/settings.json" 'j.userName + "|" + j.beta.projects')" "Node User|true"
+
+c=$(code POST /api/vault "$WORK/node.jar" '{"type":"login","title":"Node login","website":"https://node.example.test","username":"node-user","password":"node-pw-XYZ"}')
+expect N5 "Node creates a Vault login" "$c" 200
+NODE_VAULT_ID=$(jv "$WORK/last.body" 'j.id')
+expect N5b "Node vault.enc has the bot-vault envelope" "$(jv "$HOME_DIR/vault.enc" 'j.format + " " + j.version + " " + j.cipher')" "bot-vault 1 aes-256-gcm"
+expect N5c "Node vault.enc holds no plaintext password" "$(leaks "$HOME_DIR/vault.enc" node-pw-XYZ)" no
+expect N5d "Node .vault-key is 32 bytes, mode 600" "$(wc -c < "$HOME_DIR/.vault-key" | tr -d ' ')|$(stat -c %a "$HOME_DIR/.vault-key")" "32|600"
+
+c=$(code POST /api/projects/items "$WORK/node.jar" '{"items":[{"title":"Node item","kind":"task"}]}'); expect N6 "Node saves a Projects item" "$c" 200
+NODE_ITEM=$(jv "$APP/projects.json" 'Object.keys(j.items)[0]')
+expect N6b "Node writes projects.json with the item" "$(jv "$APP/projects.json" 'Object.keys(j.items).length + "|" + j.items[Object.keys(j.items)[0]].title')" "1|Node item"
+
+c=$(code GET /api/session "$WORK/node.jar" ""); expect N7 "Node reports its own session as signed in" "$(jv "$WORK/last.body" 'j.authenticated')" true
+stop
+
+# ---------------------------------------------------------------- phase 2: Rust reads and writes
+echo "== phase 2: the Rust gateway on the same home"
+start rust "$HOME_DIR"
+login "$WORK/rust.jar"
+
+expect R0 "Rust refuses /api/bots without a session" "$(code GET /api/bots "" "")" 401
+c=$(code GET /api/session "$WORK/node.jar" ""); expect R1 "Rust accepts the cookie Node issued" "$(jv "$WORK/last.body" 'j.authenticated')" true
+
+c=$(code GET /api/bots "$WORK/node.jar"); expect R2 "Rust answers GET /api/bots" "$c" 200
+expect R2b "Rust reads Node's main-bot.json and bot.json" "$(jv "$WORK/last.body" 'j.bots.map(b => b.slug + ":" + b.primary).join(",")')" "b-ada:false,b-grace:true"
+expect R2c "Rust reads Node's label edit" "$(jv "$WORK/last.body" 'j.bots.find(b => b.slug === "b-grace").label')" "Node label"
+
+c=$(code GET /api/settings "$WORK/node.jar"); expect R3 "Rust reads Node's settings" "$(jv "$WORK/last.body" 'j.userName + "|" + j.beta.projects')" "Node User|true"
+
+c=$(code GET /api/vault "$WORK/node.jar"); expect R4 "Rust lists Node's Vault item" "$(jv "$WORK/last.body" 'j.items.map(i => i.title).join(",")')" "Node login"
+expect R4b "Rust redacts the password in the list" "$(jv "$WORK/last.body" 'j.items[0].password !== "node-pw-XYZ"')" true
+c=$(code GET "/api/vault/$NODE_VAULT_ID?reveal=1" "$WORK/node.jar"); expect R4c "Rust decrypts Node's vault.enc on reveal" "$(jv "$WORK/last.body" 'j.password')" node-pw-XYZ
+
+c=$(code GET /api/projects "$WORK/node.jar"); expect R5 "Rust reads Node's Projects item" "$(jv "$WORK/last.body" 'j.items.filter(i => i.title === "Node item").length')" 1
+
+c=$(code PUT /api/bots/b-ada "$WORK/rust.jar" '{"label":"Rust label"}'); expect R6 "Rust saves a Bot" "$c" 200
+expect R6b "Rust writes bot.json, keeps name, mainThreadId and createdAt" "$(jv "$HOME_DIR/bots/b-ada/.bot/bot.json" 'j.label + "|" + j.name + "|" + j.mainThreadId + "|" + j.createdAt')" "Rust label|Ada|thread-ada|2026-01-01T00:00:00.000Z"
+
+c=$(code PUT /api/main-bot "$WORK/rust.jar" '{"slug":"b-ada"}'); expect R7 "Rust selects the main Bot" "$c" 200
+expect R7b "Rust writes main-bot.json and moves the primary flag" "$(jv "$APP/main-bot.json" 'j.slug')|$(jv "$HOME_DIR/bots/b-ada/.bot/bot.json" 'j.primary')|$(jv "$HOME_DIR/bots/b-grace/.bot/bot.json" 'j.primary')" "b-ada|true|false"
+
+c=$(code PUT /api/settings "$WORK/rust.jar" '{"userName":"Rust User"}'); expect R8 "Rust saves settings" "$c" 200
+expect R8b "Rust keeps the Beta switch when it saves settings" "$(jv "$APP/settings.json" 'j.userName + "|" + j.beta.projects')" "Rust User|true"
+
+KEY_BEFORE=$(sha "$HOME_DIR/.vault-key")
+c=$(code POST /api/vault "$WORK/rust.jar" '{"type":"login","title":"Rust login","website":"https://rust.example.test","username":"rust-user","password":"rust-pw-ABC"}'); expect R9 "Rust creates a Vault login" "$c" 200
+RUST_VAULT_ID=$(jv "$WORK/last.body" 'j.id')
+expect R9b "Rust vault.enc holds no plaintext password" "$(leaks "$HOME_DIR/vault.enc" rust-pw-ABC)" no
+expect R9c "Rust keeps the vault key unchanged" "$([ "$(sha "$HOME_DIR/.vault-key")" = "$KEY_BEFORE" ] && echo same || echo changed)" same
+c=$(code GET "/api/vault/$NODE_VAULT_ID?reveal=1" "$WORK/rust.jar"); expect R9d "Rust still reveals Node's item after writing" "$(jv "$WORK/last.body" 'j.password')" node-pw-XYZ
+
+c=$(code POST /api/projects/items "$WORK/rust.jar" "{\"items\":[{\"id\":\"$NODE_ITEM\",\"title\":\"Rust edit\"}]}"); expect R10 "Rust saves a change to Node's Projects item" "$c" 200
+expect R10b "Rust keeps Node's item fields on a partial save" "$(jv "$APP/projects.json" "(() => { const i = j.items[\"$NODE_ITEM\"]; return [i.title, typeof i.createdAt, i.createdBy && i.createdBy.type, Array.isArray(i.links), typeof i.fields, typeof i.pinned, typeof i.archived].join(\"|\"); })()")" "Rust edit|string|user|true|object|boolean|boolean"
+
+c=$(code GET /api/session "$WORK/rust.jar" ""); expect R11 "Rust's own session is signed in" "$(jv "$WORK/last.body" 'j.authenticated')" true
+stop
+
+# ---------------------------------------------------------------- phase 3: hbots again, after Rust
+echo "== phase 3: hbots Node gateway again, after Rust wrote the home"
+start node "$HOME_DIR"
+
+c=$(code GET /api/session "$WORK/rust.jar" ""); expect N8 "Node accepts the cookie Rust issued" "$(jv "$WORK/last.body" 'j.authenticated')" true
+c=$(code GET /api/bots "$WORK/rust.jar"); expect N9 "Node reads Rust's main-bot.json and bot.json" "$(jv "$WORK/last.body" 'j.bots.map(b => b.slug + ":" + b.primary + ":" + b.label).join(",")')" "b-ada:true:Rust label,b-grace:false:Node label"
+c=$(code GET /api/settings "$WORK/rust.jar"); expect N10 "Node reads Rust's settings" "$(jv "$WORK/last.body" 'j.userName')" "Rust User"
+c=$(code GET "/api/vault/$RUST_VAULT_ID?reveal=1" "$WORK/rust.jar"); expect N11 "Node decrypts Rust's vault.enc on reveal" "$(jv "$WORK/last.body" 'j.password')" rust-pw-ABC
+c=$(code GET "/api/vault/$NODE_VAULT_ID?reveal=1" "$WORK/rust.jar"); expect N11b "Node still reveals its own item after Rust's write" "$(jv "$WORK/last.body" 'j.password')" node-pw-XYZ
+c=$(code GET /api/projects "$WORK/rust.jar"); expect N12 "Node reads Rust's Projects edit" "$(jv "$WORK/last.body" "j.items.find(i => i.id === \"$NODE_ITEM\").title")" "Rust edit"
+c=$(code POST /api/projects/items "$WORK/rust.jar" "{\"items\":[{\"id\":\"$NODE_ITEM\",\"title\":\"Node edit\"}]}"); expect N13 "Node saves a Projects change over Rust's" "$c" 200
+expect N13b "Node keeps the item's createdBy and createdAt" "$(jv "$APP/projects.json" "(() => { const i = j.items[\"$NODE_ITEM\"]; return [i.title, i.createdBy && i.createdBy.type, typeof i.createdAt].join(\"|\"); })()")" "Node edit|user|string"
+stop
+
+# ---------------------------------------------------------------- differences on the same input (observations)
+echo "== differences: same input, both gateways"
+
+# D1: a fresh home. Does startup create files?
+D1=$WORK/diff-fresh-node; mkdir -p "$D1"
+start node "$D1"; info D1 "Node fresh home after start: settings.json=$([ -f "$D1/bots/.botapp/settings.json" ] && echo written || echo absent), bot-secrets=$([ -d "$D1/bot-secrets" ] && echo yes || echo no)"; stop
+D1R=$WORK/diff-fresh-rust; mkdir -p "$D1R"
+start rust "$D1R"; info D1 "Rust fresh home after start: settings.json=$([ -f "$D1R/bots/.botapp/settings.json" ] && echo written || echo absent), bot-secrets=$([ -d "$D1R/bot-secrets" ] && echo yes || echo no)"; stop
+
+# D2: Beta default. Settings without `beta`, but a board with an item. hbots settles the default at startup.
+D2=$WORK/diff-beta-node; rm -rf "$D2"; mkdir -p "$D2/bots/.botapp"
+echo '{"userName":"Migrated"}' > "$D2/bots/.botapp/settings.json"
+echo '{"version":1,"seq":1,"items":{"x":{"id":"x","kind":"task","title":"Old","createdAt":"2026-01-01T00:00:00.000Z","createdBy":{"type":"user"},"links":[],"fields":{},"pinned":false,"archived":false}},"activity":[]}' > "$D2/bots/.botapp/projects.json"
+cp "$D2/bots/.botapp/settings.json" "$D2/settings.before.json"
+start node "$D2"; info D2 "Node startup, settings without beta, board with 1 item: beta.projects=$(jv "$D2/bots/.botapp/settings.json" 'j.beta && j.beta.projects')"; stop
+D2R=$WORK/diff-beta-rust; rm -rf "$D2R"; mkdir -p "$D2R/bots/.botapp"; cp "$D2/settings.before.json" "$D2R/bots/.botapp/settings.json"; cp "$D2/bots/.botapp/projects.json" "$D2R/bots/.botapp/projects.json"
+start rust "$D2R"; login "$WORK/d2r.jar"
+rewritten=yes; [ "$(sha "$D2R/bots/.botapp/settings.json")" = "$(sha "$D2/settings.before.json")" ] && rewritten=no
+code GET /api/settings "$WORK/d2r.jar" "" >/dev/null
+info D2 "Rust startup, same files: settings.json rewritten=$rewritten, GET /api/settings beta.projects=$(jv "$WORK/last.body" 'j.beta.projects')"; stop
+
+# D3: session payload shape. hbots adds accessLogin; Rust always sends false.
+D3=$WORK/diff-session; rm -rf "$D3"; mkdir -p "$D3"
+start node "$D3"; code GET /api/session "" "" >/dev/null; info D3 "Node /api/session without a password: $(cat "$WORK/last.body")"; stop
+start rust "$D3"; code GET /api/session "" "" >/dev/null; info D3 "Rust /api/session without a password: $(cat "$WORK/last.body")"; stop
+
+# D4: a Bot without createdAt. hbots takes the file's birth time; Rust stamps the current time on each read.
+D4=$WORK/diff-created; rm -rf "$D4"; mkdir -p "$D4/bots/b-linus/.bot"; cp "$HERE/fixtures/bot-linus.json" "$D4/bots/b-linus/.bot/bot.json"
+start node "$D4"; login "$WORK/d4n.jar"
+a=$(code GET /api/bots/b-linus "$WORK/d4n.jar" >/dev/null; jv "$WORK/last.body" 'j.createdAt'); sleep 1.1
+b=$(code GET /api/bots/b-linus "$WORK/d4n.jar" >/dev/null; jv "$WORK/last.body" 'j.createdAt'); info D4 "Node createdAt, two reads 1.1s apart: $a then $b"; stop
+start rust "$D4"; login "$WORK/d4r.jar"
+a=$(code GET /api/bots/b-linus "$WORK/d4r.jar" >/dev/null; jv "$WORK/last.body" 'j.createdAt'); sleep 1.1
+b=$(code GET /api/bots/b-linus "$WORK/d4r.jar" >/dev/null; jv "$WORK/last.body" 'j.createdAt'); info D4 "Rust createdAt, two reads 1.1s apart: $a then $b"; stop
+
+# D5: main-bot.json that is not JSON. hbots refuses to start reconciling; Rust treats it as no choice.
+D5=$WORK/diff-badmain; rm -rf "$D5"; fixtures "$D5"; mkdir -p "$D5/bots/.botapp"; echo '{not json' > "$D5/bots/.botapp/main-bot.json"
+start node "$D5"; login "$WORK/d5n.jar"; c=$(code GET /api/bots "$WORK/d5n.jar"); info D5 "Node GET /api/bots with unreadable main-bot.json: HTTP $c"; stop
+echo '{not json' > "$D5/bots/.botapp/main-bot.json"
+start rust "$D5"; login "$WORK/d5r.jar"; c=$(code GET /api/bots "$WORK/d5r.jar"); info D5 "Rust GET /api/bots with unreadable main-bot.json: HTTP $c, main=$(jv "$WORK/last.body" 'j.bots.find(b => b.primary).slug'), main-bot.json now $(jv "$D5/bots/.botapp/main-bot.json" 'JSON.stringify(j)')"; stop
+
+# D6: a board that is not JSON. hbots refuses to load it (a save can't overwrite it); Rust reads it as empty.
+D6=$WORK/diff-badboard; rm -rf "$D6"; mkdir -p "$D6/bots/.botapp"; echo '{"items":' > "$D6/bots/.botapp/projects.json"; echo '{"userName":"x","beta":{"projects":true}}' > "$D6/bots/.botapp/settings.json"
+start node "$D6"; login "$WORK/d6n.jar"; c=$(code GET /api/projects "$WORK/d6n.jar"); info D6 "Node GET /api/projects with an unreadable board: HTTP $c"; stop
+start rust "$D6"; login "$WORK/d6r.jar"; c=$(code GET /api/projects "$WORK/d6r.jar"); info D6 "Rust GET /api/projects with an unreadable board: HTTP $c, items=$(jv "$WORK/last.body" 'j.items.length')"; stop
+
+echo "== summary: $PASSED passed, $FAILED failed (work dir $WORK)"
+[ "$FAILED" -eq 0 ]
