locale "en-US"
test "management MCP can be enabled and its one-time token revoked"
  tap "Settings"
  clock data
  expect tree missing "settings-domain-integrations"
  tap "settings-domain-access"
  clock data
  expect tree has "mcp-enabled"
  expect tree missing "mcp-endpoint"
  tap "mcp-enabled"
  clock data
  expect text "mcp-endpoint" == "http://127.0.0.1:4321/mcp"
  tap "mcp-new-token"
  expect disabled "mcp-create-token"
  tap "mcp-cancel-token"
  expect tree missing "mcp-token-form"
  tap "mcp-new-token"
  expect tree has "mcp-scope-read"
  tap "mcp-scope-write"
  expect tree has "mcp-scope-write"
  expect tree has "mcp-scope-admin"
  type "mcp-token-label" "Test client"
  tap "mcp-create-token"
  clock data
  expect text "mcp-token" == "fixture-token-only"
  expect tree has "mcp-copy-token"
  expect tree has "mcp-token-done"
  tap "mcp-copy-token"
  expect text "mcp-copy-token" == "Copied"
  tap "mcp-token-done"
  expect tree missing "mcp-token"
  expect tree missing "mcp-token-form"
  expect tree has "mcp-new-token"
  tap "mcp-enabled"
  clock data
  expect tree missing "mcp-endpoint"
  expect tree has "mcp-revoke-fixture"
  expect text "mcp-permissions-fixture" == "Read, Manage Bots and groups"
  tap "mcp-revoke-fixture"
  clock data
  expect tree missing "mcp-token"
  expect tree missing "mcp-revoke-fixture"
  expect tree missing "mcp-new-token"
