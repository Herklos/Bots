// Run with: bun scripts/test-sidebar.mjs. Uses only its local sample gateway.
test "the header restores the current Bot avatar and has no readiness subtitle"
  size 1440x900
  tap "bot-ada"
  clock +600
  clock data
  expect tree has "chat-avatar"
  expect text "chat-title" == "Ada"
  expect text "chat-header" == "Ada"
  expect state panelOpen == true
  expect tree has "panel-tab-details"
  expect tree has "panel-tab-library"
  expect tree has "panel-tab-computer"

test "sidebar drafts survive polling, tabs, and closing the panel"
  size 1440x900
  tap "bot-ada"
  clock +600
  clock data
  type "routine-title" "Keep this routine draft"
  clock +6000
  clock data
  expect text "routine-title" == "Keep this routine draft"
  tap "panel-tab-library"
  clock data
  type "library-title" "Keep this note draft"
  tap "panel-tab-details"
  expect text "routine-title" == "Keep this routine draft"
  tap "panel-toggle"
  clock +3000
  clock data
  expect state panelOpen == false
  tap "panel-toggle"
  expect text "routine-title" == "Keep this routine draft"
  tap "panel-tab-library"
  expect text "library-title" == "Keep this note draft"
  expect text "chat-title" == "Ada"

test "sidebar tabs support arrow keys, Home, and End"
  size 1440x900
  tap "bot-ada"
  clock +600
  clock data
  type "panel-tab-details" key "ArrowRight"
  clock data
  expect state panelTab == "library"
  type "panel-tab-library" key "End"
  clock data
  expect state panelTab == "computer"
  expect tree has "computer-status"
  type "panel-tab-computer" key "Home"
  expect state panelTab == "details"
  expect tree has "bot-name"

test "a narrow panel switches tabs without leaving the conversation"
  size 340x740
  tap "bot-ada"
  clock +600
  clock data
  tap "panel-toggle"
  expect state panelOpen == true
  tap "panel-tab-library"
  clock data
  type "library-title" "A phone draft"
  tap "panel-tab-computer"
  clock data
  expect tree has "computer-status"
  tap "panel-tab-library"
  expect text "library-title" == "A phone draft"
  tap "panel-toggle"
  expect state panelOpen == false
  expect tree has "composer"
  expect text "chat-title" == "Ada"
